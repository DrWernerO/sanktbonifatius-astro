# Zugangsdaten für den Mailversand des Taufe-Anmeldeformulars.
# Diese Datei als ".env" kopieren und ausfüllen (nur für lokalen Test). Die echte .env
# NIE committen (steht in .gitignore). Werte kommen vom All-inkl-Postfach (kasserver.com).
#
# PRODUKTIV: Diese Werte liegen als Environment-Variablen in NETLIFY
# (Site configuration → Environment variables), NICHT im Repo. Absender ist das
# Funktionspostfach formular@mail.sanktbonifatius.de (All-inkl). Läuft live seit 2026-07.

# SMTP-Server des Postfachs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Absender (= Funktionspostfach) und Empfänger (durch Komma getrennt)
SMTP_FROM=formular@mail.sanktbonifatius.de
TAUFE_TO=n.tadic@sanktbonifatius.de, info@sanktbonifatius.de

# Empfänger für Kita-Bewerbungen (Formular auf /kitas/stellenboerse/<slug>/). Nutzt
# dieselben SMTP_*-Zugangsdaten wie oben. Ohne diese Variable geht die Mail an
# bewerbungen-kita@sanktbonifatius.de (im Code hinterlegter Standardwert).
BEWERBUNG_TO=bewerbungen-kita@sanktbonifatius.de

# Passwort für die geschützte Raumbuchungsseite (/kontakt/raumbuchung/), siehe
# src/middleware.ts. PRODUKTIV als Netlify-Umgebungsvariable setzen, NICHT im Repo.
RAUMBUCHUNG_PASSWORD=

# Gemeinsames Passwort aller internen Seiten außer Raumbuchung: Jubiläumsseite (/100-jahre/),
# digitale Kirchenführung (/100-jahre/rundgang/), Download-Statistik (/downloads/statistik/) und
# Pause für die Seele (/exerzitien2027/); der Benutzername wird ignoriert (src/middleware.ts). PRODUKTIV als Netlify-Umgebungsvariable setzen, NICHT im Repo.
INTERNE_SEITEN_PASSWORD=

# ChurchDesk-API (Gottesdienstplan), siehe src/lib/churchdesk.js — Token von ChurchDesk
# bereitgestellt (Partner-API-Key). Organisations-ID 5499 = Pfarrei Sankt Bonifatius Frankfurt.
# PRODUKTIV als Netlify-Umgebungsvariable setzen, NICHT im Repo.
CHURCHDESK_API_TOKEN=
CHURCHDESK_ORGANIZATION_ID=5499

