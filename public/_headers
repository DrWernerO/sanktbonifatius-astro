# Netlify liefert prerenderte Astro-Routen (astro build) als normale statische Dateien vom
# CDN aus — die Response-Header aus dem Code (src/pages/downloads/*.pdf.ts) gelten nur beim
# einmaligen Build, nicht bei der Auslieferung an Besucher. Deshalb hier explizit erzwingen,
# damit ein Klick im Downloads-Menü wirklich sofort herunterlädt (statt eine Vorschau zu
# öffnen) und dabei der schöne Dateiname ankommt (Handbuch 1d).
#
# Highlights-PDF zusätzlich mit X-Robots-Tag: noindex (Auftrag Werner, 2026-09-22) — Google soll
# künftig die eigene Landingpage /downloads/bonifatius-highlights/ ranken statt der PDF direkt.
/downloads/pfarrbrief.pdf
  Content-Disposition: attachment; filename="Sankt Bonifatius Pfarrbrief.pdf"
  Cache-Control: public, max-age=3600, must-revalidate

/downloads/highlights.pdf
  Content-Disposition: attachment; filename="Sankt Bonifatius Highlights.pdf"
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: noindex, nofollow

# Versteckte QR-Landingpage (Brief zum Willkommens-Flyer): zusätzlich zum <meta name="robots"> auch
# als HTTP-Header noindex, damit Suchmaschinen sie sicher nicht aufnehmen (Handbuch 18).
/willkommen/*
  X-Robots-Tag: noindex, nofollow

# Versteckte QR-Landingpage (Brief zum Gutscheinheft): wie /willkommen/ zusätzlich noindex per Header (Handbuch 19).
/baby/*
  X-Robots-Tag: noindex, nofollow

# Interne Statistikseite (Passwortschutz per Middleware): zusätzlich noindex per Header, wie /baby/ und /willkommen/.
/statistik/*
  X-Robots-Tag: noindex, nofollow
/statistik
  X-Robots-Tag: noindex, nofollow
