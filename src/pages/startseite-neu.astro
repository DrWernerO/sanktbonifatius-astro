---
// TESTSEITE: neue Startseite (Entwurf von Werner, Frank und Lovis zur Besprechung, 03.11.2026).
// Ersetzt NICHT die echte Startseite (`index.astro`) — liegt unter /startseite-neu/, bis die Gestaltung
// freigegeben ist. Entwurf/Prototyp: Entwuerfe/startseite-hero/startseite.html + Bericht-PDF.
//
// PASSWORTSCHUTZ: HTTP-Basic-Auth über src/middleware.ts (Benutzername egal, Passwort = Env
// INTERNE_SEITEN_PASSWORD, gemeinsames internes Passwort). Dafür ist `prerender = false` zwingend
// (sonst liefert Netlify die Seite an der Middleware vorbei aus). noindex, nicht in Sitemap,
// robots-Disallow, nicht im Menü.
//
// AUFBAU: neuer Kopfbereich (HeroOrte → NaechsteGottesdienste → WegeKacheln), darunter UNVERÄNDERT
// die bisherigen Startseiten-Komponenten (Termine, Beiträge, Programm, Sakramente, Kirchorte, Foto-Band …).
// FREISCHALTEN (später): Inhalt in index.astro übernehmen (Hero/QuickLinks ersetzen), diese Datei, den
// Eintrag in middleware.ts, sitemap-Filter, robots- und _headers-Zeile entfernen; SEO-Eintrag '/' in
// seo-static.js auf den neuen Kopfbereich prüfen (Titel/Beschreibung bleiben).
// FOTOS: Hero St. Aposteln und St. Wendel stehen noch aus (siehe HeroOrte.astro).
export const prerender = false;

import Base from '../layouts/Base.astro';
import HeroOrte from '../components/HeroOrte.astro';
import NaechsteGottesdienste from '../components/NaechsteGottesdienste.astro';
import WegeKacheln from '../components/WegeKacheln.astro';
import ProgramGrid from '../components/ProgramGrid.astro';
import Sacraments from '../components/Sacraments.astro';
import EventCalendar from '../components/EventCalendar.astro';
import NewsGrid from '../components/NewsGrid.astro';
import ChurchLocations from '../components/ChurchLocations.astro';
import PhotoMarquee from '../components/PhotoMarquee.astro';
import FeatureBlocks from '../components/FeatureBlocks.astro';
import CtaBanner from '../components/CtaBanner.astro';
import NewsLightbox from '../components/NewsLightbox.astro';
---
<Base
  title="Testseite neue Startseite"
  description="Interne Testseite: Entwurf der neuen Startseite."
  noindex={true}
>
  <div class="astro-hn-top">
    <HeroOrte />
    <NaechsteGottesdienste />
    <WegeKacheln />
  </div>
  <EventCalendar tripleHero heading="Aktuelle Veranstaltungen" anchorId="veranstaltungen" />
  <NewsGrid />
  <ProgramGrid seoH1={false} />
  <Sacraments />
  <ChurchLocations />
  <PhotoMarquee />
  <FeatureBlocks />
  <CtaBanner />
  <NewsLightbox />
</Base>

<style>
  /* Handy: Reihenfolge Hero → Wegekacheln → Gottesdienst-Liste (die Liste steht im Quelltext vor den
     Kacheln, weil sie am Desktop als Streifen direkt unter dem Foto sitzt). Nur visuell per order. */
  @media (max-width: 860px) {
    .astro-hn-top { display: flex; flex-direction: column; }
    .astro-hn-top :global(.astro-hn) { order: 1; }
    .astro-hn-top :global(.astro-wege) { order: 2; }
    .astro-hn-top :global(.astro-nxg-m) { order: 3; }
  }
</style>
