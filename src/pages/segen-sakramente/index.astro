---
// Seite „Begleitung auf dem Lebensweg" (Adresse bleibt /segen-sakramente/) — WP-Seite 48265 (/segen-sakramente/), vollständig aus eigenen
// astro-Komponenten (kein set:html mit WP-Markup, vgl. Migrationsplan Abschnitt 9b). Übersichts-
// seite über dem bereits gebauten /segen-sakramente/taufe/. Nav + Footer kommen global aus
// Base.astro (Handbuch Abschnitt 4b) — hier NICHT erneut einbinden. SEO live aus WP (SEOPress).
//
// Hinweis: Die Sakrament-Unterseiten Firmung/Erstkommunion/Trauung/Beichte/Krankensalbung sind
// in Astro noch NICHT gebaut (nur Taufe). Die Kachel-Links zeigen bereits auf die künftigen
// Pfade — vor Go-Live im Portfolio-Check abgleichen (Handbuch Abschnitt 12).
import Base from '../../layouts/Base.astro';
import SegenHero from '../../components/SegenHero.astro';
import SegenStrip from '../../components/SegenStrip.astro';
import SegenIntro from '../../components/SegenIntro.astro';
import SegenWeg from '../../components/SegenWeg.astro';
import SegenFaq from '../../components/SegenFaq.astro';
import SegenCta from '../../components/SegenCta.astro';
import { SEO_STATIC } from '../../lib/seo-static.js';

const seo = SEO_STATIC['/segen-sakramente/'];

// „Gottes Segen für Sie" — 2 Segensformen
const segen = [
  {
    img: '/uploads/kacheln/segen-persoenlicher-segen.webp', alt: 'Priester legt einer Frau zum persönlichen Segen die Hand auf, im Hintergrund Kerzen in St. Bonifatius',
    label: 'Persönlicher Segen',
    title: 'Segen nach dem Gottesdienst',
    text: 'Nach unseren monatlichen Taizégottesdiensten in St. Bonifatius laden wir Sie ein, sich persönlich segnen zu lassen. Außerdem jederzeit nach Vereinbarung mit einem unserer Priester.',
    href: '/gottesdienst-glaube/gottesdienste-die-beruehren/',
    linkText: 'Termine finden &#8594;',
  },
  {
    img: '/uploads/kacheln/segen-paarsegen.webp', alt: 'Zwei Frauen halten sich beim Paarsegen an den Händen, daneben ein Priester und Kerzen',
    pos: 'center',
    label: 'Paarsegen',
    title: 'Segen für Paare',
    text: 'Segen für alle! Paare, die nicht kirchlich heiraten können oder wollen — z.&nbsp;B. in zweiter Ehe oder gleichgeschlechtliche Paare — laden wir herzlich ein, ihre Partnerschaft feierlich segnen zu lassen. Wir freuen uns auf Sie!',
    href: 'mailto:pfarrer@sanktbonifatius.de?subject=Segen%20f%C3%BCr%20Paare',
    linkText: 'Jetzt anfragen &#8594;',
  },
];

// „Sakramente in unserer Pfarrei" — 6 Sakramente
const sakramente = [
  {
    img: '/uploads/kacheln/tile-taufe.webp', alt: 'Kind mit Taufkerze, dem ein Priester die Hand auf die Stirn legt',
    label: 'Sakrament der Initiation',
    title: 'Taufe',
    text: 'In der Taufe schenkt Gott uns neues und ewiges Leben. Wir informieren Sie gerne, wie Sie selbst oder Ihr Kind die Taufe empfangen können.',
    href: '/segen-sakramente/taufe/',
    linkText: 'Zur Taufe &#8594;',
  },
  {
    img: '/uploads/kacheln/tile-firmung.webp', alt: 'Zwei Firmlinge werden von einem Priester in rotem Gewand gesegnet',
    pos: 'center',
    label: 'Sakrament der Reife',
    title: 'Firmung',
    text: 'Der Christ wird mit dem Heiligen Geist gesalbt und beauftragt, Jesus Christus im Leben zu bezeugen. Unsere Firmkurse gestalten wir mit vielfältigen Methoden.',
    href: '/segen-sakramente/firmung/',
    linkText: 'Zur Firmung &#8594;',
  },
  {
    img: '/uploads/kacheln/tile-erstkommunion.webp', alt: 'Erstkommunionkinder in weißen Gewändern mit Messdienern vor der Kirche',
    pos: 'center 25%',
    label: 'Sakrament der Mitte',
    title: 'Eucharistie &amp; Erstkommunion',
    text: 'Im Brot des Lebens gibt Gott unserer Seele Nahrung und erfüllt uns mit seiner Liebe. Die Erstkommunionvorbereitung ist für Kinder und Eltern eine bereichernde Erfahrung.',
    href: '/segen-sakramente/erstkommunion/',
    linkText: 'Zur Erstkommunion &#8594;',
  },
  {
    img: '/uploads/kacheln/tile-trauung.webp', alt: 'Brautpaar tauscht bei der kirchlichen Trauung die Ringe',
    pos: 'center 30%',
    label: 'Sakrament der Ehe',
    title: 'Kirchliche Trauung',
    text: 'Gott verbindet zwei Menschen in seiner Liebe zu einem Bund fürs Leben. Wir tun alles, damit Ihre kirchliche Hochzeit ein unvergesslicher Tag wird.',
    href: '/segen-sakramente/trauung/',
    linkText: 'Zur Trauung &#8594;',
  },
  {
    img: '/uploads/kacheln/tile-beichte.webp', alt: 'Priester im Gespräch mit einer jungen Frau in der Kirchenbank',
    label: 'Sakrament der Versöhnung',
    title: 'Beichte',
    text: 'Gott verzeiht uns unsere Schwächen und schenkt uns einen neuen Anfang. Das Sakrament der Versöhnung ist Einladung zur Befreiung und inneren Erneuerung.',
    href: '/segen-sakramente/beichte/',
    linkText: 'Zur Beichte &#8594;',
  },
  {
    img: '/uploads/kacheln/tile-krankensalbung.webp', alt: 'Offene Hände bei der Krankensalbung',
    pos: 'center',
    label: 'Sakrament der Kranken',
    title: 'Krankensalbung',
    text: 'Durch die Heilige Salbung schenkt Gott heilende Kraft für Körper und Seele. Dieses Sakrament stärkt in schwerer Krankheit und im Alter.',
    href: '/segen-sakramente/krankensalbung/',
    linkText: 'Zur Krankensalbung &#8594;',
  },
];

const [taufe, firmung, erstkommunion, trauung, beichte0, krankensalbung] = sakramente;
const beichte = { ...beichte0, label: undefined, title: 'Sakrament der Vers&ouml;hnung / Beichte', linkText: 'Zum Sakrament der Vers&ouml;hnung &#8594;' };
const katholischWerden = { img: '/uploads/kacheln/tile-katholisch-werden.webp', alt: 'Kelch und Kerzen beim Gottesdienst Fiat Lux in St. Bonifatius', pos: 'center', label: 'Neu in der Kirche', title: 'Katholisch werden',
  text: 'Sie m&ouml;chten sich taufen lassen, wieder eintreten oder in die katholische Kirche aufgenommen werden? Wir beraten Sie gerne.',
  href: '/kontakt/katholisch-werden/', linkText: 'Zum Weg in die Kirche &#8594;' };

// Abschnitte als Weg: Anlass statt Fachwort. Texte/Fotos der Sakramente aus `sakramente` weiterverwendet.
const weg = [
  { id: 'kind', bg: 'creme',
    heading: 'Ein Kind kommt zur Welt, ein Kind w&auml;chst',
    intro: 'Wir freuen uns mit Ihnen &#8212; und begleiten Ihr Kind von der Taufe bis zur Erstkommunion.',
    tiles: [taufe, erstkommunion] },
  { id: 'bund', bg: 'white',
    heading: 'Sich entscheiden, sich binden',
    intro: 'Manche Schritte bestimmen das ganze Leben: der eigene Glaube und ein Versprechen zu zweit.',
    tiles: [
      firmung,
      trauung,
    ] },
  { id: 'neuanfang', bg: 'creme',
    heading: 'Neu anfangen',
    intro: 'Manchmal braucht es ein offenes Gespr&auml;ch und die Zusage: Du darfst neu beginnen &#8212; in der Beichte oder auf dem Weg in unsere Kirche.',
    tiles: [beichte, katholischWerden] },
  { id: 'abschied', bg: 'ruhig',
    heading: 'Krankheit und Abschied',
    intro: 'In schweren Stunden sind Sie nicht allein. Wir sind da &#8212; am Krankenbett und bei einem Todesfall.',
    tiles: [
      krankensalbung,
      { label: 'Wenn jemand gestorben ist', title: 'Trauerfall',
        text: 'Wir begleiten Sie in den ersten Tagen, bei der Trauerfeier und danach. Rufen Sie uns an &#8212; wir nehmen uns Zeit.',
        href: '/kontakt/trauerfall/', linkText: 'Zum Trauerfall &#8594;' },
    ] },
];
---
<Base seo={seo}>
  <SegenHero />
  <SegenStrip />
  <SegenIntro />
  <SegenWeg
    id="segen"
    eager
    bg="white"
    heading="Gottes Segen f&uuml;r Sie"
    intro="Segen ist nicht nur f&uuml;r besondere Anl&auml;sse &#8212; wir laden Sie ein, Gottes gute N&auml;he in Ihrem Leben zu erfahren."
    tiles={segen}
  />
  {weg.map((w) => (
    <SegenWeg id={w.id} bg={w.bg} heading={w.heading} intro={w.intro} tiles={w.tiles} />
  ))}
  <SegenFaq />
  <SegenCta />
</Base>
