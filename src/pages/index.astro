---
// Startseite — vollständig aus eigenen astro-Komponenten (Migrationsplan Abschnitt 9b).
// KEIN set:html mit WP-Theme-Markup mehr → die Seite ist vom WP-Theme entkoppelt.
// Daten: feste Inhalte in den Komponenten; Termine/Beiträge live aus WP-API
// (EventCalendar client-seitig, NewsGrid server-seitig).
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import QuickLinks from '../components/QuickLinks.astro';
import ProgramGrid from '../components/ProgramGrid.astro';
import Sacraments from '../components/Sacraments.astro';
import EventCalendar from '../components/EventCalendar.astro';
import NewsGrid from '../components/NewsGrid.astro';
import ChurchLocations from '../components/ChurchLocations.astro';
import PhotoMarquee from '../components/PhotoMarquee.astro';
import FeatureBlocks from '../components/FeatureBlocks.astro';
import CtaBanner from '../components/CtaBanner.astro';
import NewsLightbox from '../components/NewsLightbox.astro';
import { SEO_STATIC } from '../lib/seo-static.js';
// Nav + Footer kommen global aus Base.astro — hier nicht mehr nötig.

// SEO (Titel/Description/OG/JSON-LD) aus der mit SEOPress optimierten WP-Startseite übernehmen.
const seo = SEO_STATIC['/'];
---
<Base seo={seo}>
  <Hero />
  <QuickLinks />
  {/* TEMPORÄR (2026-08-22, Werner): EventCalendar direkt hinter den Begrüßungstext
      "Mitten im Leben ..." (Teil von QuickLinks) vorgezogen — Original-Reihenfolge
      (nach Sacraments) siehe Git-Historie dieser Datei. sixpack gilt NUR hier auf
      der Startseite, alle anderen Seiten mit <EventCalendar /> bleiben im
      Original-Layout "2 Kacheln + Übersicht". Die notice-Box zum Bartholomäusfest
      (29./30.08.2026) wurde nach dem Fest am 2026-08-30 wieder entfernt. */}
  <EventCalendar
    sixpack
  />
  {/* TEMPORÄR (2026-08-23, Werner): Beiträge (NewsGrid) direkt hinter die Termine gezogen,
      damit Termine und Beiträge untereinanderstehen. ProgramGrid/Sacraments folgen danach
      (Original-Reihenfolge: ProgramGrid, Sacraments, NewsGrid — siehe Git-Historie). */}
  <NewsGrid />
  <ProgramGrid />
  <Sacraments />
  <ChurchLocations />
  <PhotoMarquee />
  <FeatureBlocks />
  <CtaBanner />
  <NewsLightbox />
</Base>
