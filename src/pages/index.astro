---
// Startseite (neuer Kopfbereich seit 03.11.2026: HeroOrte → NaechsteGottesdienste → WegeKacheln;
// alter Hero/QuickLinks ersetzt, Dateien Hero.astro/QuickLinks.astro liegen noch im Repo) — vollständig aus eigenen astro-Komponenten (Migrationsplan Abschnitt 9b).
// KEIN set:html mit WP-Theme-Markup mehr → die Seite ist vom WP-Theme entkoppelt.
// Daten: feste Inhalte in den Komponenten; Termine/Beiträge live aus WP-API
// (EventCalendar client-seitig, NewsGrid server-seitig).
// SSR statt statisch: der Streifen „Die nächsten Gottesdienste" zieht ChurchDesk-Daten bei jedem
// Abruf (Netlify-CDN-Cache 5 Min., s. u.), sonst stünde er bis zum nächsten Build still.
export const prerender = false;

import Base from '../layouts/Base.astro';
import HeroOrte from '../components/HeroOrte.astro';
import NaechsteGottesdienste from '../components/NaechsteGottesdienste.astro';
import WegeKacheln from '../components/WegeKacheln.astro';
import ProgramGrid from '../components/ProgramGrid.astro';
import Sacraments from '../components/Sacraments.astro';
import EventCalendar from '../components/EventCalendar.astro';
import NewsGrid from '../components/NewsGrid.astro';
import ChurchLocations from '../components/ChurchLocations.astro';
import PhotoMarquee from '../components/PhotoMarquee.astro';
import FeatureBlocks from '../components/FeatureBlocks.astro';
import CtaBanner from '../components/CtaBanner.astro';
import NewsLightbox from '../components/NewsLightbox.astro';
import { SEO_STATIC } from '../lib/seo-static.js';
// Nav + Footer kommen global aus Base.astro — hier nicht mehr nötig.

// SEO (Titel/Description/OG/JSON-LD) aus der mit SEOPress optimierten WP-Startseite übernehmen.
const seo = SEO_STATIC['/'];
Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600');
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
---
<Base seo={seo}>
  <div class="astro-home-top">
    <HeroOrte />
    <NaechsteGottesdienste />
    <WegeKacheln />
  </div>
  {/* TEMPORÄR (2026-08-22, Werner): EventCalendar direkt hinter den Begrüßungstext
      "Mitten im Leben ..." (Teil von QuickLinks) vorgezogen — Original-Reihenfolge
      (nach Sacraments) siehe Git-Historie dieser Datei. PROBEWEISE (2026-09-22, Werner):
      tripleHero-Layout "3 Kacheln + CTA-Button" (miniGrid verworfen), siehe EventCalendar.astro. */}
  <EventCalendar tripleHero heading="Aktuelle Veranstaltungen" anchorId="veranstaltungen" />
  {/* TEMPORÄR (2026-08-23, Werner): Beiträge (NewsGrid) direkt hinter die Termine gezogen,
      damit Termine und Beiträge untereinanderstehen. ProgramGrid/Sacraments folgen danach
      (Original-Reihenfolge: ProgramGrid, Sacraments, NewsGrid — siehe Git-Historie). */}
  <NewsGrid />
  <ProgramGrid seoH1={false} />
  <Sacraments />
  <ChurchLocations />
  <PhotoMarquee />
  <FeatureBlocks />
  <CtaBanner />
  <NewsLightbox />
</Base>

<style>
  /* Handy: Reihenfolge Hero → Wegekacheln → Gottesdienst-Liste (die Liste steht im Quelltext vor den
     Kacheln, weil sie am Desktop als Streifen direkt unter dem Foto sitzt). Nur visuell per order. */
  @media (max-width: 860px) {
    .astro-home-top { display: flex; flex-direction: column; }
    .astro-home-top :global(.astro-hn) { order: 1; }
    .astro-home-top :global(.astro-wege) { order: 2; }
    .astro-home-top :global(.astro-nxg-m) { order: 3; }
  }
</style>
