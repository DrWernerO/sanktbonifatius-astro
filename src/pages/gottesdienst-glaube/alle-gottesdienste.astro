---
// „Alle Gottesdienste" — vollständige, filterbare Liste aus der ChurchDesk-API (neu 2026-09-14).
// Verlinkt von GdoTermine.astro (Teaser „nächste 7 Tage" auf der Gottesdienstordnung-Seite).
// Kein WP-Gegenstück; SEO-Kopf (Titel, Beschreibung, Open Graph, Vorschaubild) seit 31.10.2026
// in src/lib/seo-static.js (Checkliste Abschnitt 4/4a).
//
// `prerender = false`: wie gottesdienstordnung.astro — Termine müssen bei jedem Aufruf frisch
// aus ChurchDesk kommen, nicht erst beim nächsten Netlify-Build.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import GdoHero from '../../components/GdoHero.astro';
import GdoAlleTermine from '../../components/GdoAlleTermine.astro';
import { SEO_STATIC } from '../../lib/seo-static.js';

const seo = SEO_STATIC['/gottesdienst-glaube/alle-gottesdienste/'];
---
<Base
  seo={seo}
  title="Alle Gottesdienste"
  description="Alle Gottesdienstzeiten der Pfarrei Sankt Bonifatius Frankfurt — filterbar nach Kirchort und Stichwort."
>
  <GdoHero
    compact
    title="Alle Gottesdienste"
    sub="Die vollständige Übersicht aller Gottesdienste mit Wochentag und Uhrzeit — filtern nach Kirchort oder nach Stichwort suchen."
    buttons={[{ label: 'Zur Gottesdienstordnung', href: '/gottesdienst-glaube/gottesdienstordnung/', primary: true }]}
  />
  <GdoAlleTermine />
</Base>
