---
// Kita-Übersicht — alle 5 Kitas der Pfarrei Sankt Bonifatius Frankfurt
// Astro-Pfad: /kitas/
import Base from '../../layouts/Base.astro';
import KitaIndexHero from '../../components/KitaIndexHero.astro';
import KitaIndexIntro from '../../components/KitaIndexIntro.astro';
import KitaIndexCards from '../../components/KitaIndexCards.astro';
import { getJobs } from '../../lib/wordpress.js';
import { SEO_STATIC } from '../../lib/seo-static.js';

// Für die Stellenanzahl im CTA unten live geholt (s. CLAUDE.md Regel 0) — deshalb die ganze
// Seite `prerender = false` (wie /kitas/stellenboerse/), sonst würde die Zahl beim nächsten
// Build einfrieren und wieder veralten.
export const prerender = false;

const jobs = await getJobs();
const seo = SEO_STATIC['/kitas/'];
---
<Base
  seo={seo}
  title="Unsere Kitas – Pfarrei Sankt Bonifatius Frankfurt"
  description="Fünf katholische Kitas in Frankfurt-Sachsenhausen: St. Bonifatius, St. Aposteln, St. Wendel, Herz Jesu und Deutschorden. Krippe und Kindergarten für Kinder von 1 bis 6 Jahren."
>
  <KitaIndexHero />
  <KitaIndexIntro />
  <KitaIndexCards jobCount={jobs.length} />
</Base>
