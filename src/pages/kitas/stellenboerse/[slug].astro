---
// Stellenanzeige-Detailseite — die Ausschreibung liegt als PDF in der WP-Mediathek (Ordner
// "Astro-Upload/Stellenanzeigen", s. getJobPdfs()/getJobPdfBySlug() in wordpress.js).
// Kein Build-Time-Freeze (prerender=false, wie zuvor): eine neu hochgeladene PDF steht sofort
// online statt erst beim nächsten Netlify-Build.
// Eigene Klassen astro-stljob-* (Fortsetzung des astro-stl-Präfixes der Übersichtsseite).
import Base from '../../../layouts/Base.astro';
import KitaBewerbungForm from '../../../components/KitaBewerbungForm.astro';
import { getJobPdfBySlug, PUBLIC_SITE } from '../../../lib/wordpress.js';

export const prerender = false;

const { slug } = Astro.params;
const job = slug ? await getJobPdfBySlug(slug) : null;

if (!job) {
  return Astro.redirect('/kitas/stellenboerse/', 302);
}

const description = `${job.title}${job.location ? '. ' + job.location : ''}. Vollständige Ausschreibung als PDF, jetzt bewerben.`;

const ICON_PIN = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>';

// JobPosting-Schema (Google for Jobs). Beschreibung bewusst kurz: der eigentliche Anzeigentext
// steckt im PDF und ist nicht als Klartext extrahierbar — title/Ort/Datumsfelder liefern die
// für Google Jobs relevanten Signale (s. Rich-Results-Test-Erkenntnis vom vorherigen Umbau).
const jobPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: job.title,
  description,
  identifier: { '@type': 'PropertyValue', name: 'Sankt Bonifatius Frankfurt', value: String(job.id) },
  datePosted: job.datePosted || undefined,
  validThrough: job.validThrough || undefined,
  hiringOrganization: {
    '@type': 'Organization',
    name: 'Pfarrei Sankt Bonifatius Frankfurt',
    sameAs: PUBLIC_SITE + '/',
    logo: PUBLIC_SITE + '/uploads/2025/09/sanktbonifatius-logo.png',
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: job.location || 'Frankfurt am Main',
      addressRegion: 'HE',
      addressCountry: 'DE',
    },
  },
};
---
<Base title={job.title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jobPostingLd)} />
  <div class="astro-stljob-wrap">
    <a class="astro-stljob-back" href="/kitas/stellenboerse/">&#8592; Zur&uuml;ck zur Stellenb&ouml;rse</a>
    <h1 class="astro-stljob-title">{job.title}</h1>
    {job.location && (
      <div class="astro-stljob-meta">
        <span class="astro-stljob-pill"><span aria-hidden="true" set:html={ICON_PIN} />{job.location}</span>
      </div>
    )}

    <div class="astro-stljob-pdf">
      <iframe class="astro-stljob-pdf__frame" src={job.url} title={`Stellenausschreibung: ${job.title}`} loading="lazy" />
      <a class="astro-stljob-pdf__fallback" href={job.url} target="_blank" rel="noopener">Ausschreibung als PDF in neuem Tab &ouml;ffnen &#8594;</a>
    </div>

    <div class="astro-stljob-cta">
      <p>Interesse geweckt? Wir freuen uns auf Ihre Bewerbung.</p>
      <a class="astro-stljob-cta__btn" href="#bewerben">Jetzt bewerben &#8594;</a>
    </div>
  </div>

  <KitaBewerbungForm jobTitle={job.title} jobSlug={job.slug} />
</Base>

<style is:global>
/* --bf-*-Tokens: diese Seite bindet keine Kxx-Hero-Komponente ein (einzige Quelle der
   Tokens sonst), deshalb hier redundant deklariert — sonst bleiben var(--bf-*) unten
   unaufgelöst (transparent/vererbte Farbe). Werte wie in KitaStellenHero.astro. */
:root {
  --bf-bg: #f7f3ef;
  --bf-bg-alt: #ede4d5;
  --bf-ink: #1e1512;
  --bf-ink-60: #6b5c52;
  --bf-accent: #9a2d2d;
  --bf-gold: #b88a3a;
  --bf-border: #e0d8cf;
  --bf-radius: 14px;
}
.astro-stljob-wrap { max-width: 860px; margin: 0 auto; padding: 56px 24px 80px; }
.astro-stljob-back { display: inline-flex; align-items: center; gap: 6px; color: var(--bf-accent); font-size: 13px; text-decoration: none; font-weight: 600; letter-spacing: .03em; margin-bottom: 40px; }
.astro-stljob-back:hover { text-decoration: underline; }
.astro-stljob-title { font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: clamp(28px, 4vw, 46px); color: var(--bf-ink); line-height: 1.15; margin: 0 0 20px; }
.astro-stljob-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 40px; padding-bottom: 32px; border-bottom: 1px solid var(--bf-border); }
.astro-stljob-pill { display: inline-flex; align-items: center; gap: 6px; background: var(--bf-bg); border: 1px solid var(--bf-border); border-radius: 50px; padding: 6px 14px; font-size: 13px; color: #4a3828; font-weight: 500; }
.astro-stljob-pdf { margin-bottom: 36px; }
.astro-stljob-pdf__frame { display: block; width: 100%; height: 80vh; max-height: 900px; min-height: 480px; border: 1px solid var(--bf-border); border-radius: var(--bf-radius); background: #fff; }
.astro-stljob-pdf__fallback { display: inline-block; margin-top: 12px; color: var(--bf-accent); font-weight: 600; font-size: 14px; text-decoration: none; }
.astro-stljob-pdf__fallback:hover { text-decoration: underline; }
.astro-stljob-cta { background: var(--bf-bg); border: 1px solid var(--bf-border); border-radius: 16px; padding: 36px 40px; margin-top: 48px; text-align: center; }
.astro-stljob-cta p { color: var(--bf-ink); font-size: 15px; margin: 0 0 20px; line-height: 1.6; }
.astro-stljob-cta__btn { display: inline-flex; align-items: center; gap: 8px; background: var(--bf-accent); color: #fff; text-decoration: none; padding: 13px 32px; border-radius: 50px; font-size: 14px; font-weight: 700; }
.astro-stljob-cta__btn:hover { background: #7e2424; }
@media (max-width: 600px) {
  .astro-stljob-wrap { padding: 40px 20px 60px; }
  .astro-stljob-cta { padding: 28px 20px; }
}
</style>
