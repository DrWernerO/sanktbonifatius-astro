---
// „100 Jahre Sankt Bonifatius" – virtueller 360°-Rundgang durch die Kirche, Unterseite der
// Jubiläumsseite (/100-jahre/rundgang/). Ersetzt seit 2026-10-28 den Prototyp mit den
// Handy-Gimbal-Fotos (alter Stand in der Git-Historie, Commit vor „Rundgang 360°“).
// Der Rundgang selbst ist die Komponente Rundgang.astro, alle Inhalte stehen in
// src/data/rundgang.json (Anleitung: docs/rundgang-anleitung.md). Panoramen: Insta360 X6, HDR,
// 14 Stationen (Aufnahmen 28.10.2026), Kacheln via scripts/rundgang-kacheln.py.
// Bewusst NICHT im Nav.astro verlinkt (Regel: Menü nur auf ausdrückliche Anweisung ändern) und mit
// noindex. Passwortschutz über src/middleware.ts (Pfad `/100-jahre/rundgang`, Benutzername egal,
// Passwort in INTERNE_SEITEN_PASSWORD) — braucht deshalb `prerender = false`, sonst würde
// Netlify die Seite als fertige statische Datei ausliefern, an der Middleware vorbei.
export const prerender = false;
import Base from '../../layouts/Base.astro';
import Rundgang from '../../components/Rundgang.astro';
---
<Base title="100 Jahre Sankt Bonifatius – virtueller Rundgang" noindex={true}>
  <section class="jub-intro">
    <p class="jub-badge">Vorschau – noch nicht öffentlich</p>
    <h1>Virtueller Rundgang durch Sankt Bonifatius</h1>
    <p>
      Schauen Sie sich in unserer Kirche um – vom Taufstein bis zum Chorraum und hinauf auf die
      Orgelempore. Ziehen Sie mit der Maus oder dem Finger im Bild, folgen Sie den Pfeilen oder lassen
      Sie sich mit „Rundgang starten“ Schritt für Schritt führen.
    </p>
    <p class="jub-zurueck"><a href="/100-jahre/">← Zur Jubiläumsseite „100 Jahre“</a></p>
  </section>

  <Rundgang />

  <section class="jub-geschichte">
    <h2>Die Geschichte unserer Kirche</h2>
    <p>
      <em>Platzhaltertext.</em> Hier entsteht später ein kurzer Abriss der Geschichte von
      Sankt Bonifatius seit der Grundsteinlegung – wichtige Jahreszahlen, Baugeschichte,
      besondere Ereignisse der letzten 100 Jahre.
    </p>
  </section>

  <section class="jub-gaestebuch">
    <h2>Gästebuch</h2>
    <p>Hinterlassen Sie einen Gruß oder eine Erinnerung zum 100-jährigen Jubiläum.</p>
    <form id="jub-gaestebuch-form">
      <label class="jub-sr" for="jub-gb-name">Ihr Name (optional)</label>
      <input type="text" id="jub-gb-name" placeholder="Ihr Name (optional)" maxlength="60" />
      <label class="jub-sr" for="jub-gb-text">Ihr Eintrag</label>
      <textarea id="jub-gb-text" placeholder="Ihr Eintrag" maxlength="800" required></textarea>
      <button type="submit">Eintragen</button>
      <p id="jub-gb-status" role="status"></p>
    </form>
    <ul id="jub-gaestebuch-liste"></ul>
  </section>

  <script is:inline>
    (function () {
      // --- Gästebuch (unverändert aus dem Prototyp übernommen) ---
      var liste = document.getElementById('jub-gaestebuch-liste');
      var status = document.getElementById('jub-gb-status');

      function formatDatum(iso) {
        try {
          return new Date(iso).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
        } catch (e) {
          return '';
        }
      }

      function renderEintraege(eintraege) {
        liste.innerHTML = '';
        eintraege.forEach(function (e) {
          var li = document.createElement('li');
          var strong = document.createElement('strong');
          strong.textContent = e.name;
          var span = document.createElement('span');
          span.className = 'jub-gb-datum';
          span.textContent = ' – ' + formatDatum(e.datum);
          var p = document.createElement('p');
          p.textContent = e.text;
          li.appendChild(strong);
          li.appendChild(span);
          li.appendChild(p);
          liste.appendChild(li);
        });
      }

      function ladeEintraege() {
        fetch('/api/jubilaeum-gaestebuch')
          .then(function (r) { return r.json(); })
          .then(renderEintraege)
          .catch(function () {});
      }

      document.getElementById('jub-gaestebuch-form').addEventListener('submit', function (e) {
        e.preventDefault();
        var name = document.getElementById('jub-gb-name').value;
        var text = document.getElementById('jub-gb-text').value;
        status.textContent = 'Wird gespeichert …';
        fetch('/api/jubilaeum-gaestebuch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: name, text: text }),
        })
          .then(function (r) {
            if (!r.ok) throw new Error('Fehler');
            return r.json();
          })
          .then(function () {
            status.textContent = 'Danke für Ihren Eintrag!';
            document.getElementById('jub-gb-name').value = '';
            document.getElementById('jub-gb-text').value = '';
            ladeEintraege();
          })
          .catch(function () {
            status.textContent = 'Das hat leider nicht geklappt. Bitte später erneut versuchen.';
          });
      });

      ladeEintraege();
    })();
  </script>

  <style>
    .jub-intro {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 40px 20px 24px;
      text-align: center;
    }
    .jub-badge {
      display: inline-block;
      background: #f5f3ef;
      color: #e2001a;
      border: 1px solid #e2001a;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 999px;
      margin-bottom: 12px;
    }
    .jub-intro h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(28px, 4vw, 42px);
      color: #1a1a1a;
      margin-bottom: 12px;
    }
    .jub-intro p { color: #4a4a4a; max-width: 680px; margin: 0 auto; }
    .jub-intro .jub-zurueck { margin-top: 12px; font-size: 15px; }
    .jub-zurueck a { color: #1a1a1a; }
    .jub-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

    .jub-geschichte, .jub-gaestebuch {
      max-width: 720px;
      margin: 0 auto 50px;
      padding: 0 20px;
    }
    .jub-geschichte h2, .jub-gaestebuch h2 {
      font-family: 'Playfair Display', serif;
      color: #1a1a1a;
      margin-bottom: 12px;
    }
    #jub-gaestebuch-form { display: flex; flex-direction: column; gap: 10px; margin: 16px 0 24px; }
    #jub-gaestebuch-form input, #jub-gaestebuch-form textarea {
      font-family: inherit; font-size: 15px; padding: 10px 12px;
      border: 1px solid #ccc; border-radius: 6px; resize: vertical;
    }
    #jub-gaestebuch-form textarea { min-height: 80px; }
    #jub-gaestebuch-form button {
      align-self: flex-start;
      background: #e2001a; color: #fff;
      border: none; border-radius: 999px;
      padding: 10px 24px; font-weight: 700; cursor: pointer;
    }
    #jub-gb-status { font-size: 14px; color: var(--txt-muted-light); min-height: 20px; }
    #jub-gaestebuch-liste { list-style: none; display: flex; flex-direction: column; gap: 16px; }
    #jub-gaestebuch-liste li { border-top: 1px solid #eee; padding-top: 12px; }
    .jub-gb-datum { color: var(--txt-muted-light); font-size: 13px; }
  </style>
</Base>
