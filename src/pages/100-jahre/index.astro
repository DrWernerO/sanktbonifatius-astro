    :global(.jub-hotspot-tuer)::after {
      content: '';
      position: absolute;
      left: 10px; right: 10px;
      top: 55%; height: 32%;
      border: 2px solid rgba(107, 83, 32, .75);
      border-radius: 4px;
    }
    /* Türgriff (als Kind-Element statt Pseudo, die beiden Kassetten belegen ::before/::after) */
