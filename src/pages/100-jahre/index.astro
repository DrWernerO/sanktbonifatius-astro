---
// Seite „100 Jahre Pfarrkirche St. Bonifatius" — zentrale Jubiläumsseite für das Festjahr 2027
// (Jubiläumsjahr 2027). Neue Seite ohne WP-Vorlage; Briefing: „100 Jahre Pfarrkirche/
// briefing-jubilaeumsseite-100-jahre.md". Vollständig aus eigenen Jub*-Komponenten (Präfix
// `astro-jub`, Handbuch 3). Nav + Footer kommen global aus Base.astro (Handbuch 4b). SEO fest aus
// lib/seo-static.js (Handbuch 1e).
//
// ADRESSE: /100-jahre/ (Kurz-Adresse /100/ in public/_redirects). Der virtuelle Rundgang ist
// Unterseite /100-jahre/rundgang/ (src/pages/100-jahre/rundgang.astro, Prototyp mit eigenem Passwortschutz).
//
// PASSWORTSCHUTZ (Werner, 03.10.2026): HTTP-Basic-Auth über src/middleware.ts (Benutzername
// egal, Passwort in Env INTERNE_SEITEN_PASSWORD — lokal .env, produktiv Netlify). Dafür ist
// `prerender = false` zwingend (sonst liefert Netlify die Seite an der Middleware vorbei aus).
// Zum Freischalten: Eintrag '/100-jahre' in middleware.ts entfernen, prerender-Zeile löschen.
//
// STATUS: noch NICHT öffentlich beworben — noindex, nicht in Sitemap, robots-Disallow, nicht im
// Nav (Regel: Menü nur auf Werners Freigabe). Zum Freischalten: `noindex` an <Base> entfernen,
// Filter in astro.config.mjs (/100-jahre/ ohne Rundgang) + Disallow in robots.txt zurücknehmen, llms.txt-Zeile ergänzen.
//
// PFLEGE: Alle Inhalte stehen als Arrays hier im Frontmatter — Programmblöcke `bloecke` (Items mit `href` = Link; Items ohne Datum
// zeigen „Termin folgt"; neue Items einfach ergänzen), Downloads (`pdf` setzen = Button statt „erscheint …"), Termine (Datum ISO, werden
// automatisch sortiert; vergangene grau). Hero-Foto: public/uploads/2027/jubilaeum/hero-pfarrkirche.jpg
// (aktuell Platzhalter). PDFs liegen lokal unter public/uploads/2027/jubilaeum/ (Handbuch 1g).
export const prerender = false;

import Base from '../../layouts/Base.astro';
import JubHero from '../../components/JubHero.astro';
import JubIntro from '../../components/JubIntro.astro';
import JubProgramm from '../../components/JubProgramm.astro';
import JubDownloads from '../../components/JubDownloads.astro';
import JubTermine from '../../components/JubTermine.astro';
import JubFaq from '../../components/JubFaq.astro';
import { SEO_STATIC } from '../../lib/seo-static.js';

const seo = SEO_STATIC['/100-jahre/'];

// Quelle der Inhalte: „Arbeitsstand.pdf" (Protokolle 16.04. und 23.06.2026) + Briefing. Nur
// besuchertaugliche Angaben — keine Verantwortlichen, kein interner Status. Mit „vorbehaltlich"/
// „Termin folgt" gekennzeichnet, was im Arbeitsstand noch offen oder nur Idee ist.
// ⚠️ ZEITRAUM: Auftakt So 24.01.2027 bis Abschluss So 08.08.2027 (Briefing sprach von „Festmonat
// August" — laut Arbeitsstand ist nur der Abschluss im August).
const bloecke = [
  { id: 'eroeffnung', variant: 'dark', label: 'Auftakt', titel: 'Feierliche Eröffnung',
    intro: 'Gemeinsam eröffnen wir das Jubiläumsjahr: mit einem festlichen Gottesdienst und anschließendem Neujahrsempfang.',
    items: [{ datum: 'Sonntag, 24. Januar 2027', zeit: '11 Uhr', titel: 'Eröffnungsgottesdienst und Neujahrsempfang', text: 'Nach dem Gottesdienst laden wir Sie zum Neujahrsempfang ein.', offen: 'Termin vorbehaltlich der endgültigen Abstimmung.' }] },
  { id: 'jubilarin', variant: 'light', label: 'Geschichte', titel: 'Die 100-jährige Jubilarin besser kennenlernen',
    intro: 'Zwei BonSalons laden ein, unsere Pfarrei und ihren Patron neu zu entdecken.',
    items: [
      { datum: 'Do 25. Februar 2027', zeit: '19:30 Uhr', ort: 'Kleiner Pfarrsaal, Holbeinstraße 70', titel: 'BonSalon: 100 Jahre St. Bonifatius in Frankfurt-Sachsenhausen', text: 'Prof. Dr. Martin Belz (Universität Osnabrück) über Seelsorge, Gemeindeleben und Gottesdienst in einem spannungsvollen Jahrhundert – mit Raum für Fragen und Gespräch.', href: '/termine/bonsalon-100-jahre-st-bonifatius-in-frankfurt-sachsenhausen/', linkText: 'Zur Veranstaltung' },
      { titel: 'BonSalon: Der Hl. Bonifatius – immer noch Vorbild für uns?', text: 'Ein Professor stellt die schillernde Figur des Pfarrpatrons vor und geht mit Pfr. Werner Otto der Frage nach, was der Heilige den heutigen „Bonifatianern“ zu sagen hätte.', offen: 'Referent und Termin werden noch bekannt gegeben.' },
    ] },
  { id: 'gespraech', variant: 'alt', label: 'Begegnung', titel: 'Bonifatianer im Gespräch',
    intro: 'Zwei Formate, in denen Menschen aus unserer Gemeinde miteinander ins Gespräch kommen.',
    items: [
      { titel: 'BonBistro', text: 'Lockere Runden zum Austausch und Kennenlernen, über das Jahr verteilt.', offen: 'Terminvorschläge: 12.02., 12.03., 09.04., 14.05. und 11.06.2027 – Uhrzeit und Ort folgen.' },
      { titel: 'Sofagespräche. Zeitzeugen erzählen', text: 'Pfr. Werner Otto lädt Menschen verschiedener Generationen ein, die in St. Bonifatius für ihr Leben und ihren Glauben wichtige Erfahrungen gemacht haben. Sie erzählen – auf dem Sofa in der Kirche.', offen: 'Termin wird noch bekannt gegeben.' },
    ] },
  { id: 'kultur', variant: 'light', label: 'Kultur', titel: 'Kulturprogramm',
    intro: 'Konzerte, Musical und mehr – der Kirchraum zum Klingen gebracht.',
    items: [
      { titel: 'Orgel- und Chorkonzert', offen: 'Termin noch offen.' },
      { titel: 'Musical und weitere Veranstaltungen', offen: 'Termine noch offen.' },
      { titel: 'Boni-Quiz', text: 'Wie gut kennen Sie unsere Kirche und ihre Geschichte? Ein Quiz zum Mitraten.', offen: 'Format und Termin noch offen.' },
    ] },
  { id: 'entdecken', variant: 'alt', label: 'Entdecken', titel: 'Unsere Pfarrkirche neu entdecken',
    intro: 'Ein digitaler Rundweg durch unsere Kirche – lassen Sie sich überraschen.',
    items: [
      { titel: 'Digitaler Rundweg', text: 'Wir arbeiten an einem digitalen Rundweg, der die Kirche aus neuen Blickwinkeln zeigt.', offen: 'Start wird noch bekannt gegeben.' },
      { titel: 'Ausstellung in der Kirche', text: 'Ein Zeitstrahl ordnet die Geschichte des Hauses ein – von der Stadt- und Bistumsgeschichte bis in unsere Tage – dazu historische Bilder. Sie beginnt kurz nach der Eröffnung.', offen: 'Genaues Datum folgt.' },
    ] },
  { id: 'familie', variant: 'light', label: 'Für alle Generationen', titel: 'Programm für Kinder, Jugend und Familie',
    intro: 'Auch die Jüngsten und ihre Familien feiern mit.', items: [], hinweis: 'Die Veranstaltungen stehen noch nicht fest. Wir ergänzen sie hier, sobald sie geplant sind.' },
  { id: 'pause', variant: 'alt', label: 'Spirituell', titel: 'Mit Leib und Seele ins Jubiläumsjahr',
    intro: 'Ökumenische Exerzitien im Alltag in der Fastenzeit: täglich ein kurzer Impuls, einmal pro Woche eine kleine Gruppe. Kostenlos, ohne Vorkenntnisse.',
    items: [{ datum: '14.02.–27.03.2027', titel: 'Pause für die Seele', text: 'Projektstart ist Samstag, 13. Februar 2027.', href: '/exerzitien2027/', linkText: 'Zur Projektseite' }] },
  { id: 'abschluss', variant: 'dark', label: 'Höhepunkt', titel: 'Festlicher Abschluss: Pontifikalamt und Sommerfest',
    intro: 'Zum Abschluss des Jubiläumsjahrs feiern wir das Pontifikalamt mit Bischof Dr. Georg Bätzing – und danach ein Sommerfest für alle.',
    items: [{ datum: 'Sonntag, 8. August 2027', zeit: '11 Uhr', titel: 'Pontifikalamt mit Bischof Dr. Georg Bätzing und Sommerfest', text: 'Eine Zeitkapsel mit Wünschen für die Zukunft der Gemeinde soll an diesem Tag im Turm versenkt werden.', offen: 'Programm des Sommerfests folgt.' }] },
];

// PDFs: `pdf: '/uploads/2027/jubilaeum/<datei>.pdf'` eintragen, sobald die Datei vorliegt.
// Der digitale Kirchenführer soll später auch als gedruckte Version entstehen (Arbeitsstand B).
const downloads = [
  { titel: 'Flyer', text: 'Das Jubiläum auf einen Blick – zum Ausdrucken und Weitergeben. Ein eigener Flyer mit den Highlight-Terminen ist zu Weihnachten geplant.', pdf: '', erscheint: 'im Laufe des Jahres 2027' },
  { titel: 'Festprogramm', text: 'Alle Veranstaltungen des Jubiläumsjahrs.', pdf: '', erscheint: 'vor der Eröffnung' },
  { titel: 'Kirchenführer', text: 'Ein Rundgang durch unsere Kirche und ihre Geschichte.', pdf: '', erscheint: 'im Laufe des Jahres 2027' },
];

// Termine: `von`/`bis` als ISO-Datum (für Sortierung + „vorbei"); bei ungefähren Angaben ein
// Näherungsdatum setzen, `anzeige` zeigt den Text. `offen` = Hinweis für unfertige Angaben.
const termine = [
  { von: '2027-01-24', anzeige: 'So 24.01.', jahr: '2027', uhrzeit: '11 Uhr', titel: 'Eröffnungsgottesdienst und Neujahrsempfang', text: 'Auftakt des Jubiläumsjahrs.', offen: 'Termin vorbehaltlich der endgültigen Abstimmung.' },
  { von: '2027-01-31', anzeige: 'Ende Januar', jahr: '2027', titel: 'Start der Ausstellung in der Kirche', offen: 'Genaues Datum folgt.' },
  { von: '2027-02-12', anzeige: 'Fr 12.02.', jahr: '2027', titel: 'BonBistro', offen: 'Terminvorschlag, weitere: 12.03., 09.04., 14.05., 11.06. – Uhrzeit und Ort folgen.' },
  { von: '2027-02-13', anzeige: 'Sa 13.02.', jahr: '2027', titel: 'Startup „Pause für die Seele“', href: '/exerzitien2027/', offen: 'Uhrzeit und Ort werden noch bekannt gegeben.' },
  { von: '2027-02-14', bis: '2027-03-27', anzeige: '14.02.–27.03.', jahr: '2027', titel: 'Exerzitien im Alltag „Pause für die Seele“', href: '/exerzitien2027/', text: 'Sechs Wochen, täglich ein Impuls, einmal pro Woche eine kleine Gruppe. Ökumenisch und kostenlos.' },
  { von: '2027-03-07', anzeige: 'So 07.03.', jahr: '2027', titel: 'Bergfest (Laetare)', href: '/exerzitien2027/', offen: 'Uhrzeit und Ort werden noch bekannt gegeben.' },
  { von: '2027-02-25', anzeige: 'Do 25.02.', jahr: '2027', uhrzeit: '19:30 Uhr', ort: 'Kleiner Pfarrsaal, Holbeinstraße 70', titel: 'BonSalon: 100 Jahre St. Bonifatius in Frankfurt-Sachsenhausen', href: '/termine/bonsalon-100-jahre-st-bonifatius-in-frankfurt-sachsenhausen/', text: 'Vortrag von Prof. Dr. Martin Belz (Universität Osnabrück) über Seelsorge, Gemeindeleben und Gottesdienst in einem spannungsvollen Jahrhundert – mit Fragen und Gespräch.' },
  { von: '2027-06-15', anzeige: 'Termin offen', jahr: '2027', titel: 'BonSalon: Der Hl. Bonifatius – immer noch Vorbild für uns?', text: 'Ein Professor stellt die schillernde Figur des Pfarrpatrons vor und geht mit Pfr. Werner Otto der Frage nach, was der Heilige den heutigen „Bonifatianern“ zu sagen hätte.', offen: 'Referent und Termin werden noch bekannt gegeben.' },
  { von: '2027-08-08', anzeige: 'So 08.08.', jahr: '2027', uhrzeit: '11 Uhr', titel: 'Pontifikalamt mit Bischof Dr. Georg Bätzing und Sommerfest', text: 'Festlicher Abschluss des Jubiläumsjahrs.' },
  { von: '2027-12-31', anzeige: 'Termin folgt', jahr: '', titel: 'Kulturprogramm, Sofagespräche, Programm für Kinder, Jugend und Familie, digitaler Rundweg', offen: 'Die Termine stehen noch nicht fest.' },
];
---
<Base seo={seo} noindex={true}>
  <div class="astro-jub">
    <JubHero />
    <JubIntro />
    <JubProgramm bloecke={bloecke} />
    <JubDownloads downloads={downloads} />
    <JubTermine termine={termine} />
    <JubFaq />
  </div>
</Base>

<style is:global>
.astro-jub{
  --bf-bg:#f7f3ef;
  --bf-bg-alt:#ede4d5;
  --bf-ink:#1e1512;
  --bf-ink-60:#6b5c52;
  --bf-accent:#9a2d2d;
  --bf-gold:#b88a3a;
  --bf-border:#e0d8cf;
  --bf-radius:14px;
  --bf-shadow:0 4px 20px rgba(30,21,18,.06);
  --bf-shadow-lg:0 10px 32px rgba(30,21,18,.1);
  --jub-serif:'Playfair Display',Georgia,serif;
  color:var(--bf-ink);
}
/* Gemeinsame Bausteine aller Jub-Sektionen (Überschrift, Unterzeile, Container, Buttons) */
.astro-jub-sec{padding:72px 0}
.astro-jub-wrap{max-width:1120px;margin:0 auto;padding:0 40px}
.astro-jub-wrap--narrow{max-width:820px}
.astro-jub-head{text-align:center;margin:0 auto 36px;max-width:720px}
.astro-jub-hl{font-family:var(--jub-serif);font-size:clamp(26px,3.6vw,38px);font-weight:700;line-height:1.15;letter-spacing:-.01em;color:var(--bf-ink);margin:0 0 10px}
.astro-jub-sub{font-size:16px;line-height:1.6;color:var(--txt-muted-light);margin:0}
.astro-jub-btn{display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:50px;font-size:15px;font-weight:600;text-decoration:none;transition:background .2s,color .2s,border-color .2s,transform .2s}
.astro-jub-btn--primary{background:var(--bf-accent);color:#fff;border:2px solid var(--bf-accent)}
.astro-jub-btn--primary:hover{transform:translateY(-1px);box-shadow:var(--bf-shadow-lg)}
.astro-jub-btn--ghost{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.7)}
.astro-jub-btn--ghost:hover{background:#fff;color:var(--bf-ink);border-color:#fff}
.astro-jub-btn:focus-visible{outline:3px solid var(--accent-gold-deco);outline-offset:3px}
.astro-jub-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;margin:0;padding:0}
@media(max-width:760px){.astro-jub-sec{padding:52px 0}.astro-jub-wrap{padding:0 20px}}
</style>
