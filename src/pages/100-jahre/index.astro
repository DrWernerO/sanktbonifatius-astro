---
// Seite „100 Jahre Pfarrkirche St. Bonifatius" — zentrale Jubiläumsseite für das Festjahr 2027
// (Jubiläumsjahr 2027). Neue Seite ohne WP-Vorlage; Briefing: „100 Jahre Pfarrkirche/
// briefing-jubilaeumsseite-100-jahre.md". Vollständig aus eigenen Jub*-Komponenten (Präfix
// `astro-jub`, Handbuch 3). Nav + Footer kommen global aus Base.astro (Handbuch 4b). SEO fest aus
// lib/seo-static.js (Handbuch 1e).
//
// ADRESSE: /100-jahre/ (Kurz-Adresse /100/ in public/_redirects). Der virtuelle Rundgang ist
// Unterseite /100-jahre/rundgang/ (src/pages/100-jahre/rundgang.astro, Prototyp mit eigenem Passwortschutz).
//
// PASSWORTSCHUTZ (Werner, 03.10.2026): HTTP-Basic-Auth über src/middleware.ts (Benutzername
// egal, Passwort in Env INTERNE_SEITEN_PASSWORD — lokal .env, produktiv Netlify). Dafür ist
// `prerender = false` zwingend (sonst liefert Netlify die Seite an der Middleware vorbei aus).
// Zum Freischalten: Eintrag '/100-jahre' in middleware.ts entfernen, prerender-Zeile löschen.
//
// STATUS: noch NICHT öffentlich beworben — noindex, nicht in Sitemap, robots-Disallow, nicht im
// Nav (Regel: Menü nur auf Werners Freigabe). Zum Freischalten: `noindex` an <Base> entfernen,
// Filter in astro.config.mjs (/100-jahre/ ohne Rundgang) + Disallow in robots.txt zurücknehmen, llms.txt-Zeile ergänzen.
//
// PFLEGE: Alle Inhalte stehen als Arrays hier im Frontmatter — Programmblöcke `bloecke` (Items mit `href` = Link; Items ohne Datum
// zeigen „Termin folgt"; neue Items einfach ergänzen), Downloads (`pdf` setzen = Button statt „erscheint …"). Hero-Foto: public/uploads/2027/jubilaeum/hero-pfarrkirche.jpg
// (aktuell Platzhalter). PDFs liegen lokal unter public/uploads/2027/jubilaeum/ (Handbuch 1g).
export const prerender = false;

import Base from '../../layouts/Base.astro';
import JubHero from '../../components/JubHero.astro';
import JubIntro from '../../components/JubIntro.astro';
import JubSparten from '../../components/JubSparten.astro';
import JubDownloads from '../../components/JubDownloads.astro';
import JubTermine from '../../components/JubTermine.astro';
import JubMitmachen from '../../components/JubMitmachen.astro';
import JubFaq from '../../components/JubFaq.astro';
import { SEO_STATIC } from '../../lib/seo-static.js';

const seo = SEO_STATIC['/100-jahre/'];

// Quelle der Inhalte: „Arbeitsstand.pdf" (Protokolle 16.04. und 23.06.2026) + Briefing. Nur
// besuchertaugliche Angaben — keine Verantwortlichen, kein interner Status. Mit „vorbehaltlich"/
// „Termin folgt" gekennzeichnet, was im Arbeitsstand noch offen oder nur Idee ist.
// ⚠️ ZEITRAUM: Auftakt So 24.01.2027 bis Abschluss So 08.08.2027 (Briefing sprach von „Festmonat
// August" — laut Arbeitsstand ist nur der Abschluss im August).
// Programmsparten nach Werners Gliederung (03.10.2026): je Sparte Foto, Überschrift, Teaser; die
// Einzeltermine klappen auf (`items`). Fotos: `fotos: [{src, alt}]` — leer = Platzhalter „Foto folgt"
// (Fotos liegen lokal unter public/uploads/2027/jubilaeum/, Handbuch 1g). Items ohne `datum` zeigen
// „Termin offen". Bewusst NICHT auf der Seite: Verantwortliche, Budget, Werbemedien/Presse,
// Zeitkapsel/Mitgebsel (nicht selbsterklärend), Portraits an der Empore, Zeitstrahl-Idee, Jubiläumsfilm,
// Boni-Quiz (entfallen, 09.11.2026), BonBons/Kaffeemobil am Schweizer Platz (Infos folgen, Werner gibt sie frei).
const IMG = '/uploads/2027/jubilaeum/';
const sparten = [
  { id: 'eroeffnung', kurz: 'Eröffnung', featured: true, ohneDetails: true, label: 'Auftakt', titel: 'Wir läuten das Jahr ein',
    teaser: 'Am 24. Januar 2027 fällt der Startschuss: Wir feiern einen festlichen Gottesdienst und stoßen danach beim Neujahrsempfang gemeinsam auf hundert Jahre Pfarrkirche an. Ein Jubiläumsjahr beginnt man am besten in guter Gesellschaft.',
    fotos: [{ src: IMG + 'auftakt.jpg', alt: 'Gottesdienst in St. Bonifatius: Gemeinde, Ministrantinnen und Ministranten stehen im Kreis um den Altar, im Hintergrund die Orgelempore' }], fakten: ['So 24.01.2027 · 11 Uhr'],
    items: [{ datum: 'So 24.01.2027', zeit: '11 Uhr', titel: 'Eröffnungsgottesdienst und Neujahrsempfang', von: '2027-01-24', kurz: 'So 24.01.', text: 'Festlicher Gottesdienst, anschließend Neujahrsempfang.' }] },
  { id: 'jubilarin', kurz: 'Pfarrei & Patron', label: 'Geschichte', titel: 'St. Bonifatius – die Pfarrei und ihr Patron',
    teaser: 'Wer war der Namensgeber unserer Kirche, und was hat er uns heute noch zu sagen? Drei BonSalons laden zum Zuhören und Diskutieren ein. Beim Sofagespräch erzählen Menschen verschiedener Generationen, was ihnen St. Bonifatius bedeutet.',
    fotos: [
      { src: IMG + 'bonifatius.jpg', alt: 'Steinfigur des Heiligen Bonifatius an der Backsteinfassade der Pfarrkirche, darüber die Kirchenfenster', h: 1049, pos: '50% 30%' },
      { src: IMG + 'sofagespraeche.jpg', alt: 'Ein grünes Sofa mitten im Kirchraum von St. Bonifatius, im Hintergrund Altar und Fenster', pos: '50% 82%' },
    ],
    fakten: ['BonSalon Do 25.02.2027', 'Sofagespräch Di 13.04.2027', 'BonSalons Mitte März und um den 05.06.'],
    items: [
      { datum: 'Do 25.02.2027', zeit: '19:30 Uhr', ort: 'Kleiner Pfarrsaal, Holbeinstraße 70', titel: 'BonSalon: 100 Jahre St. Bonifatius in Frankfurt-Sachsenhausen', von: '2027-02-25', kurz: 'Do 25.02.', ueb: 'BonSalon: 100 Jahre St. Bonifatius', href: '/termine/bonsalon-100-jahre-st-bonifatius-in-frankfurt-sachsenhausen/', text: 'Prof. Dr. Martin Belz (Universität Osnabrück) zeigt die Pfarreigeschichte als Spiegel eines Jahrhunderts – mit Diskussion.' },
      { datum: 'Mitte März 2027', zeit: '19:30 Uhr', titel: 'BonSalon: Wie weit darf die Kirche sich in die Politik einmischen?', von: '2027-03-15', kurz: 'Mitte März', ueb: 'BonSalon: Kirche und Politik', text: 'Der Journalist Matthias Drobinski spricht darüber, wie weit sich die Kirche in die Politik einmischen darf – mit Diskussion.', offen: 'Genaues Datum folgt.' },
      { datum: 'Di 13.04.2027', zeit: '19:30 Uhr', ort: 'Kirche St. Bonifatius', von: '2027-04-13', kurz: 'Di 13.04.', ueb: 'Sofagespräch: Zeitzeugen erzählen', titel: 'Sofagespräch. Zeitzeugen erzählen', text: 'Pfr. Werner Otto lädt Menschen verschiedener Generationen ein, die in St. Bonifatius für ihr Leben und ihren Glauben wichtige Erfahrungen gemacht haben, zu erzählen – auf dem Sofa in der Kirche.' },
      { datum: 'um den 05.06.2027', zeit: '19:30 Uhr', titel: 'BonSalon: St. Bonifatius – immer noch aktuell?', von: '2027-06-05', kurz: 'um den 05.06.', ueb: 'BonSalon: St. Bonifatius – aktuell?', text: 'Prof. Niccolò Steiner SJ stellt die schillernde Figur des Pfarrpatrons vor und spricht mit Pfr. Werner Otto darüber, was der Heilige den heutigen „Bonifatianern“ zu sagen hätte.', offen: 'Genaues Datum folgt.' },
    ] },
  { id: 'kultur', kurz: 'Kultur', label: 'Kultur', titel: 'Der Kirchraum klingt',
    teaser: 'Das Streichquartett der Frankfurter Oper spielt Haydn, das Frankfurter Saxophonorchester gibt ein Jubiläumskonzert: zwei Abende, an denen unsere Kirche klingt.',
    fotos: [{ src: IMG + 'kultur.jpg', alt: 'Silberne Orgelpfeifen der Orgel von St. Bonifatius, grün und violett angestrahlt', h: 935 }], fakten: ['Di 23.03.2027 · 19:30 Uhr', 'Sa 04.09.2027 · 19:30 Uhr'],
    items: [
      { datum: 'Di 23.03.2027', zeit: '19:30 Uhr', ort: 'St. Bonifatius', von: '2027-03-23', kurz: 'Di 23.03.', ueb: 'Haydn: Die sieben letzten Worte unseres Erlösers am Kreuze', titel: 'Haydn: Die sieben letzten Worte unseres Erlösers am Kreuze – Streichquartett der Frankfurter Oper', text: 'Sieben Sätze, die ein Leben auf den Punkt bringen – in Töne gefasst von Joseph Haydn. Das Streichquartett der Frankfurter Oper spielt dieses Meisterwerk der Stille und der Intensität. Zwischen den Sätzen gibt Pfr. Dr. Werner Otto kurze geistliche Impulse zum Innehalten. Ein Abend für alle, die Musik nicht nur hören, sondern spüren wollen.' },
      { datum: 'Sa 04.09.2027', zeit: '19:30 Uhr', ort: 'St.-Bonifatius-Kirche', von: '2027-09-04', kurz: 'Sa 04.09.', ueb: 'Jubiläumskonzert des Frankfurter Saxophonorchesters', titel: 'Jubiläumskonzert des Frankfurter Saxophonorchesters', text: 'Leitung: Bastian Fiebig, Mitglied unserer Gemeinde.' },
    ] },
  { id: 'gespraech', kurz: 'Begegnung', label: 'Begegnung', titel: 'Begegnen und anstoßen',
    teaser: 'Beim BonBistro treffen Sie Menschen aus unserer Gemeinde: fünf Freitagabende im Schülercafé ORCA, an denen jeweils eine andere Gruppe einlädt. Und irgendwo im Stadtteil wartet eine überraschende Begegnung am Schweizer Platz.',
    fotos: [],
    fakten: ['BonBistro ab Fr 12.02.2027 · 19:30 Uhr', 'Überraschung am Schweizer Platz: Termin folgt'],
    items: [
      { datum: 'Fr 12.02.2027', zeit: 'ab 19:30 Uhr', ort: 'Schülercafé ORCA, Holbeinstraße 70', titel: 'BonBistro – es laden ein: Jugendliche Firmbewerber', von: '2027-02-12', kurz: 'Fr 12.02.', ueb: 'BonBistro (Firmbewerber)' },
      { datum: 'Fr 12.03.2027', zeit: 'ab 19:30 Uhr', ort: 'Schülercafé ORCA, Holbeinstraße 70', titel: 'BonBistro – es laden ein: Bücherei-Team', von: '2027-03-12', kurz: 'Fr 12.03.', ueb: 'BonBistro (Bücherei-Team)' },
      { datum: 'Fr 09.04.2027', zeit: 'ab 19:30 Uhr', ort: 'Schülercafé ORCA, Holbeinstraße 70', titel: 'BonBistro – es laden ein: Jugendkirche JONA', von: '2027-04-09', kurz: 'Fr 09.04.', ueb: 'BonBistro (Jugendkirche JONA)' },
      { datum: 'Fr 14.05.2027', zeit: 'ab 19:30 Uhr', ort: 'Schülercafé ORCA, Holbeinstraße 70', titel: 'BonBistro – es laden ein: Gottesdienst-Teams', von: '2027-05-14', kurz: 'Fr 14.05.', ueb: 'BonBistro (Gottesdienst-Teams)' },
      { datum: 'Fr 04.06.2027', zeit: 'ab 19:30 Uhr', ort: 'Schülercafé ORCA, Holbeinstraße 70', titel: 'BonBistro – es laden ein: Frauengruppen', von: '2027-06-04', kurz: 'Fr 04.06.', ueb: 'BonBistro (Frauengruppen)' },
      { titel: 'Eine überraschende Begegnung am Schweizer Platz', offen: 'Infos folgen zu gegebener Zeit.' },
    ] },
  { id: 'generation', kurz: 'Nächste Generation', label: 'Für Kinder und Jugendliche', titel: 'Die nächste Generation feiert den Hl. Bonifatius',
    teaser: 'Auch die Jüngsten und die Jugendlichen feiern mit: Der Kindergarten führt das Bonifatius-Musical auf, und die Jugendkirche ist für einen Beitrag angefragt. Was genau kommt, verraten wir bald.',
    fotos: [
      { src: IMG + 'familie-kinder.jpg', alt: 'Ein Kleinkind mit Strohhut läuft lachend mit ausgestreckten Armen auf eine Frau zu' },
      { src: IMG + 'jugend-gruppe.jpg', alt: 'Eine Gruppe Jugendlicher liegt lachend im Kreis auf einer Decke im Gras, von oben fotografiert', h: 1050 },
    ],
    fakten: ['So 20.06.2027 · 11 Uhr', 'Jugendkirche: Termin folgt'],
    items: [
      { datum: 'So 20.06.2027', zeit: '11 Uhr', titel: 'Familiengottesdienst mit dem Kindergarten: Bonifatius-Musical', von: '2027-06-20', kurz: 'So 20.06.', ueb: 'Bonifatius-Musical (Kindergarten)', text: 'Aufführung des Bonifatius-Musicals im Gottesdienst mit dem Kindergarten.' },
      { titel: 'Beitrag der Jugendkirche', offen: 'Format und Termin stehen noch nicht fest.' },
    ] },
  { id: 'entdecken', kurz: 'Kirche entdecken', label: 'Entdecken', titel: 'Die Kirche mit neuen Augen',
    teaser: 'Unsere Pfarrkirche mit neuen Augen: In der Kirche zeigt eine Ausstellung mit Zeitstrahl und historischen Bildern ein bewegtes Jahrhundert. Und unser Virtueller Kirchenführer zeigt Ihre Kirche aus ganz neuen Blickwinkeln, mit Infos zu Orten und Kunstwerken, der Schatzkammer und der Heiligenwand mit Texten und Videos von Gemeindemitgliedern. Er ist schon zur Hälfte begehbar und wird laufend erweitert.',
    fotos: [{ src: IMG + 'kirchenfuehrer.jpg', alt: 'Blick in das Kirchenschiff von St. Bonifatius: weit geschwungene graue Gewölbebögen, in der Mitte ein Kronleuchter, vorn der Altarraum', h: 1062, pos: '50% 60%' }],
    fakten: ['Ausstellung ab Ende Januar', 'Digital · wird laufend erweitert'],
    items: [
      { datum: 'ab Ende Januar 2027', titel: 'Ausstellung in der Kirche', von: '2027-01-31', kurz: 'ab Ende Januar', text: 'Ein Zeitstrahl ordnet die Geschichte des Hauses ein – von der Stadt- und Bistumsgeschichte bis heute – dazu historische Bilder. Beginn kurz nach der Eröffnung.', offen: 'Genaues Datum folgt.' },
    ],
    cta: { href: '/100-jahre/rundgang/', text: 'Zum Virtuellen Kirchenführer' } },
  { id: 'pause', kurz: 'Pause für die Seele', label: 'Spirituell', titel: 'Eine Pause für die Seele',
    teaser: 'Sechs Wochen in der Fastenzeit innehalten: jeden Tag ein kurzer Impuls, einmal pro Woche eine kleine Gruppe. Ökumenisch, ohne Vorkenntnisse und mitten im Alltag – so begehen Sie das Jubiläum auch spirituell.',
    fotos: [{ src: IMG + 'pause-40-tage.jpg', alt: 'Pause für die Seele – Vierzig Tage, die gut tun.', contain: true, w: 1400, h: 788 }], mediaBg: '#581c5a',
    fakten: ['14.02.–27.03.2027', '20 € Teilnahmegebühr'],
    items: [{ datum: '14.02.–27.03.2027', titel: 'Exerzitien im Alltag „Pause für die Seele“', von: '2027-02-14', bis: '2027-03-27', kurz: '14.02.–27.03.', ueb: 'Exerzitien „Pause für die Seele“', text: 'Start am Sa 13.02., Bergfest am So 07.03.2027. Die Teilnahme kostet 20 Euro.' }],
    cta: { href: '/exerzitien2027/', text: 'Zur Projektseite' } },
  { id: 'abschluss', kurz: 'Abschluss', featured: true, ohneDetails: true, label: 'Höhepunkt', titel: 'Ein Fest, wie es sich gehört',
    teaser: 'Zum Schluss wird gefeiert: Am 8. August 2027 halten wir das Pontifikalamt mit Bischof Dr. Georg Bätzing und feiern danach ein Sommerfest für alle – unter anderem mit Kirchenfenster-Gestalten für Kinder. Das Programm des Sommerfests folgt.',
    fotos: [{ src: IMG + 'festgottesdienst.jpg', alt: 'Ein lächelnder Bischof mit Mitra und Bischofsstab im Kreis von Gottesdienstbesuchern', h: 795 }], fakten: ['So 08.08.2027 · 11 Uhr'],
    items: [{ datum: 'So 08.08.2027', zeit: '11 Uhr', titel: 'Pontifikalamt mit Bischof Dr. Georg Bätzing', von: '2027-08-08', kurz: 'So 08.08.', ueb: 'Pontifikalamt mit Bischof Dr. Georg Bätzing, danach Sommerfest', text: 'Anschließend Sommerfest für alle.', offen: 'Programm des Sommerfests folgt.' }] },
];

// Terminübersicht (vor den FAQ) = alle Items mit `von`, automatisch aus den Sparten; Items ohne
// Termin erscheinen nur in der Fußzeile „Termin folgt".
const termine = sparten.flatMap((b) => b.items.filter((i) => i.von).map((i) => ({ ...i, anker: b.id })));
const termineOffen = ['BonSalons: genaue Termine', 'Überraschende Begegnung am Schweizer Platz', 'Beitrag der Jugendkirche', 'Virtueller Kirchenführer'];

// PDFs: `pdf: '/uploads/2027/jubilaeum/<datei>.pdf'` eintragen, sobald die Datei vorliegt.
const downloads = [
  // Flyer-Karte entfällt, bis eine PDF vorliegt (dann hier wieder aufnehmen).
  { titel: 'Programmheft', text: 'Alle Veranstaltungen des Jubiläumsjahrs.', pdf: '', erscheint: 'im neuen Jahr' },
];

---
<Base seo={seo} noindex={true}>
  <div class="astro-jub">
    <JubHero />
    <JubIntro />
    <JubSparten sparten={sparten} />
    <JubMitmachen />
    <JubDownloads downloads={downloads} />
    <JubTermine termine={termine} offen={termineOffen} />
    <JubFaq />
  </div>
</Base>

<style is:global>
/* Base.astro setzt body{overflow-x:hidden} — das macht body zum Scroll-Container und bricht
   position:sticky der Sprungleiste. `clip` schneidet ebenfalls ab (100vw-Hero), erzeugt aber
   keinen Scroll-Container. Gilt nur auf dieser Seite. */
body{overflow-x:clip}
.astro-jub{
  --bf-bg:#f7f3ef;
  --bf-bg-alt:#ede4d5;
  --bf-ink:#1e1512;
  --bf-ink-60:#6b5c52;
  --bf-accent:#9a2d2d;
  --bf-gold:#b88a3a;
  --bf-border:#e0d8cf;
  --bf-radius:14px;
  --bf-shadow:0 4px 20px rgba(30,21,18,.06);
  --bf-shadow-lg:0 10px 32px rgba(30,21,18,.1);
  --jub-serif:'Playfair Display',Georgia,serif;
  color:var(--bf-ink);
}
/* Gemeinsame Bausteine aller Jub-Sektionen (Überschrift, Unterzeile, Container, Buttons) */
.astro-jub-sec{padding:40px 0}
.astro-jub-wrap{max-width:1120px;margin:0 auto;padding:0 40px}
.astro-jub-wrap--narrow{max-width:820px}
.astro-jub-head{text-align:center;margin:0 auto 22px;max-width:720px}
.astro-jub-hl{font-family:var(--jub-serif);font-size:clamp(22px,2.8vw,28px);font-weight:700;line-height:1.2;letter-spacing:-.01em;color:var(--bf-ink);margin:0 0 6px}
.astro-jub-sub{font-size:16.5px;line-height:1.6;color:var(--txt-muted-light);margin:0}
.astro-jub-btn{display:inline-flex;align-items:center;gap:8px;padding:11px 22px;border-radius:50px;font-size:15px;font-weight:600;text-decoration:none;transition:background .2s,color .2s,border-color .2s,transform .2s}
.astro-jub-btn--primary{background:var(--bf-accent);color:#fff;border:2px solid var(--bf-accent)}
.astro-jub-btn--primary:hover{transform:translateY(-1px);box-shadow:var(--bf-shadow-lg)}
/* Bewegung reduzieren: keine Hover-Bewegung/Übergänge */
@media(prefers-reduced-motion:reduce){.astro-jub-btn,.astro-jub-sp__nav a,.astro-jub-faq__item summary::after{transition:none}.astro-jub-btn--primary:hover{transform:none}}
.astro-jub-btn--ghost{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.7)}
.astro-jub-btn--ghost:hover{background:#fff;color:var(--bf-ink);border-color:#fff}
.astro-jub-btn:focus-visible{outline:3px solid var(--bf-accent);outline-offset:3px}
.astro-jub-hero .astro-jub-btn:focus-visible{outline-color:#fff}
.astro-jub-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;margin:0;padding:0}
@media(max-width:760px){.astro-jub-sec{padding:32px 0}.astro-jub-wrap{padding:0 20px}}
</style>
