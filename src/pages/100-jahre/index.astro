---
// Technischer Prototyp „100 Jahre Sankt Bonifatius" – virtueller Rundgang.
// Panorama-Bilder: fünf "Vertikal-Pano"-Aufnahmen vom DJI-Handy-Gimbal (23.09.2026, aus
// „Virtueller Rundgang Boni/3D Fotos"), aufgenommen als Stationen entlang des Mittelgangs
// (Eingang → Mitte → vor dem Altar → Altarstufen, plus ein Blick zurück zum Eingang von den
// Altarstufen aus). Reihenfolge der Dateien anhand der sichtbaren Entfernung zum Altar
// bestimmt (Dateinamen der Kamera geben die Reihenfolge NICHT wieder). Kein echtes
// equirectangular-Foto (kein GPano-Metadaten, Seitenverhältnis ~4:5 statt 2:1) — trotzdem
// deutlich mehr Decken-/Bodenanteil und größeres Sichtfeld als normale Fotos, deshalb
// `haov`/`vaov` unten großzügig (130°/160°). Zwischen den Stationen ein kurzer Hinein-Zoom
// vor dem Szenenwechsel (gehZuSzene()) statt hartem Schnitt — Werner-Feedback 2026-09-23:
// ein einzelner Sprung fühlte sich wie Teleportieren an, nicht wie Gehen; mehrere kurze
// Etappen mit Vor-/Zurück-Pfeilen simulieren das Laufen durch den Raum. Für den echten
// Rundgang später ggf. durch reine 360°-Kamera-Panoramen ersetzen, dann auch mit mehr
// Stationen. Heiligentafel = die Wand selbst an den Altarstufen, nicht ein Extra-Dialog
// (Werner-Feedback 2026-09-24): mehrere Rahmen dicht nebeneinander, „1" mit echtem Foto +
// Video (Sommerfreizeit 2026), „2"/„3" symbolisch mit Initialen als Platzhalter für weitere
// Personen. Einzelner Klick auf einen Rahmen führt direkt zu Video/Text, keine Zwischen-
// Auswahl mehr. Die Schatzkammer ist bewusst KEIN weiterer Panorama-Raum (kein eigenes
// Raumfoto vorhanden), sondern eine eigene Galerie-Überlagerung mit den echten Vasa-Sacra-
// Fotos (24.09.2026, „Virtueller Rundgang Boni/Vasa Sacra") — Namen/Erläuterungen der
// Objekte sind noch Platzhalter, bis die echten Texte vorliegen. Bewusst NICHT im Nav.astro
// verlinkt (Regel: Menü nur auf ausdrückliche Anweisung ändern) und mit noindex, damit
// Suchmaschinen den Prototyp nicht erfassen. Passwortschutz über src/middleware.ts, eigene
// Zugangsdaten (Benutzer „carloacutis", Passwort in Netlify-Umgebungsvariable
// JUBILAEUM_PASSWORD) — braucht deshalb `prerender = false`, sonst würde Netlify die Seite
// als fertige statische Datei ausliefern, an der Middleware vorbei.
export const prerender = false;
import Base from '../../layouts/Base.astro';
---
<Base title="100 Jahre Sankt Bonifatius – Rundgang (Prototyp)" noindex={true}>
  <section class="jub-intro">
    <p class="jub-badge">Technischer Prototyp – echte Fotos, noch kein vollständiges 360°-Rundumbild</p>
    <h1>100 Jahre Sankt Bonifatius – virtueller Rundgang</h1>
    <p>
      Mit der Maus (oder dem Finger) im Bild ziehen, um sich umzuschauen. Die grünen Pfeile
      führen weiter in die Kirche hinein, die blauen zurück. An den Altarstufen können Sie
      sich außerdem umdrehen und zusätzlich die Heiligentafel und die Schatzkammer-Tür
      entdecken. Die Fotos hier sind echte Panorama-Aufnahmen des Innenraums (23.09.2026).
    </p>
  </section>

  <section class="jub-viewer-wrap">
    <div id="jub-panorama"></div>
  </section>

  <!-- Modal: einzelne Person (Video oder Text) — direkt per Klick auf den jeweiligen Rahmen
       an der Wand erreichbar, keine Zwischen-Auswahl mehr (Werner-Feedback 2026-09-24: die
       Wand selbst ist die Heiligentafel, kein zusätzlicher Übersichts-Dialog). -->
  <div id="jub-modal-person" class="jub-modal" hidden>
    <div class="jub-modal-box">
      <button type="button" class="jub-modal-close" data-close>×</button>
      <h2 id="jub-person-name"></h2>
      <div id="jub-person-inhalt"></div>
    </div>
  </div>

  <!-- Überlagerung: Schatzkammer als museumsähnliche Objekt-Galerie (kein eigenes Raumfoto
       vorhanden, deshalb bewusst kein Panorama, sondern eine eigene Ausstellungsansicht). -->
  <div id="jub-schatzkammer" class="jub-modal jub-schatzkammer-overlay" hidden>
    <div class="jub-schatzkammer-box">
      <button type="button" class="jub-modal-close" data-close>×</button>
      <p class="jub-badge">Technischer Prototyp – echte Fotos, Erläuterungen folgen</p>
      <h2>Schatzkammer</h2>
      <p class="jub-modal-hint">Die Vasa Sacra unserer Pfarrei. Klicken Sie auf ein Objekt für mehr dazu.</p>
      <div class="jub-vasa-grid" id="jub-vasa-grid"></div>
    </div>
  </div>

  <!-- Modal: Schatzkammer-Objekt -->
  <div id="jub-modal-objekt" class="jub-modal" hidden>
    <div class="jub-modal-box">
      <button type="button" class="jub-modal-close" data-close>×</button>
      <img id="jub-objekt-foto" class="jub-objekt-foto" src="" alt="" />
      <h2 id="jub-objekt-name"></h2>
      <p id="jub-objekt-text"></p>
    </div>
  </div>

  <section class="jub-geschichte">
    <h2>Die Geschichte unserer Kirche</h2>
    <p>
      <em>Platzhaltertext.</em> Hier entsteht später ein kurzer Abriss der Geschichte von
      Sankt Bonifatius seit der Grundsteinlegung – wichtige Jahreszahlen, Baugeschichte,
      besondere Ereignisse der letzten 100 Jahre.
    </p>
  </section>

  <section class="jub-gaestebuch">
    <h2>Gästebuch</h2>
    <p>Hinterlassen Sie einen Gruß oder eine Erinnerung zum 100-jährigen Jubiläum.</p>
    <form id="jub-gaestebuch-form">
      <input type="text" id="jub-gb-name" placeholder="Ihr Name (optional)" maxlength="60" />
      <textarea id="jub-gb-text" placeholder="Ihr Eintrag" maxlength="800" required></textarea>
      <button type="submit">Eintragen</button>
      <p id="jub-gb-status" role="status"></p>
    </form>
    <ul id="jub-gaestebuch-liste"></ul>
  </section>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css" />
  <script is:inline src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"></script>
  <script is:inline>
    (function () {
      // Die Wand selbst ist die Heiligentafel: mehrere Rahmen dicht nebeneinander an der
      // gleichen Wandstelle, jeweils direkt anklickbar (Werner-Feedback 2026-09-24). Nur „1"
      // hat ein echtes Foto, „2"/„3" sind symbolische Rahmen mit Initialen als Platzhalter,
      // bis weitere Personen angefragt sind. pitch/yaw = Position auf der Altarstufen-Wand.
      var PERSONEN = {
        '1': {
          name: 'Sommerfreizeit 2026',
          foto: 'heiligentafel-foto-1.jpg',
          pitch: -5, yaw: 30,
          html: '<video controls preload="metadata" style="width:100%;border-radius:6px;display:block" src="/uploads/jubilaeum/sommerfreizeit-2026.mp4"></video>',
        },
        '2': {
          name: 'Hans S.',
          initialen: 'H S',
          pitch: -5, yaw: 22,
          html: '<p><em>Platzhalter für eine Geschichte.</em> Hier steht später ein kurzer, selbst geschriebener Text von Hans über ein besonderes Erlebnis in Sankt Bonifatius.</p>',
        },
        '3': {
          name: 'Anna B.',
          initialen: 'A B',
          pitch: -14, yaw: 26,
          html: '<p><em>Platzhalter für ein Video.</em> Hier würde später ein Filmchen mit Anna erscheinen.</p>',
        },
      };
      var PERSONEN_REIHENFOLGE = ['1', '2', '3'];

      // Fotos vom 24.09.2026 ("Virtueller Rundgang Boni/Vasa Sacra"). Zuordnung Foto→Objekt
      // nach Augenschein (Kelch/Ziborium ohne Deckel schwer zu unterscheiden) — Namen/Texte
      // bewusst als Platzhalter, bis die echten Erläuterungen vorliegen (Werner-Ansage
      // 2026-09-24: "Erläuterungen folgen").
      var OBJEKTE_REIHENFOLGE = ['kreuz', 'monstranz', 'kelch', 'ziborium'];
      var OBJEKTE = {
        kreuz: { name: 'Altarkreuz', foto: 'vasa-kreuz.jpg', text: 'Platzhaltertext: Herkunft, Alter und Bedeutung dieses Kreuzes. Erläuterungen folgen.' },
        monstranz: { name: 'Monstranz', foto: 'vasa-monstranz.jpg', text: 'Platzhaltertext: Herkunft, Alter und Bedeutung dieser Monstranz. Erläuterungen folgen.' },
        kelch: { name: 'Kelch', foto: 'vasa-kelch.jpg', text: 'Platzhaltertext: Herkunft, Alter und Bedeutung dieses Kelchs. Erläuterungen folgen.' },
        ziborium: { name: 'Ziborium', foto: 'vasa-ziborium.jpg', text: 'Platzhaltertext: Herkunft, Alter und Bedeutung dieses Ziboriums. Erläuterungen folgen.' },
      };

      function zeigeModal(id) {
        document.getElementById(id).hidden = false;
      }
      document.querySelectorAll('.jub-modal').forEach(function (modal) {
        modal.addEventListener('click', function (e) {
          if (e.target === modal || e.target.hasAttribute('data-close')) {
            modal.hidden = true;
          }
        });
      });

      window.__jubOpenPerson = function (id) {
        var p = PERSONEN[id];
        document.getElementById('jub-person-name').textContent = p.name;
        document.getElementById('jub-person-inhalt').innerHTML = p.html;
        zeigeModal('jub-modal-person');
      };

      window.__jubOpenObjekt = function (id) {
        var o = OBJEKTE[id];
        var foto = document.getElementById('jub-objekt-foto');
        foto.src = '/uploads/jubilaeum/' + o.foto;
        foto.alt = o.name + ' (Vasa Sacra, Platzhalterfoto)';
        document.getElementById('jub-objekt-name').textContent = o.name;
        document.getElementById('jub-objekt-text').textContent = o.text;
        zeigeModal('jub-modal-objekt');
      };

      // Schatzkammer-Galerie einmalig aus OBJEKTE aufbauen.
      var vasaGrid = document.getElementById('jub-vasa-grid');
      OBJEKTE_REIHENFOLGE.forEach(function (id) {
        var o = OBJEKTE[id];
        var karte = document.createElement('button');
        karte.type = 'button';
        karte.className = 'jub-vasa-karte';
        karte.innerHTML = '<img src="/uploads/jubilaeum/' + o.foto + '" alt="' + o.name + '"><span>' + o.name + '</span>';
        karte.addEventListener('click', function () { window.__jubOpenObjekt(id); });
        vasaGrid.appendChild(karte);
      });

      window.__jubOpenSchatzkammer = function () {
        zeigeModal('jub-schatzkammer');
      };

      // --- Panorama ---
      // haov/vaov/vOffset: die Fotos sind normale Weitwinkelaufnahmen (kein 360°-Rundumbild),
      // deshalb wird hier nur der tatsächliche Bildausschnitt der Kugel belegt (Pannellum
      // zeigt außerhalb davon Schwarz). Werte grob geschätzt (~100°/70° für ein Weitwinkel-
      // Vollformatfoto) – bei Bedarf nachjustieren, sobald das echte Objektiv bekannt ist.
      // "Hineingehen"-Effekt: kurz reinzoomen, bevor die Szene wechselt, statt hart zu
      // schneiden — täuscht ein paar Schritte nach vorne an (Werner-Feedback 2026-09-23:
      // reiner Szenen-Schnitt fühlte sich wie Springen an, nicht wie Laufen). `laeuft`-Sperre
      // verhindert, dass ein zweiter Klick während der laufenden Animation eine zweite,
      // überlagerte Zoom-Bewegung anstößt (sah dann aus wie schnelles Rein-/Rauszoomen).
      var gehZuSzeneLaeuft = false;
      function gehZuSzene(sceneId, zielPitch, zielYaw) {
        if (gehZuSzeneLaeuft) return;
        gehZuSzeneLaeuft = true;
        var aktuellesHfov = jubViewer.getHfov();
        jubViewer.setHfov(aktuellesHfov * 0.55, 450);
        setTimeout(function () {
          jubViewer.loadScene(sceneId, zielPitch, zielYaw, aktuellesHfov * 0.55);
          setTimeout(function () {
            jubViewer.setHfov(90, 500);
            setTimeout(function () { gehZuSzeneLaeuft = false; }, 500);
          }, 50);
        }, 420);
      }

      // Geh-Pfeile als Pille mit Text statt abstraktem Symbol — ein gefülltes Dreieck im
      // Kreis sieht sonst wie ein Video-Play-Knopf aus (Werner-Feedback 2026-09-23: "Ich
      // kann da auf Play drücken", meinte den grünen Weiter-Pfeil).
      function pfeilHotspot(pitch, yaw, label, art, klickFunc) {
        return {
          pitch: pitch,
          yaw: yaw,
          type: 'custom',
          cssClass: 'jub-hotspot-pfeil jub-hotspot-pfeil-' + art,
          createTooltipFunc: function (hotSpotDiv) {
            hotSpotDiv.textContent = label;
            hotSpotDiv.addEventListener('click', klickFunc);
          },
        };
      }

      // Ein Rahmen an der Wand pro Person — echtes Foto, wenn vorhanden, sonst ein
      // symbolischer Rahmen mit Initialen. Einzelner Klick führt direkt zur Person, keine
      // Zwischenstation (Werner-Feedback 2026-09-24).
      function tafelHotspot(id) {
        var p = PERSONEN[id];
        return {
          pitch: p.pitch,
          yaw: p.yaw,
          type: 'custom',
          cssClass: 'jub-hotspot-foto' + (p.foto ? '' : ' jub-hotspot-foto-symbolisch'),
          createTooltipFunc: function (hotSpotDiv) {
            if (p.foto) {
              var img = document.createElement('img');
              img.src = '/uploads/jubilaeum/' + p.foto;
              img.alt = p.name;
              hotSpotDiv.appendChild(img);
            } else {
              hotSpotDiv.textContent = p.initialen;
            }
            hotSpotDiv.title = p.name;
            hotSpotDiv.addEventListener('click', function () { window.__jubOpenPerson(id); });
          },
        };
      }

      // Fünf echte Stationen entlang des Mittelgangs (23.09.2026, DJI-Gimbal) statt nur eines
      // einzigen Punkts — Vor-/Zurück-Pfeile zwischen benachbarten Stationen statt eines
      // einzelnen großen Sprungs, dazu ein "Umdrehen"-Punkt an den Altarstufen mit Blick
      // zurück zum Eingang. Heiligentafel + Schatzkammer-Tür hängen an den Altarstufen.
      var BASIS = { type: 'equirectangular', haov: 130, vaov: 160, vOffset: 0, pitch: 0, yaw: 0, hfov: 90 };
      var jubViewer = window.pannellum.viewer('jub-panorama', {
        default: { firstScene: 'eingang', sceneFadeDuration: 800, autoLoad: true },
        scenes: {
          eingang: Object.assign({}, BASIS, {
            panorama: '/uploads/jubilaeum/panorama-1-eingang.jpg',
            hotSpots: [
              pfeilHotspot(-10, 0, 'Weiter in die Kirche →', 'vor', function () { gehZuSzene('mitte', 0, 0); }),
            ],
          }),
          mitte: Object.assign({}, BASIS, {
            panorama: '/uploads/jubilaeum/panorama-2-mitte.jpg',
            hotSpots: [
              pfeilHotspot(-10, 0, 'Weiter zum Altar →', 'vor', function () { gehZuSzene('vorneAltar', 0, 0); }),
              pfeilHotspot(-10, 180, '← Zurück zum Eingang', 'zurueck', function () { gehZuSzene('eingang', 0, 0); }),
            ],
          }),
          vorneAltar: Object.assign({}, BASIS, {
            panorama: '/uploads/jubilaeum/panorama-3-vorm-altar.jpg',
            hotSpots: [
              pfeilHotspot(-10, 0, 'Weiter zu den Altarstufen →', 'vor', function () { gehZuSzene('altarstufen', 0, 0); }),
              pfeilHotspot(-10, 180, '← Zurück', 'zurueck', function () { gehZuSzene('mitte', 0, 0); }),
            ],
          }),
          altarstufen: Object.assign({}, BASIS, {
            panorama: '/uploads/jubilaeum/panorama-4-altarstufen.jpg',
            hotSpots: [
              pfeilHotspot(-10, 180, '← Zurück', 'zurueck', function () { gehZuSzene('vorneAltar', 0, 0); }),
              pfeilHotspot(0, 90, '↻ Umdrehen', 'umdrehen', function () { gehZuSzene('blickZurueck', 0, 0); }),
              tafelHotspot('1'),
              tafelHotspot('2'),
              tafelHotspot('3'),
              {
                pitch: -18,
                yaw: -30,
                type: 'custom',
                cssClass: 'jub-hotspot-tuer',
                createTooltipFunc: function (hotSpotDiv) {
                  var griff = document.createElement('span');
                  griff.className = 'jub-tuer-griff';
                  hotSpotDiv.appendChild(griff);
                  hotSpotDiv.title = 'Zur Schatzkammer';
                  hotSpotDiv.addEventListener('click', function () { window.__jubOpenSchatzkammer(); });
                },
              },
            ],
          }),
          blickZurueck: Object.assign({}, BASIS, {
            panorama: '/uploads/jubilaeum/panorama-5-blick-zurueck.jpg',
            hotSpots: [
              pfeilHotspot(-10, 0, '← Zurück zu den Altarstufen', 'zurueck', function () { gehZuSzene('altarstufen', 0, 0); }),
            ],
          }),
        },
      });

      // --- Gästebuch ---
      var liste = document.getElementById('jub-gaestebuch-liste');
      var status = document.getElementById('jub-gb-status');

      function formatDatum(iso) {
        try {
          return new Date(iso).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
        } catch (e) {
          return '';
        }
      }

      function renderEintraege(eintraege) {
        liste.innerHTML = '';
        eintraege.forEach(function (e) {
          var li = document.createElement('li');
          var strong = document.createElement('strong');
          strong.textContent = e.name;
          var span = document.createElement('span');
          span.className = 'jub-gb-datum';
          span.textContent = ' – ' + formatDatum(e.datum);
          var p = document.createElement('p');
          p.textContent = e.text;
          li.appendChild(strong);
          li.appendChild(span);
          li.appendChild(p);
          liste.appendChild(li);
        });
      }

      function ladeEintraege() {
        fetch('/api/jubilaeum-gaestebuch')
          .then(function (r) { return r.json(); })
          .then(renderEintraege)
          .catch(function () {});
      }

      document.getElementById('jub-gaestebuch-form').addEventListener('submit', function (e) {
        e.preventDefault();
        var name = document.getElementById('jub-gb-name').value;
        var text = document.getElementById('jub-gb-text').value;
        status.textContent = 'Wird gespeichert …';
        fetch('/api/jubilaeum-gaestebuch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: name, text: text }),
        })
          .then(function (r) {
            if (!r.ok) throw new Error('Fehler');
            return r.json();
          })
          .then(function () {
            status.textContent = 'Danke für Ihren Eintrag!';
            document.getElementById('jub-gb-name').value = '';
            document.getElementById('jub-gb-text').value = '';
            ladeEintraege();
          })
          .catch(function () {
            status.textContent = 'Das hat leider nicht geklappt. Bitte später erneut versuchen.';
          });
      });

      ladeEintraege();
    })();
  </script>

  <style>
    .jub-intro {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 40px 20px 20px;
      text-align: center;
    }
    .jub-badge {
      display: inline-block;
      background: var(--accent-gold-deco);
      color: #2a2311;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 999px;
      margin-bottom: 12px;
    }
    .jub-intro h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(28px, 4vw, 42px);
      color: var(--clr-primary);
      margin-bottom: 12px;
    }
    .jub-intro p { color: var(--txt-muted-light); max-width: 640px; margin: 0 auto; }

    .jub-viewer-wrap {
      max-width: var(--max-w);
      margin: 0 auto 40px;
      padding: 0 20px;
    }
    #jub-panorama {
      width: 100%;
      height: min(70vh, 600px);
      border-radius: var(--radius);
      overflow: hidden;
      background: #111;
    }

    :global(.jub-hotspot) {
      background: var(--accent-gold-deco);
      border: 2px solid #fff;
      border-radius: 50%;
      box-shadow: 0 0 12px rgba(0,0,0,.5);
    }

    /* Geh-Pfeile zwischen den Stationen: Textpille statt Symbol — ein gefülltes Dreieck im
       Kreis sieht wie ein Video-Play-Knopf aus und wurde genau so missverstanden (Werner-
       Feedback 2026-09-23). Grün = weiter, blau = zurück, lila = umdrehen. */
    :global(.jub-hotspot-pfeil) {
      width: auto !important;
      height: auto !important;
      white-space: nowrap;
      padding: 10px 18px;
      border-radius: 999px;
      border: 2px solid #fff;
      box-shadow: 0 2px 12px rgba(0,0,0,.55);
      cursor: pointer;
      color: #fff;
      font-family: 'Source Sans 3', sans-serif;
      font-weight: 700;
      font-size: 15px;
    }
    :global(.jub-hotspot-pfeil-vor) { background: #2e9e3f; }
    :global(.jub-hotspot-pfeil-zurueck) { background: #2a6fc9; }
    :global(.jub-hotspot-pfeil-umdrehen) { background: #7a3fb5; }

    /* Heiligentafel-Rahmen: mehrere davon dicht nebeneinander bilden zusammen mit der Wand
       die "Tafel". Echtes Foto = Bilderrahmen; ohne Foto = symbolischer Rahmen mit Initialen. */
    :global(.jub-hotspot-foto) {
      width: 74px !important;
      height: 100px !important;
      padding: 5px;
      background: linear-gradient(160deg, #e6cf8e, #8a6d2c);
      border: 2px solid #6b5320;
      border-radius: 2px;
      box-shadow: 0 4px 16px rgba(0,0,0,.65);
      cursor: pointer;
    }
    :global(.jub-hotspot-foto img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    :global(.jub-hotspot-foto-symbolisch) {
      width: 58px !important;
      height: 78px !important;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #4a3a12;
      font-weight: 700;
      font-size: 16px;
      font-family: 'Playfair Display', serif;
      background: linear-gradient(160deg, #d9c58f, #a48a4f);
    }

    /* Goldene Tür zur Schatzkammer: lebensgroß und bodenständig, kein schwebendes Symbol
       mehr (Werner-Feedback 2026-09-24). Pannellum positioniert die Rahmenmitte am
       pitch/yaw-Punkt (setzt sein eigenes `transform` inline) — die Unterkante auf den
       sichtbaren Boden zu bekommen ist daher reine pitch-Feinjustierung, kein CSS-Trick. */
    :global(.jub-hotspot-tuer) {
      width: 70px !important;
      height: 190px !important;
      background: linear-gradient(180deg, #f3e2a0, #c9a227 55%, #8a6d1a) !important;
      border: 3px solid #6b5320 !important;
