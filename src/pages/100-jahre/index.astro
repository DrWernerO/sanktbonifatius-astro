    /* Türfüllungen (zwei Kassetten) */
    :global(.jub-hotspot-tuer)::before {
      content: '';
      position: absolute;
      left: 10px; right: 10px;
      top: 18%; height: 32%;
      border: 2px solid rgba(107, 83, 32, .75);
      border-radius: 4px;
