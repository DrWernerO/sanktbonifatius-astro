---
// Kontakt-Block (Pfarrbüro) am Ende der Landingpage „Willkommen" (/willkommen/).
// Eigene Klassen `astro-wkkontakt`. Adresse/Telefon/E-Mail wie Footer.astro, Öffnungszeiten wie
// KontaktAddress.astro — bei Änderungen dort auch hier nachziehen.
---
<section class="astro-wkkontakt" aria-labelledby="astro-wkkontakt-hl">
  <div class="astro-wkkontakt__inner">
    <h2 class="astro-wkkontakt__hl" id="astro-wkkontakt-hl">Sie haben Fragen? Wir sind für Sie da.</h2>
    <div class="astro-wkkontakt__grid">
      <div>
        <h3 class="astro-wkkontakt__sub">Zentrales Pfarrbüro</h3>
        <address class="astro-wkkontakt__addr">
          Holbeinstraße 70<br />
          60596 Frankfurt am Main
        </address>
        <ul class="astro-wkkontakt__links" role="list">
          <li><a class="astro-wkkontakt__btn" href="tel:+4969695975850">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            069 695 97 58 50</a></li>
          <li><a class="astro-wkkontakt__btn" href="mailto:info@sanktbonifatius.de">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="22,6 12,13 2,6"/></svg>
            info@sanktbonifatius.de</a></li>
        </ul>
      </div>
      <div>
        <h3 class="astro-wkkontakt__sub">Öffnungszeiten</h3>
        <p class="astro-wkkontakt__text">Mo – Do: 9–12 Uhr<br />Di u. Do: 14–16 Uhr<br />Fr: 9–12 Uhr</p>
        <p class="astro-wkkontakt__text astro-wkkontakt__small">
          <a href="/kontakt/pfarrbuero/">Mehr zum Pfarrbüro</a> · <a href="/datenschutz/">Datenschutz</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style is:global>
.astro-wkkontakt{background:linear-gradient(135deg,#9a2d2d 0%,#7e2424 100%);color:#fff;padding:64px 0}
.astro-wkkontakt__inner{max-width:900px;margin:0 auto;padding:0 40px}
.astro-wkkontakt__hl{font-family:'Playfair Display',Georgia,serif;font-size:clamp(24px,3vw,34px);font-weight:700;margin:0 0 28px;line-height:1.2}
.astro-wkkontakt__grid{display:grid;grid-template-columns:1fr 1fr;gap:32px}
.astro-wkkontakt__sub{font-family:'Playfair Display',Georgia,serif;font-size:19px;font-weight:700;color:#f3e2b8;margin:0 0 10px}
.astro-wkkontakt__addr{font-style:normal;font-size:16.5px;line-height:1.6;margin:0 0 14px}
.astro-wkkontakt__links{list-style:none;display:flex;flex-direction:column;gap:10px}
.astro-wkkontakt__btn{display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:10px 20px;border-radius:50px;background:#fff;color:#9a2d2d;font-size:16px;font-weight:600}
.astro-wkkontakt__btn:hover{background:#f3e7d4}
.astro-wkkontakt__btn:focus-visible,.astro-wkkontakt a:focus-visible{outline:3px solid #f3e2b8;outline-offset:3px}
.astro-wkkontakt__text{font-size:16.5px;line-height:1.6;margin:0 0 14px}
.astro-wkkontakt__small a{color:#fff;text-decoration:underline;text-underline-offset:3px}
@media(max-width:700px){.astro-wkkontakt__grid{grid-template-columns:1fr}.astro-wkkontakt__inner{padding:0 20px}.astro-wkkontakt{padding:52px 0}}
</style>
