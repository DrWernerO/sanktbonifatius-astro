---
// „Aktuelle Gottesdiensttermine" — serverseitig aus der ChurchDesk-API (src/lib/churchdesk.js),
// ersetzt das frühere Cross-Origin-iframe-Widget (2026-09-14). Grund: Das Widget lud den Inhalt
// erst client-seitig aus einem fremden iframe — Google konnte die Termine nie sehen. Jetzt
// normales HTML + schema.org/Event-JSON-LD, damit die Gottesdienste in der Google-Suche
// auftauchen können. Präfix: astro-gdotermine.
//
// Zeigt den Zeitraum bis zum übernächsten Sonntag (Werners Wunsch, 2026-09-14): diese Woche bis
// Sonntag, plus die komplette Folgewoche bis einschließlich deren Sonntag — wie im klassischen
// Pfarrbrief "diese und nächste Woche". Ist heute selbst ein Sonntag, zählt der als der "nächste".
// Darunter Link zur vollständigen Liste (GdoAlleTermine.astro).
//
// „ENTFÄLLT"-Termine (ChurchDesk-Konvention für ausfallende Messen, s. churchdesk.js) werden
// bewusst MIT angezeigt, nur optisch gedämpft — sonst wüssten Besucher:innen nicht, dass eine
// reguläre Messe ausfällt.
import { getGottesdienste } from '../lib/churchdesk.js';

const now = new Date();
// Wochentag in Berlin-Zeit (0 = Sonntag … 6 = Samstag), damit ein Serverstandort in anderer
// Zeitzone nicht den falschen Tag berechnet.
const WEEKDAYS_EN = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const weekdayIdx = WEEKDAYS_EN.indexOf(
  new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Berlin', weekday: 'short' }).format(now)
);
const daysToNextSunday = (7 - weekdayIdx) % 7; // 0, wenn heute schon Sonntag ist
const nextSunday = new Date(now.getTime() + daysToNextSunday * 24 * 60 * 60 * 1000);
const sundayAfter = new Date(nextSunday.getTime() + 7 * 24 * 60 * 60 * 1000);
// Berlin-Kalendertag von sundayAfter, als UTC-Mitternacht — ChurchDesk wertet ein reines Datum
// als "gesamter UTC-Tag", der Berlin-Tag endet immer etwas früher als der UTC-Tag (Berlin liegt
// vor UTC), der Sonntag bleibt also vollständig eingeschlossen.
const bisDatum = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Berlin' }).format(sundayAfter);
const until = new Date(`${bisDatum}T00:00:00Z`);
const termine = await getGottesdienste({ from: now, to: until });

// Tagesüberschrift kürzen: „Sonntag, 01. November 2026“ → „Sonntag, 1. November“ (Jahr nur, wenn nicht das laufende).
const jahr = String(new Date().getFullYear());
const kurzLabel = (l) => {
  const x = l.replace(/(\s)0(\d)\./, '$1$2.');
  return x.endsWith(' ' + jahr) ? x.slice(0, -(jahr.length + 1)) : x;
};
const sundayKey = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Berlin' }).format(nextSunday);

// Für die Anzeige nach Tag gruppieren (Reihenfolge bleibt erhalten, da termine bereits sortiert sind).
const tage = [];
for (const t of termine) {
  let tag = tage.find((g) => g.dateKey === t.dateKey);
  if (!tag) { tag = { dateKey: t.dateKey, dayLabel: t.dayLabel, isSunday: t.isSunday, items: [] }; tage.push(tag); }
  tag.items.push(t);
}

// Woche 1 = bis einschließlich nächstem Sonntag, Woche 2 = Folgewoche (mobil eingeklappt, s. <details>)
const woche1 = tage.filter((g) => g.dateKey <= sundayKey);
const woche2 = tage.filter((g) => g.dateKey > sundayKey);

// schema.org/Event je Termin — für Google, unsichtbar im Seitenbild. ENTFÄLLT-Termine bekommen
// eventStatus "EventCancelled" statt "EventScheduled" (schema.org-konforme Absage).
const jsonLd = termine.filter((t) => t.startISO).map((t) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: t.title,
  description: t.summary || `${t.title} in ${t.church}`,
  startDate: t.startISO,
  ...(t.endISO ? { endDate: t.endISO } : {}),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: t.isEntfaellt ? 'https://schema.org/EventCancelled' : 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: t.church,
    ...(t.address ? { address: t.address } : {}),
  },
  ...(t.celebrant ? { performer: { '@type': 'Person', name: t.celebrant } } : {}),
  organizer: {
    '@type': 'Organization',
    name: 'Pfarrei Sankt Bonifatius Frankfurt',
    url: 'https://sanktbonifatius.de',
  },
}));
---
<section class="astro-gdotermine" id="aktuelle-gottesdiensttermine">
  <div class="astro-gdotermine__inner">
    <h2 class="astro-gdotermine__hl">Aktueller Gottesdienstplan</h2>
    <p class="astro-gdotermine__sub">Die Gottesdienste der nächsten zwei Wochen in Frankfurt Sachsenhausen und Oberrad.</p>

    {tage.length === 0 ? (
      <p class="astro-gdotermine__empty">
        Aktuell sind für diesen Zeitraum keine Gottesdienste hinterlegt.
        Die vollständige Übersicht finden Sie <a href="/gottesdienst-glaube/alle-gottesdienste/">hier</a>.
      </p>
    ) : (
      <div class="astro-gdotermine__list">
        {woche1.map((tag) => (
          <Fragment>
            <div class="astro-gdotermine__day">
              <h3 class:list={['astro-gdotermine__day-hl', tag.isSunday && 'astro-gdotermine__day-hl--sun']}>{kurzLabel(tag.dayLabel)}</h3>
              {tag.items.map((t) => (
                <div class:list={['astro-gdotermine__ev', t.isEntfaellt && 'astro-gdotermine__ev--entfaellt']}>
                  <div class="astro-gdotermine__ev-time">{t.timeLabel}</div>
                  <div class="astro-gdotermine__ev-main">
                    <p class="astro-gdotermine__ev-title">{t.title}</p>
                    {(t.celebrant || t.church) && (
                      <p class:list={['astro-gdotermine__ev-celebrant', !t.celebrant && 'astro-gdotermine__ev-celebrant--m']}>
                        {t.church && <span class="astro-gdotermine__ev-church-m">{t.church}</span>}
                        {t.church && t.celebrant && <span class="astro-gdotermine__ev-sep-m"> · </span>}
                        {t.celebrant && <span>Zelebrant: {t.celebrant}</span>}
                      </p>
                    )}
                  </div>
                  {t.church && <div class="astro-gdotermine__ev-church">{t.church}</div>}
                </div>
              ))}
            </div>
          </Fragment>
        ))}
        {woche2.length > 0 && (
          <details class="astro-gdotermine__week2" id="astro-gdotermine-week2">
            <summary class="astro-gdotermine__week2-btn">
              <span class="astro-gdotermine__week2-open">Nächste Woche anzeigen</span>
              <span class="astro-gdotermine__week2-close">Nächste Woche ausblenden</span>
            </summary>
            {woche2.map((tag) => (
              <div class="astro-gdotermine__day">
                <h3 class:list={['astro-gdotermine__day-hl', tag.isSunday && 'astro-gdotermine__day-hl--sun']}>{kurzLabel(tag.dayLabel)}</h3>
                {tag.items.map((t) => (
                  <div class:list={['astro-gdotermine__ev', t.isEntfaellt && 'astro-gdotermine__ev--entfaellt']}>
                    <div class="astro-gdotermine__ev-time">{t.timeLabel}</div>
                    <div class="astro-gdotermine__ev-main">
                      <p class="astro-gdotermine__ev-title">{t.title}</p>
                      {(t.celebrant || t.church) && (
                        <p class:list={['astro-gdotermine__ev-celebrant', !t.celebrant && 'astro-gdotermine__ev-celebrant--m']}>
                          {t.church && <span class="astro-gdotermine__ev-church-m">{t.church}</span>}
                          {t.church && t.celebrant && <span class="astro-gdotermine__ev-sep-m"> · </span>}
                          {t.celebrant && <span>Zelebrant: {t.celebrant}</span>}
                        </p>
                      )}
                    </div>
                    {t.church && <div class="astro-gdotermine__ev-church">{t.church}</div>}
                  </div>
                ))}
              </div>
            ))}
          </details>
          <script is:inline>
            /* Desktop: Folgewoche sofort offen (vor dem ersten Rendern); mobil bleibt sie eingeklappt. */
            if (window.matchMedia('(min-width:601px)').matches) document.getElementById('astro-gdotermine-week2').open = true;
          </script>
        )}
      </div>
    )}

    <div class="astro-gdotermine__more">
      <a href="/gottesdienst-glaube/alle-gottesdienste/" class="astro-gdotermine__more-btn">
        Alle Gottesdienste ansehen
      </a>
    </div>
  </div>
</section>

{jsonLd.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}

<style is:global>
.astro-gdotermine{background:#fff;padding:72px 40px}
.astro-gdotermine__inner{max-width:720px;margin:0 auto}
.astro-gdotermine__hl{font-family:'Playfair Display',serif;font-size:clamp(26px,3.5vw,38px);color:#2c2420;margin:0 0 12px;text-align:center}
.astro-gdotermine__sub{text-align:center;color:var(--txt-muted-light);font-size:16px;line-height:1.65;margin:0 0 40px}
.astro-gdotermine__empty{text-align:center;color:var(--txt-muted-light);font-size:15px;padding:24px 0;line-height:1.6}
.astro-gdotermine__empty a{color:#9a2d2d;text-decoration:underline}

.astro-gdotermine__day{margin:0 0 28px}
.astro-gdotermine__day-hl{
  font-family:'Playfair Display',serif;font-size:17px;font-weight:700;color:#2c2420;
  margin:0 0 10px;padding-bottom:6px;border-bottom:2px solid #e3dace;
}
/* Sonntage hervorheben — Gold-Akzent + eigene Unterlinie statt der neutralen Trennlinie. */
.astro-gdotermine__day-hl--sun{
  color:#9a2d2d;border-bottom-color:var(--accent-gold-deco);border-bottom-width:3px;
}
.astro-gdotermine__ev{
  display:grid;grid-template-columns:64px 1fr auto;gap:14px;align-items:center;
  padding:9px 0;border-bottom:1px solid #f1ece5;
}
.astro-gdotermine__ev:last-child{border-bottom:0}
.astro-gdotermine__ev-time{font-weight:600;color:#9a2d2d;font-size:14.5px;white-space:nowrap}
.astro-gdotermine__ev-main{min-width:0}
.astro-gdotermine__ev-title{font-size:15px;font-weight:600;color:#2c2420;margin:0;line-height:1.35}
.astro-gdotermine__ev-celebrant{font-size:14px;color:#5c4e45;margin:2px 0 0;line-height:1.45}
/* Kirchort inline (nur mobil); am Desktop steht er rechts in eigener Spalte */
.astro-gdotermine__ev-church-m,.astro-gdotermine__ev-sep-m,.astro-gdotermine__ev-celebrant--m{display:none}
.astro-gdotermine__ev-church{font-size:14px;color:#5c4e45;text-align:right;white-space:nowrap;flex-shrink:0}
/* ENTFÄLLT-Termine bleiben sichtbar (Werners Wunsch), aber optisch gedämpft statt wie ein normaler Termin. */
.astro-gdotermine__ev--entfaellt .astro-gdotermine__ev-time,
.astro-gdotermine__ev--entfaellt .astro-gdotermine__ev-title{color:#a89c8f}
.astro-gdotermine__ev--entfaellt .astro-gdotermine__ev-title{font-style:italic;font-weight:600}

.astro-gdotermine__more{text-align:center;margin:36px 0 0}
.astro-gdotermine__more-btn{
  display:inline-block;font-size:14.5px;font-weight:600;color:#fff;background:#9a2d2d;
  border-radius:8px;padding:12px 26px;transition:background .2s;
}
.astro-gdotermine__more-btn:hover{background:#7e2424}

.astro-gdotermine__week2>summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:center;
  min-height:48px;margin:4px 0 20px;border:2px solid #9a2d2d;border-radius:50px;color:#9a2d2d;font-weight:600;font-size:15px;padding:0 24px;transition:background .2s,color .2s}
.astro-gdotermine__week2>summary::-webkit-details-marker{display:none}
.astro-gdotermine__week2>summary:hover{background:#9a2d2d;color:#fff}
.astro-gdotermine__week2>summary:focus-visible{outline:3px solid #2c2420;outline-offset:3px}
/* Desktop: Folgewoche ist per Script offen — der Ein-/Ausklapp-Button wird dann nicht gebraucht */
@media(min-width:601px){.astro-gdotermine__week2[open]>summary{display:none}}
.astro-gdotermine__week2-close{display:none}
.astro-gdotermine__week2[open]>summary .astro-gdotermine__week2-open{display:none}
.astro-gdotermine__week2[open]>summary .astro-gdotermine__week2-close{display:inline}

@media(max-width:600px){
  .astro-gdotermine{padding:48px 20px}
  .astro-gdotermine__sub{margin-bottom:28px}
  .astro-gdotermine__day{margin-bottom:20px}
  .astro-gdotermine__ev{grid-template-columns:60px 1fr;gap:4px 12px;align-items:start;padding:10px 0}
  .astro-gdotermine__ev-church{display:none}
  .astro-gdotermine__ev-church-m,.astro-gdotermine__ev-sep-m{display:inline}
  .astro-gdotermine__ev-celebrant--m{display:block}
  .astro-gdotermine__ev-title{font-size:16px}
  .astro-gdotermine__ev-time{font-size:15px}
  .astro-gdotermine__ev-celebrant{font-size:14.5px}
}
</style>
