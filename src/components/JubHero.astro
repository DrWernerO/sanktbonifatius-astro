---
// Hero der Jubiläumsseite „100 Jahre Pfarrkirche St. Bonifatius" (/100-jahre/).
// Eigene Klassen `astro-jub-hero` (Handbuch 3). Foto + Verlauf-Overlay (Muster SegenHero).
// ⚠️ PLATZHALTER-FOTO: public/uploads/2027/jubilaeum/hero-pfarrkirche.jpg ist vorerst das
// Außenfoto von 2020 — Werner liefert das Festjahr-Foto, einfach unter gleichem Namen ersetzen
// (Bildrechte klären, Alt-Text ggf. anpassen).
// H1-Varianten aus dem Briefing: „100 Jahre Bonifatius – feiern Sie mit" (gewählt) /
// „Ein Haus für alle. Seit 100 Jahren." / „100 Jahre. Eine Kirche. Viele Geschichten."
const bg = '/uploads/2027/jubilaeum/hero-pfarrkirche.jpg';
---
<section class="astro-jub-hero" style={`--jub-bg:url('${bg}')`}>
  <div class="astro-jub-hero__inner">
    <p class="astro-jub-hero__eyebrow">Jubiläumsjahr 2027</p>
    <h1 class="astro-jub-hero__title">100 Jahre Bonifatius – feiern Sie mit</h1>
    <p class="astro-jub-hero__sub">Vom 24. Januar bis 8. August 2027 &middot; Pfarrkirche St. Bonifatius, Frankfurt</p>
    <div class="astro-jub-hero__cta">
      <a class="astro-jub-btn astro-jub-btn--primary" href="#programm">Zum Programm</a>
      <a class="astro-jub-btn astro-jub-btn--ghost" href="#termine">Termine ansehen</a>
    </div>
  </div>
  <p class="astro-jub-sr">Foto: Pfarrkirche St. Bonifatius in Frankfurt-Sachsenhausen</p>
</section>

<style is:global>
.astro-jub-hero{position:relative;width:100vw;left:50%;margin-left:-50vw;margin-right:-50vw;min-height:min(78vh,680px);display:flex;align-items:flex-end;color:#fff;background:linear-gradient(180deg,rgba(30,21,18,.35) 0%,rgba(30,21,18,.78) 100%),var(--jub-bg) center/cover no-repeat,#3a2315;padding:120px 0 64px}
.astro-jub-hero__inner{max-width:1120px;width:100%;margin:0 auto;padding:0 40px}
.astro-jub-hero__eyebrow{font-size:13px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:var(--accent-gold-deco);margin:0 0 14px}
.astro-jub-hero__title{font-family:var(--jub-serif);font-size:clamp(34px,6vw,64px);font-weight:700;line-height:1.08;letter-spacing:-.01em;margin:0 0 16px;max-width:16ch}
.astro-jub-hero__sub{font-size:clamp(16px,2vw,20px);line-height:1.5;color:rgba(255,255,255,.92);margin:0 0 28px}
.astro-jub-hero__cta{display:flex;flex-wrap:wrap;gap:12px}
@media(max-width:600px){.astro-jub-hero{padding:100px 0 44px}.astro-jub-hero__inner{padding:0 20px}.astro-jub-hero__cta .astro-jub-btn{flex:1 1 100%;justify-content:center}}
</style>
