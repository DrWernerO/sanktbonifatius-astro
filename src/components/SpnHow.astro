---
// „So spenden Sie" — drei Schritte zur Online-Spende über ChurchDesk. Inhalte 1:1 aus der
// Live-Seite (/spenden/). Eigene Klassen `astro-spn-how`.
const STEPS = [
  {
    label: 'Schritt 1',
    titel: 'Projekt auswählen',
    text: 'Wählen Sie eines unserer vier aktuellen Hilfsprojekte aus. Jedes Projekt hat sein eigenes Spendenformular.',
  },
  {
    label: 'Schritt 2',
    titel: 'Betrag & Daten eingeben',
    text: 'Im blau unterlegten Fenster scrollen Sie nach unten, wählen Ihren Betrag und drücken auf „Spenden“. Anschließend geben Sie Ihre Bank- oder Kreditkartendaten ein.',
  },
  {
    label: 'Schritt 3',
    titel: 'Spendenquittung',
    text: 'Bei Spenden bis 300 € ist der Bankbeleg ausreichend. Auf Wunsch stellen wir Ihnen gerne eine Spendenquittung aus – einfach im Formular angeben.',
  },
];
---
<section class="astro-spn-how">
  <div class="astro-spn-how__inner">
    <div class="astro-spn-how__head">
      <h2 class="astro-spn-how__hl">So spenden Sie</h2>
      <p class="astro-spn-how__sub">In drei einfachen Schritten zu Ihrer Spende.</p>
    </div>
    <div class="astro-spn-how__grid">
      {STEPS.map((s, i) => (
        <article class="astro-spn-how__step">
          <div class="astro-spn-how__num" aria-hidden="true">{i + 1}</div>
          <span class="astro-spn-how__label">{s.label}</span>
          <h3 class="astro-spn-how__step-hl">{s.titel}</h3>
          <p class="astro-spn-how__step-tx">{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
.astro-spn-how{background:#fff;padding:40px 0 32px}
.astro-spn-how__inner{max-width:1120px;margin:0 auto;padding:0 40px}
.astro-spn-how__head{text-align:center;margin:0 0 22px}
.astro-spn-how__hl{font-family:'Playfair Display',serif;font-size:clamp(24px,3vw,32px);font-weight:700;color:#2c2420;margin:0 0 4px}
.astro-spn-how__sub{font-size:15px;color:#6b5c52;line-height:1.5;margin:0}
.astro-spn-how__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.astro-spn-how__step{background:#f7f3ef;border:1px solid #e0d8cf;border-radius:12px;padding:16px 18px;position:relative;display:grid;grid-template-columns:34px 1fr;column-gap:12px;align-items:start}
.astro-spn-how__num{width:34px;height:34px;grid-row:1/4;border-radius:50%;background:#9a2d2d;color:#fff;font-family:'Playfair Display',serif;font-size:17px;font-weight:700;display:flex;align-items:center;justify-content:center;margin:0}
.astro-spn-how__label{display:inline-block;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#9a2d2d;font-weight:700;margin:0 0 2px}
.astro-spn-how__step-hl{font-family:'Playfair Display',serif;font-size:17px;font-weight:700;color:#2c2420;margin:0 0 6px}
.astro-spn-how__step-tx{font-size:14px;color:#6b5c52;line-height:1.5;margin:0}
@media(max-width:860px){.astro-spn-how__grid{grid-template-columns:1fr}}
@media(max-width:600px){.astro-spn-how{padding:32px 0 24px}.astro-spn-how__inner{padding:0 20px}}
</style>
