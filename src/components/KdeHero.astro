---
// Hero + Kontakt der Kita Deutschorden (vereinfacht — WP-Seite im Aufbau)
// Eigene Klassen astro-kde-* (nie WP-Präfixe wiederverwenden).
// Kontakt-Bereich im Stil der Kita St. Bonifatius (KboKontakt.astro) gehalten.
---
<div class="astro-kde-root">
  <!-- HERO -->
  <section class="astro-kde-hero">
    <div class="astro-kde-hero__in">
      <p class="astro-kde-eyebrow">Frankfurt-Sachsenhausen</p>
      <h1 class="astro-kde-hero__h1">Kita Deutschorden</h1>
      <p class="astro-kde-hero__motto">Gemeinschaft, die tr&auml;gt.</p>
      <p class="astro-kde-hero__lead">Katholische Kita f&uuml;r Kinder von 3 bis 6 Jahren im historischen Sachsenhausen, in Tr&auml;gerschaft der Pfarrei Sankt Bonifatius.</p>
      <div class="astro-kde-hero__ctas">
        <a href="#astro-kde-kontakt" class="astro-kde-btn astro-kde-btn--ghost">Kontakt aufnehmen</a>
        <a href="/kitas/stellenboerse/" class="astro-kde-btn astro-kde-btn--gold">Stellenb&ouml;rse</a>
      </div>
    </div>
  </section>
</div>

<!-- INFO STRIP -->
<section class="astro-kde-strip astro-kde-sec">
  <div class="astro-kde-strip__in">
    <div class="astro-kde-strip__item">
      <div class="astro-kde-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div class="astro-kde-strip__label">Alter</div>
      <div class="astro-kde-strip__value">3 &ndash; 6 Jahre</div>
    </div>
    <div class="astro-kde-strip__item">
      <div class="astro-kde-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </div>
      <div class="astro-kde-strip__label">Ort</div>
      <div class="astro-kde-strip__value">Frankfurt-Sachsenhausen</div>
    </div>
    <div class="astro-kde-strip__item">
      <div class="astro-kde-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
      </div>
      <div class="astro-kde-strip__label">Tr&auml;ger</div>
      <div class="astro-kde-strip__value">Pfarrei Sankt Bonifatius</div>
    </div>
    <div class="astro-kde-strip__item">
      <div class="astro-kde-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="astro-kde-strip__label">&Ouml;ffnungszeiten</div>
      <div class="astro-kde-strip__value">Mo&ndash;Fr 7:30 &ndash; 17:00</div>
    </div>
  </div>
</section>

<!-- ANKÜNDIGUNG -->
<section class="astro-kde-coming astro-kde-sec">
  <div class="astro-kde-coming__in">
    <div class="astro-kde-coming__card">
      <h2 class="astro-kde-coming__h2">Webauftritt im Aufbau &ndash; mehr folgt in K&uuml;rze</h2>
      <p>Wir bereiten gerade den Webauftritt der Kita Deutschorden vor. Informationen &uuml;ber unser p&auml;dagogisches Konzept, den Tagesablauf und das Anmeldeverfahren folgen in K&uuml;rze. Bis dahin erreichen Sie uns jederzeit direkt.</p>
      <a href="#astro-kde-kontakt" class="astro-kde-btn astro-kde-btn--accent">Jetzt Kontakt aufnehmen</a>
    </div>
  </div>
</section>

<!-- KONTAKT (Stil wie Kita St. Bonifatius) -->
<section class="astro-kde-kontakt astro-kde-sec" id="astro-kde-kontakt">
  <div class="astro-kde-kontakt__in">
    <h2 class="astro-kde-kontakt__h2">Ihr Team &ndash; Ansprechpersonen</h2>

    <!-- Kita-Leitung -->
    <div class="astro-kde-kontakt__team">
      <div class="astro-kde-kontakt__person">
        <div class="astro-kde-kontakt__photo astro-kde-kontakt__photo--placeholder" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <p class="astro-kde-kontakt__role">Kita-Leitung</p>
        <p class="astro-kde-kontakt__name">Sarah Osorio</p>
        <p class="astro-kde-kontakt__info">Tel: <a href="tel:+496927297987">069 . 27 29 79 87</a></p>
        <p class="astro-kde-kontakt__info"><a href="mailto:kita-deutschorden@sanktbonifatius.de">kita-deutschorden@sanktbonifatius.de</a></p>
      </div>

      <div class="astro-kde-kontakt__person">
        <div class="astro-kde-kontakt__photo astro-kde-kontakt__photo--placeholder" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <p class="astro-kde-kontakt__role">Stellv. Leitung</p>
        <p class="astro-kde-kontakt__name">Anke Reinhardt</p>
        <p class="astro-kde-kontakt__info">Tel: <a href="tel:+496927297987">069 . 27 29 79 87</a></p>
        <p class="astro-kde-kontakt__info"><a href="mailto:kita-deutschorden@sanktbonifatius.de">kita-deutschorden@sanktbonifatius.de</a></p>
      </div>
    </div>

    <!-- Kita-Koordination -->
    <div class="astro-kde-kontakt__koord-head">
      <h3 class="astro-kde-kontakt__koord-title">Kita-Koordination der Pfarrei</h3>
    </div>
    <div class="astro-kde-kontakt__koord">
      <div class="astro-kde-kontakt__koord-card">
        <img src="/uploads/2026/07/Sandra-Roos-Greulich-2026.jpg" alt="Sandra Roos-Greulich" class="astro-kde-kontakt__koord-photo" loading="lazy" />
        <p class="astro-kde-kontakt__koord-role">Kita-Koordinatorin</p>
        <p class="astro-kde-kontakt__koord-name">Sandra Roos-Greulich</p>
        <a href="mailto:s.roos-greulich@sanktbonifatius.de">s.roos-greulich@sanktbonifatius.de</a>
      </div>
      <div class="astro-kde-kontakt__koord-card">
        <img src="/uploads/2026/07/Jeannine-Douverne-2026.jpg" alt="Jeannine Douverne" class="astro-kde-kontakt__koord-photo" loading="lazy" />
        <p class="astro-kde-kontakt__koord-role">Referentin Kita-Koordination</p>
        <p class="astro-kde-kontakt__koord-name">Jeannine Douverne</p>
        <a href="mailto:j.douverne@sanktbonifatius.de">j.douverne@sanktbonifatius.de</a>
      </div>
    </div>

    <hr class="astro-kde-kontakt__divider" />

    <!-- Adresse -->
    <div class="astro-kde-kontakt__addr">
      <div class="astro-kde-kontakt__addr-text">
        <h2 class="astro-kde-kontakt__addr-head">Interesse an einem Platz?</h2>
        <p>Anmeldungen laufen &uuml;ber Kindernet Frankfurt. Bei Fragen zu Betreuungszeiten, freien Pl&auml;tzen oder dem Einrichtungsalltag kontaktieren Sie uns direkt.</p>
        <a href="https://www.kindernetfrankfurt.de" target="_blank" rel="noopener" class="astro-kde-btn astro-kde-btn--accent" style="margin-top:20px;display:inline-flex">
          Anmeldung &uuml;ber Kindernet Frankfurt &#8599;
        </a>
      </div>
      <div class="astro-kde-kontakt__addr-info">
        <div class="astro-kde-kontakt__info-row">
          <strong>Adresse</strong>
          <span>Eingang: Elisabethenstr. 14<br>Post: Br&uuml;ckenstra&szlig;e 3, 60594 Frankfurt am Main</span>
        </div>
        <div class="astro-kde-kontakt__info-row">
          <strong>Telefon</strong>
          <span><a href="tel:+496927297987">069 . 27 29 79 87</a></span>
        </div>
        <div class="astro-kde-kontakt__info-row">
          <strong>E-Mail</strong>
          <span><a href="mailto:kita-deutschorden@sanktbonifatius.de">kita-deutschorden@sanktbonifatius.de</a></span>
        </div>
        <div class="astro-kde-kontakt__info-row">
          <strong>Jobs</strong>
          <span><a href="/kitas/stellenboerse/" style="color:var(--bf-accent)">Kita-Stellenb&ouml;rse &rarr;</a></span>
        </div>
        <div class="astro-kde-kontakt__info-row">
          <span style="grid-column:1/-1">
            <a href="https://maps.google.com/?q=Elisabethenstra%C3%9Fe+14+60594+Frankfurt" target="_blank" rel="noopener">In Google Maps &ouml;ffnen &rarr;</a>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
:root {
  --bf-bg: #f7f3ef;
  --bf-bg-alt: #ede4d5;
  --bf-ink: #1e1512;
  --bf-ink-60: #6b5c52;
  --bf-accent: #9a2d2d;
  --bf-gold: #b88a3a;
  --bf-border: #e0d8cf;
  --bf-radius: 14px;
}
.astro-kde-root {
  width: 100vw;
  position: relative;
  left: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
}
.astro-kde-hero {
  min-height: 480px;
  display: flex;
  align-items: flex-end;
  background: url('/uploads/2026/08/kita-deutschorden-spielhof.jpg') center/cover no-repeat;
  position: relative;
}
.astro-kde-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(20,10,10,.62) 0%, rgba(26,26,58,.32) 50%, rgba(26,26,58,.08) 100%);
}
.astro-kde-hero__in {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px 56px;
}
.astro-kde-eyebrow {
  font-family: 'Playfair Display', Georgia, serif;
  font-style: italic;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: rgba(255,255,255,.95);
  text-shadow: 0 1px 3px rgba(0,0,0,.9), 0 0 14px rgba(0,0,0,.5);
  margin: 0 0 14px;
}
.astro-kde-hero__h1 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(32px, 5vw, 58px);
  font-weight: 700;
  color: #fff;
  margin: 0 0 10px;
  line-height: 1.15;
  max-width: 700px;
}
.astro-kde-hero__motto {
  font-family: 'Playfair Display', Georgia, serif;
  font-style: italic;
  font-weight: 700;
  font-size: clamp(19px, 2.6vw, 26px);
  color: #f2b429;
  text-shadow: 0 1px 3px rgba(0,0,0,.9), 0 0 14px rgba(0,0,0,.5);
  margin: 0 0 18px;
}
.astro-kde-hero__lead {
  font-size: clamp(15px, 2vw, 18px);
  color: rgba(255,255,255,.85);
  max-width: 520px;
  line-height: 1.65;
  margin: 0 0 28px;
}
.astro-kde-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }
.astro-kde-btn {
  display: inline-flex;
  align-items: center;
  padding: 13px 26px;
  border-radius: 32px;
  font-weight: 700;
  font-size: 14.5px;
  text-decoration: none;
  min-height: 44px;
  transition: all .2s;
}
.astro-kde-btn--ghost { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.5); }
.astro-kde-btn--ghost:hover { background: rgba(255,255,255,.12); border-color: #fff; }
.astro-kde-btn--gold { background: #f2b429; color: #1a120e; border: 2px solid #f2b429; }
.astro-kde-btn--gold:hover { background: #e0a520; border-color: #e0a520; }
.astro-kde-btn--accent { background: var(--bf-accent); color: #fff; border: 2px solid var(--bf-accent); }
.astro-kde-btn--accent:hover { background: #7a2424; border-color: #7a2424; }
.astro-kde-sec { width: 100vw; position: relative; left: 50%; margin-left: -50vw; margin-right: -50vw; }
[id] { scroll-margin-top: 100px; }

/* Strip */
.astro-kde-strip { background: var(--bf-bg); padding: 48px 24px; }
.astro-kde-strip__in { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 20px; }
.astro-kde-strip__item { text-align: center; background: #fff; border-radius: 10px; padding: 20px 14px; border: 1px solid var(--bf-border); transition: transform .2s, box-shadow .2s; }
.astro-kde-strip__item:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(30,21,18,.08); }
.astro-kde-strip__icon { color: var(--bf-accent); margin-bottom: 8px; display: flex; justify-content: center; }
.astro-kde-strip__label { font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--bf-ink-60); margin-bottom: 6px; }
.astro-kde-strip__value { font-family: 'Playfair Display', Georgia, serif; font-size: 15px; color: var(--bf-ink); line-height: 1.4; font-weight: 700; }

/* Coming soon */
.astro-kde-coming { background: #fff; padding: 72px 24px; }
.astro-kde-coming__in { max-width: 680px; margin: 0 auto; text-align: center; }
.astro-kde-coming__card { background: var(--bf-bg); border: 1px solid var(--bf-border); border-radius: 20px; padding: 44px 40px; }
.astro-kde-coming__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(22px, 3vw, 32px); font-weight: 700; color: var(--bf-ink); margin: 0 0 14px; }
.astro-kde-coming__card p { font-size: 15.5px; color: var(--bf-ink-60); line-height: 1.75; margin: 0 0 24px; }

/* Kontakt (Stil wie Kita St. Bonifatius) */
.astro-kde-kontakt { background: var(--bf-bg); padding: 80px 24px; }
.astro-kde-kontakt__in { max-width: 1100px; margin: 0 auto; }
.astro-kde-kontakt__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(26px, 3vw, 38px); font-weight: 700; color: var(--bf-ink); margin: 0 0 40px; text-align: center; }

/* Team (Leitung) */
.astro-kde-kontakt__team { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; max-width: 680px; margin: 0 auto 48px; }
.astro-kde-kontakt__person { text-align: center; background: #fff; border-radius: var(--bf-radius); padding: 28px 20px; border: 1px solid var(--bf-border); }
.astro-kde-kontakt__photo { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; object-position: top; border: 3px solid var(--bf-border); margin: 0 auto 16px; display: block; }
.astro-kde-kontakt__photo--placeholder { display: flex; align-items: center; justify-content: center; background: var(--bf-bg); color: var(--bf-ink-60); }
.astro-kde-kontakt__role { font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--bf-accent); margin: 0 0 4px; }
.astro-kde-kontakt__name { font-family: 'Playfair Display', Georgia, serif; font-size: 17px; font-weight: 700; color: var(--bf-ink); margin: 0 0 10px; }
.astro-kde-kontakt__info { font-size: 14px; color: var(--bf-ink-60); margin: 4px 0; }
.astro-kde-kontakt__info a { color: var(--bf-ink-60); text-decoration: none; word-break: break-word; }
.astro-kde-kontakt__info a:hover { color: var(--bf-accent); }

/* Koordination */
.astro-kde-kontakt__koord-head { text-align: center; margin-bottom: 20px; }
.astro-kde-kontakt__koord-title { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(20px, 2.2vw, 28px); font-weight: 700; color: var(--bf-ink); margin: 0; }
.astro-kde-kontakt__koord { display: flex; gap: 24px; justify-content: center; flex-wrap: wrap; margin-bottom: 48px; }
.astro-kde-kontakt__koord-card { background: #fff; border-radius: var(--bf-radius); padding: 28px 32px; border: 1px solid var(--bf-border); text-align: center; min-width: 220px; max-width: 280px; }
.astro-kde-kontakt__koord-photo { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; object-position: top; border: 2px solid var(--bf-border); margin: 0 auto 14px; display: block; }
.astro-kde-kontakt__koord-role { font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--bf-accent); margin: 0 0 6px; }
.astro-kde-kontakt__koord-name { font-family: 'Playfair Display', Georgia, serif; font-size: 17px; font-weight: 700; color: var(--bf-ink); margin: 0 0 10px; }
.astro-kde-kontakt__koord-card a { font-size: 13px; color: var(--bf-accent); text-decoration: none; word-break: break-all; }
.astro-kde-kontakt__koord-card a:hover { text-decoration: underline; }

.astro-kde-kontakt__divider { border: none; border-top: 1px solid var(--bf-border); margin: 0 0 48px; }

/* Adresse */
.astro-kde-kontakt__addr { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
.astro-kde-kontakt__addr-head { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(22px, 2.5vw, 32px); font-weight: 700; color: var(--bf-ink); margin: 0 0 12px; }
.astro-kde-kontakt__addr-text p { font-size: 15px; color: var(--bf-ink-60); line-height: 1.75; margin: 0; }
.astro-kde-kontakt__addr-info { background: #fff; border: 1px solid var(--bf-border); border-radius: var(--bf-radius); padding: 28px 32px; }
.astro-kde-kontakt__info-row { display: grid; grid-template-columns: 80px 1fr; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--bf-border); font-size: 14px; color: var(--bf-ink); }
.astro-kde-kontakt__info-row:last-child { border-bottom: none; }
.astro-kde-kontakt__info-row strong { font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--bf-accent); padding-top: 2px; }
.astro-kde-kontakt__info-row a { color: var(--bf-ink-60); text-decoration: none; }
.astro-kde-kontakt__info-row a:hover { color: var(--bf-accent); }

@media (max-width: 700px) {
  .astro-kde-kontakt__team { grid-template-columns: 1fr; max-width: 360px; }
  .astro-kde-kontakt__addr { grid-template-columns: 1fr; gap: 28px; }
  .astro-kde-hero__in { padding: 0 20px 48px; }
}
</style>
