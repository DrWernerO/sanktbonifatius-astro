---
// „So läuft es ab" — drei Karten (Impulse, Kleingruppe, Meilensteine).
// Eigene Klassen `astro-pfs-ablauf` (Handbuch 3). Icons als Inline-SVG (keine Emojis, Handbuch 8).
const karten = [
  {
    titel: 'Tägliche Impulse',
    text: 'Jede Woche beginnt mit einem Sonntagsimpuls zum Sonntagstext, dazu kommen sechs kurze Tagesimpulse – ein Text, ein Gedanke, eine Frage. Rund 15 Minuten am Tag genügen.',
    icon: '<path d="M4 5a2 2 0 0 1 2-2h11v16H6a2 2 0 0 0-2 2V5z"/><path d="M4 19a2 2 0 0 1 2-2h11"/><path d="M9 7h5M9 11h4"/>',
  },
  {
    titel: 'Wöchentliche Kleingruppe',
    text: 'Einmal pro Woche treffen Sie sich mit 8–12 Personen für etwa 90 Minuten. Hier ist Raum, das Erlebte zu teilen, einander zuzuhören und miteinander ins Gespräch zu kommen.',
    icon: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M15 14.5c.6-.3 1.3-.5 2-.5 2.8 0 4.5 2.2 4.5 5"/>',
  },
  {
    titel: 'Gemeinsame Meilensteine',
    text: 'Ein gemeinsamer Start, ein Bergfest zur Halbzeit und ein Abschluss verbinden alle Gruppen – über Gemeinde- und Konfessionsgrenzen hinweg.',
    icon: '<path d="M3 20l6-10 4 6 3-4 5 8H3z"/><path d="M9 10V4l5 2-5 2"/>',
  },
];
---
<section class="astro-pfs-sec astro-pfs-ablauf">
  <div class="astro-pfs-wrap">
    <div class="astro-pfs-head">
      <h2 class="astro-pfs-hl">So läuft es ab</h2>
      <p class="astro-pfs-sub">Drei Bausteine, die sich gegenseitig tragen.</p>
    </div>
    <div class="astro-pfs-ablauf__grid">
      {karten.map((k, i) => (
        <article class="astro-pfs-ablauf__card">
          <span class="astro-pfs-ablauf__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={k.icon} />
          </span>
          <p class="astro-pfs-ablauf__nr">Baustein {i + 1}</p>
          <h3 class="astro-pfs-ablauf__title">{k.titel}</h3>
          <p class="astro-pfs-ablauf__text">{k.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
.astro-pfs-ablauf{background:var(--bf-bg)}
.astro-pfs-ablauf__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.astro-pfs-ablauf__card{background:#fff;border:1px solid var(--bf-border);border-radius:var(--bf-radius);box-shadow:var(--bf-shadow);padding:32px 28px}
.astro-pfs-ablauf__icon{display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:50%;background:var(--bf-bg-alt);color:var(--bf-accent);margin-bottom:18px}
.astro-pfs-ablauf__nr{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--txt-gold-label);font-weight:600;margin:0 0 6px}
.astro-pfs-ablauf__title{font-family:var(--pfs-serif);font-size:22px;font-weight:700;color:var(--bf-ink);margin:0 0 10px;line-height:1.25}
.astro-pfs-ablauf__text{font-size:15.5px;line-height:1.65;color:var(--txt-muted-light);margin:0}
@media(max-width:900px){.astro-pfs-ablauf__grid{grid-template-columns:1fr}}
</style>
