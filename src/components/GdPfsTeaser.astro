---
// Teaser „Pause für die Seele 2027" auf /gottesdienst-glaube/ (zwischen GdWelcome und GdFormate).
// Eigene Klassen `astro-gdpfs` (Handbuch 3). Motiv von Werner (30.09.2026), lokal unter
// public/uploads/2027/01/ (Handbuch 1g). Das Motiv enthält den Titel bereits als Schrift —
// deshalb alt-Text mit Titel + Claim, und daneben keine Wiederholung als großes H2.
// Sand-Band (--bf-bg-alt), weil GdWelcome (weiß) und GdFormate (Crème) direkt angrenzen
// (Design-System 5: benachbarte Sections nie gleiche Farbe).
// Hinweis: Solange die Zielseite passwortgeschützt ist, landen Besucher hier im Login-Dialog.
const img = '/uploads/2027/01/pause-fuer-die-seele-2027-teaser.png';
const href = '/gottesdienst-glaube/pause-fuer-die-seele/';
---
<section class="astro-gdpfs">
  <div class="astro-gdpfs__inner">
    <a class="astro-gdpfs__card" href={href}>
      <img class="astro-gdpfs__img" src={img} width="1720" height="910" loading="lazy"
           alt="Pause für die Seele – Vierzig Tage, die gut tun." />
      <div class="astro-gdpfs__body">
        <p class="astro-gdpfs__label">Fastenzeit 2027 &middot; 14.02.–27.03.</p>
        <h2 class="astro-gdpfs__hl">Ökumenische Exerzitien im Alltag</h2>
        <p class="astro-gdpfs__text">
          Sechs Wochen mit täglichen Impulsen und einer wöchentlichen Kleingruppe – gemeinsam mit
          der Dreikönigsgemeinde, der Maria-Magdalena-Gemeinde und der Erlösergemeinde Oberrad.
        </p>
        <span class="astro-gdpfs__btn">Mehr erfahren &amp; anmelden <span aria-hidden="true">&rarr;</span></span>
      </div>
    </a>
  </div>
</section>

<style is:global>
.astro-gdpfs{
  --bf-bg-alt:#ede4d5;--bf-ink:#1e1512;--bf-accent:#9a2d2d;--bf-border:#e0d8cf;--bf-radius:14px;
  --bf-shadow:0 4px 20px rgba(30,21,18,.06);--bf-shadow-lg:0 10px 32px rgba(30,21,18,.1);
  background:var(--bf-bg-alt);padding:56px 0
}
.astro-gdpfs__inner{max-width:1120px;margin:0 auto;padding:0 40px}
.astro-gdpfs__card{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);background:#fff;border:1px solid var(--bf-border);border-radius:var(--bf-radius);overflow:hidden;box-shadow:var(--bf-shadow);text-decoration:none;color:inherit;transition:box-shadow .2s,transform .2s}
.astro-gdpfs__card:hover{box-shadow:var(--bf-shadow-lg);transform:translateY(-2px)}
.astro-gdpfs__card:focus-visible{outline:3px solid var(--accent-gold-deco);outline-offset:3px}
.astro-gdpfs__img{width:100%;height:100%;object-fit:cover;display:block}
.astro-gdpfs__body{padding:36px 40px;display:flex;flex-direction:column;justify-content:center}
.astro-gdpfs__label{font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;color:var(--txt-gold-label);margin:0 0 10px}
.astro-gdpfs__hl{font-family:'Playfair Display',Georgia,serif;font-size:clamp(22px,2.6vw,30px);font-weight:700;line-height:1.2;color:var(--bf-ink);margin:0 0 12px}
.astro-gdpfs__text{font-size:16px;line-height:1.65;color:var(--txt-muted-light);margin:0 0 22px}
.astro-gdpfs__btn{align-self:flex-start;display:inline-flex;gap:8px;align-items:center;padding:12px 24px;border-radius:50px;background:var(--bf-accent);color:#fff;font-size:14.5px;font-weight:600}
@media(max-width:860px){.astro-gdpfs__card{grid-template-columns:1fr}.astro-gdpfs__img{height:auto;aspect-ratio:1720/910}.astro-gdpfs__body{padding:26px 24px 28px}}
@media(max-width:600px){.astro-gdpfs{padding:44px 0}.astro-gdpfs__inner{padding:0 20px}}
</style>
