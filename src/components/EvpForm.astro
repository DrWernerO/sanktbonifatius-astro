---
// Formular „Ehevorbereitungsprotokoll": kompletter Abschnitt A des amtlichen Formulars (Nr. 1–9, je Bräutigam
// und Braut, + Familienname nach der Eheschließung) sowie geplante Eheschließung (Kopf). Eigene Klassen `astro-evp`.
//
// Übermittlung: Das Formular sendet per fetch (FormData) an `/api/evp-anmeldung`
// (src/pages/api/evp-anmeldung.ts). Die Route füllt das amtliche PDF (src/lib/evp/fill-evp.js)
// und verschickt es als Mail-Anhang.
//
// 🔑 Feldnamen `mann_*` / `frau_*` sind VERTRAG mit src/lib/evp/fill-evp.js — NICHT umbenennen.
//
// Bedienung: 3 Schritte (Bräutigam → Braut → Absenden), ohne JavaScript sind alle Schritte sichtbar.
// Bedingte Felder: Attribut data-if="feldname=Wert|Wert2" (per Skript ein-/ausgeblendet; ausgeblendete
// Felder sind deaktiviert und werden nicht übertragen).

const personen = [
  { p: 'mann', titel: 'Bräutigam', nr: 1 },
  { p: 'frau', titel: 'Braut', nr: 2 },
];
const konfessionen = [
  'römisch-katholisch', 'evangelisch', 'orthodox', 'altkatholisch',
  'andere christliche Konfession', 'muslimisch', 'andere Religion', 'keine Religionszugehörigkeit',
];
---
<section class="astro-evp" id="evp">
  <div class="astro-evp__inner">
    <ol class="astro-evp__steps" id="astro-evp-steps" aria-label="Fortschritt">
      <li data-step="1"><span>1</span> Bräutigam</li>
      <li data-step="2"><span>2</span> Braut</li>
      <li data-step="3"><span>3</span> Gemeinsames &amp; Versenden</li>
    </ol>

    <form id="astro-evp-form" class="astro-evp__form" novalidate>
      {personen.map(({ p, titel, nr }) => (
        <div class="astro-evp__step" data-step={nr}>
          <h2 class="astro-evp__h2">Angaben zum {titel}</h2>

          <fieldset class="astro-evp__fs">
            <legend class="astro-evp__legend">Name</legend>
            <div class="astro-evp__grid">
              <label class="astro-evp__f">Familienname *<input type="text" name={`${p}_familienname`} required autocomplete="off" /></label>
              <label class="astro-evp__f">Geburtsname<small>nur ausfüllen, wenn er vom Familiennamen abweicht</small><input type="text" name={`${p}_geburtsname`} autocomplete="off" /></label>
              <label class="astro-evp__f">Alle Vornamen *<small>so wie in der Geburtsurkunde</small><input type="text" name={`${p}_vornamen`} required autocomplete="off" /></label>
              <label class="astro-evp__f">Rufname<small>nur bei mehreren Vornamen: Welchen nutzen Sie im Alltag?</small><input type="text" name={`${p}_rufname`} autocomplete="off" /></label>
              <label class="astro-evp__f astro-evp__f--wide">Wie lautet {p === 'mann' ? 'sein' : 'ihr'} Familienname nach der Eheschließung? *<small>Bei Doppelnamen bitte genau so, wie er geführt werden soll.</small><input type="text" name={`${p}_ehename`} required autocomplete="off" /></label>
            </div>
          </fieldset>

          <fieldset class="astro-evp__fs">
            <legend class="astro-evp__legend">Geburt</legend>
            <div class="astro-evp__grid">
              <label class="astro-evp__f">Geboren am *<input type="date" name={`${p}_geburtsdatum`} required min="1930-01-01" max="2012-12-31" /></label>
              <label class="astro-evp__f">Geburtsort *<input type="text" name={`${p}_geburtsort`} required autocomplete="off" /></label>
              <label class="astro-evp__f">Geburtsland (Staat)<input type="text" name={`${p}_geburtsland`} value="Deutschland" autocomplete="off" /></label>
              <label class="astro-evp__f">Staatsangehörigkeit<input type="text" name={`${p}_staatsangehoerigkeit`} value="deutsch" autocomplete="off" /></label>
            </div>
          </fieldset>

          <fieldset class="astro-evp__fs">
            <legend class="astro-evp__legend">Konfession, Taufe und Firmung</legend>
            <div class="astro-evp__grid">
              <label class="astro-evp__f">Konfession / Religion *
                <select name={`${p}_konfession`} required>
                  <option value="">– bitte wählen –</option>
                  {konfessionen.map((k) => <option>{k}</option>)}
                </select>
              </label>
              <label class="astro-evp__f" data-if={`${p}_konfession=andere christliche Konfession|andere Religion`}>Welche genau?<input type="text" name={`${p}_konfession_zusatz`} autocomplete="off" /></label>
            </div>

            <div class="astro-evp__q">
              <span class="astro-evp__qt">Sind Sie getauft? *</span>
              <span class="astro-evp__radios">
                <label><input type="radio" name={`${p}_getauft`} value="Ja" required /> Ja</label>
                <label><input type="radio" name={`${p}_getauft`} value="Nein" /> Nein</label>
              </span>
            </div>
            <div class="astro-evp__grid" data-if={`${p}_getauft=Ja`}>
              <label class="astro-evp__f">Taufdatum<small>falls nicht bekannt, leer lassen</small><input type="date" name={`${p}_taufdatum`} /></label>
              <label class="astro-evp__f">Taufpfarrei<small>Name der Kirche, Ort und möglichst die Anschrift</small><input type="text" name={`${p}_taufpfarrei`} autocomplete="off" /></label>
            </div>

            <div data-if={`${p}_konfession=römisch-katholisch`}>
            <div class="astro-evp__q">
              <span class="astro-evp__qt">Sind Sie gefirmt?</span>
              <span class="astro-evp__radios">
                <label><input type="radio" name={`${p}_gefirmt`} value="Ja" /> Ja</label>
                <label><input type="radio" name={`${p}_gefirmt`} value="Nein" /> Nein</label>
                <label><input type="radio" name={`${p}_gefirmt`} value="Weiß nicht" /> Weiß ich nicht</label>
              </span>
            </div>
            <div class="astro-evp__grid" data-if={`${p}_gefirmt=Ja`}>
              <label class="astro-evp__f">Firmdatum<small>soweit bekannt</small><input type="date" name={`${p}_firmdatum`} /></label>
              <label class="astro-evp__f">Firmort<input type="text" name={`${p}_firmort`} autocomplete="off" /></label>
            </div>
            </div>

            <div class="astro-evp__grid">
              <label class="astro-evp__f astro-evp__f--wide">Gehörten Sie früher einer anderen Konfession oder Religion an?<small>Wenn nicht, leer lassen.</small><input type="text" name={`${p}_frueher_konfession`} autocomplete="off" /></label>
            </div>

            <div data-if={`${p}_getauft=Ja`}>
              <div class="astro-evp__q">
                <span class="astro-evp__qt">Sind Sie aus der Kirche ausgetreten?</span>
                <span class="astro-evp__radios">
                  <label><input type="radio" name={`${p}_austritt`} value="Nein" checked /> Nein</label>
                  <label><input type="radio" name={`${p}_austritt`} value="Ja" /> Ja</label>
                </span>
              </div>
              <div data-if={`${p}_austritt=Ja`}>
                <div class="astro-evp__grid">
                  <label class="astro-evp__f">Austritt am<input type="date" name={`${p}_austritt_datum`} /></label>
                  <label class="astro-evp__f">Wo?<small>z. B. Bürgeramt Frankfurt</small><input type="text" name={`${p}_austritt_ort`} autocomplete="off" /></label>
                </div>
                <div class="astro-evp__q">
                  <span class="astro-evp__qt">Sind Sie nach Ihrem Kirchenaustritt in die Kirche wiederaufgenommen worden?</span>
                  <span class="astro-evp__radios">
                    <label><input type="radio" name={`${p}_wiederaufnahme`} value="Nein" checked /> Nein</label>
                    <label><input type="radio" name={`${p}_wiederaufnahme`} value="Ja" /> Ja</label>
                  </span>
                </div>
                <div class="astro-evp__grid" data-if={`${p}_wiederaufnahme=Ja`}>
                  <label class="astro-evp__f">Wiederaufnahme am<input type="date" name={`${p}_wiederaufnahme_datum`} /></label>
                  <label class="astro-evp__f">Wo?<input type="text" name={`${p}_wiederaufnahme_ort`} autocomplete="off" /></label>
                </div>
              </div>
            </div>
          </fieldset>

          <fieldset class="astro-evp__fs">
            <legend class="astro-evp__legend">Wohnsitz</legend>
            <div class="astro-evp__grid">
              <label class="astro-evp__f astro-evp__f--wide">Straße und Hausnummer *<input type="text" name={`${p}_strasse`} required autocomplete="off" /></label>
              <label class="astro-evp__f">Postleitzahl *<input type="text" name={`${p}_plz`} required inputmode="numeric" maxlength="10" autocomplete="off" /></label>
              <label class="astro-evp__f">Ort *<input type="text" name={`${p}_ort`} required autocomplete="off" /></label>
            </div>
          </fieldset>

          <fieldset class="astro-evp__fs">
            <legend class="astro-evp__legend">Eltern</legend>
            {[['vater', 'Leiblicher Vater'], ['mutter', 'Leibliche Mutter']].map(([k, l]) => (
              <div class="astro-evp__group">
                <p class="astro-evp__gt">{l}</p>
                <div class="astro-evp__grid">
                  <label class="astro-evp__f">Vorname<input type="text" name={`${p}_${k}_vorname`} autocomplete="off" /></label>
                  <label class="astro-evp__f">Familienname<input type="text" name={`${p}_${k}_name`} autocomplete="off" /></label>
                  <label class="astro-evp__f">Geburtsname<small>falls abweichend</small><input type="text" name={`${p}_${k}_geburtsname`} autocomplete="off" /></label>
                  <label class="astro-evp__f">Konfession / Religion<input type="text" name={`${p}_${k}_konfession`} placeholder="z. B. römisch-katholisch" autocomplete="off" /></label>
                </div>
              </div>
            ))}
          </fieldset>

          <fieldset class="astro-evp__fs">
            <legend class="astro-evp__legend">Frühere Ehe und Kinder aus früherer Verbindung</legend>
            <div class="astro-evp__q">
              <span class="astro-evp__qt">Waren Sie schon einmal verheiratet?<small>Auch standesamtlich, in einer anderen Religion oder in einer eingetragenen Lebenspartnerschaft.</small></span>
              <span class="astro-evp__radios">
                <label><input type="radio" name={`${p}_vorehe`} value="Nein" checked /> Nein</label>
                <label><input type="radio" name={`${p}_vorehe`} value="Ja" /> Ja</label>
              </span>
            </div>
            <div data-if={`${p}_vorehe=Ja`}>
              <div class="astro-evp__grid">
                <label class="astro-evp__f astro-evp__f--wide">Mit wem?<small>Name, Geburtsname, Konfession/Religion des früheren Partners bzw. der früheren Partnerin</small><input type="text" name={`${p}_vorehe_partner`} autocomplete="off" /></label>
                <label class="astro-evp__f">Wie ist diese Ehe beendet worden?
                  <select name={`${p}_vorehe_ende`}>
                    <option value="">– bitte wählen –</option>
                    <option>Scheidung (standesamtlich)</option>
                    <option>Tod des Partners</option>
                    <option>Kirchliche Nichtigkeitserklärung</option>
                  </select>
                </label>
                <label class="astro-evp__f" data-if={`${p}_vorehe_ende=Scheidung (standesamtlich)|Tod des Partners`}>Wann?<small>Datum der Scheidung bzw. des Todes</small><input type="date" name={`${p}_vorehe_datum`} /></label>
                <label class="astro-evp__f astro-evp__f--wide" data-if={`${p}_vorehe_ende=Kirchliche Nichtigkeitserklärung`}>Durch wen, wann, Aktenzeichen<input type="text" name={`${p}_vorehe_nichtigkeit`} autocomplete="off" /></label>
              </div>
            </div>
            <div class="astro-evp__q">
              <span class="astro-evp__qt">Haben Sie Kinder aus einer früheren Verbindung?</span>
              <span class="astro-evp__radios">
                <label><input type="radio" name={`${p}_kinder_frueher`} value="Nein" checked /> Nein</label>
                <label><input type="radio" name={`${p}_kinder_frueher`} value="Ja" /> Ja</label>
              </span>
            </div>
            <div class="astro-evp__grid" data-if={`${p}_kinder_frueher=Ja`}>
              <label class="astro-evp__f astro-evp__f--wide">Name, Alter, Konfession/Religion<small>Ein Kind pro Zeile</small><textarea name={`${p}_kinder_frueher_liste`} rows="3"></textarea></label>
            </div>
          </fieldset>


          <div class="astro-evp__nav">
            {nr > 1 && <button type="button" class="astro-evp__btn astro-evp__btn--ghost" data-go="prev">Zurück</button>}
            <button type="button" class="astro-evp__btn" data-go="next">Weiter: {nr === 1 ? 'Braut' : 'Gemeinsame Fragen'}</button>
          </div>
        </div>
      ))}

      <div class="astro-evp__step" data-step="3">
        <h2 class="astro-evp__h2">Gemeinsame Fragen &amp; Versenden</h2>

        <fieldset class="astro-evp__fs">
          <legend class="astro-evp__legend">Geplante Eheschließung</legend>
          <p class="astro-evp__hint">Nur ausfüllen, was schon feststeht.</p>
          <div class="astro-evp__grid">
            <label class="astro-evp__f">Standesamtliche Trauung am<input type="date" name="zivil_datum" /></label>
            <label class="astro-evp__f">Standesamt / Ort<input type="text" name="zivil_ort" autocomplete="off" /></label>
            <label class="astro-evp__f">Kirchliche Trauung am<input type="date" name="kath_datum" /></label>
            <label class="astro-evp__f">Uhrzeit<input type="time" name="kath_uhrzeit" /></label>
            <label class="astro-evp__f astro-evp__f--wide">Kirche / Ort der kirchlichen Trauung
              <input type="text" name="kath_ort" list="astro-evp-kirchen" autocomplete="off" />
              <datalist id="astro-evp-kirchen"><option value="St. Bonifatius, Frankfurt"></option><option value="St. Wendel, Frankfurt"></option><option value="Herz Jesu, Frankfurt"></option></datalist>
            </label>
          </div>
        </fieldset>

        <fieldset class="astro-evp__fs">
          <legend class="astro-evp__legend">Wohnsitz nach der Eheschließung</legend>
          <div class="astro-evp__q">
            <span class="astro-evp__qt">Wo werden Sie gemeinsam wohnen?</span>
            <span class="astro-evp__radios">
              <label><input type="radio" name="ehewohnsitz" value="Bräutigam" /> Adresse des Bräutigams</label>
              <label><input type="radio" name="ehewohnsitz" value="Braut" /> Adresse der Braut</label>
              <label><input type="radio" name="ehewohnsitz" value="Neu" /> Neue Adresse</label>
            </span>
          </div>
          <div class="astro-evp__grid" data-if="ehewohnsitz=Neu">
            <label class="astro-evp__f astro-evp__f--wide">Straße und Hausnummer<input type="text" name="ehewohnsitz_strasse" autocomplete="off" /></label>
            <label class="astro-evp__f">Postleitzahl<input type="text" name="ehewohnsitz_plz" inputmode="numeric" maxlength="10" autocomplete="off" /></label>
            <label class="astro-evp__f">Ort<input type="text" name="ehewohnsitz_ort" autocomplete="off" /></label>
          </div>
        </fieldset>

        <fieldset class="astro-evp__fs">
          <legend class="astro-evp__legend">Gemeinsame Kinder</legend>
          <div class="astro-evp__q">
            <span class="astro-evp__qt">Haben Sie gemeinsame Kinder?</span>
            <span class="astro-evp__radios">
              <label><input type="radio" name="kinder" value="Nein" checked /> Nein</label>
              <label><input type="radio" name="kinder" value="Ja" /> Ja</label>
            </span>
          </div>
          <div class="astro-evp__grid" data-if="kinder=Ja">
            <label class="astro-evp__f astro-evp__f--wide">Name, Alter, Konfession/Religion<small>Ein Kind pro Zeile</small><textarea name="kinder_liste" rows="3"></textarea></label>
          </div>
        </fieldset>

        <fieldset class="astro-evp__fs">
          <legend class="astro-evp__legend">Kontakt für Rückfragen</legend>
          <div class="astro-evp__grid">
            <label class="astro-evp__f">E-Mail-Adresse *<input type="email" name="kontakt_email" required autocomplete="email" /></label>
            <label class="astro-evp__f">Telefonnummer<input type="tel" name="kontakt_telefon" autocomplete="tel" /></label>
          </div>
        </fieldset>
        <p class="astro-evp__privacy">Ihre Angaben werden verschlüsselt übertragen und als Formular per E-Mail an das Pfarrbüro gesendet. Wir verwenden sie nur für die Vorbereitung Ihrer Trauung. Mehr dazu in der <a href="/datenschutz/" target="_blank" rel="noopener">Datenschutzerklärung</a>.</p>
        
        <div class="astro-evp__nav">
          <button type="button" class="astro-evp__btn astro-evp__btn--ghost" data-go="prev">Zurück</button>
          <button type="submit" class="astro-evp__btn astro-evp__submit">Angaben versenden</button>
        </div>
        <div class="astro-evp__msg" id="astro-evp-msg" role="status" aria-live="polite" hidden></div>
      </div>

      <!-- Anti-Spam: für Menschen unsichtbar; Bots füllen das Feld, der Server verwirft still. -->
      <div class="astro-evp__hp" aria-hidden="true">
        <label>Bitte dieses Feld leer lassen<input type="text" name="webseite" tabindex="-1" autocomplete="off" /></label>
      </div>
      <input type="hidden" name="astro_ts" id="astro-evp-ts" value="" />
    </form>

    <div class="astro-evp__done" id="astro-evp-done" hidden>
      <h2 class="astro-evp__h2">Vielen Dank!</h2>
      <p>Ihre Angaben sind bei uns eingegangen. Wir melden uns bei Ihnen.</p>
    </div>
  </div>
</section>

<style is:global>
.astro-evp{background:#f7f3ef;padding:40px 0 72px;scroll-margin-top:80px}
.astro-evp__inner{max-width:880px;margin:0 auto;padding:0 40px}
.astro-evp__steps{list-style:none;display:flex;gap:8px;margin:0 0 24px;padding:0}
.astro-evp__steps li{flex:1;display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:12px;background:#ece3d8;color:#6b5c52;font-size:14.5px;font-weight:600}
.astro-evp__steps li span{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:#fff;color:#9a2d2d;font-size:13px;flex:none}
.astro-evp__steps li.is-active{background:#9a2d2d;color:#fff}
.astro-evp__steps li.is-done span{background:#9a2d2d;color:#fff}
.astro-evp__form{background:#fff;border-radius:14px;box-shadow:0 2px 16px rgba(30,21,18,.07);padding:30px 28px 34px}
.astro-evp__h2{font-family:'Playfair Display',serif;font-size:clamp(24px,3vw,32px);font-weight:700;color:#2c2420;margin:0 0 6px}
.astro-evp__fs{border:none;border-top:1px solid #ece3d8;padding:22px 0 4px;margin:0}
.astro-evp__fs:first-of-type{border-top:none}
.astro-evp__legend{font-family:'Playfair Display',serif;font-size:19px;font-weight:700;color:#9a2d2d;padding:0;margin:0 0 16px}
.astro-evp__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px 18px;margin:0 0 16px}
.astro-evp__f{display:flex;flex-direction:column;font-size:14px;font-weight:600;color:#3d3530;gap:5px}
.astro-evp__f[hidden]{display:none}
.astro-evp__f>input,.astro-evp__f>select,.astro-evp__f>textarea{margin-top:auto}
.astro-evp__f--wide{grid-column:1 / -1}
.astro-evp small{font-size:12.5px;font-weight:400;color:#6b5c52;line-height:1.4}
.astro-evp__f input,.astro-evp__f select,.astro-evp__f textarea{font-family:inherit;font-size:16px;font-weight:400;color:#2c2420;padding:11px 12px;border:1px solid #cfc3b4;border-radius:8px;background:#fdfbf8;min-height:46px;transition:border-color .15s,box-shadow .15s}
.astro-evp__f input:focus,.astro-evp__f select:focus,.astro-evp__f textarea:focus{outline:none;border-color:#9a2d2d;box-shadow:0 0 0 3px rgba(154,45,45,.14)}
.astro-evp__f input:user-invalid,.astro-evp__f select:user-invalid{border-color:#c62828}
.astro-evp__q{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 18px;background:#f7f3ef;border-radius:10px;padding:14px 16px;margin:0 0 16px}
.astro-evp__qt{font-size:14px;font-weight:600;color:#3d3530;flex:1;min-width:220px;display:flex;flex-direction:column;gap:3px}
.astro-evp__radios{display:flex;flex-wrap:wrap;gap:6px 20px;font-size:15px;color:#2c2420;font-weight:600}
.astro-evp__radios label{display:inline-flex;align-items:center;gap:8px;cursor:pointer;min-height:40px}
.astro-evp__radios input{width:20px;height:20px;accent-color:#9a2d2d}
.astro-evp [data-if][hidden]{display:none}
.astro-evp__group{margin:0 0 6px}
.astro-evp__gt{font-size:14px;font-weight:700;color:#2c2420;margin:0 0 10px}
.astro-evp__nav{display:flex;justify-content:space-between;gap:12px;margin:26px 0 0}
.astro-evp__nav .astro-evp__btn:only-child{margin-left:auto}
.astro-evp__btn{min-height:50px;padding:12px 28px;border:2px solid #9a2d2d;border-radius:50px;background:#9a2d2d;color:#fff;font-size:16px;font-weight:600;cursor:pointer;font-family:inherit;transition:background .2s}
.astro-evp__btn:hover{background:#7e2424;border-color:#7e2424}
.astro-evp__btn--ghost{background:#fff;color:#9a2d2d}
.astro-evp__btn--ghost:hover{background:#f7ecec;color:#7e2424}
.astro-evp__btn:disabled{opacity:.65;cursor:default}
.astro-evp__btn:focus-visible{outline:3px solid #f3b8b8;outline-offset:2px}
.astro-evp__hint{font-size:14px;color:#6b5c52;margin:-8px 0 14px}
.astro-evp__privacy{font-size:13.5px;color:#6b5c52;line-height:1.55;margin:6px 0 0}
.astro-evp__privacy a{color:#9a2d2d}
.astro-evp__req{font-size:13px;color:#6b5c52;margin:14px 0 0}
.astro-evp__msg{padding:14px 16px;border-radius:8px;margin:16px 0 0;font-size:15px;line-height:1.5}
.astro-evp__done{background:#fff;border-radius:14px;padding:40px 28px;text-align:center;box-shadow:0 2px 16px rgba(30,21,18,.07)}
.astro-evp__done p{font-size:17px;color:#3d3530;margin:10px 0 0}
.astro-evp__hp{position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden}
/* Mit Skript: nur der aktuelle Schritt ist sichtbar */
.astro-evp--js .astro-evp__step{display:none}
.astro-evp--js .astro-evp__step.is-active{display:block}
.astro-evp:not(.astro-evp--js) .astro-evp__steps,.astro-evp:not(.astro-evp--js) [data-go]{display:none}
.astro-evp:not(.astro-evp--js) .astro-evp__step+.astro-evp__step{margin-top:36px;border-top:2px solid #ece3d8;padding-top:30px}
@media(max-width:600px){
  .astro-evp{padding:24px 0 52px}
  .astro-evp__inner{padding:0 16px}
  .astro-evp__form{padding:22px 16px 26px}
  .astro-evp__grid{grid-template-columns:1fr}
  .astro-evp__steps{gap:6px}
  .astro-evp__steps li{flex-direction:column;gap:4px;padding:8px 6px;font-size:12.5px;text-align:center}
  .astro-evp__nav{flex-direction:column-reverse}
  .astro-evp__btn{width:100%}
}
</style>

<script>
(function(){
  const root = document.getElementById('evp');
  const form = document.getElementById('astro-evp-form');
  if(!root || !form) return;
  root.classList.add('astro-evp--js');

  const steps = Array.from(form.querySelectorAll('.astro-evp__step'));
  const dots  = Array.from(document.querySelectorAll('#astro-evp-steps li'));
  const msg   = document.getElementById('astro-evp-msg');
  const btn   = form.querySelector('.astro-evp__submit');
  let cur = 1;

  // Anti-Spam: Ladezeitpunkt für den Zeit-Check im Backend (evp-anmeldung.ts)
  document.getElementById('astro-evp-ts').value = String(Date.now());

  // Bedingte Felder: data-if="feld=Wert|Wert2"
  function updateConditions(){
    form.querySelectorAll('[data-if]').forEach(function(el){
      const parts = el.getAttribute('data-if').split('=');
      const name = parts[0], allowed = parts.slice(1).join('=').split('|');
      const ctl = form.elements[name];
      let val = '';
      if(ctl instanceof RadioNodeList) val = ctl.value;
      else if(ctl) val = ctl.value;
      const show = allowed.indexOf(val) !== -1;
      // verschachtelte Bedingungen: nur anzeigen, wenn alle Eltern-Container sichtbar sind
      el.hidden = !show;
    });
    // Felder in ausgeblendeten Containern deaktivieren (werden nicht geprüft/gesendet)
    form.querySelectorAll('input,select,textarea').forEach(function(i){
      if(i.name === 'webseite' || i.name === 'astro_ts') return;
      i.disabled = !!i.closest('[data-if][hidden]');
    });
  }
  form.addEventListener('change', updateConditions);
  updateConditions();

  function show(n, scroll){
    cur = n;
    steps.forEach(function(s){ s.classList.toggle('is-active', Number(s.dataset.step) === n); });
    dots.forEach(function(d){
      const k = Number(d.dataset.step);
      d.classList.toggle('is-active', k === n);
      d.classList.toggle('is-done', k < n);
    });
    if(scroll !== false) root.scrollIntoView({ block: 'start' });
  }

  function validStep(n){
    const step = steps[n - 1];
    const fields = Array.from(step.querySelectorAll('input,select,textarea')).filter(function(f){ return !f.disabled; });
    for(const f of fields){ if(!f.checkValidity()){ f.reportValidity(); return false; } }
    return true;
  }

  form.addEventListener('click', function(e){
    const b = e.target.closest('[data-go]');
    if(!b) return;
    if(b.dataset.go === 'next'){ if(validStep(cur)) show(cur + 1); }
    else show(cur - 1);
  });

  function setMsg(ok, text){
    msg.hidden = false;
    msg.style.background = ok ? '#e8f5e9' : '#ffebee';
    msg.style.border     = ok ? '1px solid #a5d6a7' : '1px solid #ef9a9a';
    msg.style.color      = ok ? '#2e7d32' : '#c62828';
    msg.textContent = (ok ? '✓ ' : '⚠ ') + text;
  }

  form.addEventListener('submit', async function(e){
    e.preventDefault();
    if(!validStep(3)) return;
    btn.disabled = true;
    btn.textContent = 'Wird gesendet…';
    try {
      updateConditions();
      const res = await fetch('/api/evp-anmeldung', { method: 'POST', body: new FormData(form) }).then(function(r){ return r.json(); });
      if(res && res.success){
        form.hidden = true;
        document.getElementById('astro-evp-steps').hidden = true;
        document.getElementById('astro-evp-done').hidden = false;
        root.scrollIntoView({ block: 'start' });
      } else {
        setMsg(false, (res && res.data) || 'Fehler beim Senden. Bitte versuchen Sie es erneut.');
        btn.disabled = false; btn.textContent = 'Angaben versenden';
      }
    } catch(err) {
      setMsg(false, 'Verbindungsfehler. Bitte versuchen Sie es erneut oder rufen Sie uns an.');
      btn.disabled = false; btn.textContent = 'Angaben versenden';
    }
  });

  show(1, false);
})();
</script>
