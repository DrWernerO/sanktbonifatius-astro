---
// Hauptinhalt Kita St. Aposteln — Info-Strip, Angebot, Haus, Tagesablauf, Öffnungszeiten, Anmeldung, Pädagogik
---

<!-- INFO STRIP -->
<section class="astro-kap-strip astro-kap-sec" id="astro-kap-strip">
  <div class="astro-kap-strip__in">
    <div class="astro-kap-strip__item">
      <div class="astro-kap-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div class="astro-kap-strip__label">Alter</div>
      <div class="astro-kap-strip__value">3 &ndash; 6 Jahre</div>
    </div>
    <div class="astro-kap-strip__item">
      <div class="astro-kap-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div class="astro-kap-strip__label">Gruppen</div>
      <div class="astro-kap-strip__value">4 Stammgruppen</div>
    </div>
    <div class="astro-kap-strip__item">
      <div class="astro-kap-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </div>
      <div class="astro-kap-strip__label">Ort</div>
      <div class="astro-kap-strip__value">Frankfurt-Sachsenhausen</div>
    </div>
    <div class="astro-kap-strip__item">
      <div class="astro-kap-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12l2 2 4-4"/></svg>
      </div>
      <div class="astro-kap-strip__label">Konzept</div>
      <div class="astro-kap-strip__value">teiloffen</div>
    </div>
  </div>
</section>

<!-- BETREUUNGSANGEBOT -->
<section class="astro-kap-konzept astro-kap-sec" id="astro-kap-angebot">
  <div class="astro-kap-konzept__in">
    <div class="astro-kap-konzept__text">
      <p class="astro-kap-eyebrow">Unser Angebot</p>
      <h2 class="astro-kap-konzept__h2">Unser Betreuungsangebot</h2>
      <p>Wir betreuen in unserer Kita 80 Kinder im Alter von drei bis sechs Jahren in vier Kindergartengruppen. Wir arbeiten in einem teiloffenen Konzept. Zus&auml;tzlich zu den Stammgruppen (Haie, Drachen, Igel und Piraten) k&ouml;nnen die Kinder alle Funktionsr&auml;ume besuchen.</p>
    </div>
    <div class="astro-kap-konzept__cards">
      <div class="astro-kap-konzept__card"><h4>80 Kinder</h4><p>3 bis 6 Jahre, vier Stammgruppen: Haie, Drachen, Igel und Piraten.</p></div>
      <div class="astro-kap-konzept__card"><h4>Ganztagspl&auml;tze</h4><p>Betreuung montags bis freitags von 7:30 bis 17:00 Uhr.</p></div>
      <div class="astro-kap-konzept__card"><h4>teiloffenes Konzept</h4><p>Feste Stammgruppen mit freiem Zugang zu allen Funktionsr&auml;umen.</p></div>
    </div>
  </div>
</section>

<!-- UNSER HAUS -->
<section class="astro-kap-haus astro-kap-sec" id="astro-kap-haus">
  <div class="astro-kap-haus__in">
    <div class="astro-kap-haus__head">
      <p class="astro-kap-eyebrow">Unser Haus</p>
      <h2 class="astro-kap-haus__h2">Unser Haus &amp; Au&szlig;engel&auml;nde</h2>
    </div>
    <div class="astro-kap-haus__grid">
      <div class="astro-kap-haus__item">
        <div class="astro-kap-haus__icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2v-4M9 21H5a2 2 0 0 1-2-2v-4m0 0h18"/></svg></div>
        <div class="astro-kap-haus__title">Forscherraum</div>
        <p class="astro-kap-haus__text">Experimente, Entdeckungen und naturwissenschaftliche Bildung</p>
      </div>
      <div class="astro-kap-haus__item">
        <div class="astro-kap-haus__icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12l2 2 4-4"/></svg></div>
        <div class="astro-kap-haus__title">Turnraum</div>
        <p class="astro-kap-haus__text">T&auml;gliche Bewegungsangebote f&uuml;r gro&szlig;motorische Entwicklung</p>
      </div>
      <div class="astro-kap-haus__item">
        <div class="astro-kap-haus__icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
        <div class="astro-kap-haus__title">Rollenspielraum</div>
        <p class="astro-kap-haus__text">Spielk&uuml;che, Verkleidung und kreative Rollenspiele</p>
      </div>
      <div class="astro-kap-haus__item">
        <div class="astro-kap-haus__icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg></div>
        <div class="astro-kap-haus__title">Bauraum</div>
        <p class="astro-kap-haus__text">Lego, Duplo, Holzbausteine und konstruktives Spielen</p>
      </div>
      <div class="astro-kap-haus__item">
        <div class="astro-kap-haus__icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg></div>
        <div class="astro-kap-haus__title">Au&szlig;engel&auml;nde</div>
        <p class="astro-kap-haus__text">Gro&szlig;es Spielgel&auml;nde mit vielf&auml;ltigen Spiel- und Bewegungsm&ouml;glichkeiten</p>
      </div>
    </div>
  </div>
</section>

<!-- TAGESABLAUF -->
<section class="astro-kap-tages astro-kap-sec" id="astro-kap-tagesablauf">
  <div class="astro-kap-tages__in">
    <div class="astro-kap-tages__head">
      <p class="astro-kap-eyebrow">Ein Tag bei uns</p>
      <h2 class="astro-kap-tages__h2">Typischer Tagesablauf</h2>
      <p class="astro-kap-tages__sub">Wiederkehrende Rituale geben den Kindern Sicherheit und Orientierung. Im Alltag k&ouml;nnen die Uhrzeiten leicht abweichen.</p>
    </div>
    <div class="astro-kap-tages__panel">
      <div class="astro-kap-tages__row"><div class="astro-kap-tages__time">7:30 Uhr</div><div class="astro-kap-tages__act">Ankommen und Freispiel in den Stammgruppen</div></div>
      <div class="astro-kap-tages__row"><div class="astro-kap-tages__time">9:00 Uhr</div><div class="astro-kap-tages__act">Morgenkreis: Austausch, Planung, Einwahl in Funktionsr&auml;ume</div></div>
      <div class="astro-kap-tages__row"><div class="astro-kap-tages__time">10:30 Uhr</div><div class="astro-kap-tages__act">Fr&uuml;hst&uuml;ckssnack: Obst und Gem&uuml;se f&uuml;r alle Kinder</div></div>
      <div class="astro-kap-tages__row"><div class="astro-kap-tages__time">11:00 Uhr</div><div class="astro-kap-tages__act">Au&szlig;engel&auml;nde: Toben, Forschen, Spielen</div></div>
      <div class="astro-kap-tages__row"><div class="astro-kap-tages__time">12:00 &ndash; 14:05 Uhr</div><div class="astro-kap-tages__act">Mittagessen und Stille Stunde: Rituale, Ruhephase, Schlafen oder stille Besch&auml;ftigung</div></div>
      <div class="astro-kap-tages__row"><div class="astro-kap-tages__time">ab 14:15 Uhr</div><div class="astro-kap-tages__act">Flexible Abholzeit, Funktionsr&auml;ume, Angebote</div></div>
      <div class="astro-kap-tages__row"><div class="astro-kap-tages__time">15:30 &ndash; 16:00 Uhr</div><div class="astro-kap-tages__act">Snack: gemeinsame Mahlzeit</div></div>
      <div class="astro-kap-tages__row"><div class="astro-kap-tages__time">17:00 Uhr</div><div class="astro-kap-tages__act">Kita schlie&szlig;t.</div></div>
    </div>
  </div>
</section>

<!-- ÖFFNUNGSZEITEN -->
<section class="astro-kap-zeiten astro-kap-sec" id="astro-kap-zeiten">
  <div class="astro-kap-zeiten__in">
    <div class="astro-kap-zeiten__text">
      <p class="astro-kap-eyebrow">Erreichbarkeit</p>
      <h2 class="astro-kap-zeiten__h2">Unsere &Ouml;ffnungs- und Schlie&szlig;zeiten</h2>
      <p class="astro-kap-zeiten__p">Unsere Schlie&szlig;zeiten f&uuml;r das laufende Jahr entnehmen Sie bitte unserem Schlie&szlig;zeitenkalender.</p>
      <a href="https://www.sanktbonifatius.de/wp-content/uploads/2026/05/Schliesszeitenkalender-2026-Kita-St.-Aposteln-Stand-Mai-2026.pdf"
         target="_blank" rel="noopener" class="astro-kap-zeiten__dl">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Schlie&szlig;zeitenkalender 2026
      </a>
    </div>
    <div class="astro-kap-zeiten__grid">
      <div class="astro-kap-zeiten__row">
        <span class="astro-kap-zeiten__day">Montag &ndash; Freitag</span>
        <span class="astro-kap-zeiten__time">7:30 &ndash; 17:00 Uhr</span>
      </div>
      <div class="astro-kap-zeiten__row">
        <span class="astro-kap-zeiten__day">Samstag &amp; Sonntag</span>
        <span class="astro-kap-zeiten__time">Geschlossen</span>
      </div>
    </div>
  </div>
</section>

<!-- INTERESSE / ANMELDUNG -->
<section class="astro-kap-anmeld astro-kap-sec" id="astro-kap-anmeld">
  <div class="astro-kap-anmeld__in">
    <p class="astro-kap-eyebrow" style="text-align:center">Jetzt kennenlernen</p>
    <h2 class="astro-kap-anmeld__h2">Sie haben Interesse an einem Platz?</h2>
    <p class="astro-kap-anmeld__lead">Wir freuen uns, wenn Sie zu einem Informationsnachmittag vorbeikommen und wir Sie pers&ouml;nlich kennenlernen. Bei einer F&uuml;hrung durch die Kita bekommen Sie einen ersten Eindruck von unserer Arbeit.</p>
    <p class="astro-kap-anmeld__lead" style="margin-top:8px">Besichtigungstermine sind jeden 3. Mittwoch im Monat um 17:00 Uhr in der Kita St. Aposteln. Termine 2026: 15.07., 19.08., 16.09., 21.10., 18.11.</p>
    <div class="astro-kap-anmeld__ctas">
      <a href="#astro-kap-kontakt" class="astro-kap-btn astro-kap-btn--accent">Besichtigungstermin anfragen</a>
      <a href="https://www.kindernetfrankfurt.de/start?0" target="_blank" rel="noopener" class="astro-kap-btn astro-kap-btn--outline">Anmeldung &uuml;ber Kindernet Frankfurt &#8599;</a>
    </div>
  </div>
</section>

<!-- PÄDAGOGIK & DOKUMENTE -->
<section class="astro-kap-paed astro-kap-sec" id="astro-kap-paed">
  <div class="astro-kap-paed__in">
    <div class="astro-kap-paed__head">
      <p class="astro-kap-eyebrow">Transparenz &amp; Qualit&auml;t</p>
      <h2 class="astro-kap-paed__h2">Unsere p&auml;dagogische Arbeit</h2>
      <p class="astro-kap-paed__lead">Gerne m&ouml;chten wir Ihnen unsere p&auml;dagogische Arbeit vorstellen. Alle Dokumente stehen zum Download bereit.</p>
    </div>
    <div class="astro-kap-paed__grid">
      <div class="astro-kap-paed__card">
        <div class="astro-kap-paed__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <h3>Unsere Konzeption</h3>
        <p>Kommt in K&uuml;rze.</p>
      </div>
      <div class="astro-kap-paed__card">
        <div class="astro-kap-paed__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <h3>Schlie&szlig;zeiten 2026</h3>
        <a href="https://www.sanktbonifatius.de/wp-content/uploads/2026/05/Schliesszeitenkalender-2026-Kita-St.-Aposteln-Stand-Mai-2026.pdf"
           target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          PDF herunterladen
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
/* STRIP */
.astro-kap-strip { background: var(--bf-bg); padding: 48px 24px; }
.astro-kap-strip__in {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 20px;
}
.astro-kap-strip__item { text-align: center; background: #fff; border-radius: 10px; padding: 20px 14px; border: 1px solid var(--bf-border); }
.astro-kap-strip__icon { color: var(--bf-accent); margin-bottom: 8px; display: flex; justify-content: center; }
.astro-kap-strip__label { font-family: 'Futura LT W01 Book', Futura, sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--bf-ink-60); margin-bottom: 6px; }
.astro-kap-strip__value { font-family: 'Playfair Display', Georgia, serif; font-size: 15px; color: var(--bf-ink); line-height: 1.4; font-weight: 700; }

/* KONZEPT */
.astro-kap-konzept { background: var(--bf-bg); padding: 80px 24px; }
.astro-kap-konzept__in { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start; }
.astro-kap-konzept__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: var(--bf-ink); margin: 0 0 16px; }
.astro-kap-konzept__text p { font-size: 15.5px; line-height: 1.75; color: var(--bf-ink-60); }
.astro-kap-konzept__cards { display: flex; flex-direction: column; gap: 14px; }
.astro-kap-konzept__card { background: #fff; border: 1px solid var(--bf-border); border-radius: var(--bf-radius); padding: 18px 22px; border-left: 3px solid var(--bf-accent); }
.astro-kap-konzept__card h4 { font-family: 'Playfair Display', Georgia, serif; font-size: 15px; font-weight: 700; color: var(--bf-ink); margin: 0 0 4px; }
.astro-kap-konzept__card p { font-size: 14px; line-height: 1.6; color: var(--bf-ink-60); margin: 0; }

/* HAUS */
.astro-kap-haus { background: #fff; padding: 80px 24px; }
.astro-kap-haus__in { max-width: 1100px; margin: 0 auto; }
.astro-kap-haus__head { text-align: center; margin-bottom: 48px; }
.astro-kap-haus__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 3vw, 38px); font-weight: 700; color: var(--bf-ink); margin: 0; }
.astro-kap-haus__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.astro-kap-haus__item { background: var(--bf-bg); border-radius: var(--bf-radius); padding: 24px; text-align: center; display: flex; flex-direction: column; align-items: center; }
.astro-kap-haus__icon { color: var(--bf-accent); margin-bottom: 10px; display: flex; justify-content: center; }
.astro-kap-haus__title { font-family: 'Playfair Display', Georgia, serif; font-size: 15px; font-weight: 700; color: var(--bf-ink); margin: 0 0 6px; }
.astro-kap-haus__text { font-size: 13px; color: var(--bf-ink-60); line-height: 1.5; margin: 0; }
@media (max-width: 640px) { .astro-kap-haus__grid { grid-template-columns: repeat(2, 1fr); } }

/* TAGESABLAUF */
.astro-kap-tages { background: var(--bf-bg); padding: 80px 24px; }
.astro-kap-tages__in { max-width: 900px; margin: 0 auto; }
.astro-kap-tages__head { text-align: center; margin-bottom: 40px; }
.astro-kap-tages__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: var(--bf-ink); margin: 0 0 10px; }
.astro-kap-tages__sub { font-size: 15px; color: var(--bf-ink-60); max-width: 640px; margin: 0 auto; line-height: 1.65; }
.astro-kap-tages__panel { background: #fff; border-radius: var(--bf-radius); border: 1px solid var(--bf-border); overflow: hidden; }
.astro-kap-tages__row { display: grid; grid-template-columns: 150px 1fr; gap: 16px; padding: 11px 24px; border-bottom: 1px solid var(--bf-border); align-items: start; }
.astro-kap-tages__row:last-child { border-bottom: none; }
.astro-kap-tages__time { font-family: 'Playfair Display', Georgia, serif; font-weight: 700; color: var(--bf-accent); font-size: 14px; padding-top: 2px; }
.astro-kap-tages__act { font-size: 14px; color: var(--bf-ink); line-height: 1.6; }
@media (max-width: 600px) { .astro-kap-tages__row { grid-template-columns: 1fr; gap: 4px; padding: 14px 20px; } }

/* ÖFFNUNGSZEITEN */
.astro-kap-zeiten { background: var(--bf-bg-alt); padding: 72px 24px; }
.astro-kap-zeiten__in { max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
.astro-kap-zeiten__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 3vw, 34px); font-weight: 700; color: var(--bf-ink); margin: 0 0 14px; line-height: 1.2; }
.astro-kap-zeiten__p { font-size: 15.5px; color: var(--bf-ink-60); line-height: 1.75; margin: 0 0 20px; }
.astro-kap-zeiten__dl { display: inline-flex; align-items: center; gap: 7px; padding: 8px 16px; border-radius: 20px; background: var(--bf-accent); color: #fff; font-weight: 600; font-size: 13px; text-decoration: none; min-height: 34px; transition: background .2s; }
.astro-kap-zeiten__dl:hover { background: #7a2424; }
.astro-kap-zeiten__grid { background: #fff; border-radius: var(--bf-radius); padding: 24px 28px; border: 1px solid var(--bf-border); }
.astro-kap-zeiten__row { display: flex; justify-content: space-between; align-items: center; padding: 11px 0; border-bottom: 1px solid var(--bf-border); font-size: 15px; }
.astro-kap-zeiten__row:last-child { border-bottom: none; }
.astro-kap-zeiten__day { color: var(--bf-ink); font-weight: 600; }
.astro-kap-zeiten__time { color: var(--bf-ink-60); }
@media (max-width: 760px) { .astro-kap-zeiten__in { grid-template-columns: 1fr; gap: 28px; } }

/* ANMELDUNG */
.astro-kap-anmeld { background: #fff; padding: 80px 24px; }
.astro-kap-anmeld__in { max-width: 900px; margin: 0 auto; text-align: center; }
.astro-kap-anmeld__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: var(--bf-ink); margin: 0 0 16px; line-height: 1.2; }
.astro-kap-anmeld__lead { font-size: 16px; color: var(--bf-ink-60); max-width: 720px; margin: 0 auto; line-height: 1.75; }
.astro-kap-anmeld__ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-top: 32px; }
.astro-kap-btn--outline { background: transparent; color: var(--bf-accent); border: 2px solid var(--bf-accent); padding: 13px 26px; border-radius: 32px; font-weight: 700; font-size: 14.5px; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; transition: all .2s; }
.astro-kap-btn--outline:hover { background: var(--bf-accent); color: #fff; }

/* PÄDAGOGIK */
.astro-kap-paed { background: var(--bf-bg); padding: 80px 24px; }
.astro-kap-paed__in { max-width: 1000px; margin: 0 auto; }
.astro-kap-paed__head { text-align: center; margin-bottom: 44px; }
.astro-kap-paed__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: var(--bf-ink); margin: 0 0 12px; }
