---
// „Nächstes Treffen" — Präfix `astro-btnext`. Zeigt automatisch den nächsten Better-Together-
// Termin aus dem WP-Terminkalender (Termine = erlaubte Live-Daten, Regel 0), clientseitig über
// den /wp-proxy wie EventCalendar.astro — so stimmt der Hinweis auch ohne Rebuild jeden Tag.
// Erkennung: Kategorie BonFamily (2586) + Titel beginnt mit „Better together" (eigene
// Kategorie gibt es nicht). Kein Termin → Hinweis „wird gerade geplant" mit Kontakt-Link.
// Weißer Hintergrund = setzt den Abschnitt „Darum geht's" fort (Bänder-Prinzip).
// „In meinen Kalender eintragen" erzeugt clientseitig eine .ics-Datei aus denselben Termindaten.
// Karte ist ein <div> mit gestrecktem Haupt-Link (::after), damit der Kalender-Button daneben
// ein eigenes, klickbares Element sein kann (keine verschachtelten Links).
---
<section class="astro-btnext" data-astro-btnext>
  <div class="astro-btnext__inner">
    <div class="astro-btnext__card is-loading">
      <div class="astro-btnext__media">
        <span class="astro-btnext__date" hidden><span class="astro-btnext__day"></span><span class="astro-btnext__month"></span></span>
      </div>
      <div class="astro-btnext__body">
        <span class="astro-btnext__eyebrow">Nächstes Treffen</span>
        <h2 class="astro-btnext__title">Termin wird geladen …</h2>
        <p class="astro-btnext__meta"></p>
        <p class="astro-btnext__sub"></p>
        <div class="astro-btnext__actions">
          <a class="astro-btnext__btn" href="/bonfamily/#bonfamily-termine">Details &amp; Anmeldung<span aria-hidden="true">→</span></a>
          <button type="button" class="astro-btnext__ics" hidden>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="12" y1="14" x2="12" y2="19"/><line x1="9.5" y1="16.5" x2="14.5" y2="16.5"/></svg>
            In meinen Kalender eintragen
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const WP = '/wp-proxy/wp-json/wp/v2';
  const KATEGORIE = 2586; // BonFamily
  const TITEL = /^\s*better[\s-]*together/i;
  const TAGE = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
  const MONATE = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];

  type Termin = { slug: string; link: string; title: { rendered: string }; event_meta?: Record<string, string> };

  const datum = (s: string) => new Date(`${s.slice(0, 4)}-${s.slice(4, 6)}-${s.slice(6, 8)}`);
  const heute = () => { const d = new Date(); return `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}`; };
  const pfad = (url: string) => { try { return new URL(url).pathname; } catch { return url; } };
  const text = (html: string) => { const t = document.createElement('textarea'); t.innerHTML = html; return t.value; };

  async function naechsterTermin(): Promise<Termin | null> {
    const res = await fetch(`${WP}/event?per_page=100&event-category=${KATEGORIE}&_fields=slug,link,title,event_meta`);
    if (!res.ok) throw new Error(String(res.status));
    const ab = heute();
    const liste: Termin[] = await res.json();
    return liste
      .filter((e) => e.event_meta?.start_date && e.event_meta.start_date >= ab && TITEL.test(text(e.title.rendered)))
      .sort((a, b) => a.event_meta!.start_date.localeCompare(b.event_meta!.start_date))[0] ?? null;
  }

  async function bild(id?: string) {
    if (!id) return null;
    try {
      const d = await (await fetch(`${WP}/media/${id}?_fields=source_url`)).json();
      return d.source_url ? d.source_url.replace(/^https?:\/\/(?:www|dev)\.sanktbonifatius\.de/, '/wp-proxy') : null;
    } catch { return null; }
  }


  // ---- Kalender-Datei (.ics, RFC 5545) ----
  const icsText = (v: string) => v.replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\r?\n/g, '\\n');
  const falten = (zeile: string) => {
    // Zeilen > 75 Bytes umbrechen (Folgezeile beginnt mit Leerzeichen)
    const enc = new TextEncoder(); const teile: string[] = []; let akt = '';
    for (const z of zeile) {
      if (enc.encode(akt + z).length > (teile.length ? 74 : 75)) { teile.push(akt); akt = ''; }
      akt += z;
    }
    teile.push(akt);
    return teile.join('\r\n ');
  };
  // „15:00-18:00 Uhr" / „15 Uhr" / „15.30–17 Uhr" → [start, ende] als HHMMSS, sonst null (= ganztägig)
  const zeiten = (s = ''): [string, string | null] | null => {
    const t = [...s.matchAll(/(\d{1,2})(?:[:.](\d{2}))?/g)].map((m) => m[1].padStart(2, '0') + (m[2] ?? '00') + '00');
    return t.length ? [t[0], t[1] ?? null] : null;
  };
  const plusStunden = (hhmmss: string, h: number) => String(Math.min(23, +hhmmss.slice(0, 2) + h)).padStart(2, '0') + hhmmss.slice(2);
  const naechsterTag = (yyyymmdd: string) => { const d = datum(yyyymmdd); d.setDate(d.getDate() + 1); return `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}`; };

  function icsDatei(t: Termin, titel: string, url: string) {
    const m = t.event_meta!;
    const z = zeiten(m.times);
    const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    const beschreibung = [m.subtitle ? text(m.subtitle) : '', m.times ? `Zeit: ${m.times}` : '', `Infos & Anmeldung: ${url}`].filter(Boolean).join('\n\n');
    const zeilen = [
      'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Pfarrei St. Bonifatius Frankfurt//Better Together//DE', 'CALSCALE:GREGORIAN', 'METHOD:PUBLISH',
      'BEGIN:VTIMEZONE', 'TZID:Europe/Berlin',
      'BEGIN:DAYLIGHT', 'TZOFFSETFROM:+0100', 'TZOFFSETTO:+0200', 'TZNAME:CEST', 'DTSTART:19700329T020000', 'RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU', 'END:DAYLIGHT',
      'BEGIN:STANDARD', 'TZOFFSETFROM:+0200', 'TZOFFSETTO:+0100', 'TZNAME:CET', 'DTSTART:19701025T030000', 'RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU', 'END:STANDARD',
      'END:VTIMEZONE',
      'BEGIN:VEVENT',
      `UID:${t.slug}-${m.start_date}@sanktbonifatius.de`,
      `DTSTAMP:${stamp}`,
      ...(z
        ? [`DTSTART;TZID=Europe/Berlin:${m.start_date}T${z[0]}`, `DTEND;TZID=Europe/Berlin:${m.end_date || m.start_date}T${z[1] ?? plusStunden(z[0], 2)}`]
        : [`DTSTART;VALUE=DATE:${m.start_date}`, `DTEND;VALUE=DATE:${naechsterTag(m.end_date || m.start_date)}`]),
      `SUMMARY:${icsText(text(t.title.rendered) || `Better Together – ${titel}`)}`,
      ...(m.location ? [`LOCATION:${icsText(m.location)}`] : []),
      `DESCRIPTION:${icsText(beschreibung)}`,
      `URL:${url}`,
      'BEGIN:VALARM', 'ACTION:DISPLAY', `DESCRIPTION:${icsText(titel)}`, 'TRIGGER:-P1D', 'END:VALARM',
      'END:VEVENT', 'END:VCALENDAR',
    ];
    return zeilen.map(falten).join('\r\n') + '\r\n';
  }

  function herunterladen(inhalt: string, name: string) {
    const blob = new Blob([inhalt], { type: 'text/calendar;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }

  document.querySelectorAll<HTMLElement>('[data-astro-btnext]').forEach(async (sec) => {
    const card = sec.querySelector<HTMLElement>('.astro-btnext__card')!;
    const haupt = sec.querySelector<HTMLAnchorElement>('.astro-btnext__btn')!;
    const ics = sec.querySelector<HTMLButtonElement>('.astro-btnext__ics')!;
    const $ = (c: string) => sec.querySelector<HTMLElement>(`.astro-btnext__${c}`)!;
    const leer = () => {
      card.classList.add('is-empty');
      haupt.href = '#better-together-kontakt';
      $('title').textContent = 'Der nächste Termin wird gerade geplant';
      $('sub').textContent = 'Schaut bald wieder vorbei – oder meldet euch, dann sagen wir euch Bescheid, sobald es losgeht.';
      $('btn').firstChild!.textContent = 'Kontakt aufnehmen';
    };
    try {
      const t = await naechsterTermin();
      if (!t) return leer();
      const m = t.event_meta!;
      const d = datum(m.start_date);
      haupt.href = pfad(t.link);
      // „Better together – Martinsgänse backen" → „Martinsgänse backen"
      const titel = text(t.title.rendered).replace(/^\s*better[\s-]*together\s*[–—:-]?\s*/i, '') || 'Better Together';
      $('title').textContent = titel;
      const absolut = new URL(pfad(t.link), 'https://sanktbonifatius.de').href;
      ics.hidden = false;
      ics.addEventListener('click', () => herunterladen(icsDatei(t, titel, absolut), `${t.slug}.ics`));
      $('meta').textContent = [`${TAGE[d.getDay()]}, ${d.getDate()}. ${MONATE[d.getMonth()]} ${d.getFullYear()}`, m.times, m.location].filter(Boolean).join(' · ');
      $('sub').textContent = m.subtitle ? text(m.subtitle) : '';
      $('day').textContent = String(d.getDate());
      $('month').textContent = MONATE[d.getMonth()].slice(0, 3);
      $('date').hidden = false;
      const url = await bild(m.image);
      if (url) $('media').style.backgroundImage = `url("${url}")`;
    } catch {
      leer();
    } finally {
      card.classList.remove('is-loading');
    }
  });
</script>

<style is:global>
.astro-btnext{background:#fff;padding:0 40px 72px}
.astro-btnext__inner{max-width:900px;margin:0 auto}
.astro-btnext__card{position:relative;display:grid;grid-template-columns:minmax(220px,2fr) 3fr;border-radius:18px;overflow:hidden;text-decoration:none;color:inherit;background:#fff;border:1px solid #e0d8cf;box-shadow:0 10px 32px rgba(30,21,18,.08);transition:box-shadow .2s ease,transform .2s ease}
.astro-btnext__card:hover{box-shadow:0 14px 40px rgba(30,21,18,.14);transform:translateY(-2px)}
.astro-btnext__media{position:relative;min-height:220px;background:linear-gradient(135deg,#4a2e1a 0%,#9a2d2d 100%) center/cover no-repeat}
.astro-btnext__date{position:absolute;top:16px;left:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;width:64px;height:64px;border-radius:14px;background:#fff;box-shadow:0 4px 14px rgba(0,0,0,.18);line-height:1}
.astro-btnext__date[hidden]{display:none}
.astro-btnext__day{font-family:'Playfair Display',Georgia,serif;font-size:26px;font-weight:700;color:#9a2d2d}
.astro-btnext__month{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#5a4a3a;margin-top:4px}
.astro-btnext__body{padding:30px 32px;display:flex;flex-direction:column;gap:8px;justify-content:center}
.astro-btnext__eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#c5a55a;font-weight:700}
.astro-btnext__title{font-family:'Playfair Display',Georgia,serif;font-size:clamp(24px,2.8vw,32px);font-weight:700;color:#2c2420;margin:0;line-height:1.2}
.astro-btnext__meta{font-size:15px;color:#9a2d2d;font-weight:600;margin:0}
.astro-btnext__meta:empty,.astro-btnext__sub:empty{display:none}
.astro-btnext__sub{font-size:15.5px;line-height:1.6;color:#5a4a3a;margin:4px 0 0}
.astro-btnext__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:14px}
.astro-btnext__btn{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:50px;background:#9a2d2d;color:#fff;font-size:15px;font-weight:600;text-decoration:none;transition:background .18s}
.astro-btnext__btn::after{content:'';position:absolute;inset:0;border-radius:18px}
.astro-btnext__btn:focus-visible{outline:3px solid #c5a55a;outline-offset:3px}
.astro-btnext__ics{position:relative;z-index:1;display:inline-flex;align-items:center;gap:8px;padding:11px 20px;border-radius:50px;border:1.5px solid #9a2d2d;background:#fff;color:#9a2d2d;font:inherit;font-size:15px;font-weight:600;cursor:pointer;transition:background .18s,color .18s}
.astro-btnext__ics:hover{background:#9a2d2d;color:#fff}
.astro-btnext__ics[hidden]{display:none}
.astro-btnext__card:hover .astro-btnext__btn{background:#7d2424}
.astro-btnext__card.is-loading .astro-btnext__title{color:#b5a898}
.astro-btnext__card.is-loading .astro-btnext__btn{visibility:hidden}
.astro-btnext__card.is-empty .astro-btnext__media{min-height:160px}
@media(max-width:700px){
  .astro-btnext{padding:0 20px 52px}
  .astro-btnext__card{grid-template-columns:1fr}
  .astro-btnext__media{min-height:200px}
  .astro-btnext__body{padding:24px 22px}
}
</style>
