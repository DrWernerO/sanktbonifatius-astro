---
// Kita-Übersicht Hero — alle 5 Kitas der Pfarrei Sankt Bonifatius
// CSS-Präfix: astro-ki-
// Willkommenstext liegt in KitaIndexIntro.astro (Feedback Sandra 12.08.2026: stand doppelt).
---
<div class="astro-ki-root">
  <section class="astro-ki-hero">
    <div class="astro-ki-hero__in">
      <p class="astro-ki-eyebrow">Unsere Kitas</p>
      <h1 class="astro-ki-hero__h1">F&uuml;nf Orte.<br>Eine Gemeinschaft.</h1>
      <p class="astro-ki-hero__lead">Von Sachsenhausen bis Oberrad &mdash; in unseren f&uuml;nf Kindertagesst&auml;tten begleiten wir Kinder auf ihrem ganz eigenen Weg.</p>
      <div class="astro-ki-hero__ctas">
        <a href="#astro-ki-kitas" class="astro-ki-btn astro-ki-btn--gold">Kitas entdecken</a>
        <a href="/kitas/stellenboerse/" class="astro-ki-btn astro-ki-btn--ghost">Stellenb&ouml;rse</a>
      </div>
    </div>
  </section>
</div>

<style is:global>
:root {
  --bf-bg: #f7f3ef;
  --bf-bg-alt: #ede4d5;
  --bf-ink: #1e1512;
  --bf-ink-60: #6b5c52;
  --bf-accent: #9a2d2d;
  --bf-gold: #b88a3a;
  --bf-border: #e0d8cf;
  --bf-radius: 14px;
}
.astro-ki-root {
  width: 100vw;
  position: relative;
  left: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
}
.astro-ki-hero {
  min-height: 520px;
  display: flex;
  align-items: flex-end;
  position: relative;
  padding: 0;
  overflow: hidden;
  background: url('/uploads/2020/09/kitas_banner.jpg') center top / cover no-repeat;
}
.astro-ki-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(30,21,18,.15) 0%, rgba(30,21,18,.6) 55%, rgba(30,21,18,.92) 100%);
}
.astro-ki-hero__in {
  position: relative;
  z-index: 2;
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
  padding: 0 40px 64px;
}
.astro-ki-eyebrow {
  font-family: 'Playfair Display', Georgia, serif;
  font-style: italic;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: rgba(255,255,255,.92);
  text-shadow: 0 1px 4px rgba(0,0,0,.45);
  margin: 0 0 16px;
}
.astro-ki-hero__h1 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(34px, 5.5vw, 64px);
  font-weight: 700;
  color: #fff;
  margin: 0 0 18px;
  line-height: 1.1;
}
.astro-ki-hero__lead {
  font-family: 'Playfair Display', Georgia, serif;
  font-style: italic;
  font-size: clamp(17px, 2.2vw, 21px);
  color: #f2b429;
  text-shadow: 0 1px 4px rgba(0,0,0,.45);
  max-width: 620px;
  line-height: 1.6;
  margin: 0 0 32px;
}
.astro-ki-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }
.astro-ki-btn {
  display: inline-flex;
  align-items: center;
  padding: 13px 26px;
  border-radius: 32px;
  font-weight: 700;
  font-size: 14.5px;
  text-decoration: none;
  min-height: 44px;
  transition: all .2s;
}
.astro-ki-btn--gold { background: #f2b429; color: #1a120e; }
.astro-ki-btn--gold:hover { background: #e0a520; }
.astro-ki-btn--ghost { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.5); }
.astro-ki-btn--ghost:hover { background: rgba(255,255,255,.12); border-color: #fff; }
.astro-ki-btn--red { background: var(--bf-accent); color: #fff; }
.astro-ki-btn--red:hover { background: #7e2424; }

/* Shared */
.astro-ki-sec { width: 100vw; position: relative; left: 50%; margin-left: -50vw; margin-right: -50vw; }
[id] { scroll-margin-top: 100px; }

@media (max-width: 600px) {
  .astro-ki-hero__in { padding: 0 20px 48px; }
}
</style>
