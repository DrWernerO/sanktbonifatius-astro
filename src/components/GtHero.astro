---
// Hero „Gruppen und Treffpunkte" (A9, 2026-09-16) — Präfix `astro-gt`.
// Foto bereits lokal vorhanden (auch Hero von /ueberuns/gemeinschaft/, GemHero.astro) —
// passt inhaltlich gut: Menschen jeden Alters an einem Tisch, genau die Stimmung dieser Seite.
const bg = '/uploads/2026/04/Gemeinschaft.jpg';
---
<section class="astro-gt-hero">
  <div class="astro-gt-hero__bg" role="img"
       aria-label="Menschen verschiedener Generationen sitzen gemeinsam an einem Tisch in der Pfarrei Sankt Bonifatius"
       style={`background-image:url('${bg}')`}></div>
  <div class="astro-gt-hero__overlay"></div>
  <div class="astro-gt-hero__inner">
    <p class="astro-gt-hero__eyebrow">Pfarrei Sankt Bonifatius &middot; Frankfurt am Main</p>
    <h1 class="astro-gt-hero__title">Gruppen &amp; Treffpunkte</h1>
    <p class="astro-gt-hero__sub">
      Vom Kirchcaf&eacute; bis zum Pfadfinderlager, von der Baby Lounge bis zum BonCasino 60+ &#8211;
      f&uuml;r fast jedes Interesse und jede Lebensphase gibt es in unserer Pfarrei einen Ort zum
      Ankommen. Schauen Sie einfach mal vorbei.
    </p>
    <a class="astro-gt-hero__cta" href="#gottesdienst-glaube">Alle Angebote entdecken &#8594;</a>
  </div>
</section>

<style is:global>
.astro-gt-hero{position:relative;width:100vw;left:50%;margin-left:-50vw;margin-right:-50vw;height:min(72vh,640px);display:flex;align-items:flex-end;overflow:hidden}
.astro-gt-hero__bg{position:absolute;inset:0;background-size:cover;background-position:center 30%}
.astro-gt-hero__overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(30,21,18,.10) 0%,rgba(30,21,18,.42) 55%,rgba(30,21,18,.86) 100%)}
.astro-gt-hero__inner{position:relative;z-index:2;width:100%;max-width:1280px;margin:0 auto;padding:0 40px 56px;color:#f0e8d8}
.astro-gt-hero__eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent-gold-deco);margin:0 0 14px}
.astro-gt-hero__title{font-family:'Playfair Display',Georgia,serif;font-size:clamp(36px,5.5vw,68px);color:#fff;margin:0 0 16px;line-height:1.08;font-weight:700;letter-spacing:-.01em}
.astro-gt-hero__sub{color:rgba(255,255,255,.92);font-size:clamp(16px,2vw,21px);margin:0 0 30px;max-width:640px;line-height:1.5}
.astro-gt-hero__cta{display:inline-flex;align-items:center;gap:8px;width:fit-content;background:#fff;color:#9a2d2d;font-weight:700;font-size:15px;padding:14px 28px;border-radius:50px;text-decoration:none;transition:background .2s,color .2s}
.astro-gt-hero__cta:hover{background:#f3e7d4;color:#7e2424}
@media(max-width:600px){.astro-gt-hero{height:min(66vh,500px)}.astro-gt-hero__inner{padding:0 20px 40px}}
</style>
