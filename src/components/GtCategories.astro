---
{CATEGORIES.map((cat, ci) => (
  <section class="astro-gt-cat" id={cat.id}>
    <div class="astro-gt-cat__inner">
      <div class="astro-gt-cat__head">
        <h2 class="astro-gt-cat__title">{cat.title}</h2>
        <p class="astro-gt-cat__intro">{cat.intro}</p>
        <a href={cat.href} class="astro-gt-cat__link">Zur Bereichsseite {cat.title} &#8594;</a>
      </div>
      <div class="astro-gt-cat__grid">
        {cat.items.map(item => (
          <article class="astro-gt-card" id={slugify(item.title)}>
            <h3 class="astro-gt-card__title">{item.title}</h3>
            <p class="astro-gt-card__text">{item.text}</p>
            {(item.schedule || item.ort) && (
              <div class="astro-gt-card__meta">
                {item.schedule && item.schedule.map(s => <p class="astro-gt-card__sched">{s}</p>)}
                {item.ort && <p class="astro-gt-card__ort">{item.ort}</p>}
              </div>
            )}
            {item.contact && (
              <p class="astro-gt-card__contact">
                {item.contact.map((c, i) => (
                  <>
                    {i > 0 && ' · '}
                    {c.type === 'mail' ? <a href={`mailto:${c.value}`}>{c.label || c.value}</a> :
                     c.type === 'tel' ? <a href={`tel:${c.value.replace(/\s+/g, '')}`}>{c.label ? `${c.label}: ${c.value}` : c.value}</a> :
                     c.value}
                  </>
                ))}
              </p>
            )}
            {item.more && (
              <a class="astro-gt-card__more" href={item.more.href} target={item.more.external ? '_blank' : undefined} rel={item.more.external ? 'noopener' : undefined}>
                {item.more.label} &#8594;
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
))}

<style is:global>
.astro-gt-cat{padding:56px 0}
.astro-gt-cat:nth-child(odd){background:#fff}
.astro-gt-cat:nth-child(even){background:#f7f3ef}
.astro-gt-cat__inner{max-width:1100px;margin:0 auto;padding:0 40px}
.astro-gt-cat__head{margin:0 0 32px}
.astro-gt-cat__title{font-family:'Playfair Display',Georgia,serif;font-size:clamp(26px,3.5vw,36px);font-weight:700;color:#2c2420;margin:0 0 10px}
.astro-gt-cat__intro{font-size:16px;color:#6b5c52;margin:0 0 10px;max-width:600px}
.astro-gt-cat__link{font-size:14px;font-weight:600;color:#9a2d2d;text-decoration:none}
.astro-gt-cat__link:hover{color:#7e2424;text-decoration:underline}
.astro-gt-cat__grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.astro-gt-card{background:#fff;border:1px solid #e0d8cf;border-radius:14px;padding:26px 28px;scroll-margin-top:100px;box-shadow:0 2px 12px rgba(30,21,18,.04)}
.astro-gt-cat:nth-child(even) .astro-gt-card{background:#fff}
.astro-gt-card__title{font-family:'Playfair Display',Georgia,serif;font-size:19px;font-weight:700;color:#2c2420;margin:0 0 10px}
.astro-gt-card__text{font-size:14.5px;line-height:1.65;color:#5a4a3a;margin:0 0 14px}
.astro-gt-card__meta{margin:0 0 10px;padding-top:10px;border-top:1px solid #f0ebe5}
.astro-gt-card__sched{font-size:13.5px;font-weight:600;color:#9a2d2d;margin:0 0 2px}
.astro-gt-card__ort{font-size:13.5px;color:#6b5c52;margin:0}
.astro-gt-card__contact{font-size:13px;color:#6b5c52;margin:0 0 10px}
.astro-gt-card__contact a{color:#9a2d2d;text-decoration:underline}
.astro-gt-card__more{display:inline-block;font-size:13.5px;font-weight:600;color:#128C7E;text-decoration:none}
.astro-gt-card__more:hover{text-decoration:underline}
@media(max-width:860px){.astro-gt-cat__grid{grid-template-columns:1fr}}
@media(max-width:600px){.astro-gt-cat__inner{padding:0 20px}.astro-gt-cat{padding:40px 0}}
</style>
