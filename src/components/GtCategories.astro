---
// Alle Gruppen & Treffpunkte, nach Bereich (A9, 2026-09-16) — Präfix `astro-gt`.
// Inhalt 1:1 aus dem Heft „Gruppen und Treffpunkte 2026" der Pfarrei übernommen, mit
// Sprungadresse je Gruppe (Anker) und Verlinkung zu bestehenden Einzelseiten, wo vorhanden.
function slugify(s) {
  return s.toLowerCase()
    .replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss')
    .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

