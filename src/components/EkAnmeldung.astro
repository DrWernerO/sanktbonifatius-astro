---
// Band „Anmeldung zur Erstkommunion" (WP-Block `ek-anmeldung`). Klassen `astro-ek-anm`.
// Zwei Kurs-Kacheln (St. Bonifatius/St. Aposteln + St. Wendel/Herz Jesu) statt der früheren
// 3-Schritte-Anleitung + Status-Kasten (Werner-Wunsch 2026-08-25). Anker #anmeldung (Hero-Button).
// Info-PDFs liegen lokal im Astro-Repo (public/uploads/…, Konvention seit 2026-08-25: Fotos
// und Dokumente liegen im Astro-Projekt, Ausnahme nur Termine/Beiträge/News, s. CLAUDE.md).
// Anmeldung führt direkt zum ChurchDesk-Formular des jeweiligen Kurses.
const KURSE = [
  {
    title: 'Erstkommunion St. Bonifatius',
    sub: 'Für die Kirchorte St. Aposteln und St. Bonifatius',
    dates: [
      'Elternabend: Mo., 14.09.2026, 19:30 Uhr (Großer Pfarrsaal, Holbeinstr. 70)',
      'Kursstart: ab Mo., 19.10.2026',
      'Fototermin: So., 25.10.2026, 10:00 Uhr',
      'Erstkommunionfeier in St. Bonifatius: So., 18.04.2027 (zwei Gottesdienste)',
      'Dankamt: Mo., 19.04.2027, 10:00 Uhr',
    ],
    infoPdf: '/uploads/2026/08/infobrief-erstkommunion-st-bonifatius.pdf',
    anmeldeLink: 'https://forms.churchdesk.com/f/8fmmrdSxPE',
  },
  {
    title: 'Erstkommunion St. Wendel',
    sub: 'Für die Kirchorte Herz Jesu und St. Wendel',
    dates: [
      'Elternabend für beide Kirchorte: Mi., 16.09.2026, 19:30 Uhr (St. Wendel, Altes Schützenhüttengäßchen 4)',
      'Erstkommunionfeier in St. Wendel: Sa., 17.04.2027, 10:00 Uhr',
      'Erstkommunionfeier in Herz Jesu: So., 18.04.2027, 10:00 Uhr',
      'Dankamt in St. Bonifatius: Mo., 19.04.2027, 10:00 Uhr',
    ],
    infoPdf: '/uploads/2026/08/infobrief-erstkommunion-st-wendel.pdf',
    anmeldeLink: 'https://forms.churchdesk.com/f/5yEi4oVRfl',
  },
];
---
<section class="astro-ek-anm" id="anmeldung">
  <div class="astro-ek-anm__inner">
    <p class="astro-ek-anm__eyebrow">Anmeldung</p>
    <h2>Jetzt anmelden f&uuml;r den Kurs Erstkommunion 2027</h2>
    <div class="astro-ek-anm__tiles">
      {KURSE.map((k) => (
        <div class="astro-ek-anm__tile">
          <h3>{k.title}</h3>
          <p class="astro-ek-anm__tile-sub">{k.sub}</p>
          <ul class="astro-ek-anm__dates">
            {k.dates.map((d) => <li>{d}</li>)}
          </ul>
          <div class="astro-ek-anm__tile-btns">
            <a class="astro-ek-anm__btn astro-ek-anm__btn--ghost" href={k.infoPdf} target="_blank" rel="noopener">
              Wichtige Informationen zum Kurs
            </a>
            <a class="astro-ek-anm__btn" href={k.anmeldeLink} target="_blank" rel="noopener">
              Jetzt anmelden
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
.astro-ek-anm{background:#ede4d5;padding:72px 0}
.astro-ek-anm__inner{max-width:1080px;margin:0 auto;padding:0 48px;text-align:center}
.astro-ek-anm__eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#9a2d2d;font-weight:600;margin:0 0 12px}
.astro-ek-anm h2{font-family:'Playfair Display',Georgia,serif;font-size:clamp(23px,3.3vw,34px);color:#1e1512;font-weight:700;margin:0 0 40px}
.astro-ek-anm__tiles{display:grid;grid-template-columns:1fr 1fr;gap:28px;text-align:left}
.astro-ek-anm__tile{background:#fff;border:1px solid #ddd0bf;border-radius:16px;padding:34px 32px;display:flex;flex-direction:column}
.astro-ek-anm__tile h3{font-family:'Playfair Display',Georgia,serif;font-size:1.35rem;color:#1e1512;font-weight:700;margin:0 0 8px}
.astro-ek-anm__tile-sub{color:#9a2d2d;font-size:.9rem;font-weight:600;margin:0 0 20px}
.astro-ek-anm__dates{list-style:none;margin:0 0 28px;padding:0;flex:1}
.astro-ek-anm__dates li{color:#5a4a3a;font-size:.95rem;line-height:1.6;padding:10px 0;border-top:1px solid #ede4d5}
.astro-ek-anm__dates li:first-child{border-top:none}
.astro-ek-anm__tile-btns{display:flex;flex-direction:column;gap:10px}
.astro-ek-anm__btn{display:inline-flex;align-items:center;justify-content:center;text-align:center;padding:13px 22px;border-radius:50px;font-size:.92rem;font-weight:700;text-decoration:none;background:#9a2d2d;color:#fff;transition:background .2s,color .2s,border-color .2s}
.astro-ek-anm__btn:hover{background:#7e2424}
.astro-ek-anm__btn--ghost{background:transparent;color:#9a2d2d;box-shadow:inset 0 0 0 1.5px #c9b18a}
.astro-ek-anm__btn--ghost:hover{background:#f7f1e6;color:#7e2424}
@media(max-width:760px){.astro-ek-anm__tiles{grid-template-columns:1fr}}
@media(max-width:600px){.astro-ek-anm{padding:56px 0}.astro-ek-anm__inner{padding:0 20px}.astro-ek-anm__tile{padding:28px 24px}}
</style>
