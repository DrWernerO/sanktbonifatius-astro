---
// Hero + Kontakt der Kita Herz Jesu (vereinfacht — WP-Seite im Aufbau)
// Eigene Klassen astro-khj-* (nie WP-Präfixe wiederverwenden).
---
<div class="astro-khj-root">
  <!-- HERO -->
  <section class="astro-khj-hero">
    <div class="astro-khj-hero__in">
      <p class="astro-khj-eyebrow">Kita Herz Jesu &middot; Frankfurt-Sachsenh&auml;user Berg</p>
      <h1 class="astro-khj-hero__h1">Glaube, Geborgenheit und Wachsen.</h1>
      <p class="astro-khj-hero__lead">Katholische Kita f&uuml;r Kinder von 3 bis 6 Jahren in einer ruhigen Wohnstra&szlig;e im s&uuml;dlichen Sachsenhausen.</p>
      <div class="astro-khj-hero__ctas">
        <a href="#astro-khj-kontakt" class="astro-khj-btn astro-khj-btn--ghost">Kontakt aufnehmen</a>
        <a href="/kitas/stellenboerse/" class="astro-khj-btn astro-khj-btn--ghost">Stellenb&ouml;rse</a>
      </div>
    </div>
  </section>
</div>

<!-- INFO STRIP -->
<section class="astro-khj-strip astro-khj-sec">
  <div class="astro-khj-strip__in">
    <div class="astro-khj-strip__item">
      <div class="astro-khj-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div class="astro-khj-strip__label">Alter</div>
      <div class="astro-khj-strip__value">3 &ndash; 6 Jahre</div>
    </div>
    <div class="astro-khj-strip__item">
      <div class="astro-khj-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </div>
      <div class="astro-khj-strip__label">Ort</div>
      <div class="astro-khj-strip__value">Frankfurt-Sachsenhausen</div>
    </div>
    <div class="astro-khj-strip__item">
      <div class="astro-khj-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
      </div>
      <div class="astro-khj-strip__label">Tr&auml;ger</div>
      <div class="astro-khj-strip__value">Gemeindeverband Sankt Bonifatius</div>
    </div>
    <div class="astro-khj-strip__item">
      <div class="astro-khj-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="astro-khj-strip__label">&Ouml;ffnungszeiten</div>
      <div class="astro-khj-strip__value">Mo&ndash;Fr 7:30 &ndash; 17:00</div>
    </div>
  </div>
</section>

<!-- ANKÜNDIGUNG -->
<section class="astro-khj-coming astro-khj-sec">
  <div class="astro-khj-coming__in">
    <div class="astro-khj-coming__card">
      <p class="astro-khj-eyebrow-sm">Webauftritt im Aufbau</p>
      <h2 class="astro-khj-coming__h2">Mehr Informationen folgen in K&uuml;rze</h2>
      <p>Wir bereiten gerade den Webauftritt f&uuml;r die Kita Herz Jesu vor. Informationen &uuml;ber unser p&auml;dagogisches Konzept, den Tagesablauf und die Anmeldung folgen in K&uuml;rze. F&uuml;r alle Fragen stehen wir Ihnen gerne direkt zur Verf&uuml;gung.</p>
      <a href="#astro-khj-kontakt" class="astro-khj-btn astro-khj-btn--accent">Jetzt Kontakt aufnehmen</a>
    </div>
  </div>
</section>

<!-- KONTAKT -->
<section class="astro-khj-kontakt astro-khj-sec" id="astro-khj-kontakt">
  <div class="astro-khj-kontakt__in">
    <div class="astro-khj-kontakt__text">
      <p class="astro-khj-eyebrow-sm">Kontakt</p>
      <h2 class="astro-khj-kontakt__h2">So erreichen Sie uns</h2>
      <p>Die Kita Herz Jesu liegt in einer ruhigen Stra&szlig;e im s&uuml;dlichen Sachsenhausen, gut erreichbar mit ÖPNV.</p>
      <div class="astro-khj-kontakt__leitung">
        <p class="astro-khj-kontakt__lname">Dorota Wieckowska</p>
        <p class="astro-khj-kontakt__lrole">Einrichtungsleitung</p>
      </div>
    </div>
    <address class="astro-khj-kontakt__addr">
      <p class="astro-khj-kontakt__addr-name">Kita Herz Jesu</p>
      <p>Mathildenstra&szlig;e 30a<br>60599 Frankfurt am Main</p>
      <p>
        <a href="tel:+49696522522">069 652522</a><br>
        <a href="mailto:kita-herzjesu@sanktbonifatius.de">kita-herzjesu@sanktbonifatius.de</a>
      </p>
      <hr class="astro-khj-kontakt__divider">
      <p class="astro-khj-kontakt__koord-label">Kita-Koordination</p>
      <p>
        Sandra Roos-Greulich<br>
        <a href="mailto:s.roos-greulich@sanktbonifatius.de">s.roos-greulich@sanktbonifatius.de</a>
      </p>
      <p>
        Jeannine Douverne<br>
        <a href="mailto:j.douverne@sanktbonifatius.de">j.douverne@sanktbonifatius.de</a>
      </p>
    </address>
  </div>
</section>

<style is:global>
:root {
  --bf-bg: #f7f3ef;
  --bf-bg-alt: #ede4d5;
  --bf-ink: #1e1512;
  --bf-ink-60: #6b5c52;
  --bf-accent: #9a2d2d;
  --bf-gold: #b88a3a;
  --bf-border: #e0d8cf;
  --bf-radius: 14px;
}
.astro-khj-root {
  width: 100vw;
  position: relative;
  left: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
}
.astro-khj-hero {
  min-height: 480px;
  display: flex;
  align-items: flex-end;
  background: url('/uploads/2026/08/kita-herzjesu-luftbild.jpg') center/cover no-repeat;
  position: relative;
}
.astro-khj-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(20,10,10,.85) 0%, rgba(58,24,24,.55) 45%, rgba(58,24,24,.25) 100%);
}
.astro-khj-hero__in {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px 56px;
}
.astro-khj-eyebrow {
  font-family: 'Futura LT W01 Book', Futura, sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--bf-gold);
  margin: 0 0 14px;
}
.astro-khj-hero__h1 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(32px, 5vw, 58px);
  font-weight: 700;
  color: #fff;
  margin: 0 0 16px;
  line-height: 1.15;
  max-width: 700px;
}
.astro-khj-hero__lead {
  font-size: clamp(15px, 2vw, 18px);
  color: rgba(255,255,255,.85);
  max-width: 520px;
  line-height: 1.65;
  margin: 0 0 28px;
}
.astro-khj-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }
.astro-khj-btn {
  display: inline-flex;
  align-items: center;
  padding: 13px 26px;
  border-radius: 32px;
  font-weight: 700;
  font-size: 14.5px;
  text-decoration: none;
  min-height: 44px;
  transition: all .2s;
}
.astro-khj-btn--ghost { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.5); }
.astro-khj-btn--ghost:hover { background: rgba(255,255,255,.12); border-color: #fff; }
.astro-khj-btn--accent { background: var(--bf-accent); color: #fff; border: 2px solid var(--bf-accent); }
.astro-khj-btn--accent:hover { background: #7a2424; border-color: #7a2424; }
.astro-khj-sec { width: 100vw; position: relative; left: 50%; margin-left: -50vw; margin-right: -50vw; }
.astro-khj-eyebrow-sm { font-family: 'Futura LT W01 Book', Futura, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--bf-accent); margin: 0 0 12px; }
[id] { scroll-margin-top: 100px; }

/* Strip */
.astro-khj-strip { background: var(--bf-bg); padding: 48px 24px; }
.astro-khj-strip__in { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 20px; }
.astro-khj-strip__item { text-align: center; background: #fff; border-radius: 10px; padding: 20px 14px; border: 1px solid var(--bf-border); transition: transform .2s, box-shadow .2s; }
.astro-khj-strip__item:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(30,21,18,.08); }
.astro-khj-strip__icon { color: var(--bf-accent); margin-bottom: 8px; display: flex; justify-content: center; }
.astro-khj-strip__label { font-family: 'Futura LT W01 Book', Futura, sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--bf-ink-60); margin-bottom: 6px; }
.astro-khj-strip__value { font-family: 'Playfair Display', Georgia, serif; font-size: 15px; color: var(--bf-ink); line-height: 1.4; font-weight: 700; }

/* Coming soon */
.astro-khj-coming { background: #fff; padding: 72px 24px; }
.astro-khj-coming__in { max-width: 680px; margin: 0 auto; text-align: center; }
.astro-khj-coming__card { background: var(--bf-bg); border: 1px solid var(--bf-border); border-radius: 20px; padding: 44px 40px; }
.astro-khj-coming__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(22px, 3vw, 32px); font-weight: 700; color: var(--bf-ink); margin: 0 0 14px; }
.astro-khj-coming__card p { font-size: 15.5px; color: var(--bf-ink-60); line-height: 1.75; margin: 0 0 24px; }

/* Kontakt */
.astro-khj-kontakt { background: var(--bf-bg); padding: 80px 24px; }
.astro-khj-kontakt__in { max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
.astro-khj-kontakt__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(22px, 3vw, 32px); font-weight: 700; color: var(--bf-ink); margin: 0 0 16px; }
.astro-khj-kontakt__text p { font-size: 15px; color: var(--bf-ink-60); line-height: 1.7; margin: 0 0 20px; }
.astro-khj-kontakt__leitung { background: #fff; border: 1px solid var(--bf-border); border-radius: 10px; padding: 14px 18px; border-left: 3px solid var(--bf-accent); }
.astro-khj-kontakt__lname { font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: 15px; color: var(--bf-ink); margin: 0 0 2px; }
.astro-khj-kontakt__lrole { font-size: 13px; color: var(--bf-ink-60); margin: 0; }
.astro-khj-kontakt__addr { font-style: normal; background: #fff; border: 1px solid var(--bf-border); border-radius: var(--bf-radius); padding: 26px 28px; }
.astro-khj-kontakt__addr-name { font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: 16px; color: var(--bf-ink); margin: 0 0 10px; }
.astro-khj-kontakt__addr p { font-size: 14.5px; color: var(--bf-ink-60); line-height: 1.7; margin: 0 0 8px; }
.astro-khj-kontakt__addr p:last-child { margin-bottom: 0; }
.astro-khj-kontakt__addr a { color: var(--bf-accent); text-decoration: none; }
.astro-khj-kontakt__addr a:hover { text-decoration: underline; }
.astro-khj-kontakt__divider { border: none; border-top: 1px solid var(--bf-border); margin: 16px 0; }
.astro-khj-kontakt__koord-label { font-family: 'Futura LT W01 Book', Futura, sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--bf-ink-60); margin: 0 0 8px; }
@media (max-width: 700px) {
  .astro-khj-kontakt__in { grid-template-columns: 1fr; gap: 24px; }
  .astro-khj-hero__in { padding: 0 20px 48px; }
}
</style>
