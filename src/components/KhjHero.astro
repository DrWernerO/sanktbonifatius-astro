---
// Hero der Kita Herz Jesu — Aufbau 1:1 wie KapHero (Vorlage Jeannine, 23.09.2026:
// „genauso aufgebaut wie die Seite der Kita St. Aposteln").
// Eigene Klassen astro-khj-* (nie WP-Präfixe wiederverwenden).
// Bilderleiste: bisher nur drei echte Fotos der Kita — der Satz wird mehrfach wiederholt,
// damit die Laufschrift auch auf breiten Bildschirmen lückenlos läuft.
const fotos = [
  { src: '/uploads/2026/08/kita-herzjesu-luftbild.jpg', alt: 'Luftbild der Kita Herz Jesu mit Garten neben der Kirche' },
  { src: '/uploads/2026/09/kita-herzjesu-bauraum-lego.jpg', alt: 'Bauwerk aus Lego-Steinen im Bauraum der Kita Herz Jesu' },
  { src: '/uploads/2026/09/kita-herzjesu-atelier-farben.jpg', alt: 'Farbbecher und Kinderbilder im Atelier der Kita Herz Jesu' },
];
const leiste = [...fotos, ...fotos, ...fotos, ...fotos];
---
<div class="astro-khj-root">
  <section class="astro-khj-hero">
    <div class="astro-khj-hero__in">
      <p class="astro-khj-eyebrow">Frankfurt-Oberrad</p>
      <h1 class="astro-khj-hero__h1">Kita Herz Jesu</h1>
      <p class="astro-khj-hero__motto">Glaube, Geborgenheit und Wachsen.</p>
      <p class="astro-khj-hero__lead">Teiloffene Arbeit mit Funktionsr&auml;umen f&uuml;r Kinder von 3 bis 6 Jahren &ndash; direkt neben der Kirche Herz Jesu in Oberrad.</p>
      <div class="astro-khj-hero__ctas">
        <a href="https://www.kindernetfrankfurt.de" target="_blank" rel="noopener" class="astro-khj-btn astro-khj-btn--primary">Platz anfragen &#8599;</a>
        <a href="#astro-khj-haus" class="astro-khj-btn astro-khj-btn--ghost">Kita kennenlernen</a>
        <a href="/kitas/stellenboerse/" class="astro-khj-btn astro-khj-btn--gold">Stellenb&ouml;rse</a>
      </div>
    </div>
  </section>

  <!-- Fotostreifen -->
  <div class="astro-khj-marquee">
    <div class="astro-khj-marquee__track">
      {leiste.map((f, i) => (
        <img src={f.src} alt={i === 0 ? f.alt : ''} aria-hidden={i === 0 ? undefined : 'true'} loading="lazy" />
      ))}
      <!-- Duplikat fuer nahtlose Schleife -->
      {leiste.map((f) => (
        <img src={f.src} alt="" aria-hidden="true" loading="lazy" />
      ))}
    </div>
  </div>

  <!-- Quicknav -->
  <nav class="astro-khj-quicknav" aria-label="Schnellzugriff">
    <div class="astro-khj-quicknav__in">
      <a href="#astro-khj-angebot">Angebot</a>
      <a href="#astro-khj-tagesablauf">Tagesablauf</a>
      <a href="#astro-khj-zeiten">&Ouml;ffnungszeiten</a>
      <a href="#astro-khj-anmeld">Anmeldung</a>
      <a href="#astro-khj-paed">P&auml;dagogik</a>
      <a href="#astro-khj-kontakt">Kontakt</a>
    </div>
  </nav>
</div>

<style is:global>
:root {
  --bf-bg: #f7f3ef;
  --bf-bg-alt: #ede4d5;
  --bf-ink: #1e1512;
  --bf-ink-60: #6b5c52;
  --bf-accent: #9a2d2d;
  --bf-gold: #b88a3a;
  --bf-border: #e0d8cf;
  --bf-radius: 14px;
}
.astro-khj-root {
  width: 100vw;
  position: relative;
  left: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
}
.astro-khj-hero {
  height: min(70vh, 580px);
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  position: relative;
  background: url('/uploads/2026/08/kita-herzjesu-luftbild.jpg') center/cover no-repeat;
}
.astro-khj-hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.65) 0%, rgba(0,0,0,.2) 45%, rgba(0,0,0,.02) 100%);
}
.astro-khj-hero__in {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px 60px;
}
.astro-khj-eyebrow {
  font-family: 'Playfair Display', Georgia, serif;
  font-style: italic;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: rgba(255,255,255,.95);
  text-shadow: 0 1px 3px rgba(0,0,0,.9), 0 0 14px rgba(0,0,0,.5);
  margin: 0 0 14px;
}
.astro-khj-hero__h1 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(34px, 5.5vw, 64px);
  font-weight: 700;
  color: #fff;
  margin: 0 0 10px;
  line-height: 1.1;
}
.astro-khj-hero__motto {
  font-family: 'Playfair Display', Georgia, serif;
  font-style: italic;
  font-weight: 700;
  font-size: clamp(19px, 2.6vw, 26px);
  color: #f2b429;
  text-shadow: 0 1px 3px rgba(0,0,0,.9), 0 0 14px rgba(0,0,0,.5);
  margin: 0 0 18px;
}
.astro-khj-hero__lead {
  font-size: clamp(15px, 2vw, 18px);
  color: rgba(255,255,255,.88);
  max-width: 560px;
  line-height: 1.65;
  margin: 0 0 28px;
}
.astro-khj-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }
.astro-khj-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 13px 26px;
  border-radius: 32px;
  font-weight: 700;
  font-size: 14.5px;
  text-decoration: none;
  min-height: 44px;
  transition: all .2s;
  letter-spacing: .02em;
}
.astro-khj-btn--primary { background: #fff; color: var(--bf-accent); }
.astro-khj-btn--primary:hover { background: #f0e8d8; }
.astro-khj-btn--ghost { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.5); }
.astro-khj-btn--ghost:hover { background: rgba(255,255,255,.12); border-color: #fff; }
.astro-khj-btn--gold { background: #f2b429; color: #1a120e; border: 2px solid #f2b429; }
.astro-khj-btn--gold:hover { background: #e0a520; border-color: #e0a520; }
.astro-khj-btn--accent { background: var(--bf-accent); color: #fff; }
.astro-khj-btn--accent:hover { background: #7a2424; }

/* Marquee */
.astro-khj-marquee {
  overflow: hidden;
  background: #1e1512;
  padding: 6px 0;
}
.astro-khj-marquee__track {
  display: flex;
  gap: 8px;
  width: max-content;
  animation: astroKhjMarquee 70s linear infinite;
}
.astro-khj-marquee__track:hover { animation-play-state: paused; }
.astro-khj-marquee__track img {
  height: 220px;
  width: auto;
  object-fit: cover;
  border-radius: 4px;
  display: block;
  flex-shrink: 0;
}
@keyframes astroKhjMarquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
@media (prefers-reduced-motion: reduce) {
  .astro-khj-marquee__track { animation: none; overflow-x: auto; }
}

/* Quicknav */
.astro-khj-quicknav { background: var(--bf-ink); padding: 0 16px; position: sticky; top: 80px; z-index: 999; }
.astro-khj-quicknav__in {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  justify-content: center;
  gap: 4px;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  padding: 14px 0;
  scrollbar-width: none;
}
.astro-khj-quicknav__in::-webkit-scrollbar { display: none; }
.astro-khj-quicknav a {
  color: #fff;
  background: var(--bf-accent);
  text-decoration: none;
  padding: 10px 18px;
  border-radius: 22px;
  font-size: 14px;
  font-weight: 600;
  white-space: nowrap;
  transition: background .2s, color .2s;
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--bf-accent);
}
.astro-khj-quicknav a:hover { background: var(--bf-gold); color: var(--bf-ink); border-color: var(--bf-gold); }

/* Shared section helpers */
.astro-khj-sec {
  width: 100vw;
  position: relative;
  left: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
}
[id] { scroll-margin-top: 100px; }

@media (max-width: 600px) {
  .astro-khj-hero__in { padding: 0 20px 48px; }
  .astro-khj-quicknav__in { justify-content: flex-start; padding-left: 8px; }
  .astro-khj-marquee__track img { height: 160px; }
}
</style>
