---
// BonFamily Musicalprojekt — Einladung zum Familiengottesdienst mit Musical, mit Plakat-Bild.
// Präfix `astro-bfmusical`. Hintergrund #ede4d5 (Sand) für Wechsel nach EventCalendar (Crème) und vor Gottesdienste (Weiß).
---
<section id="bonfamily-musical" class="astro-bfmusical">
  <div class="astro-bfmusical__inner">
    <div class="astro-bfmusical__text">
      <span class="astro-bfmusical__badge">Familiengottesdienst</span>
      <h2 class="astro-bfmusical__title">St.-Martins-Musical &bdquo;Aufregung im G&auml;nsestall&ldquo;</h2>
      <p class="astro-bfmusical__lead">
        Am 15. November um 11 Uhr bringen unsere kleinen und gro&szlig;en Mitwirkenden das
        St.-Martins-Musical in den Familiengottesdienst nach St. Wendel. Freut euch auf Musik,
        Schauspiel und die Botschaft des heiligen Martin: teilen, helfen und f&uuml;reinander da sein.
      </p>
      <ul class="astro-bfmusical__facts">
        <li><strong>Sonntag, 15. November 2026, 11 Uhr</strong></li>
        <li>St. Wendel, Altes Sch&uuml;tzenh&uuml;tteng&auml;sschen</li>
        <li>Gerne Laterne mitbringen!</li>
      </ul>
      <p class="astro-bfmusical__closing">
        Seid dabei! Wir freuen uns auf viele Kinder, Familien und bekannte Gesichter!
      </p>
    </div>
    <div class="astro-bfmusical__poster">
      <img
        src="/uploads/2026/11/familiengottesdienst-st-martin-musical.jpg"
        alt="Plakat: Familiengottesdienst mit dem Musical „Aufregung im Gänsestall“ für Kinder und Familien, Sonntag 15.11.2026, 11 Uhr, St. Wendel – gerne Laterne mitbringen"
        class="astro-bfmusical__img"
        width="848" height="1200"
        loading="lazy" decoding="async"
      />
    </div>
  </div>
</section>

<style is:global>
.astro-bfmusical{padding:72px 0;background:#ede4d5;width:100vw;position:relative;left:50%;margin-left:-50vw;margin-right:-50vw;scroll-margin-top:96px}
.astro-bfmusical__inner{max-width:1200px;margin:0 auto;padding:0 40px;display:grid;grid-template-columns:1fr auto;gap:64px;align-items:center}
.astro-bfmusical__badge{display:inline-block;background:#9a2d2d;color:#fff;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:4px 12px;border-radius:50px;margin-bottom:16px}
.astro-bfmusical__title{font-family:'Playfair Display',Georgia,serif;font-size:clamp(26px,3vw,38px);font-weight:700;color:#9a2d2d;margin:0 0 14px;line-height:1.15}
.astro-bfmusical__lead{font-size:17px;line-height:1.7;color:#5a4a3a;margin:0 0 22px}
.astro-bfmusical__facts{list-style:none;margin:0 0 22px;padding:14px 18px;background:#f7f0e6;border-left:3px solid #9a2d2d;border-radius:8px}
.astro-bfmusical__facts li{font-size:15px;color:#3d2b1a;line-height:1.6}
.astro-bfmusical__facts strong{color:#9a2d2d}
.astro-bfmusical__closing{font-size:17px;font-weight:600;color:#2c2420;line-height:1.6;margin:0}
.astro-bfmusical__poster{flex-shrink:0}
.astro-bfmusical__img{width:400px;height:auto;max-width:100%;border-radius:12px;box-shadow:0 8px 32px rgba(30,21,18,.15);display:block}
@media(max-width:900px){.astro-bfmusical__inner{grid-template-columns:1fr;gap:32px}.astro-bfmusical__poster{justify-self:center}.astro-bfmusical__img{width:360px}}
@media(max-width:600px){.astro-bfmusical__inner{padding:0 20px}.astro-bfmusical{padding:52px 0}}
</style>
