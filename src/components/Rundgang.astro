---
// Virtueller 360°-Rundgang durch die Kirche St. Bonifatius (100 Jahre).
// Alle Inhalte (Stationen, Verbindungen, Infopunkte, Geschichten, Führungsreihenfolge) stehen in
// src/data/rundgang.json — Anleitung zum Pflegen: docs/rundgang-anleitung.md.
// Viewer: Pannellum 2.5.6, SELBST gehostet unter /vendor/pannellum/ (kein CDN, Datenschutz).
// Panoramen als Multires-Kacheln (scripts/rundgang-kacheln.py), Kennwerte in rundgang-kacheln.json.
// Pfeile und Infopunkte werden aus den Grundriss-Positionen berechnet (Richtung = Himmelsrichtung
// zum Ziel minus Blickrichtung der Bildmitte), damit neue Stationen ohne Rechnen eingetragen werden.
import daten from '../data/rundgang.json';
import kacheln from '../data/rundgang-kacheln.json';

const stationen = daten.stationen.filter((s) => kacheln[s.id]);
// Ortsliste: dieselben Infopunkte wie im Bild – von der Empore alle sichtbaren, sonst nur die in Reichweite
const meterBis = (s: any, i: any) => Math.hypot(
  ((i.position.x - s.position.x) / 100) * daten.grundriss.breiteMeter,
  ((i.position.y - s.position.y) / 100) * daten.grundriss.hoeheMeter,
  (i.boden || 0) + (i.hoehe ?? 1.5) - ((s.boden || 0) + daten.kamerahoeheMeter),
);
const infoProStation = Object.fromEntries(
  stationen.map((s) => [s.id, daten.infopunkte
    .filter((i) => i.sichtbarVon.includes(s.id) && (s.ebene === 'Empore' || meterBis(s, i) <= daten.infopunktAnzeige.reichweiteMeter
      || (s as any).zusaetzlicheInfopunkte?.includes(i.id)))
    .sort((a, b) => meterBis(s, a) - meterBis(s, b))]),
);
// Heiligengalerie als Tafelwand („Heiligengalerie von St. Bonifatius“, 2026-11-05): ersetzt den Zylinder, wenn `gedenktafeln.aktiv`.
// In der Ortsliste bei den Stationen nennen, die höchstens 15 m vor einer Tafelwand stehen.
const TF: any = (daten as any).gedenktafeln?.aktiv ? (daten as any).gedenktafeln : null;
const geschichtenTitel = TF ? TF.titel : daten.heiligengalerie.titel;
// Liste unter dem Rundgang: bei der Tafelwand nur die Geschichten, die auch wirklich auf einer Tafel hängen
const geschichtenListe = TF
  ? TF.tafeln.map((t: any) => daten.geschichten.find((g) => g.id === t.geschichte)).filter(Boolean)
  : daten.geschichten;
const tafelnNah = (s: any) => !!TF && TF.waende.some((w: any) => {
  if (w.verdecktVon?.includes(s.id)) return false;
  const m = (p: any) => [(p.x / 100) * daten.grundriss.breiteMeter, (p.y / 100) * daten.grundriss.hoeheMeter];
  const [ax, ay] = m(w.a), [bx, by] = m(w.b), [sx, sy] = m(s.position);
  return Math.hypot(sx - (ax + bx) / 2, sy - (ay + by) / 2) <= 15 && (sx - ax) * (by - ay) - (sy - ay) * (bx - ax) > 0;
});
const geschichtenHier = (s: any) => (TF ? tafelnNah(s) : s.id === daten.heiligengalerie.station);
const clientDaten = JSON.stringify({ ...daten, stationen, kacheln });
---
<link rel="stylesheet" href="/vendor/pannellum/pannellum.css" />
<script is:inline src="/vendor/pannellum/pannellum.js"></script>

<section class="astro-rg" aria-labelledby="astro-rg-titel">
  <h2 id="astro-rg-titel" class="astro-rg-sr">Virtueller Rundgang durch die Kirche</h2>

  <!-- „So geht’s“ (Frank 2026-11-05): steht VOR dem Bild und ist mit dem Seitenkopf zu einem Einstieg zusammengeführt –
       erst erklären, dann wählen (Knöpfe), dann umschauen. Bedienung immer sichtbar, in einfachen Worten und mit denselben
       Zeichen wie im Bild, weil unser Publikum oft wenig technikerfahren ist. Seltenere Tipps bleiben zum Aufklappen. -->
  <section class="astro-rg-sogehts" aria-labelledby="astro-rg-sogehts-titel">
    <h2 id="astro-rg-sogehts-titel">So geht’s – ganz einfach</h2>
    <ol class="astro-rg-schritte">
      <li>
        <span class="astro-rg-schritt-bild astro-rg-sb-hand" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M9 11.24V7.5C9 6.12 10.12 5 11.5 5S14 6.12 14 7.5v3.74c1.21-.81 2-2.18 2-3.74C16 5.01 13.99 3 11.5 3S7 5.01 7 7.5c0 1.56.79 2.93 2 3.74zm9.84 4.63l-4.54-2.26c-.17-.07-.35-.11-.54-.11H13v-6c0-.83-.67-1.5-1.5-1.5S10 6.67 10 7.5v10.74l-3.43-.72c-.08-.01-.15-.03-.24-.03-.31 0-.59.13-.79.33l-.79.8 4.94 4.94c.27.27.65.44 1.06.44h6.79c.75 0 1.33-.55 1.44-1.28l.75-5.27c.01-.07.02-.14.02-.2 0-.62-.38-1.16-.91-1.38z"/></svg></span>
        <strong>Umschauen</strong>
        <span>Ins Bild tippen und mit dem Finger oder der Maus ziehen – so drehen Sie sich in alle Richtungen.</span>
      </li>
      <li>
        <span class="astro-rg-schritt-bild astro-rg-sb-weg" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 15l7-7 7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <strong>Weitergehen</strong>
        <span>Einen weißen Pfeil im Bild antippen – schon stehen Sie an der nächsten Stelle.</span>
      </li>
      <li>
        <span class="astro-rg-schritt-bild astro-rg-sb-karte" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2V6z M9 4v14 M15 6v14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
        <strong>Grundriss</strong>
        <span>Den Knopf mit der Karte oben rechts im Bild antippen – dort sehen Sie alle Orte und springen mit einem Tipp hin.</span>
      </li>
      <li>
        <span class="astro-rg-schritt-bild astro-rg-sb-info" aria-hidden="true">i</span>
        <strong>Mehr erfahren</strong>
        <span>Einen roten Punkt mit „i“ antippen – dann lesen Sie, was Sie gerade sehen.</span>
      </li>
      <li>
        <span class="astro-rg-schritt-bild astro-rg-sb-tafel" aria-hidden="true"><span></span></span>
        <strong>{TF ? TF.titel : daten.heiligengalerie.titel}</strong>
        {TF
          ? <span>Vorne an den Wänden eine goldene Tafel antippen – Menschen aus unserer Gemeinde erzählen ihre Geschichte.</span>
          : <span>Hinter dem Altar den goldenen Knopf antippen – ringsum erscheinen Geschichten von Menschen aus unserer Gemeinde.</span>}
      </li>
    </ol>
    <div class="astro-rg-leiste">
      <div class="astro-rg-leiste-start" id="astro-rg-start-bereich">
        <button type="button" class="astro-rg-knopf astro-rg-knopf-rot" id="astro-rg-start">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
          Rundgang starten
        </button>
        {TF?.direkt && (
          <button type="button" class="astro-rg-knopf astro-rg-knopf-gold" id="astro-rg-zur-galerie">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V9l8-5 8 5v11z M9 20v-6h6v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            Direkt zur Heiligengalerie
          </button>
        )}
      </div>
      <p class="astro-rg-leiste-hinweis"><strong>Lieber begleitet?</strong> „Rundgang starten“ führt Sie Schritt für Schritt durch die Kirche – Sie tippen nur auf „Weiter“.</p>
    </div>

    <details class="astro-rg-hilfe">
      <summary>Weitere Tipps</summary>
      <ul>
        <li>Näher heranholen: mit zwei Fingern im Bild auseinanderziehen, mit dem Mausrad oder mit den Knöpfen + und − oben links.</li>
        <li>Der Knopf mit den vier Ecken oben rechts im Bild schaltet auf Vollbild – noch einmal antippen, und alles ist wieder wie vorher.</li>
        <li>Unten rechts im Bild lassen sich Wege, Infopunkte und Geschichten einzeln aus- und einblenden.</li>
        <li>Mit der Tastatur: Pfeiltasten drehen, Plus und Minus zoomen, mit der Tabulatortaste erreichen Sie Pfeile, Punkte und Tafeln.</li>
        <li>Ganz unten auf dieser Seite stehen alle Orte noch einmal als Liste – zum Lesen oder um direkt dorthin zu springen.</li>
      </ul>
    </details>
  </section>


  <div class="astro-rg-buehne" id="astro-rg-buehne">
    <div id="astro-rg-viewer" class="astro-rg-viewer" aria-label="360-Grad-Ansicht der Kirche. Mit Maus, Finger oder Pfeiltasten umschauen."></div>

    <p class="astro-rg-ort" id="astro-rg-ort" aria-live="polite"></p>

    <!-- Erster Hinweis mitten im Bild; verschwindet, sobald man sich einmal umgeschaut hat (Frank 2026-11-05) -->
    <div class="astro-rg-anfang" id="astro-rg-anfang" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path fill="currentColor" d="M9 11.24V7.5C9 6.12 10.12 5 11.5 5S14 6.12 14 7.5v3.74c1.21-.81 2-2.18 2-3.74C16 5.01 13.99 3 11.5 3S7 5.01 7 7.5c0 1.56.79 2.93 2 3.74zm9.84 4.63l-4.54-2.26c-.17-.07-.35-.11-.54-.11H13v-6c0-.83-.67-1.5-1.5-1.5S10 6.67 10 7.5v10.74l-3.43-.72c-.08-.01-.15-.03-.24-.03-.31 0-.59.13-.79.33l-.79.8 4.94 4.94c.27.27.65.44 1.06.44h6.79c.75 0 1.33-.55 1.44-1.28l.75-5.27c.01-.07.02-.14.02-.2 0-.62-.38-1.16-.91-1.38z"/></svg>
      <span>Zum Umschauen ins Bild tippen und ziehen</span>
    </div>

    <div class="astro-rg-hg-steuerung" id="astro-rg-hg-steuerung" role="group" aria-label={daten.heiligengalerie.titel} hidden>
      <button type="button" id="astro-rg-hg-links" aria-label="Zur vorigen Geschichte drehen">←</button>
      <span class="astro-rg-hg-titel">{daten.heiligengalerie.titel}</span>
      <button type="button" id="astro-rg-hg-zu"><span class="astro-rg-hg-lang">Galerie schließen</span><span class="astro-rg-hg-kurz">Schließen</span></button>
      <button type="button" id="astro-rg-hg-rechts" aria-label="Zur nächsten Geschichte drehen">→</button>
    </div>

    <div class="astro-rg-werkzeuge">
      <button type="button" class="astro-rg-rund" id="astro-rg-karte-knopf" aria-expanded="false" aria-controls="astro-rg-karte" title="Grundriss">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2V6z M9 4v14 M15 6v14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        <span class="astro-rg-sr">Grundriss anzeigen</span>
      </button>
      <button type="button" class="astro-rg-rund" id="astro-rg-vollbild" title="Vollbild" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5 M20 9V4h-5 M4 15v5h5 M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="astro-rg-sr">Vollbild ein- oder ausschalten</span>
      </button>
    </div>

    <div class="astro-rg-karte" id="astro-rg-karte" hidden>
      <div class="astro-rg-karte-kopf">
        <strong>Grundriss</strong>
        <span>Station anklicken, um dorthin zu springen</span>
      </div>
      <div class="astro-rg-karte-bild">
        <img src={daten.grundriss.bild} alt="" width="1350" height="540" />
        <svg class="astro-rg-kegel" id="astro-rg-kegel" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"></svg>
        {stationen.map((s) => (
          <button
            type="button"
            class:list={['astro-rg-punkt', { 'astro-rg-punkt-empore': s.ebene === 'Empore' }]}
            style={`left:${(s.karte || s.position).x}%;top:${(s.karte || s.position).y}%`}
            data-station={s.id}
            aria-label={`Station ${s.nr}: ${s.titel}${s.ebene ? ` (${s.ebene})` : ''}`}
            title={`${s.nr} · ${s.titel}`}
          >{s.nr}</button>
        ))}
      </div>
      <p class="astro-rg-karte-hinweis">Station 14 liegt oben auf der Orgelempore.</p>
    </div>

    <!-- Filter „Im Bild“ (Frank 2026-11-05): unten rechts im Bild statt unter dem Bild; auf dem Handy nur die Symbole -->
    <div class="astro-rg-legende" role="group" aria-label="Im Bild anzeigen">
      <span class="astro-rg-legende-titel" aria-hidden="true">Im Bild:</span>
      <button type="button" class="astro-rg-ebene" data-ebene="weg" aria-pressed="true" title="Wege ein- oder ausblenden">
        <span class="astro-rg-marke astro-rg-marke-weg" aria-hidden="true"></span><span class="astro-rg-ebene-text">Wege</span>
      </button>
      <button type="button" class="astro-rg-ebene" data-ebene="info" aria-pressed="true" title="Infopunkte ein- oder ausblenden">
        <span class="astro-rg-marke astro-rg-marke-info" aria-hidden="true">i</span><span class="astro-rg-ebene-text">Infopunkte</span>
      </button>
      <button type="button" class="astro-rg-ebene" data-ebene="geschichte" aria-pressed="true" title="Geschichten ein- oder ausblenden">
        <span class="astro-rg-marke astro-rg-marke-geschichte" aria-hidden="true"></span><span class="astro-rg-ebene-text">Geschichten</span>
      </button>
    </div>
  </div>

  <!-- Karte der aktuellen Station beim freien Umschauen (Frank 2026-11-05): wie die Führungskarte, Inhalt aus der
       Stationskarte der Liste unten, wechselt mit jedem Standort. Während der Führung übernimmt die Führungskarte. -->
  <div class="astro-rg-fuehrung astro-rg-hier" id="astro-rg-hier">
    <p class="astro-rg-fuehrung-nr" id="astro-rg-hier-nr"></p>
    <h3 id="astro-rg-hier-titel"></h3>
    <p class="astro-rg-hier-lage" id="astro-rg-hier-lage"></p>
    <p id="astro-rg-hier-text"></p>
    <div class="astro-rg-hier-details" id="astro-rg-hier-details"></div>
  </div>

  <div class="astro-rg-fuehrung" id="astro-rg-fuehrung" hidden>
    <p class="astro-rg-fuehrung-nr" id="astro-rg-fuehrung-nr"></p>
    <h3 id="astro-rg-fuehrung-titel" tabindex="-1"></h3>
    <p id="astro-rg-fuehrung-text"></p>
    <div class="astro-rg-fuehrung-knoepfe">
      <button type="button" class="astro-rg-knopf" id="astro-rg-zurueck">← Zurück</button>
      <button type="button" class="astro-rg-knopf astro-rg-knopf-rot" id="astro-rg-weiter">Weiter →</button>
      <button type="button" class="astro-rg-knopf astro-rg-knopf-leise" id="astro-rg-ende">Rundgang beenden</button>
    </div>
  </div>

  <div class="astro-rg-orte">
    <h2>Alle Orte im Überblick</h2>
    <p class="astro-rg-orte-intro">Die Stationen des Rundgangs als Liste – zum Lesen oder um direkt zu einem Ort zu springen.</p>
    <ol>
      {stationen.map((s) => (
        <li class="astro-rg-ort-karte" id={`astro-rg-ort-${s.id}`}>
          <img src={`${daten.vorschauBasis}/${s.id}.jpg`} alt={`Blick: ${s.titel}`} loading="lazy" width="960" height="600" />
          <div class="astro-rg-ort-text">
            <h3><span class="astro-rg-ort-nr">{s.nr}</span> {s.titel}</h3>
            <p class="astro-rg-ort-lage">{s.ort}</p>
            <p>{s.begleittext}</p>
            {(infoProStation[s.id].length > 0 || geschichtenHier(s)) && (
              <p class="astro-rg-ort-details-titel" id={`astro-rg-details-${s.id}`}>Von hier aus zu entdecken</p>
            )}
            {(infoProStation[s.id].length > 0 || geschichtenHier(s)) && (
              <ul class="astro-rg-ort-details" aria-labelledby={`astro-rg-details-${s.id}`}>
                {infoProStation[s.id].map((i) => <li>{i.titel}{!i.text && <em> – Infotext folgt</em>}</li>)}
                {geschichtenHier(s) && <li>{geschichtenTitel} mit {TF ? TF.tafeln.length : daten.geschichten.length} Geschichten</li>}
              </ul>
            )}
            <button type="button" class="astro-rg-knopf" data-station={s.id}>Hier umschauen</button>
          </div>
        </li>
      ))}
    </ol>

    <details class="astro-rg-hg-liste">
      <summary>Alle Geschichten der {geschichtenTitel} ({geschichtenListe.length})</summary>
      <ul>
        {geschichtenListe.map((g) => (
          <li>
            <button type="button" data-geschichte={g.id}>{g.titel}</button>
            {' – '}{[g.person, g.jahr].filter(Boolean).join(', ')}{g.beispiel && <em> (Beispiel)</em>}
          </li>
        ))}
      </ul>
    </details>
  </div>

  <dialog class="astro-rg-dialog" id="astro-rg-dialog" aria-labelledby="astro-rg-dialog-titel">
    <button type="button" class="astro-rg-dialog-zu" id="astro-rg-dialog-zu" aria-label="Schließen">×</button>
    <div class="astro-rg-dialog-box">
      <div id="astro-rg-dialog-inhalt"></div>
    </div>
  </dialog>

  <script type="application/json" id="astro-rg-daten" set:html={clientDaten}></script>
</section>

<script>
  type Pos = { x: number; y: number };
  type Station = {
    nr: number; id: string; titel: string; ort: string; position: Pos; karte?: Pos; blickrichtung: number;
    boden?: number; ebene?: string; startblick: { yaw: number; pitch: number }; zusaetzlicheInfopunkte?: string[];
    verbindungen: (string | { ziel: string; yaw?: number; pitch?: number; label?: string; ueber?: Pos[]; wegpunkt?: 'umweg' })[];
    begleittext: string;
  };

  const daten = JSON.parse(document.getElementById('astro-rg-daten')!.textContent!);
  const stationen: Record<string, Station> = Object.fromEntries(daten.stationen.map((s: Station) => [s.id, s]));
  const reihenfolge: string[] = daten.fuehrung.filter((id: string) => stationen[id]);
  const W = daten.grundriss.breiteMeter, H = daten.grundriss.hoeheMeter, KAMERA = daten.kamerahoeheMeter;
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const grad = (r: number) => (r * 180) / Math.PI;
  const wrap = (a: number) => ((((a + 180) % 360) + 360) % 360) - 180;

  // Richtung und Neigung von einer Station zu einem Punkt im Grundriss.
  function richtung(von: Station, nach: Pos, zielBoden = 0, zielHoehe = 0) {
    const dx = ((nach.x - von.position.x) / 100) * W;
    const dy = ((nach.y - von.position.y) / 100) * H;
    const abstand = Math.max(0.5, Math.hypot(dx, dy));
    const yaw = wrap(grad(Math.atan2(dy, dx)) - von.blickrichtung);
    const hoehe = zielBoden + zielHoehe - ((von.boden || 0) + KAMERA);
    const pitch = grad(Math.atan2(hoehe, abstand));
    return { yaw, pitch, abstand, raum: Math.hypot(abstand, hoehe) };
  }

  // Punkte werden mit der Entfernung im Raum kleiner (Frank 2026-10-30): bis ca. 6 m volle Größe,
  // ab ca. 25 m die Mindestgröße (bleibt antippbar). Wirkt über die CSS-Variable --rg-gross.
  const groesse = (meter: number) => Math.max(0.6, Math.min(1, 1.2 - 0.024 * meter)).toFixed(2);

  // Infopunkte (Frank 2026-11-04): direkt davor volle Größe, in der Nähe deutlich kleiner und mit der
  // Entfernung weiter schrumpfend, außer Reichweite ausgeblendet – damit der Blick nicht überladen wirkt.
  // Von der Empore alle sichtbaren, ebenfalls nach Entfernung abgestuft (dort ist nichts näher als ~14 m).
  const { vollBisMeter: VOLL, reichweiteMeter: REICHWEITE } = daten.infopunktAnzeige;
  const anteil = (m: number, von: number, bis: number) => Math.max(0, Math.min(1, (m - von) / (bis - von)));
  // `zusaetzlicheInfopunkte` einer Station: dort auch jenseits der Reichweite zeigen (kleinste Größe),
  // z. B. vom zentralen Platz vor dem Altar die Osterkerze und die Engelbilder.
  function infoGroesse(meter: number, s: Station, id: string): string | null {
    if (s.ebene === 'Empore') return (0.9 - 0.4 * anteil(meter, 14, 40)).toFixed(2);
    if (meter > REICHWEITE) return s.zusaetzlicheInfopunkte?.includes(id) ? '0.45' : null;
    return meter <= VOLL ? '1' : (0.7 - 0.25 * anteil(meter, VOLL, REICHWEITE)).toFixed(2);
  }

  const ICON: Record<string, string> = {
    pfeil: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 15l7-7 7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    video: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="13" height="12" rx="2" fill="currentColor"/><path d="M17 10l4-2v8l-4-2z" fill="currentColor"/></svg>',
    audio: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14v-2a8 8 0 0116 0v2" fill="none" stroke="currentColor" stroke-width="2.4"/><rect x="3" y="13" width="4" height="7" rx="1.5" fill="currentColor"/><rect x="17" y="13" width="4" height="7" rx="1.5" fill="currentColor"/></svg>',
    text: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M5 12h14M5 17h9" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>',
    galerie: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V9l8-5 8 5v11z M9 20v-6h6v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>',
  };
  ICON.foto = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2" fill="currentColor"/><circle cx="12" cy="12.5" r="3.4" fill="#c5a55a"/><path d="M8 6l1.5-2h5L16 6z" fill="currentColor"/></svg>';
  const MEDIUM: Record<string, string> = { video: 'Video', audio: 'Tonaufnahme', text: 'Text', foto: 'Foto' };

  function knopf(div: HTMLElement, klasse: string, html: string, label: string, aktion: () => void, meter = 0, gross?: string) {
    div.classList.add('astro-rg-hs');
    div.style.setProperty('--rg-gross', gross ?? groesse(meter));
    const b = document.createElement('button');
    b.type = 'button';
    b.className = klasse;
    b.innerHTML = html;
    b.setAttribute('aria-label', label);
    b.addEventListener('click', (e) => { e.stopPropagation(); aktion(); });
    b.addEventListener('pointerdown', (e) => e.stopPropagation());
    div.appendChild(b);
  }

  function hotspots(s: Station) {
    const liste: any[] = [];
    for (const v of s.verbindungen) {
      const ziel = typeof v === 'string' ? v : v.ziel;
      const z = stationen[ziel];
      if (!z) continue;
      // Wegpunkt sitzt am Ziel; mit `"wegpunkt": "umweg"` stattdessen am letzten Umwegpunkt (Ziel verdeckt
      // oder Wegpunkt fiele auf einen Infopunkt, z. B. Altar, Ambo, Taufstein).
      const umweg = typeof v === 'object' && v.wegpunkt === 'umweg' && v.ueber?.length ? v.ueber[v.ueber.length - 1] : null;
      const r = umweg ? richtung(s, umweg, s.boden || 0, 0) : richtung(s, z.position, z.boden || 0, 0);
      const yaw = typeof v === 'object' && v.yaw !== undefined ? v.yaw : r.yaw;
      const pitch = typeof v === 'object' && v.pitch !== undefined ? v.pitch : Math.max(-40, Math.min(-3, r.pitch));
      const label = (typeof v === 'object' && v.label) || z.titel;
      liste.push({
        yaw, pitch, type: 'custom', cssClass: 'astro-rg-hs-weg',
        createTooltipFunc: (div: HTMLElement) => {
          knopf(div, 'astro-rg-weg', `<span class="astro-rg-weg-punkt">${ICON.pfeil}</span><span class="astro-rg-hs-label">${label}</span>`, `Weitergehen: ${label}`, () => gehZu(ziel, { ueber: yaw }), r.raum);
          const b = div.querySelector('button')!;
          const an = () => hebeLinieHervor(ziel), aus = () => hebeLinieHervor(null);
          b.addEventListener('mouseenter', an); b.addEventListener('focus', an);
          b.addEventListener('mouseleave', aus); b.addEventListener('blur', aus);
        },
      });
    }
    for (const i of daten.infopunkte.filter((p: any) => p.sichtbarVon.includes(s.id))) {
      // `ansichten.<station>`: Lage im Bild von Hand (z. B. von der Empore, wo Objekthöhen von oben nicht passen)
      const berechnet = richtung(s, i.position, i.boden || 0, i.hoehe ?? 1.5);
      const gross = infoGroesse(berechnet.raum, s, i.id);
      if (gross === null) continue;
      const r = i.ansichten?.[s.id] || berechnet;
      liste.push({
        yaw: r.yaw, pitch: r.pitch, type: 'custom', cssClass: 'astro-rg-hs-info',
        createTooltipFunc: (div: HTMLElement) =>
          knopf(div, 'astro-rg-info', `<span aria-hidden="true">i</span><span class="astro-rg-hs-label">${i.titel}</span>`, `Info: ${i.titel}`, () => zeigeInfo(i), berechnet.raum, gross),
      });
    }
    // Geschichten hängen nicht mehr im Raum, sondern gesammelt in der Heiligengalerie (Frank 2026-11-04):
    // an ihrer Station nur ein Knopf auf den Stufen zum Hochaltar, der den Zylinder hochfährt.
    if (s.id === GAL.station && !daten.gedenktafeln?.aktiv) {
      const r = richtung(s, GAL.knopf, GAL.knopf.boden || 0, GAL.knopf.hoehe ?? 0.4);
      liste.push({
        yaw: r.yaw, pitch: r.pitch, type: 'custom', cssClass: 'astro-rg-hs-geschichte',
        createTooltipFunc: (div: HTMLElement) =>
          knopf(div, 'astro-rg-hg-knopf', `${ICON.galerie}<span>${GAL.titel}</span>`, `${GAL.titel} öffnen – ${daten.geschichten.length} Geschichten`, oeffneGalerie, 0, '1'),
      });
    }
    for (const gal of daten.galerien.filter((x: any) => x.station === s.id)) {
      liste.push({
        yaw: gal.yaw, pitch: gal.pitch, type: 'custom', cssClass: 'astro-rg-hs-info',
        createTooltipFunc: (div: HTMLElement) =>
          knopf(div, 'astro-rg-galerie',`${ICON.galerie}<span>${gal.titel}</span>`, `${gal.titel} öffnen`, () => zeigeGalerie(gal)),
      });
    }
    return liste;
  }
  function titelAus() {
    document.querySelectorAll('.astro-rg-titel-an').forEach((x) => x.classList.remove('astro-rg-titel-an'));
  }

  // ---------- Heiligengalerie (Frank 2026-11-04) ----------
  // Ein durchsichtiger Zylinder rund um die Station: Knopf antippen → der Zylinder fährt von unten hoch
  // (gezeichnet als Band zwischen Unter- und Oberkante, Projektion wie die Bodenlinien), dann erscheinen
  // ringsum die Geschichten – bewusst durcheinander in Reihenfolge und Höhe, aber ohne sich zu überdecken.
  const GAL = daten.heiligengalerie;
  const HUB_MS = 1100;
  let galerieOffen = false;
  let hub = 0;                 // 0 = Zylinder unten, 1 = ganz hochgezogen
  let hubZiel = 0;

  function geschichteKnopf(div: HTMLElement, g: any) {
    const bild = g.vorschaubild
      ? `<img src="${g.vorschaubild}" alt="">`
      : `<span class="astro-rg-initialen">${g.kuerzel || (g.person || g.titel).split(/\s+/).map((w: string) => w[0]).join('').slice(0, 2)}</span>`;
    const zeile = [g.titel, g.jahr].filter(Boolean).join(' · ');
    // Titel nur beim Drüberfahren; auf Touch-Geräten zeigt der erste Tipp den Titel, der zweite öffnet.
    let tippen = false;
    knopf(div, 'astro-rg-geschichte', `<span class="astro-rg-portrait">${bild}<span class="astro-rg-medium">${ICON[g.medium] || ''}</span></span><span class="astro-rg-hs-label">${zeile}</span>`,
      `Geschichte: ${zeile} (${MEDIUM[g.medium] || ''})`, () => {
        if (tippen && !b.classList.contains('astro-rg-titel-an')) {
          titelAus();
          b.classList.add('astro-rg-titel-an');
          return;
        }
        titelAus();
        zeigeGeschichte(g);
      }, 0, '1');
    const b = div.querySelector('button')!;
    b.addEventListener('pointerdown', (e) => { tippen = e.pointerType !== 'mouse'; });
  }

  // Feste „Zufalls“-Verteilung (gleicher Startwert → bei jedem Besuch dieselbe Anordnung).
  function zufallszahlen(start: number) {
    let a = start;
    return () => { a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
  }
  const galerieLage: { g: any; yaw: number; pitch: number; verz: number }[] = (() => {
    const zz = zufallszahlen(1927);
    const liste = [...daten.geschichten];
    for (let i = liste.length - 1; i > 0; i--) { const j = Math.floor(zz() * (i + 1)); [liste[i], liste[j]] = [liste[j], liste[i]]; }
    const schritt = 360 / Math.max(1, liste.length);
    const knopfYaw = richtung(stationen[GAL.station], GAL.knopf).yaw;
    // drei Höhenlagen im Wechsel, damit Nachbarn nie auf gleicher Höhe hängen; dazu etwas Streuung
    const rand = 8, unten = GAL.ring.unten + rand, oben = GAL.ring.oben - rand, lagen = [unten, (unten + oben) / 2, oben];
    const reihe = [0, 2, 1];
    return liste.map((g, i) => ({
      g,
      yaw: wrap(knopfYaw + i * schritt + (zz() - 0.5) * schritt * 0.5),
      pitch: lagen[reihe[i % 3]] + (zz() - 0.5) * 7,
      verz: Math.round(zz() * 500),
    }));
  })();

  function hubAnimieren(ziel: number, fertig?: () => void) {
    hubZiel = ziel;
    if (ruhig) { hub = ziel; fertig?.(); return; }
    const start = hub, t0 = performance.now(), dauer = HUB_MS * Math.abs(ziel - start);
    (function schritt(t: number) {
      if (hubZiel !== ziel) return;   // inzwischen umgekehrt
      const x = dauer ? Math.min(1, (t - t0) / dauer) : 1;
      hub = start + (ziel - start) * (1 - Math.pow(1 - x, 3));
      if (x < 1) requestAnimationFrame(schritt); else fertig?.();
    })(t0);
  }
  function oeffneGalerie() {
    if (galerieOffen || viewer.getScene() !== GAL.station) return;
    galerieOffen = true;
    titelAus();
    viewerEl.classList.add('astro-rg-galerie-offen');
    hgSteuerung.hidden = false;
    // schmale Bildschirme: etwas hineinzoomen, sonst drängen sich die Porträts nebeneinander
    if (viewerEl.clientWidth < 640 && viewer.getHfov() > 65) viewer.setHfov(65, ruhig ? false : 600);
    hubAnimieren(1, () => {
      if (!galerieOffen) return;
      galerieLage.forEach(({ g, yaw, pitch, verz }) =>
        viewer.addHotSpot({
          id: `hg-${g.id}`, yaw, pitch, type: 'custom', cssClass: 'astro-rg-hs-zylinder',
          createTooltipFunc: (div: HTMLElement) => { div.style.setProperty('--verz', `${verz}ms`); geschichteKnopf(div, g); },
        }, GAL.station),
      );
    });
    (document.getElementById('astro-rg-hg-zu') as HTMLButtonElement).focus();
  }
  function schliesseGalerie(sofort = false) {
    if (!galerieOffen) return;
    galerieOffen = false;
    titelAus();
    galerieLage.forEach(({ g }) => { try { viewer.removeHotSpot(`hg-${g.id}`, GAL.station); } catch {} });
    hgSteuerung.hidden = true;
    const ende = () => viewerEl.classList.remove('astro-rg-galerie-offen');
    if (sofort) { hubZiel = 0; hub = 0; ende(); } else hubAnimieren(0, ende);
  }
  // Pfeile: Blick zur nächsten Geschichte links/rechts drehen (auch ohne Ziehen bedienbar)
  function blaettere(richtungPfeil: 1 | -1) {
    const jetzt = viewer.getYaw();
    const abstand = (y: number) => ((richtungPfeil * (y - jetzt)) % 360 + 360) % 360;
    const naechste = galerieLage.filter((l) => abstand(l.yaw) > 3).sort((a, b) => abstand(a.yaw) - abstand(b.yaw))[0];
    if (naechste) viewer.lookAt(naechste.pitch, naechste.yaw, viewer.getHfov(), ruhig ? false : 700);
  }

  // ---------- Bodenlinien (Frank 2026-10-30) ----------
  // Zu jedem erreichbaren Standpunkt ein schmales Band, das auf dem Fußboden liegt statt als Luftlinie
  // durch den Raum zu gehen. Das Band wird einmal pro Station als Folge von Bodenpunkten (Richtung/Neigung
  // ab Kamera) vorberechnet und bei jeder Drehung mit derselben Formel wie Pannellums Hotspots
  // (pannellum.js, Funktion `Ca`) aufs Bild projiziert. Es liegt immer obenauf – Stühle o. Ä. verdecken
  // es nicht; deshalb schmal und halb durchsichtig. Umwege (z. B. am Altar vorbei): `ueber` in der Verbindung.
  const BAND = 0.09;          // halbe Bandbreite in Metern
  const ABSTAND_START = 0.9;  // erst ab hier zeichnen (darunter Stativ-Flicken im Boden)
  const ABSTAND_ENDE = 0.4;   // kurz vor dem Ziel aufhören (dort sitzt der Wegpunkt)
  type Kante = { l: [number, number]; r: [number, number]; anteil: number; weg: number };
  type Linie = { ziel: string; kanten: Kante[] };

  function bodenlinien(s: Station): Linie[] {
    if (s.ebene) return [];
    const m = (p: Pos) => ({ x: (p.x / 100) * W, y: (p.y / 100) * H });
    const ich = m(s.position), b0 = s.boden || 0;
    const linien: Linie[] = [];
    for (const v of s.verbindungen) {
      const ziel = typeof v === 'string' ? v : v.ziel;
      const z = stationen[ziel];
      if (!z || z.ebene) continue;
      const pkt = [s.position, ...((typeof v === 'object' && v.ueber) || []), z.position].map(m);
      const laengen = pkt.slice(1).map((p, i) => Math.hypot(p.x - pkt[i].x, p.y - pkt[i].y));
      const L = laengen.reduce((a, b) => a + b, 0);
      const b1 = z.boden || 0;
      const kanten: Kante[] = [];
      for (let d = ABSTAND_START; d <= L - ABSTAND_ENDE; d += 0.25) {
        let rest = d, i = 0;
        while (i < laengen.length - 1 && rest > laengen[i]) { rest -= laengen[i]; i++; }
        const a = pkt[i], b = pkt[i + 1], t = rest / laengen[i];
        const x = a.x + (b.x - a.x) * t, y = a.y + (b.y - a.y) * t;
        const nx = -(b.y - a.y) / laengen[i], ny = (b.x - a.x) / laengen[i];
        const hoehe = b0 + (b1 - b0) * (d / L) - (b0 + KAMERA);   // Treppe zum Chorraum: linear ansteigend
        const winkel = (px: number, py: number): [number, number] => [
          wrap(grad(Math.atan2(py - ich.y, px - ich.x)) - s.blickrichtung),
          grad(Math.atan2(hoehe, Math.hypot(px - ich.x, py - ich.y))),
        ];
        kanten.push({ l: winkel(x + nx * BAND, y + ny * BAND), r: winkel(x - nx * BAND, y - ny * BAND), anteil: d / L, weg: d });
      }
      linien.push({ ziel, kanten });
    }
    return linien;
  }

  const rad = (g: number) => (g * Math.PI) / 180;
  function projPunkt([yaw, pitch]: [number, number], v: { yaw: number; pitch: number; hfov: number; w: number; h: number }): [number, number] | null {
    const f = Math.sin(rad(pitch)), c = Math.cos(rad(pitch)), d = Math.sin(rad(v.pitch)), e = Math.cos(rad(v.pitch));
    const g = Math.cos(rad(v.yaw - yaw)), z = f * d + c * g * e;
    if (z <= 0.02) return null;   // hinter dem Betrachter
    const l = Math.sin(rad(v.yaw - yaw)), k = Math.tan(rad(v.hfov / 2));
    return [v.w / 2 - (v.w / k) * l * c / z / 2, v.h / 2 - (v.w / k) * (f * e - c * g * d) / z / 2];
  }
  function projiziere(p: [number, number], v: { yaw: number; pitch: number; hfov: number; w: number; h: number }) {
    const q = projPunkt(p, v);
    return q ? `${q[0].toFixed(1)},${q[1].toFixed(1)}` : null;
  }

  const linienProStation: Record<string, Linie[]> = {};
  const linienSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  linienSvg.setAttribute('class', 'astro-rg-linien');
  linienSvg.setAttribute('aria-hidden', 'true');
  let hervorgehoben: string | null = null;
  let letzterStand = '';

  function zeichneLinien() {
    const canvas = viewer.getRenderer()?.getCanvas();
    if (!canvas) return;
    if (linienSvg.parentNode !== canvas.parentNode) canvas.parentNode.insertBefore(linienSvg, canvas.nextSibling);
    const v = { yaw: viewer.getYaw(), pitch: viewer.getPitch(), hfov: viewer.getHfov(), w: canvas.clientWidth, h: canvas.clientHeight };
    const stand = [viewer.getScene(), v.yaw.toFixed(2), v.pitch.toFixed(2), v.hfov.toFixed(2), v.w, v.h, hervorgehoben, hub.toFixed(3)].join('|');
    if (stand === letzterStand) return;
    letzterStand = stand;
    linienSvg.setAttribute('viewBox', `0 0 ${v.w} ${v.h}`);
    let svg = '';
    if (hub > 0 && viewer.getScene() === GAL.station) {
      // Heiligengalerie: Band zwischen Unterkante und (hochfahrender) Oberkante, nur im Blickfeld berechnet
      const unten = GAL.ring.unten, oben = unten + (GAL.ring.oben - unten) * hub, weite = v.hfov / 2 + 45;
      const kante = (p: number) => {
        const pkte: string[] = [];
        for (let y = v.yaw - weite; y <= v.yaw + weite; y += 2) { const q = projiziere([y, p], v); if (q) pkte.push(q); }
        return pkte;
      };
      const o = kante(oben), u = kante(unten);
      linienSvg.innerHTML = `<polygon class="astro-rg-zylinder" points="${[...o, ...[...u].reverse()].join(' ')}"/>`
        + `<polyline class="astro-rg-zylinder-rand" points="${o.join(' ')}"/><polyline class="astro-rg-zylinder-rand" points="${u.join(' ')}"/>`;
      return;
    }
    for (const linie of linienProStation[viewer.getScene()] || []) {
      const aktiv = linie.ziel === hervorgehoben;
      svg += `<g class="${aktiv ? 'astro-rg-linie-aktiv' : ''}">`;
      for (let i = 0; i < linie.kanten.length - 1; i++) {
        const a = linie.kanten[i], b = linie.kanten[i + 1];
        const ecken = [projiziere(a.l, v), projiziere(b.l, v), projiziere(b.r, v), projiziere(a.r, v)];
        if (ecken.includes(null)) continue;
        // sanft einblenden direkt vor den Füßen, erst kurz vor dem Wegpunkt leicht ausblenden (Frank 2026-10-30:
        // die Linie soll sichtbar bis zum Wegpunkt reichen)
        const deckkraft = Math.min(1, (a.weg - ABSTAND_START) / 0.8 + 0.15) * (a.anteil > 0.9 ? 1 - (a.anteil - 0.9) * 4 : 1);
        svg += `<polygon points="${ecken.join(' ')}" fill-opacity="${deckkraft.toFixed(2)}"/>`;
      }
      svg += '</g>';
    }
    linienSvg.innerHTML = svg;
  }
  function hebeLinieHervor(ziel: string | null) { hervorgehoben = ziel; }

  // ---------- Heiligengalerie als Tafelwand (Frank 2026-11-05) ----------
  // Jede Geschichte als goldene Tafel, fest an einer Wand: Die Tafel ist ein echtes Rechteck im Raum
  // (Wand aus `gedenktafeln.waende`, Lage in Metern). Ihre vier Ecken werden je Bild mit derselben
  // Projektion wie Pannellum aufs Bild gerechnet und die Tafel per CSS-matrix3d genau in dieses Viereck
  // gezogen – so sitzt sie von jeder Station aus perspektivisch richtig an der Wand. Das Foto kennt keine
  // Tiefe: Wo etwas davorsteht, die Wand per `verdecktVon` für diese Station ausblenden. Die Ebene liegt
  // unter Pannellums Zieh-Fläche (Umschauen bleibt überall möglich); Klicks werden selbst zugeordnet.
  const GT = daten.gedenktafeln;
  const TAFELN_AN = !!GT?.aktiv;
  // Detailstufen (wie Mipmaps): Die Tafel wird in etwa der Größe gezeichnet, in der sie gerade im Bild erscheint
  // (75/150/300/600 px breit). Zu groß gezeichnet und dann stark verkleinert flimmert sie pixelig, zu klein
  // gezeichnet und vergrößert verschwimmt sie. Alle Maße im CSS hängen an --u (= Breite / 200).
  const STUFEN = [75, 150, 300, 600];
  const SEITEN = (GT?.format.hoehe ?? 0.68) / (GT?.format.breite ?? 0.5);
  const DICKE = 0.02;          // Plattenstärke in m – ergibt je nach Blickwinkel sichtbare Kanten
  type P3 = [number, number, number];
  type Kante = { el: HTMLElement; idx: number[]; normale: P3; punkt: P3 };
  type Tafel = {
    g: any; wand: any; mitte: P3; n: [number, number]; el: HTMLButtonElement; stufe: number;
    punkte: P3[];              // 0–3 Vorderseite, 4–7 an der Wand, 8–11 Schatten (je oben-links, oben-rechts, unten-rechts, unten-links)
    kanten: Kante[]; schatten: HTMLElement;
  };
  type Eck = [number, number];
  const rgViewerEl = document.getElementById('astro-rg-viewer')!;
  const tafelEbene = document.createElement('div');
  tafelEbene.className = 'astro-rg-tafeln';
  const tafelLabel = document.createElement('span');
  tafelLabel.className = 'astro-rg-tafel-label';
  tafelLabel.setAttribute('aria-hidden', 'true');
  tafelEbene.appendChild(tafelLabel);
  const tafeln: Tafel[] = [];
  if (TAFELN_AN) {
    const waende = Object.fromEntries(GT.waende.map((w: any) => [w.id, w]));
    for (const t of GT.tafeln) {
      const w = waende[t.wand];
      const g = daten.geschichten.find((x: any) => x.id === t.geschichte);
      if (!w || !g) continue;
      const ax = (w.a.x / 100) * W, ay = (w.a.y / 100) * H, bx = (w.b.x / 100) * W, by = (w.b.y / 100) * H;
      const L = Math.hypot(bx - ax, by - ay), dx = (bx - ax) / L, dy = (by - ay) / L;
      const n: [number, number] = [dy, -dx];             // Vorderseite: links von a→b
      const rx = n[1], ry = -n[0];                         // „rechts“ für jemanden, der auf die Wand schaut
      const cx = ax + dx * t.entlang, cy = ay + dy * t.entlang, cz = (w.boden || 0) + t.hoehe;
      const hb = GT.format.breite / 2, hh = GT.format.hoehe / 2;
      const ecke = (sr: number, sz: number, vor: number, unten = 0, rand = 0): P3 =>
        [cx + rx * (hb + rand) * sr + n[0] * vor, cy + ry * (hb + rand) * sr + n[1] * vor, cz - unten + (hh + rand) * sz];
      const reihum: [number, number][] = [[-1, 1], [1, 1], [1, -1], [-1, -1]];
      const punkte: P3[] = [
        ...reihum.map(([a, b]) => ecke(a, b, DICKE)),
        ...reihum.map(([a, b]) => ecke(a, b, 0)),
        ...reihum.map(([a, b]) => ecke(a, b, 0, 0.045, 0.012)),   // Schatten: Licht von oben → etwas tiefer
      ];
      // Kanten der Platte: oben, rechts, unten, links – sichtbar, wenn ihre Außenseite zur Kamera zeigt
      const kanten: Kante[] = ([
        ['oben', [0, 1, 5, 4], [0, 0, 1]], ['rechts', [1, 2, 6, 5], [rx, ry, 0]],
        ['unten', [3, 2, 6, 7], [0, 0, -1]], ['links', [0, 3, 7, 4], [-rx, -ry, 0]],
      ] as [string, number[], P3][]).map(([seite, idx, normale]) => {
        const k = document.createElement('span');
        k.className = `astro-rg-tafel-kante astro-rg-tafel-kante-${seite}`;
        k.setAttribute('aria-hidden', 'true');
        return { el: k, idx, normale, punkt: punkte[idx[0]] };
      });
      const schatten = document.createElement('span');
      schatten.className = 'astro-rg-tafel-schatten';
      schatten.setAttribute('aria-hidden', 'true');
      const el = document.createElement('button');
      el.type = 'button';
      el.className = 'astro-rg-tafel';
      const zeile = [g.titel, g.jahr].filter(Boolean).join(' · ');
      el.setAttribute('aria-label', `Geschichte: ${zeile} (${MEDIUM[g.medium] || ''})`);
      // `tafelbild`: großes Hochformat-Porträt (480 × 600) eigens für die Tafel, sonst das kleine Vorschaubild
      const tb = g.tafelbild || g.vorschaubild;
      const bild = tb
        ? `<img src="${tb}" alt="" draggable="false" decoding="async">`
        : `<span class="astro-rg-tafel-initialen">${g.kuerzel || (g.person || g.titel).split(/\s+/).map((x: string) => x[0]).join('').slice(0, 2)}</span>`;
      el.innerHTML = `<span class="astro-rg-tafel-bild">${bild}</span><span class="astro-rg-tafel-name">${g.person || ''}</span>`
        + `<span class="astro-rg-tafel-titel">${g.titel}</span><span class="astro-rg-tafel-jahr">${g.jahr || ''}</span>`;
      el.addEventListener('click', () => zeigeGeschichte(g));
      const tafel: Tafel = { g, wand: w, mitte: [cx, cy, cz], n, el, stufe: 0, punkte, kanten, schatten };
      setzeStufe(tafel, 150);
      // Tastatur: beim Ansteuern mit Tab die Tafel ins Bild drehen
      el.addEventListener('focus', () => {
        const s = stationen[viewer.getScene()];
        const k = GT.korrektur?.[s.id]?.[w.id] ?? 0;
        const [kd, kn] = Array.isArray(k) ? k : [k, 0];
        const [y0, p0] = winkel(s, tafel.mitte);
        const yaw = wrap(y0 + kd), pitch = p0 + kn;
        viewer.lookAt(pitch, yaw, Math.min(viewer.getHfov(), 70), ruhig ? false : 600);
      });
      tafelEbene.append(schatten, ...kanten.map((k) => k.el), el);
      tafeln.push(tafel);
    }
  }
  function winkel(s: Station, [x, y, z]: [number, number, number]): Eck {
    const sx = (s.position.x / 100) * W, sy = (s.position.y / 100) * H;
    return [wrap(grad(Math.atan2(y - sy, x - sx)) - s.blickrichtung),
      grad(Math.atan2(z - ((s.boden || 0) + KAMERA), Math.hypot(x - sx, y - sy)))];
  }
  function setzeStufe(t: Tafel, breite: number) {
    if (t.stufe === breite) return;
    t.stufe = breite;
    t.el.style.width = `${breite}px`;
    t.el.style.height = `${Math.round(breite * SEITEN)}px`;
    t.el.style.setProperty('--u', `${breite / 200}px`);
  }
  // je Station einmal: welche Tafeln sind von dort zu sehen (Vorderseite, Reichweite, nicht verdeckt),
  // die Winkel aller Eckpunkte, welche Plattenkanten zur Kamera zeigen und wo der Glanz liegt
  type Sicht = { t: Tafel; winkel: Eck[]; meter: number; kanten: Kante[]; glanz: number };
  const tafelnProStation: Record<string, Sicht[]> = {};
  for (const s of Object.values(stationen)) {
    const sx = (s.position.x / 100) * W, sy = (s.position.y / 100) * H, sz = (s.boden || 0) + KAMERA;
    tafelnProStation[s.id] = tafeln
      .filter((t) => !t.wand.verdecktVon?.includes(s.id) && (sx - t.mitte[0]) * t.n[0] + (sy - t.mitte[1]) * t.n[1] > 0.3)
      .map((t) => {
        const zu = (p: P3) => [sx - p[0], sy - p[1], sz - p[2]];
        const kanten = t.kanten.filter((k) => { const d = zu(k.punkt); return d[0] * k.normale[0] + d[1] * k.normale[1] + d[2] * k.normale[2] > 0; });
        // seitlicher Blickwinkel auf die Tafel → Lage des Glanzstreifens (frontal = Mitte)
        const d = zu(t.mitte), lang = Math.hypot(d[0], d[1]);
        const seitlich = (d[0] * t.n[1] - d[1] * t.n[0]) / lang;
        // gemessene Korrektur je Station und Wand (gleicht kleine Lagefehler der Stationen aus)
        const k = GT.korrektur?.[s.id]?.[t.wand.id] ?? 0;
        const [kd, kn] = Array.isArray(k) ? k : [k, 0];
        const wk = t.punkte.map((p) => { const [y, n] = winkel(s, p); return [wrap(y + kd), n + kn] as Eck; });
        return { t, winkel: wk, meter: lang, kanten, glanz: Math.round(50 + seitlich * 45) };
      })
      .filter((x) => x.meter <= GT.reichweiteMeter);
  }
  // Viereck (Bildpunkte, Reihenfolge oben-links, oben-rechts, unten-rechts, unten-links) → CSS matrix3d
  function matrixFuer(q: Eck[], w: number, h: number) {
    const [[x0, y0], [x1, y1], [x2, y2], [x3, y3]] = q;
    const sx = x0 - x1 + x2 - x3, sy = y0 - y1 + y2 - y3;
    const dx1 = x1 - x2, dx2 = x3 - x2, dy1 = y1 - y2, dy2 = y3 - y2, den = dx1 * dy2 - dx2 * dy1;
    if (Math.abs(den) < 1e-9) return null;
    const g = (sx * dy2 - dx2 * sy) / den, k = (dx1 * sy - sx * dy1) / den;
    const a = x1 - x0 + g * x1, b = x3 - x0 + k * x3, d = y1 - y0 + g * y1, e = y3 - y0 + k * y3;
    return `matrix3d(${[a / w, d / w, 0, g / w, b / h, e / h, 0, k / h, 0, 0, 1, 0, x0, y0, 0, 1].map((z) => +z.toPrecision(9)).join(',')})`;   // signifikante Stellen: die Perspektiv-Werte sind winzig
  }
  let tafelQuads: { t: Tafel; q: Eck[] }[] = [];
  let verdeckt: Eck[][] = [];   // Umrisse der Verdecker im Bild (für die Trefferprüfung)
  const innenPolygon = (px: number, py: number, pg: Eck[]) => {
    let drin = false;
    for (let i = 0, j = pg.length - 1; i < pg.length; j = i++) {
      const [xi, yi] = pg[i], [xj, yj] = pg[j];
      if ((yi > py) !== (yj > py) && px < ((xj - xi) * (py - yi)) / (yj - yi) + xi) drin = !drin;
    }
    return drin;
  };
  let tafelStand = '';
  let tafelUeber: Tafel | null = null;
  function zeichneTafeln() {
    if (!TAFELN_AN) return;
    const canvas = viewer.getRenderer()?.getCanvas();
    if (!canvas) return;
    if (tafelEbene.parentNode !== canvas.parentNode) canvas.parentNode.insertBefore(tafelEbene, linienSvg.nextSibling);
    const v = { yaw: viewer.getYaw(), pitch: viewer.getPitch(), hfov: viewer.getHfov(), w: canvas.clientWidth, h: canvas.clientHeight };
    const stand = [viewer.getScene(), v.yaw.toFixed(2), v.pitch.toFixed(2), v.hfov.toFixed(2), v.w, v.h, tafelUeber?.g.id].join('|');
    if (stand === tafelStand) return;
    tafelStand = stand;
    const sichtbar = tafelnProStation[viewer.getScene()] || [];
    tafelQuads = [];
    const weg = 'translate(-99999px, 0)';
    for (const t of tafeln) {
      const x = sichtbar.find((y) => y.t === t);
      const q = x ? x.winkel.map((e) => projPunkt(e, v)) : [];
      const vorn = q.slice(0, 4) as Eck[];
      const ok = !!x && !q.includes(null);
      // Detailstufe nach der Breite im Bild wählen (vor dem Berechnen der Matrix, die hängt an der Größe)
      if (ok) {
        const breite = Math.max(Math.hypot(vorn[1][0] - vorn[0][0], vorn[1][1] - vorn[0][1]), Math.hypot(vorn[2][0] - vorn[3][0], vorn[2][1] - vorn[3][1]));
        setzeStufe(t, STUFEN.find((s) => s >= breite * 0.9) ?? STUFEN[STUFEN.length - 1]);
      }
      const m = ok ? matrixFuer(vorn, t.stufe, Math.round(t.stufe * SEITEN)) : null;
      // Von dieser Station aus nicht zu sehen → ganz aus (auch für die Tastatur). Nur gerade außerhalb des
      // Blickfelds → aus dem Bild schieben, aber per Tab erreichbar lassen (Fokus dreht dann dorthin).
      t.el.style.visibility = x ? 'visible' : 'hidden';
      if (!m) {
        t.el.style.transform = weg; t.schatten.style.transform = weg;
        t.kanten.forEach((k) => (k.el.style.transform = weg));
        continue;
      }
      t.el.style.transform = m;
      t.el.style.setProperty('--glanz', `${x!.glanz}%`);
      t.schatten.style.transform = matrixFuer(q.slice(8, 12) as Eck[], 100, 100) || weg;
      for (const k of t.kanten) {
        k.el.style.transform = x!.kanten.includes(k) ? (matrixFuer(k.idx.map((i) => q[i]) as Eck[], 100, 10) || weg) : weg;
      }
      t.el.classList.toggle('astro-rg-tafel-ueber', t === tafelUeber);
      tafelQuads.push({ t, q: vorn });
    }
    // Verdecker (z. B. Lesepult vor einer Tafel): Tafel-Ebene dort ausschneiden, damit das Objekt aus dem Foto
    // davor bleibt. Ausschnitt im Bild = alles minus Umriss (evenodd).
    let ausschnitt = '';
    verdeckt = [];
    for (const vd of GT.verdecker?.[viewer.getScene()] || []) {
      const pk = vd.umriss.map((u: Eck) => projPunkt(u, v));
      if (pk.includes(null)) continue;
      verdeckt.push(pk as Eck[]);
      ausschnitt += ` M${pk.map((p: Eck) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' L')} Z`;
    }
    tafelEbene.style.clipPath = ausschnitt ? `path(evenodd, "M-10 -10 H${v.w + 10} V${v.h + 10} H-10 Z${ausschnitt}")` : '';
    // Titel über der Tafel, auf die der Mauszeiger zeigt (hilft vor allem bei weit entfernten Tafeln)
    const u = tafelQuads.find((x) => x.t === tafelUeber);
    if (u) {
      tafelLabel.textContent = [u.t.g.titel, u.t.g.jahr].filter(Boolean).join(' · ');
      tafelLabel.style.left = `${(u.q[0][0] + u.q[1][0]) / 2}px`;
      tafelLabel.style.top = `${Math.min(u.q[0][1], u.q[1][1])}px`;
      tafelLabel.classList.add('astro-rg-tafel-label-an');
    } else tafelLabel.classList.remove('astro-rg-tafel-label-an');
  }
  // Treffer: im Viereck – kleine (ferne) Tafeln bekommen eine Mindest-Trefferfläche von 28 px
  function tafelAn(px: number, py: number): Tafel | null {
    if (!TAFELN_AN || rgViewerEl.classList.contains('astro-rg-ohne-geschichte')) return null;
    if (verdeckt.some((pg) => innenPolygon(px, py, pg))) return null;
    for (let i = tafelQuads.length - 1; i >= 0; i--) {
      const { t, q } = tafelQuads[i];
      const xs = q.map((p) => p[0]), ys = q.map((p) => p[1]);
      const minX = Math.min(...xs), maxX = Math.max(...xs), minY = Math.min(...ys), maxY = Math.max(...ys);
      if (maxX - minX < 28 || maxY - minY < 28) {
        const mx = (minX + maxX) / 2, my = (minY + maxY) / 2;
        if (Math.abs(px - mx) <= Math.max(14, (maxX - minX) / 2) && Math.abs(py - my) <= Math.max(14, (maxY - minY) / 2)) return t;
        continue;
      }
      let innen = true;
      for (let j = 0; j < 4; j++) {
        const [ax, ay] = q[j], [bx, by] = q[(j + 1) % 4];
        if ((bx - ax) * (py - ay) - (by - ay) * (px - ax) < 0) { innen = false; break; }
      }
      if (innen) return t;
    }
    return null;
  }
  if (TAFELN_AN) {
    const lokal = (e: PointerEvent): Eck => {
      const r = (viewer.getRenderer()?.getCanvas() as HTMLElement).getBoundingClientRect();
      return [e.clientX - r.left, e.clientY - r.top];
    };
    let druck: { x: number; y: number; t: number } | null = null;
    rgViewerEl.addEventListener('pointerdown', (e) => { druck = { x: e.clientX, y: e.clientY, t: performance.now() }; });
    rgViewerEl.addEventListener('pointerup', (e) => {
      if (!druck || (e.target as HTMLElement).closest?.('.astro-rg-hs, .pnlm-controls-container')) { druck = null; return; }
      const kurz = Math.hypot(e.clientX - druck.x, e.clientY - druck.y) < 6 && performance.now() - druck.t < 600;
      druck = null;
      if (!kurz) return;
      const t = tafelAn(...lokal(e));
      if (t) zeigeGeschichte(t.g);
    });
    rgViewerEl.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || e.buttons) return;
      const t = (e.target as HTMLElement).closest?.('.astro-rg-hs') ? null : tafelAn(...lokal(e));
      if (t !== tafelUeber) { tafelUeber = t; rgViewerEl.classList.toggle('astro-rg-zeiger', !!t); }
    });
    rgViewerEl.addEventListener('pointerleave', () => { tafelUeber = null; rgViewerEl.classList.remove('astro-rg-zeiger'); });
  }

  // ---------- Viewer ----------
  const szenen: Record<string, any> = {};
  for (const s of Object.values(stationen)) {
    const k = daten.kacheln[s.id];
    szenen[s.id] = {
      type: 'multires',
      multiRes: { basePath: `${daten.kachelBasis}/${s.id}`, path: '/%l/%s%y_%x', extension: 'jpg', tileResolution: k.tileResolution, maxLevel: k.maxLevel, cubeResolution: k.cubeResolution },
      yaw: s.startblick.yaw, pitch: s.startblick.pitch, hfov: 100,
      hotSpots: hotspots(s),
    };
    linienProStation[s.id] = bodenlinien(s);
  }
  const ausAdresse = decodeURIComponent(location.hash.slice(1));
  const erste = stationen[ausAdresse] ? ausAdresse : daten.start;

  const viewer = (window as any).pannellum.viewer('astro-rg-viewer', {
    default: {
      firstScene: erste, sceneFadeDuration: ruhig ? 0 : 900, autoLoad: true,
      showFullscreenCtrl: false, showZoomCtrl: true, keyboardZoom: true, compass: false,
      minHfov: 30, maxHfov: 120, hfov: 100,
      strings: {
        loadButtonLabel: 'Rundgang laden', loadingLabel: 'Wird geladen …', bylineLabel: '',
        noPanoramaError: 'Kein Panorama gefunden.', fileAccessError: 'Die Datei %s konnte nicht geladen werden.',
        malformedURLError: 'Die Adresse des Panoramas ist fehlerhaft.',
        iOS8WebGLError: 'Ihr Gerät kann diese Ansicht leider nicht darstellen.',
        genericWebGLError: 'Ihr Browser unterstützt die nötige Grafikfunktion (WebGL) nicht. Bitte nutzen Sie die Liste der Orte unten.',
        textureSizeError: 'Dieses Panorama ist zu groß für Ihr Gerät.', unknownError: 'Unbekannter Fehler – bitte die Seite neu laden.',
      },
    },
    scenes: szenen,
  });

  // Linien bei jedem Bild nachführen (nur neu zeichnen, wenn sich Blick oder Größe geändert haben);
  // während der Überblendung zur nächsten Station ausblenden.
  (function schleife() { zeichneLinien(); zeichneTafeln(); requestAnimationFrame(schleife); })();
  viewer.on('scenechange', () => { schliesseGalerie(true); linienSvg.classList.add('astro-rg-linien-weg'); tafelEbene.classList.add('astro-rg-linien-weg'); tafelUeber = null; hervorgehoben = null; titelAus(); });
  // Tipp ins Bild (nicht auf einen Punkt) blendet einen offenen Geschichten-Titel wieder aus
  viewer.on('mousedown', (e: any) => { if (!e?.target?.closest?.('.astro-rg-hs')) titelAus(); });
  viewer.on('load', () => { letzterStand = ''; tafelStand = ''; linienSvg.classList.remove('astro-rg-linien-weg'); tafelEbene.classList.remove('astro-rg-linien-weg'); });

  // Gehen: kurz in Laufrichtung hineinzoomen, dann überblenden (Werner-Feedback 2026-09-23: sonst
  // fühlt sich der Wechsel wie Teleportieren an). Ankunft mit Blick in Laufrichtung.
  let laeuft = false;
  let fuehrungAktiv = false;
  let fuehrungIndex = 0;
  function gehZu(id: string, opt: { ueber?: number; startblick?: boolean } = {}) {
    if (laeuft || !stationen[id] || viewer.getScene() === id) return;
    const von = stationen[viewer.getScene()];
    const ziel = stationen[id];
    let yaw = ziel.startblick.yaw, pitch = ziel.startblick.pitch;
    if (!opt.startblick && von) {
      const r = richtung(von, ziel.position);
      const lauf = r.yaw + von.blickrichtung;            // Himmelsrichtung der Bewegung
      yaw = wrap(lauf - ziel.blickrichtung); pitch = 0;
      if (ziel.ebene === 'Empore' || von.ebene === 'Empore') { yaw = ziel.startblick.yaw; pitch = ziel.startblick.pitch; }
    }
    if (ruhig || opt.ueber === undefined) {
      viewer.loadScene(id, pitch, yaw, 100);
      return;
    }
    laeuft = true;
    const hf = viewer.getHfov();
    viewer.lookAt(viewer.getPitch(), opt.ueber, hf * 0.6, 450);
    setTimeout(() => {
      viewer.loadScene(id, pitch, yaw, hf * 0.6);
      viewer.on('load', function zurueck() {
        viewer.off('load', zurueck);
        viewer.setHfov(100, 600);
        setTimeout(() => (laeuft = false), 600);
      });
    }, 460);
  }

  // ---------- Anzeige der aktuellen Station ----------
  const ortEl = document.getElementById('astro-rg-ort')!;
  const punkte = document.querySelectorAll<HTMLButtonElement>('.astro-rg-punkt');
  function aktualisiere(id: string) {
    const s = stationen[id];
    ortEl.textContent = `${s.nr} · ${s.titel}`;
    punkte.forEach((p) => p.classList.toggle('astro-rg-punkt-aktiv', p.dataset.station === id));
    history.replaceState(null, '', `#${id}`);
    if (fuehrungAktiv) zeigeFuehrung(id);
    zeigeHier(id);
    vorladen(s);
  }
  viewer.on('scenechange', aktualisiere);

  // Karte „Hier stehen Sie“ unter dem Bild: Texte aus den Daten, die Liste „Von hier aus zu entdecken“ aus der
  // passenden Stationskarte unten kopiert (so bleiben beide immer gleich).
  const hier = document.getElementById('astro-rg-hier')!;
  function zeigeHier(id: string) {
    const s = stationen[id];
    document.getElementById('astro-rg-hier-nr')!.textContent = `Hier stehen Sie · Station ${s.nr}`;
    document.getElementById('astro-rg-hier-titel')!.textContent = s.titel;
    document.getElementById('astro-rg-hier-lage')!.textContent = s.ort;
    document.getElementById('astro-rg-hier-text')!.textContent = s.begleittext;
    const ziel = document.getElementById('astro-rg-hier-details')!;
    ziel.replaceChildren();
    const karte = document.getElementById(`astro-rg-ort-${id}`);
    const titel = karte?.querySelector('.astro-rg-ort-details-titel'), liste = karte?.querySelector('.astro-rg-ort-details');
    if (titel && liste) {
      const t2 = titel.cloneNode(true) as HTMLElement, l2 = liste.cloneNode(true) as HTMLElement;
      t2.id = 'astro-rg-hier-details-titel';
      l2.setAttribute('aria-labelledby', t2.id);
      ziel.append(t2, l2);
    }
  }

  // Nachbarstationen in grober Auflösung vorladen (Stufe 1 und 2), damit das Weitergehen flott ist.
  // Bewusst in einer Warteschlange mit wenigen gleichzeitigen Anfragen – schont Handy-Verbindungen
  // (und den lokalen Netlify-Entwicklungsserver, der bei hunderten parallelen Anfragen aussteigt).
  const vorgeladen = new Set<string>();
  const warteschlange: string[] = [];
  let aktiv = 0;
  function naechste() {
    while (aktiv < 3 && warteschlange.length) {
      aktiv++;
      const bild = new Image();
      bild.onload = bild.onerror = () => { aktiv--; naechste(); };
      bild.src = warteschlange.shift()!;
    }
  }
  function vorladen(s: Station) {
    const nachbarn = s.verbindungen.map((v) => (typeof v === 'string' ? v : v.ziel)).filter((id) => stationen[id] && !vorgeladen.has(id));
    const los = () => {
      for (const id of nachbarn) {
        vorgeladen.add(id);
        const k = daten.kacheln[id];
        let groesse = k.cubeResolution;
        const groessen: number[] = [];
        for (let l = k.maxLevel; l >= 1; l--) { groessen[l] = groesse; groesse = Math.floor(groesse / 2); }
        for (const l of [1, 2]) {
          const n = Math.ceil(groessen[l] / k.tileResolution);
          for (const f of 'fbudlr') for (let i = 0; i < n; i++) for (let j = 0; j < n; j++) {
            warteschlange.push(`${daten.kachelBasis}/${id}/${l}/${f}${i}_${j}.jpg`);
          }
        }
      }
      naechste();
    };
    setTimeout(los, 2500); // erst nachdem die aktuelle Station sichtbar ist
  }

  // ---------- Grundriss ----------
  const karte = document.getElementById('astro-rg-karte')!;
  const karteKnopf = document.getElementById('astro-rg-karte-knopf')!;
  const kegel = document.getElementById('astro-rg-kegel')!;
  let kegelLauf = 0;
  function zeichneKegel() {
    const s = stationen[viewer.getScene()];
    if (s) {
      const blick = viewer.getYaw() + s.blickrichtung;
      const breite = viewer.getHfov() / 2;
      const r = 9; // Länge in Prozent der Kartenbreite
      const k = s.karte || s.position;   // Punkt im Grundriss (Empore: neben dem Taufstein statt darüber)
      const pkt = (w: number) => {
        const a = ((blick + w) * Math.PI) / 180;
        return `${k.x + r * Math.cos(a)},${k.y + r * (W / H) * Math.sin(a)}`;
      };
      kegel.innerHTML = `<polygon points="${k.x},${k.y} ${pkt(-breite)} ${pkt(breite)}" />`;
    }
    kegelLauf = requestAnimationFrame(zeichneKegel);
  }
  function karteZeigen(offen: boolean) {
    karte.hidden = !offen;
    karteKnopf.setAttribute('aria-expanded', String(offen));
    cancelAnimationFrame(kegelLauf);
    if (offen) zeichneKegel();
  }
  karteKnopf.addEventListener('click', () => karteZeigen(karte.hidden));
  // Nach dem Sprung schließt sich der Grundriss, damit er den neuen Ort nicht verdeckt.
  punkte.forEach((p) => p.addEventListener('click', () => {
    karteZeigen(false);
    karteKnopf.focus();
    gehZu(p.dataset.station!, { startblick: true });
  }));

  // ---------- Vollbild (Bühne inkl. Bedienelemente) ----------
  const buehne = document.getElementById('astro-rg-buehne')!;
  const vollbild = document.getElementById('astro-rg-vollbild')!;
  if (buehne.requestFullscreen) {
    vollbild.hidden = false;
    vollbild.addEventListener('click', () => (document.fullscreenElement ? document.exitFullscreen() : buehne.requestFullscreen()));
    document.addEventListener('fullscreenchange', () => setTimeout(() => viewer.resize(), 50));
  }

  // ---------- Geführter Rundgang ----------
  const fuehrung = document.getElementById('astro-rg-fuehrung')!;
  const startBereich = document.getElementById('astro-rg-start-bereich')!;
  function zeigeFuehrung(id: string) {
    const idx = reihenfolge.indexOf(id);
    if (idx >= 0) fuehrungIndex = idx;
    const s = stationen[id];
    document.getElementById('astro-rg-fuehrung-nr')!.textContent = idx >= 0 ? `Station ${idx + 1} von ${reihenfolge.length}` : 'Abstecher – „Weiter“ führt zurück auf den Weg';
    document.getElementById('astro-rg-fuehrung-titel')!.textContent = s.titel;
    document.getElementById('astro-rg-fuehrung-text')!.textContent = s.begleittext;
    (document.getElementById('astro-rg-zurueck') as HTMLButtonElement).disabled = idx === 0;
    document.getElementById('astro-rg-weiter')!.textContent = idx === reihenfolge.length - 1 ? 'Rundgang beenden' : 'Weiter →';
  }
  function fuehrungZu(idx: number) {
    fuehrungIndex = Math.max(0, Math.min(reihenfolge.length - 1, idx));
    const id = reihenfolge[fuehrungIndex];
    if (viewer.getScene() === id) zeigeFuehrung(id); else gehZu(id, { startblick: true });
  }
  // Während der Führung wird der Viewer etwas niedriger, damit Bild und Begleittext samt
  // „Weiter“ gemeinsam auf einen Laptop-Bildschirm passen.
  const rgSektion = document.querySelector('.astro-rg') as HTMLElement;
  function fuehrungsModus(an: boolean) {
    rgSektion.classList.toggle('astro-rg-fuehrung-aktiv', an);
    hier.hidden = an;
    if (typeof viewer.resize === 'function') viewer.resize();
  }
  document.getElementById('astro-rg-start')!.addEventListener('click', () => {
    fuehrungAktiv = true;
    anfangWeg();
    fuehrung.hidden = false;
    startBereich.hidden = true;
    fuehrungsModus(true);
    fuehrungZu(0);
    zeigeFuehrung(reihenfolge[0]);
    buehne.scrollIntoView({ behavior: ruhig ? 'auto' : 'smooth', block: 'start' });
  });
  // Erster Hinweis „ins Bild tippen und ziehen“: weg, sobald man sich umgeschaut, gedreht oder weiterbewegt hat
  const anfang = document.getElementById('astro-rg-anfang')!;
  const anfangWeg = () => anfang.classList.add('astro-rg-anfang-weg');
  rgViewerEl.addEventListener('pointerdown', anfangWeg, { once: true });
  rgViewerEl.addEventListener('keydown', anfangWeg, { once: true });
  // Pannellum meldet beim ersten Laden auch einen „Wechsel“ zur Startstation – nur echte Wechsel zählen
  viewer.on('scenechange', (id: string) => { if (id !== erste) anfangWeg(); });
  // „Direkt zur Heiligengalerie“: zur Station mit dem besten Blick auf beide Tafelwände springen
  document.getElementById('astro-rg-zur-galerie')?.addEventListener('click', () => {
    const z = daten.gedenktafeln.direkt;
    anfangWeg();
    buehne.scrollIntoView({ behavior: ruhig ? 'auto' : 'smooth', block: 'start' });
    if (laeuft || !stationen[z.station]) return;
    if (viewer.getScene() === z.station) viewer.lookAt(z.pitch, z.yaw, z.hfov, ruhig ? false : 800);
    else viewer.loadScene(z.station, z.pitch, z.yaw, z.hfov);
  });
  function beende() {
    fuehrungAktiv = false;
    fuehrung.hidden = true;
    startBereich.hidden = false;
    fuehrungsModus(false);
    (document.getElementById('astro-rg-start') as HTMLButtonElement).focus({ preventScroll: true });
  }
  document.getElementById('astro-rg-weiter')!.addEventListener('click', () => {
    const aktuell = reihenfolge.indexOf(viewer.getScene());
    if (aktuell === reihenfolge.length - 1) return beende();
    fuehrungZu((aktuell >= 0 ? aktuell : fuehrungIndex) + 1);
  });
  document.getElementById('astro-rg-zurueck')!.addEventListener('click', () => {
    const aktuell = reihenfolge.indexOf(viewer.getScene());
    fuehrungZu((aktuell >= 0 ? aktuell : fuehrungIndex + 1) - 1);
  });
  document.getElementById('astro-rg-ende')!.addEventListener('click', beende);

  // ---------- Legende: Wege, Infopunkte, Geschichten ein/aus ----------
  const viewerEl = document.getElementById('astro-rg-viewer')!;

  // ---------- Heiligengalerie: Bedienung ----------
  const hgSteuerung = document.getElementById('astro-rg-hg-steuerung')!;
  document.getElementById('astro-rg-hg-zu')!.addEventListener('click', () => schliesseGalerie());
  document.getElementById('astro-rg-hg-links')!.addEventListener('click', () => blaettere(-1));
  document.getElementById('astro-rg-hg-rechts')!.addEventListener('click', () => blaettere(1));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && galerieOffen && !dialog.open) schliesseGalerie(); });
  document.querySelectorAll<HTMLButtonElement>('.astro-rg-hg-liste button[data-geschichte]').forEach((b) =>
    b.addEventListener('click', () => {
      const g = daten.geschichten.find((x: any) => x.id === b.dataset.geschichte);
      if (g) zeigeGeschichte(g);
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('.astro-rg-ebene').forEach((b) =>
    b.addEventListener('click', () => {
      const an = b.getAttribute('aria-pressed') !== 'true';
      b.setAttribute('aria-pressed', String(an));
      viewerEl.classList.toggle(`astro-rg-ohne-${b.dataset.ebene}`, !an);
    }),
  );

  // ---------- Liste der Orte ----------
  document.querySelectorAll<HTMLButtonElement>('.astro-rg-ort-karte button[data-station]').forEach((b) =>
    b.addEventListener('click', () => {
      buehne.scrollIntoView({ behavior: ruhig ? 'auto' : 'smooth', block: 'start' });
      gehZu(b.dataset.station!, { startblick: true });
    }),
  );

  // ---------- Dialoge ----------
  const dialog = document.getElementById('astro-rg-dialog') as HTMLDialogElement;
  const inhalt = document.getElementById('astro-rg-dialog-inhalt')!;
  document.getElementById('astro-rg-dialog-zu')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => { inhalt.querySelectorAll('video,audio').forEach((m) => (m as HTMLMediaElement).pause()); });

  function el(tag: string, text?: string, klasse?: string) {
    const e = document.createElement(tag);
    if (text) e.textContent = text;
    if (klasse) e.className = klasse;
    return e;
  }
  function oeffne(titel: string, teile: HTMLElement[], vorzeile?: string) {
    inhalt.replaceChildren();
    if (vorzeile) inhalt.appendChild(el('p', vorzeile, 'astro-rg-dialog-vorzeile'));
    const h = el('h2', titel); h.id = 'astro-rg-dialog-titel';
    inhalt.appendChild(h);
    teile.forEach((t) => inhalt.appendChild(t));
    if (!dialog.open) dialog.showModal();
  }
  function zeigeInfo(i: any) {
    const teile: HTMLElement[] = [];
    if (i.foto) { const img = el('img') as HTMLImageElement; img.src = i.foto; img.alt = i.titel; teile.push(img); }
    teile.push(el('p', i.text || 'Infotext und Detailfoto folgen.', i.text ? '' : 'astro-rg-platzhalter'));
    if (i.mehr?.length) {
      const d = el('details', '', 'astro-rg-mehr'); d.appendChild(el('summary', 'Mehr erfahren'));
      i.mehr.forEach((absatz: string) => d.appendChild(el('p', absatz)));
      teile.push(d);
    }
    oeffne(i.titel, teile, 'Infopunkt');
  }
  function zeigeGeschichte(g: any) {
    const teile: HTMLElement[] = [];
    if (g.beispiel) teile.push(el('p', 'Beispiel – hier steht später eine echte Geschichte.', 'astro-rg-platzhalter'));
    if (g.medium === 'video' && g.datei) {
      const v = el('video') as HTMLVideoElement; v.controls = true; v.preload = 'metadata'; v.src = g.datei; teile.push(v);
    } else if (g.medium === 'audio' && g.datei) {
      const a = el('audio') as HTMLAudioElement; a.controls = true; a.preload = 'metadata'; a.src = g.datei; teile.push(a);
    } else if (g.medium === 'foto' && g.datei) {
      const img = el('img') as HTMLImageElement; img.src = g.datei; img.alt = `${g.titel} – ${g.person}`; teile.push(img);
    }
    // `text`: die Geschichte selbst, immer sichtbar; `abschrift`: Wortlaut von Video/Ton, eingeklappt
    if (g.text) teile.push(el('p', g.text));
    if (g.abschrift) { const d = el('details'); d.appendChild(el('summary', 'Abschrift')); d.appendChild(el('p', g.abschrift)); teile.push(d); }
    oeffne(g.titel, teile, [g.person, g.jahr, MEDIUM[g.medium]].filter(Boolean).join(' · '));
  }
  function zeigeGalerie(gal: any) {
    const raster = el('div', '', 'astro-rg-galerie');
    gal.objekte.forEach((o: any) => {
      const b = el('button', '', 'astro-rg-galerie-objekt') as HTMLButtonElement;
      b.type = 'button';
      const img = el('img') as HTMLImageElement; img.src = o.foto; img.alt = '';
      b.append(img, el('span', o.titel));
      b.addEventListener('click', () => {
        const zurueck = el('button', '← Zurück zur Übersicht', 'astro-rg-knopf') as HTMLButtonElement;
        zurueck.type = 'button';
        zurueck.addEventListener('click', () => zeigeGalerie(gal));
        const bild = el('img') as HTMLImageElement; bild.src = o.foto; bild.alt = o.titel; bild.className = 'astro-rg-galerie-gross';
        oeffne(o.titel, [bild, el('p', o.text, 'astro-rg-platzhalter'), zurueck], gal.titel);
      });
      raster.appendChild(b);
    });
    oeffne(gal.titel, [el('p', gal.hinweis), raster]);
  }

  aktualisiere(erste);
  if (import.meta.env.DEV) (window as any).__rgViewer = viewer; // nur für Tests in der lokalen Entwicklung
</script>

<style is:global>
