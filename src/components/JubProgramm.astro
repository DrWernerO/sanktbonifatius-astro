---
// Programm des Jubiläumsjahrs, gegliedert nach Themenblöcken (Werner, 03.10.2026):
// Eröffnung · Jubilarin kennenlernen · Bonifatianer im Gespräch · Kulturprogramm ·
// Kirche neu entdecken · Kinder/Jugend/Familie · Abschluss.
// Eigene Klassen `astro-jub-prog` (Handbuch 3). Daten kommen als Prop `bloecke` aus dem
// Seiten-Frontmatter (src/pages/100-jahre/index.astro). Block-Felder: id, label, titel, intro,
// variant ('dark' | 'light' | 'alt'), items[], hinweis. Item-Felder: datum, zeit, ort, titel, text,
// href, linkText, offen (Hinweistext, wenn Angaben fehlen). Ein Item ohne `datum` zeigt „Termin folgt".
const { bloecke = [] } = Astro.props;
---
<div id="programm">
{bloecke.map((b) => (
  <section class={`astro-jub-sec astro-jub-prog astro-jub-prog--${b.variant ?? 'light'}`} id={b.id}>
    <div class="astro-jub-wrap">
      <div class="astro-jub-prog__head">
        {b.label && <p class="astro-jub-prog__label">{b.label}</p>}
        <h2 class="astro-jub-prog__hl">{b.titel}</h2>
        {b.intro && <p class="astro-jub-prog__intro">{b.intro}</p>}
      </div>
      {b.items && b.items.length > 0 && (
        <ul class={`astro-jub-prog__grid astro-jub-prog__grid--${Math.min(b.items.length, 3)}`}>
          {b.items.map((i) => (
            <li class="astro-jub-prog__card">
              <p class="astro-jub-prog__date">{i.datum ?? 'Termin folgt'}</p>
              {(i.zeit || i.ort) && <p class="astro-jub-prog__meta">{[i.zeit, i.ort].filter(Boolean).join(' · ')}</p>}
              <h3 class="astro-jub-prog__title">{i.titel}</h3>
              {i.text && <p class="astro-jub-prog__text">{i.text}</p>}
              {i.offen && <p class="astro-jub-prog__open">{i.offen}</p>}
              {i.href && <a class="astro-jub-prog__link" href={i.href}>{i.linkText ?? 'Mehr erfahren'} <span aria-hidden="true">&rarr;</span></a>}
            </li>
          ))}
        </ul>
      )}
      {b.hinweis && <p class="astro-jub-prog__note">{b.hinweis}</p>}
    </div>
  </section>
))}
</div>

<style is:global>
.astro-jub-prog--light{background:#fff}
.astro-jub-prog--alt{background:var(--bf-bg)}
.astro-jub-prog--dark{background:linear-gradient(135deg,#4a2e1a 0%,#3a2315 100%);color:#fff}
.astro-jub-prog__head{max-width:760px;margin:0 auto 36px;text-align:center}
.astro-jub-prog__label{font-size:13px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--txt-gold-label);margin:0 0 10px}
.astro-jub-prog--dark .astro-jub-prog__label{color:var(--accent-gold-deco)}
.astro-jub-prog__hl{font-family:var(--jub-serif);font-size:clamp(26px,3.6vw,38px);font-weight:700;line-height:1.15;letter-spacing:-.01em;color:var(--bf-ink);margin:0 0 12px}
.astro-jub-prog--dark .astro-jub-prog__hl{color:#fff}
.astro-jub-prog__intro{font-size:17px;line-height:1.65;color:var(--txt-muted-light);margin:0}
.astro-jub-prog--dark .astro-jub-prog__intro{color:rgba(255,255,255,.88)}
.astro-jub-prog__grid{list-style:none;margin:0 auto;padding:0;display:grid;gap:22px}
.astro-jub-prog__grid--1{grid-template-columns:minmax(0,640px);justify-content:center}
.astro-jub-prog__grid--2{grid-template-columns:repeat(2,1fr)}
.astro-jub-prog__grid--3{grid-template-columns:repeat(3,1fr)}
.astro-jub-prog__card{display:flex;flex-direction:column;background:var(--bf-bg);border:1px solid var(--bf-border);border-top:4px solid var(--accent-gold-deco);border-radius:var(--bf-radius);padding:26px 24px;box-shadow:var(--bf-shadow)}
.astro-jub-prog--alt .astro-jub-prog__card{background:#fff}
.astro-jub-prog--dark .astro-jub-prog__card{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.18);border-top-color:var(--accent-gold-deco);box-shadow:none}
.astro-jub-prog__date{font-family:var(--jub-serif);font-size:22px;font-weight:700;line-height:1.2;color:var(--bf-accent);margin:0 0 4px}
.astro-jub-prog--dark .astro-jub-prog__date{color:#fff;font-size:26px}
.astro-jub-prog__meta{font-size:14.5px;font-weight:600;color:var(--txt-gold-label);margin:0 0 10px}
.astro-jub-prog--dark .astro-jub-prog__meta{color:var(--accent-gold-deco)}
.astro-jub-prog__title{font-family:var(--jub-serif);font-size:19px;font-weight:700;line-height:1.3;color:var(--bf-ink);margin:8px 0 8px}
.astro-jub-prog--dark .astro-jub-prog__title{color:#fff}
.astro-jub-prog__text{font-size:15.5px;line-height:1.65;color:var(--txt-muted-light);margin:0 0 12px}
.astro-jub-prog--dark .astro-jub-prog__text{color:rgba(255,255,255,.88)}
.astro-jub-prog__open{font-size:14.5px;font-style:italic;color:var(--txt-muted-light);margin:0 0 12px}
.astro-jub-prog--dark .astro-jub-prog__open{color:rgba(255,255,255,.75)}
.astro-jub-prog__link{margin-top:auto;font-weight:700;font-size:15px;color:var(--bf-accent);text-decoration:none}
.astro-jub-prog--dark .astro-jub-prog__link{color:#fff;text-decoration:underline;text-underline-offset:3px}
.astro-jub-prog__link:hover{text-decoration:underline}
.astro-jub-prog__link:focus-visible{outline:3px solid var(--accent-gold-deco);outline-offset:3px;border-radius:4px}
.astro-jub-prog__note{text-align:center;font-size:15px;font-style:italic;color:var(--txt-muted-light);margin:28px 0 0}
.astro-jub-prog--dark .astro-jub-prog__note{color:rgba(255,255,255,.8)}
@media(max-width:900px){.astro-jub-prog__grid--3{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.astro-jub-prog__grid--2,.astro-jub-prog__grid--3{grid-template-columns:1fr}.astro-jub-prog__card{padding:22px 20px}}
</style>
