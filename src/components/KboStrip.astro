---
// Info-Strip Kita St. Bonifatius — Alter, Gruppen, Ort, Kinder, Träger
// Kein Öffnungszeiten-Strip (Feedback).
---
<section class="astro-kb-strip astro-kb-sec" id="astro-kb-strip">
  <div class="astro-kb-strip__in">
    <div class="astro-kb-strip__item">
      <div class="astro-kb-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div class="astro-kb-strip__label">Alter</div>
      <div class="astro-kb-strip__value">1 &ndash; 6 Jahre</div>
    </div>
    <div class="astro-kb-strip__item">
      <div class="astro-kb-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div class="astro-kb-strip__label">Gruppen</div>
      <div class="astro-kb-strip__value">4 KiGa + 2 Krippe</div>
    </div>
    <div class="astro-kb-strip__item">
      <div class="astro-kb-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </div>
      <div class="astro-kb-strip__label">Ort</div>
      <div class="astro-kb-strip__value">Frankfurt-Sachsenhausen</div>
    </div>
    <div class="astro-kb-strip__item">
      <div class="astro-kb-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
      </div>
      <div class="astro-kb-strip__label">Kinder</div>
      <div class="astro-kb-strip__value">100 Pl&auml;tze</div>
    </div>
    <div class="astro-kb-strip__item">
      <div class="astro-kb-strip__icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </div>
      <div class="astro-kb-strip__label">Tr&auml;ger</div>
      <div class="astro-kb-strip__value">Kath. Pfarrei St.&nbsp;Bonifatius</div>
    </div>
  </div>
</section>

<style is:global>
.astro-kb-strip {
  background: var(--bf-bg);
  padding: 48px 24px;
}
.astro-kb-strip__in {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 20px;
}
.astro-kb-strip__item {
  text-align: center;
  background: #fff;
  border-radius: 10px;
  padding: 20px 14px;
  border: 1px solid var(--bf-border);
}
.astro-kb-strip__icon {
  color: var(--bf-accent);
  margin-bottom: 8px;
  display: flex;
  justify-content: center;
}
.astro-kb-strip__label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: var(--bf-ink-60);
  margin-bottom: 6px;
}
.astro-kb-strip__value {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 15px;
  color: var(--bf-ink);
  line-height: 1.4;
  font-weight: 700;
}
@media (max-width: 600px) {
  .astro-kb-strip__in { grid-template-columns: repeat(2, 1fr); }
}
</style>
