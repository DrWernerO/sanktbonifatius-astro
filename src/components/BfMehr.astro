---
// „Taufe und Kitas" auf der BonFamily-Seite — seit 2026-11-03 ein kompakter Wegweiser-Block
// statt der zwei großen Kacheln BfTaufe + BfKitas (Feedback Werner: Seite zu lang, Kachel-Muster
// zu gleichförmig). Zwei ganzflächig verlinkte Querkacheln mit Foto, Kurztext und Pfeil.
// Präfix `astro-bfmehr`. Anker #bonfamily-taufe bleibt für den Schnellzugriff erhalten.
const wege = [
  {
    id: 'bonfamily-taufe',
    href: '/segen-sakramente/taufe/',
    img: '/uploads/2026/06/Taufe.jpg',
    alt: 'Taufe in der Pfarrei Sankt Bonifatius Frankfurt',
    eyebrow: 'Taufe',
    title: 'Euer Kind taufen lassen',
    text: 'Taufgespräch, Vorbereitung für Eltern und Paten und eine schöne Feier in St. Bonifatius oder St. Wendel – offen für alle Familien.',
    cta: 'Alles zur Taufe',
  },
  {
    id: 'bonfamily-kitas',
    href: '/kitas/',
    img: '/uploads/2024/07/Garten-Kita-St-Bonifatius-Kinder.jpg',
    alt: 'Kinder spielen im Garten der Kita St. Bonifatius',
    eyebrow: 'Kitas',
    title: 'Unsere fünf Kitas',
    text: 'St. Bonifatius, St. Aposteln, Herz Jesu, St. Wendel und Deutschorden – Betreuung für Kinder von 0 bis 6 Jahren.',
    cta: 'Zu den Kitas',
  },
];
---
<section class="astro-bfmehr">
  <div class="astro-bfmehr__inner">
    <h2 class="astro-bfmehr__title">Taufe und Kitas</h2>
    <div class="astro-bfmehr__grid">
      {wege.map(w => (
        <a href={w.href} id={w.id} class="astro-bfmehr__tile">
          <img src={w.img} alt={w.alt} class="astro-bfmehr__img" loading="lazy" decoding="async" />
          <div class="astro-bfmehr__body">
            <span class="astro-bfmehr__eyebrow">{w.eyebrow}</span>
            <h3 class="astro-bfmehr__tile-title">{w.title}</h3>
            <p class="astro-bfmehr__text">{w.text}</p>
            <span class="astro-bfmehr__cta">
              {w.cta}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
.astro-bfmehr{padding:64px 0;background:#fff;width:100vw;position:relative;left:50%;margin-left:-50vw;margin-right:-50vw}
.astro-bfmehr__inner{max-width:1120px;margin:0 auto;padding:0 40px}
.astro-bfmehr__title{font-family:'Playfair Display',Georgia,serif;font-size:clamp(26px,3.5vw,38px);font-weight:700;color:#9a2d2d;margin:0 0 32px;text-align:center}
.astro-bfmehr__grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.astro-bfmehr__tile{display:grid;grid-template-columns:180px 1fr;border-radius:16px;overflow:hidden;background:#f7f3ef;border:1px solid #e0d8cf;text-decoration:none;color:inherit;scroll-margin-top:96px;transition:box-shadow .2s,transform .2s}
.astro-bfmehr__tile:hover{box-shadow:0 8px 28px rgba(30,21,18,.12);transform:translateY(-2px)}
.astro-bfmehr__tile:focus-visible{outline:3px solid #9a2d2d;outline-offset:3px}
.astro-bfmehr__img{width:100%;height:100%;min-height:200px;object-fit:cover;display:block}
.astro-bfmehr__body{padding:24px 26px;display:flex;flex-direction:column;gap:8px}
.astro-bfmehr__eyebrow{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#9a2d2d}
.astro-bfmehr__tile-title{font-family:'Playfair Display',Georgia,serif;font-size:21px;font-weight:700;color:#2c2420;margin:0}
.astro-bfmehr__text{font-size:15px;line-height:1.6;color:#5a4a3a;margin:0;flex:1}
.astro-bfmehr__cta{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:600;color:#9a2d2d;margin-top:4px}
.astro-bfmehr__cta svg{transition:transform .15s}
.astro-bfmehr__tile:hover .astro-bfmehr__cta svg{transform:translateX(4px)}
@media(max-width:900px){.astro-bfmehr__grid{grid-template-columns:1fr;max-width:600px;margin:0 auto}}
@media(max-width:600px){
  .astro-bfmehr{padding:52px 0}
  .astro-bfmehr__inner{padding:0 20px}
  .astro-bfmehr__tile{grid-template-columns:1fr}
  .astro-bfmehr__img{min-height:0;aspect-ratio:16/9;height:auto}
}
</style>
