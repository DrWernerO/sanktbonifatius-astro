---
// Kita-Übersichtskarten — alle 5 Kitas + Koordination + Stellenbörse CTA
// CSS-Präfix: astro-ki-
---

<!-- KITA CARDS -->
<section class="astro-ki-cards astro-ki-sec" id="astro-ki-kitas">
  <div class="astro-ki-cards__in">
    <div class="astro-ki-cards__head">
      <p class="astro-ki-eyebrow-sm">Unsere Einrichtungen</p>
      <h2 class="astro-ki-cards__h2">F&uuml;nf Kitas in Sachsenhausen</h2>
    </div>
    <div class="astro-ki-cards__grid">

      <!-- Kita St. Bonifatius -->
      <article class="astro-ki-card">
        <div class="astro-ki-card__img-wrap">
          <img
            src="/uploads/2024/07/Garten-Kita-St-Bonifatius-Kinder.jpg"
            alt="Kinder im Garten der Kita St. Bonifatius"
            loading="lazy"
            class="astro-ki-card__img"
          >
        </div>
        <div class="astro-ki-card__body">
          <p class="astro-ki-card__tag">Krippe &amp; Kindergarten</p>
          <h3 class="astro-ki-card__h3">Kita St. Bonifatius</h3>
          <p class="astro-ki-card__desc">Gr&ouml;&szlig;te unserer Kitas mit 100 Pl&auml;tzen in vier Kita- und zwei Krippengruppen. Situationsansatz in einer Umgebung, die zum Entdecken einl&auml;dt.</p>
          <ul class="astro-ki-card__meta">
            <li>1&ndash;6 Jahre &middot; 100 Pl&auml;tze</li>
            <li>Achenbachstr. 5, 60596 Frankfurt</li>
          </ul>
          <a href="/kitas/st-bonifatius-cs/" class="astro-ki-card__link">Kita ansehen &#8594;</a>
        </div>
      </article>

      <!-- Kita St. Aposteln -->
      <article class="astro-ki-card">
        <div class="astro-ki-card__img-wrap">
          <img
            src="/uploads/2024/12/Umabu-St.-Aposteln-1-e1733907623749.jpg"
            alt="Kita St. Aposteln von außen"
            loading="lazy"
            class="astro-ki-card__img"
          >
        </div>
        <div class="astro-ki-card__body">
          <p class="astro-ki-card__tag">Kindergarten &middot; Teiloffen</p>
          <h3 class="astro-ki-card__h3">Kita St. Aposteln</h3>
          <p class="astro-ki-card__desc">Teiloffenes Konzept mit Funktionsr&auml;umen und vier Stammgruppen. Lebendige Gemeinschaft in einem modern umgebauten Haus.</p>
          <ul class="astro-ki-card__meta">
            <li>3&ndash;6 Jahre &middot; 4 Gruppen</li>
            <li>Ziegelh&uuml;ttenweg 149, 60598 Frankfurt</li>
          </ul>
          <a href="/kitas/st-aposteln-cs/" class="astro-ki-card__link">Kita ansehen &#8594;</a>
        </div>
      </article>

      <!-- Kita St. Wendel -->
      <article class="astro-ki-card">
        <div class="astro-ki-card__img-wrap">
          <img
            src="/uploads/2024/08/KiTa-St-Wendel-Gebaeude.jpg"
            alt="Geb&auml;ude der Kita St. Wendel"
            loading="lazy"
            class="astro-ki-card__img"
          >
        </div>
        <div class="astro-ki-card__body">
          <p class="astro-ki-card__tag">Krippe &amp; Kindergarten</p>
          <h3 class="astro-ki-card__h3">Kita St. Wendel</h3>
          <p class="astro-ki-card__desc">GUK, METACOM und Religionsp&auml;dagogik als besondere Schwerpunkte. P&auml;dagogik nach Situationsansatz und Emmi Pikler in gr&uuml;ner Lage.</p>
          <ul class="astro-ki-card__meta">
            <li>1&ndash;6 Jahre &middot; 2 Krippe + 2 KiGa</li>
            <li>Altes Sch&uuml;tzh&uuml;tteng&auml;sschen 2, 60599 Frankfurt</li>
          </ul>
          <a href="/kitas/st-wendel-cs/" class="astro-ki-card__link">Kita ansehen &#8594;</a>
        </div>
      </article>

      <!-- Kita Herz Jesu -->
      <article class="astro-ki-card">
        <div class="astro-ki-card__img-wrap astro-ki-card__img-wrap--placeholder">
          <div class="astro-ki-card__img-ph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="40" height="40"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
        </div>
        <div class="astro-ki-card__body">
          <p class="astro-ki-card__tag">Kindergarten</p>
          <h3 class="astro-ki-card__h3">Kita Herz Jesu</h3>
          <p class="astro-ki-card__desc">Katholische Kita in ruhiger Wohnlage im s&uuml;dlichen Sachsenhausen. Webauftritt im Aufbau &ndash; jetzt Kontakt aufnehmen.</p>
          <ul class="astro-ki-card__meta">
            <li>3&ndash;6 Jahre</li>
            <li>Mathildenstra&szlig;e 30a, 60599 Frankfurt</li>
          </ul>
          <a href="/kitas/herz-jesu-cs/" class="astro-ki-card__link">Kita ansehen &#8594;</a>
        </div>
      </article>

      <!-- Kita Deutschorden -->
      <article class="astro-ki-card">
        <div class="astro-ki-card__img-wrap astro-ki-card__img-wrap--placeholder">
          <div class="astro-ki-card__img-ph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="40" height="40"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
        </div>
        <div class="astro-ki-card__body">
          <p class="astro-ki-card__tag">Kindergarten</p>
          <h3 class="astro-ki-card__h3">Kita Deutschorden</h3>
          <p class="astro-ki-card__desc">Einrichtung im historischen Sachsenhausen, Eingang Elisabethenstr. 14. Webauftritt im Aufbau &ndash; jetzt Kontakt aufnehmen.</p>
          <ul class="astro-ki-card__meta">
            <li>3&ndash;6 Jahre</li>
            <li>Elisabethenstr. 14, 60594 Frankfurt</li>
          </ul>
          <a href="/kitas/deutschorden-cs/" class="astro-ki-card__link">Kita ansehen &#8594;</a>
        </div>
      </article>

    </div>
  </div>
</section>

<!-- KOORDINATION -->
<section class="astro-ki-koord astro-ki-sec">
  <div class="astro-ki-koord__in">
    <p class="astro-ki-eyebrow-sm">Zentrale Ansprechpartnerinnen</p>
    <h2 class="astro-ki-koord__h2">Kita-Koordination</h2>
    <p class="astro-ki-koord__sub">Fragen zu Betreuungspl&auml;tzen, Anmeldung oder Kooperationen? Sandra und Jeannine helfen Ihnen weiter.</p>
    <div class="astro-ki-koord__cards">
      <div class="astro-ki-koord__card">
        <p class="astro-ki-koord__name">Sandra Roos-Greulich</p>
        <a href="mailto:sandra.roos@sanktbonifatius.de" class="astro-ki-koord__email">sandra.roos@sanktbonifatius.de</a>
      </div>
      <div class="astro-ki-koord__card">
        <p class="astro-ki-koord__name">Jeannine Douverne</p>
        <a href="mailto:jeannine.douverne@sanktbonifatius.de" class="astro-ki-koord__email">jeannine.douverne@sanktbonifatius.de</a>
      </div>
    </div>
  </div>
</section>

<!-- STELLEN CTA -->
<section class="astro-ki-stellen-cta astro-ki-sec">
  <div class="astro-ki-stellen-cta__in">
    <p class="astro-ki-eyebrow-sm" style="color:var(--bf-gold)">Jetzt bewerben</p>
    <h2 class="astro-ki-stellen-cta__h2">Mitarbeiten in unseren Kitas</h2>
    <p class="astro-ki-stellen-cta__p">Wir suchen P&auml;dagog:innen und Leitungen, die Kinder auf ihrem Weg begleiten m&ouml;chten. Aktuell vier offene Stellen in Frankfurt-Sachsenhausen.</p>
    <a href="/kitas/stellenboerse/" class="astro-ki-btn astro-ki-btn--gold">Zu den offenen Stellen</a>
  </div>
</section>

<style is:global>
/* CARDS */
.astro-ki-cards { background: var(--bf-bg); padding: 80px 24px; }
.astro-ki-cards__in { max-width: 1160px; margin: 0 auto; }
.astro-ki-cards__head { text-align: center; margin-bottom: 48px; }
.astro-ki-cards__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(26px, 3.5vw, 40px); font-weight: 700; color: var(--bf-ink); margin: 0; }
.astro-ki-cards__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 28px; }
.astro-ki-card { background: #fff; border: 1px solid var(--bf-border); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; }
.astro-ki-card__img-wrap { aspect-ratio: 16/9; overflow: hidden; }
.astro-ki-card__img-wrap--placeholder { background: var(--bf-bg-alt); display: flex; align-items: center; justify-content: center; }
.astro-ki-card__img-ph { color: var(--bf-border); }
.astro-ki-card__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s; }
.astro-ki-card:hover .astro-ki-card__img { transform: scale(1.03); }
.astro-ki-card__body { padding: 22px 24px 24px; flex: 1; display: flex; flex-direction: column; }
.astro-ki-card__tag { font-family: 'Futura LT W01 Book', Futura, sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--bf-accent); margin: 0 0 8px; }
.astro-ki-card__h3 { font-family: 'Playfair Display', Georgia, serif; font-size: 20px; font-weight: 700; color: var(--bf-ink); margin: 0 0 10px; }
.astro-ki-card__desc { font-size: 14px; color: var(--bf-ink-60); line-height: 1.65; margin: 0 0 14px; flex: 1; }
.astro-ki-card__meta { list-style: none; margin: 0 0 18px; padding: 0; display: flex; flex-direction: column; gap: 4px; }
.astro-ki-card__meta li { font-size: 13px; color: var(--bf-ink-60); }
.astro-ki-card__meta li::before { content: '↳ '; color: var(--bf-accent); }
.astro-ki-card__link { font-size: 14px; font-weight: 700; color: var(--bf-accent); text-decoration: none; }
.astro-ki-card__link:hover { text-decoration: underline; }

/* KOORDINATION */
.astro-ki-koord { background: #fff; padding: 72px 24px; }
.astro-ki-koord__in { max-width: 860px; margin: 0 auto; text-align: center; }
.astro-ki-koord__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 3vw, 34px); font-weight: 700; color: var(--bf-ink); margin: 0 0 10px; }
.astro-ki-koord__sub { font-size: 16px; color: var(--bf-ink-60); line-height: 1.65; margin: 0 0 32px; }
.astro-ki-koord__cards { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }
.astro-ki-koord__card { background: var(--bf-bg); border: 1px solid var(--bf-border); border-radius: 12px; padding: 18px 24px; min-width: 220px; }
.astro-ki-koord__name { font-family: 'Playfair Display', Georgia, serif; font-size: 16px; font-weight: 700; color: var(--bf-ink); margin: 0 0 6px; }
.astro-ki-koord__email { font-size: 13.5px; color: var(--bf-accent); text-decoration: none; }
.astro-ki-koord__email:hover { text-decoration: underline; }

/* STELLEN CTA */
.astro-ki-stellen-cta { background: linear-gradient(135deg, #3a1818 0%, #5a2424 55%, #4a2e1a 100%); padding: 80px 24px; text-align: center; }
.astro-ki-stellen-cta__in { max-width: 600px; margin: 0 auto; }
.astro-ki-stellen-cta__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(26px, 4vw, 40px); font-weight: 700; color: #f0e8d8; margin: 0 0 14px; }
.astro-ki-stellen-cta__p { color: rgba(240,232,216,.75); font-size: 16px; line-height: 1.65; margin: 0 0 32px; }
</style>
