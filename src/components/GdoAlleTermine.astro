---
// Vollständige, filterbare Gottesdienst-Übersicht aus der ChurchDesk-API (Präfix astro-gdoalle).
// Verwandt: CalendarOverview.astro (Terminkalender, WP-Termine) — läuft seit 2026-09-16 ebenfalls
// serverseitig, rendert die Liste dort aber direkt als sichtbares HTML (kein „Termine werden
// geladen …" ohne JS). Hier läuft der Abruf serverseitig (ChurchDesk-Token ist geheim, s.
// src/lib/churchdesk.js) und wird als fertiges JSON in die Seite eingebettet; gefiltert wird rein
// client-seitig ohne weiteren Serverkontakt.
//
// HORIZON_DAYS: wie weit im Voraus geladen wird (aktuell 120 Tage ≈ 4 Monate). Bei Bedarf
// erhöhen — die API liefert bislang alle Termine in einem Request (kein Pagination-Handling
// eingebaut, s. getGottesdienste()).
import { getGottesdienste } from '../lib/churchdesk.js';

const HORIZON_DAYS = 120;
const now = new Date();
const until = new Date(now.getTime() + HORIZON_DAYS * 24 * 60 * 60 * 1000);
const termine = await getGottesdienste({ from: now, to: until });

const monthFmt = new Intl.DateTimeFormat('de-DE', { timeZone: 'Europe/Berlin', month: 'long', year: 'numeric' });
const monthKeyFmt = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Berlin', year: 'numeric', month: '2-digit' });

const items = termine.map((t) => ({
  id: t.id,
  title: t.title,
  isEntfaellt: t.isEntfaellt,
  church: t.church,
  address: t.address,
  summary: t.summary,
  celebrant: t.celebrant,
  dateKey: t.dateKey,
  dayLabel: t.dayLabel,
  shortDay: t.shortDay,
  shortMonth: t.shortMonth,
  timeLabel: t.timeLabel,
  isSunday: t.isSunday,
  monthKey: monthKeyFmt.format(t.start),
  monthLabel: monthFmt.format(t.start),
  startISO: t.startISO,
  endISO: t.endISO,
}));

const churches = [...new Set(items.map((i) => i.church).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'de'));

const jsonLd = items.map((t) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: t.title,
  startDate: t.startISO,
  ...(t.endISO ? { endDate: t.endISO } : {}),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: t.isEntfaellt ? 'https://schema.org/EventCancelled' : 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: t.church, ...(t.address ? { address: t.address } : {}) },
  ...(t.celebrant ? { performer: { '@type': 'Person', name: t.celebrant } } : {}),
  organizer: { '@type': 'Organization', name: 'Pfarrei Sankt Bonifatius Frankfurt', url: 'https://sanktbonifatius.de' },
}));
---
<section class="astro-gdoalle">
  <div class="astro-gdoalle__inner">
    <div class="astro-gdoalle__filters">
      <label class="astro-gdoalle__field">
        <span class="astro-gdoalle__label">Kirchort</span>
        <select class="astro-gdoalle__select" id="astro-gdoalle-church">
          <option value="*">Alle Kirchorte</option>
          {churches.map((c) => <option value={c}>{c}</option>)}
        </select>
      </label>
      <label class="astro-gdoalle__field astro-gdoalle__field--grow">
        <span class="astro-gdoalle__label">Stichwort</span>
        <input class="astro-gdoalle__input" id="astro-gdoalle-search" type="search" placeholder="z. B. Taizé, Familiengottesdienst …" />
      </label>
      <button type="button" class="astro-gdoalle__clear" id="astro-gdoalle-clear">Filter zurücksetzen</button>
    </div>

    <div class="astro-gdoalle__list" id="astro-gdoalle-list">
      <p class="astro-gdoalle__status">Termine werden geladen …</p>
    </div>
  </div>
</section>

<script type="application/json" id="astro-gdoalle-data" set:html={JSON.stringify(items)} />
{jsonLd.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}

<style is:global>
.astro-gdoalle{background:#f7f3ef;padding:56px 0 80px}
.astro-gdoalle__inner{max-width:1000px;margin:0 auto;padding:0 40px}
.astro-gdoalle__filters{
  display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;
  background:#fff;border-radius:12px;padding:20px 22px;
  box-shadow:0 2px 12px rgba(30,21,18,.06);margin:0 0 28px;
}
.astro-gdoalle__field{display:flex;flex-direction:column;gap:6px;flex:1 1 180px;min-width:160px}
.astro-gdoalle__field--grow{flex:2 1 260px}
.astro-gdoalle__label{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--txt-muted-light)}
.astro-gdoalle__select,.astro-gdoalle__input{
  font-family:inherit;font-size:14px;color:#2c2420;background:#f7f3ef;
  border:1px solid #e3dace;border-radius:7px;padding:9px 11px;
}
.astro-gdoalle__select{cursor:pointer;appearance:none}
.astro-gdoalle__select:focus,.astro-gdoalle__input:focus{outline:none;border-color:#9a2d2d}
.astro-gdoalle__clear{
  flex:0 0 auto;font-family:inherit;font-size:13px;font-weight:600;color:#6b5c52;
  background:transparent;border:1px solid #d8cfc2;border-radius:7px;padding:10px 16px;cursor:pointer;
  transition:background .2s,color .2s,border-color .2s;
}
.astro-gdoalle__clear:hover{background:#9a2d2d;border-color:#9a2d2d;color:#fff}
.astro-gdoalle__status{color:var(--txt-muted-light);font-size:14px;padding:24px 0;text-align:center}

.astro-gdoalle__list{display:flex;flex-direction:column}
.astro-gdoalle__month-hl{
  font-family:'Playfair Display',serif;font-size:20px;font-weight:700;color:#2c2420;
  margin:28px 0 12px;padding-bottom:8px;border-bottom:2px solid #e3dace;
}
.astro-gdoalle__list > .astro-gdoalle__month-hl:first-child{margin-top:0}
.astro-gdoalle-ev{
  display:grid;grid-template-columns:44px 68px 1fr auto;gap:12px;align-items:center;
  background:#fff;border-radius:10px;padding:10px 18px;margin:0 0 8px;
  color:#2c2420;box-shadow:0 1px 6px rgba(30,21,18,.05);border-left:4px solid #9a2d2d;
}
/* Sonntage hervorheben — gleicher Gold-Akzent wie in GdoTermine.astro (Teaser). */
.astro-gdoalle-ev--sun{border-left-color:var(--accent-gold-deco);background:#fdf9f0}
.astro-gdoalle-ev__date{font-family:'Playfair Display',serif;font-weight:700;color:#9a2d2d;line-height:1.15;text-align:center}
.astro-gdoalle-ev__date b{display:block;font-size:18px}
.astro-gdoalle-ev__date span{font-size:10.5px;letter-spacing:.04em;text-transform:uppercase;color:var(--txt-muted-light)}
.astro-gdoalle-ev__time{font-weight:600;color:#9a2d2d;font-size:14px;white-space:nowrap}
.astro-gdoalle-ev__main{min-width:0}
.astro-gdoalle-ev__title{font-size:15px;font-weight:600;line-height:1.3;margin:0}
.astro-gdoalle-ev__sub,.astro-gdoalle-ev__celebrant{font-size:12.5px;color:#6b5c52;line-height:1.4;margin:2px 0 0;
  display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}
.astro-gdoalle-ev__church{text-align:right;font-size:13px;color:var(--txt-muted-light);white-space:nowrap;flex-shrink:0}
/* ENTFÄLLT-Termine bleiben sichtbar (Werners Wunsch), aber optisch gedämpft statt wie ein normaler Termin. */
.astro-gdoalle-ev--entfaellt .astro-gdoalle-ev__time,
.astro-gdoalle-ev--entfaellt .astro-gdoalle-ev__title{color:#a89c8f}
.astro-gdoalle-ev--entfaellt .astro-gdoalle-ev__title{font-style:italic}
.astro-gdoalle__empty{color:var(--txt-muted-light);font-size:14px;padding:32px 0;text-align:center}

@media(max-width:640px){
  .astro-gdoalle__inner{padding:0 20px}
  .astro-gdoalle-ev{grid-template-columns:40px 56px 1fr;gap:4px 10px;padding:10px 14px}
  .astro-gdoalle-ev__church{grid-column:1 / -1;text-align:left;margin-top:2px}
  .astro-gdoalle-ev__date b{font-size:16px}
}
</style>

<script>
(function(){
  const listEl   = document.getElementById('astro-gdoalle-list');
  const churchSel= document.getElementById('astro-gdoalle-church');
  const searchIn = document.getElementById('astro-gdoalle-search');
  const clearBtn = document.getElementById('astro-gdoalle-clear');
  const dataEl   = document.getElementById('astro-gdoalle-data');
  if(!listEl || !dataEl) return;

  let EVENTS = [];
  try { EVENTS = JSON.parse(dataEl.textContent || '[]'); } catch(e) { EVENTS = []; }

  function esc(s){
    return String(s).replace(/[&<>"']/g, function(c){
      return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c];
    });
  }

  function render(){
    const fChurch = churchSel.value;
    const q = searchIn.value.trim().toLowerCase();

    const shown = EVENTS.filter(function(e){
      const cOk = fChurch==='*' || e.church===fChurch;
      const qOk = !q || (e.title+' '+e.church+' '+(e.summary||'')).toLowerCase().indexOf(q) > -1;
      return cOk && qOk;
    });

    if(!shown.length){ listEl.innerHTML='<p class="astro-gdoalle__empty">Keine Gottesdienste für diese Auswahl.</p>'; return; }

    let html='', curMonth='';
    shown.forEach(function(e){
      if(e.monthKey!==curMonth){ curMonth=e.monthKey; html+='<h2 class="astro-gdoalle__month-hl">'+esc(e.monthLabel)+'</h2>'; }
      var cls = 'astro-gdoalle-ev'+(e.isSunday?' astro-gdoalle-ev--sun':'')+(e.isEntfaellt?' astro-gdoalle-ev--entfaellt':'');
      html+=''
        +'<div class="'+cls+'">'
        +  '<div class="astro-gdoalle-ev__date"><b>'+esc(e.shortDay)+'.</b><span>'+esc(e.shortMonth)+'</span></div>'
        +  '<div class="astro-gdoalle-ev__time">'+esc(e.timeLabel)+'</div>'
        +  '<div class="astro-gdoalle-ev__main">'
        +    '<p class="astro-gdoalle-ev__title">'+esc(e.title)+'</p>'
        +    (e.summary ? '<p class="astro-gdoalle-ev__sub">'+esc(e.summary)+'</p>' : '')
        +    (e.celebrant ? '<p class="astro-gdoalle-ev__celebrant">Zelebrant: '+esc(e.celebrant)+'</p>' : '')
        +  '</div>'
        +  (e.church ? '<div class="astro-gdoalle-ev__church">'+esc(e.church)+'</div>' : '')
        +'</div>';
    });
    listEl.innerHTML=html;
  }

  churchSel.addEventListener('change', render);
  searchIn.addEventListener('input', render);
  clearBtn.addEventListener('click', function(){
    churchSel.value='*'; searchIn.value=''; render();
  });

  render();
})();
</script>
