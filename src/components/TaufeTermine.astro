---
// „Tauftermine" (WP-Block `ta-termine`). Eigene Klassen `astro-tatermine`.
// id="termine" für die Hero-Sprungmarke.
//
// Termine kommen aus einer Word-Datei im Mediathek-Ordner „Astro Upload/Tauftermine"
// (RML 206, Handbuch 13c): Kirchenname als Zeile, darunter ein Termin pro Aufzählungspunkt,
// z.B. „SA. 17.10.2026, 11 Uhr" oder „SO. 07.02.2027, 11 Uhr in der Sonntagsmesse".
// Uhrzeit frei, Zusatz optional, vergangene Termine fallen automatisch weg. Fällt WP aus,
// greift die FALLBACK-Liste (gleiches Format) → der Build bricht nie ab.
import { getTaufeTermine, parseTaufText, TAUF_KIRCHEN } from '../lib/wordpress.js';

const ADRESSEN = {
  'St. Bonifatius': 'Holbeinstr. 70 · 60596 Frankfurt-Sachsenhausen',
  'St. Wendel': 'Altes Schützenhüttengäßchen 4–6 · 60599 Frankfurt-Sachsenhausen',
  'Herz Jesu': 'Mathildenstr. 32 · 60599 Frankfurt-Oberrad',
};
const FALLBACK = `
St. Bonifatius
SA. 17.10.2026, 11 Uhr
SA. 07.11.2026, 11 Uhr
SA. 05.12.2026, 11 Uhr
SO. 07.02.2027, 11 Uhr in der Sonntagsmesse
St. Wendel
SA. 17.10.2026, 11 Uhr
SA. 14.11.2026, 11 Uhr
SA. 19.12.2026, 11 Uhr
Herz Jesu
SA. 24.10.2026, 11 Uhr
`;
const fromWp = await getTaufeTermine();
const geladen = fromWp.length ? fromWp : parseTaufText(FALLBACK);
// Immer alle drei Kirchen in fester Reihenfolge zeigen, auch wenn eine gerade keine Termine hat.
const kirchen = TAUF_KIRCHEN.map((name) => ({
  name,
  adresse: ADRESSEN[name],
  termine: geladen.find((k) => k.name === name)?.termine ?? [],
}));
---
<section class="astro-tatermine" id="termine">
  <div class="astro-tatermine__inner">
    <div class="astro-tatermine__head">
      <h2 class="astro-tatermine__hl">Tauftermine</h2>
      <p class="astro-tatermine__sub">Wählen Sie eine unserer drei Kirchen. Wir taufen samstags in einem eigenen Taufgottesdienst oder sonntags in der Messe.</p>
    </div>
    <div class="astro-tatermine__grid">
      {kirchen.map((k) => (
        <article class="astro-tatermine-card">
          <div class="astro-tatermine-card__head">
            <h3 class="astro-tatermine-card__name">{k.name}</h3>
            <p class="astro-tatermine-card__adr">{k.adresse}</p>
          </div>
          {k.termine.length ? (
            <ul class="astro-tatermine-card__dates">
              {k.termine.map((t) => (
                <li>
                  <time datetime={t.iso}>{t.datum}</time>{t.uhrzeit && <span class="astro-tatermine-card__time"> · {t.uhrzeit}</span>}
                  {t.zusatz && <span class="astro-tatermine-card__extra">{t.zusatz}</span>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="astro-tatermine-card__empty">Neue Termine folgen in Kürze.</p>
          )}
        </article>
      ))}
    </div>
    <p class="astro-tatermine__note">
      Die Uhrzeit steht jeweils beim Termin. Anmeldung bitte über das Formular weiter unten oder telefonisch.
    </p>
  </div>
</section>

<style is:global>
.astro-tatermine{background:#fff;padding:72px 0}
.astro-tatermine__inner{max-width:1200px;margin:0 auto;padding:0 40px}
.astro-tatermine__head{text-align:center;margin:0 0 40px}
.astro-tatermine__hl{font-family:'Playfair Display',serif;font-size:clamp(26px,3.4vw,40px);font-weight:700;color:#2c2420;margin:0 0 14px}
.astro-tatermine__sub{font-size:clamp(15px,1.7vw,18px);color:#6b5c52;line-height:1.6;margin:0 auto;max-width:640px}
.astro-tatermine__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;align-items:start}
.astro-tatermine-card{background:#f7f3ef;border-radius:14px;padding:28px 26px;box-shadow:0 2px 12px rgba(30,21,18,.05)}
.astro-tatermine-card__head{border-bottom:1px solid #e7ddd2;padding:0 0 16px;margin:0 0 16px;min-height:96px}
.astro-tatermine-card__name{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:#9a2d2d;margin:0 0 8px}
.astro-tatermine-card__adr{font-size:13.5px;color:var(--txt-muted-light);line-height:1.5;margin:0}
.astro-tatermine-card__dates{list-style:none;margin:0;padding:0}
.astro-tatermine-card__dates li{font-size:15px;color:#3d3530;padding:7px 0 7px 22px;position:relative;border-bottom:1px solid #efe7dd}
.astro-tatermine-card__dates li:last-child{border-bottom:none}
.astro-tatermine-card__dates li::before{content:"";position:absolute;left:2px;top:14px;width:7px;height:7px;border-radius:50%;background:var(--accent-gold-deco)}
.astro-tatermine-card__dates time,.astro-tatermine-card__time{white-space:nowrap}
.astro-tatermine-card__time{color:#6b5c52}
.astro-tatermine-card__extra{display:block;font-size:13px;color:#9a2d2d;margin-top:2px}
.astro-tatermine-card__empty{font-size:14.5px;color:var(--txt-muted-light);margin:0}
.astro-tatermine__note{text-align:center;font-size:14px;color:var(--txt-muted-light);margin:36px 0 0}
@media(max-width:920px){.astro-tatermine__grid{grid-template-columns:1fr;gap:16px}.astro-tatermine-card__head{min-height:0}}
@media(max-width:600px){.astro-tatermine{padding:52px 0}.astro-tatermine__inner{padding:0 20px}}
</style>
