---
// Hero der Seite „Pause für die Seele" (/gottesdienst-glaube/pause-fuer-die-seele/).
// Eigene Klassen `astro-pfs-hero` (Handbuch 3). Motiv von Werner (30.09.2026), lokal unter
// public/uploads/2027/01/ (Handbuch 1g). Das Motiv enthält Titel + Claim bereits als Schrift —
// deshalb wird es als echtes <img> (mit alt) vollständig gezeigt statt als beschnittener
// Hintergrund, und die <h1> ist nur für Screenreader/Suchmaschinen sichtbar (genau EINE h1).
// Band-Farbe --pfs-g = Motiv-Hintergrund (nach sRGB-Umrechnung gesampelt #581c5a), damit Bild und Fläche nahtlos
// ineinander übergehen (Rubrik-Farbe nur im Hero, Design-System 1 „Programmsparten-Farben").
// Buttons bleiben Haus-Bordeaux bzw. weiß (keine Rubrik-Farbe als Aktionsfarbe).
const img = '/uploads/2027/01/pause-fuer-die-seele-2027-motiv.png';
---
<section class="astro-pfs-hero">
  <div class="astro-pfs-hero__inner">
    <h1 class="astro-pfs-sr">Pause für die Seele</h1>
    <img class="astro-pfs-hero__img" src={img} width="1720" height="910" fetchpriority="high"
         alt="Pause für die Seele – Vierzig Tage, die gut tun." />
    <div class="astro-pfs-hero__bar">
      <p class="astro-pfs-hero__sub">Ökumenische Exerzitien im Alltag &middot; Fastenzeit 2027</p>
      <div class="astro-pfs-hero__cta">
        <a class="astro-pfs-btn astro-pfs-btn--primary" href="#anmeldung">Jetzt anmelden</a>
        <a class="astro-pfs-btn astro-pfs-btn--ghost" href="#material">Zu den Materialien</a>
      </div>
    </div>
  </div>
</section>

<style is:global>
.astro-pfs-hero{--pfs-g:#581c5a;position:relative;width:100vw;left:50%;margin-left:-50vw;margin-right:-50vw;background:var(--pfs-g);color:#fff;padding:80px 0 0}
.astro-pfs-hero__inner{max-width:1280px;margin:0 auto}
.astro-pfs-hero__img{display:block;width:100%;height:auto;max-height:min(62vh,620px);object-fit:contain}
.astro-pfs-hero__bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px 28px;padding:22px 40px 40px;border-top:1px solid rgba(255,255,255,.14)}
.astro-pfs-hero__sub{font-family:var(--pfs-serif);font-size:clamp(17px,2vw,22px);color:rgba(255,255,255,.92);margin:0;line-height:1.4}
.astro-pfs-hero__cta{display:flex;flex-wrap:wrap;gap:12px}
@media(max-width:600px){.astro-pfs-hero{padding-top:80px}.astro-pfs-hero__bar{padding:18px 20px 32px}.astro-pfs-hero__cta{width:100%}.astro-pfs-hero__cta .astro-pfs-btn{flex:1 1 100%;justify-content:center}}
</style>
