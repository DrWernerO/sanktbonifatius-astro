---
// „Sie suchen etwas? Wir auch." — vier Wegekacheln + Reihe „Häufig gesucht" (Entwurf 03.11.2026).
// Ziele: Gottesdienste/Termine (zwei Links), Familie & Kinder (BonFamily, mit Hinweis auf die fünf Kitas),
// Begleitung auf dem Lebensweg (/segen-sakramente/), Pfarrbüro (Telefon). Die Kachel
// „Gottesdienste und Termine" ist KEIN Gesamt-Link, weil sie zwei Links enthält.
// Chips „Häufig gesucht": Kitas bewusst in der Mitte. Menü (Nav.astro) bleibt unberührt.
const chips = [
  { href: '/segen-sakramente/taufe/', label: 'Taufe' },
  { href: '/segen-sakramente/trauung/', label: 'Trauung' },
  { href: '/kontakt/trauerfall/', label: 'Trauerfall' },
  { href: '/kitas/', label: 'Kitas' },
  { href: '/segen-sakramente/erstkommunion/', label: 'Erstkommunion' },
  { href: '/segen-sakramente/firmung/', label: 'Firmung' },
  { href: '/kirchorte/', label: 'Kirchorte' },
  { href: '/jugend/', label: 'Jugend' },
];
---
<section class="astro-wege" aria-labelledby="astro-wege-h">
  <h2 class="astro-wege__lead" id="astro-wege-h">Sie suchen etwas? Wir auch.</h2>
  <div class="astro-wege__grid">
    <div class="astro-weg">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3v5M13.5 5.5h5M7 28V16l9-7 9 7v12M13 28v-7a3 3 0 0 1 6 0v7M4 28h24"/></svg>
      <h3>Gottesdienste und Termine finden</h3>
      <p>Alle Gottesdienste und Veranstaltungen</p>
      <div class="astro-weg__go2">
        <a href="/gottesdienst-glaube/gottesdienstordnung/"><span class="astro-weg__d">Zur Gottesdienstordnung</span><span class="astro-weg__m">Gottesdienste</span> →</a>
        <a href="/terminkalender/"><span class="astro-weg__d">Zum Terminkalender</span><span class="astro-weg__m">Terminkalender</span> →</a>
      </div>
    </div>
    <a class="astro-weg" href="/bonfamily/">
      <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="11" cy="9" r="3.2"/><circle cx="22" cy="12" r="2.4"/><path d="M5 26v-5a6 6 0 0 1 12 0v5M18 26v-4a4.5 4.5 0 0 1 9 0v4"/></svg>
      <h3>Familie &amp; Kinder</h3>
      <p>BonFamily, Baby-Lounge und unsere <strong>fünf Kitas</strong></p>
      <span class="astro-weg__go">Zu BonFamily →</span>
    </a>
    <a class="astro-weg" href="/segen-sakramente/">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5 28c9 0 9-8 15-8s6-8 7-15"/><circle cx="27" cy="5" r="2"/><circle cx="5" cy="28" r="1.5"/></svg>
      <h3>Begleitung auf dem Lebensweg</h3>
      <p>Taufe, Trauung, Abschied – Segen und Sakramente</p>
      <span class="astro-weg__go">Lebensweg entdecken →</span>
    </a>
    <a class="astro-weg" href="tel:+496959758500">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 4h5l2 6-3 2a15 15 0 0 0 9 9l2-3 6 2v5a3 3 0 0 1-3 3A22 22 0 0 1 4 7a3 3 0 0 1 3-3z"/></svg>
      <h3>Pfarrbüro anrufen</h3>
      <p>069 695 97 58 50<br>Di–Fr 9–12 Uhr</p>
      <span class="astro-weg__go">Jetzt anrufen →</span>
    </a>
  </div>
  <nav class="astro-wege__also" aria-label="Häufig gesucht">
    <span>Häufig gesucht:</span>
    {chips.map((c) => <a href={c.href}>{c.label}</a>)}
  </nav>
</section>

<style is:global>
.astro-wege{max-width:1200px;margin:0 auto;padding:46px 32px 48px}
.astro-wege__lead{font-family:'Playfair Display',Georgia,serif;font-style:italic;font-weight:400;font-size:clamp(26px,2.6vw,34px);margin:0 0 22px;color:#2c2420}
.astro-wege__lead::after{content:"";display:block;width:44px;height:2px;background:#c5a55a;margin-top:12px}
.astro-wege__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.astro-weg{background:#fff;border-radius:8px;padding:26px 24px 22px;box-shadow:0 14px 40px rgba(44,36,32,.16);border:1px solid #e0d8cf;border-bottom:3px solid #c5a55a;display:flex;flex-direction:column;gap:6px;transition:transform .25s,box-shadow .25s;min-height:188px;text-decoration:none;color:#2c2420}
.astro-weg:hover{transform:translateY(-5px);box-shadow:0 20px 48px rgba(44,36,32,.22)}
div.astro-weg:hover{transform:none;box-shadow:0 14px 40px rgba(44,36,32,.16)}
.astro-weg svg{width:34px;height:34px;stroke:#806b3a;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;margin-bottom:8px}
.astro-weg h3{font-family:'Playfair Display',Georgia,serif;font-size:21px;line-height:1.2;margin:0;font-weight:700}
.astro-weg p{margin:0;font-size:15px;color:#5a4a3a}
.astro-weg p strong{color:#2c2420;font-weight:600;border-bottom:2px solid #c5a55a}
.astro-weg__go{margin-top:auto;padding-top:10px;font-weight:600;font-size:14px;color:#806b3a;letter-spacing:.03em}
.astro-weg__go2{margin-top:auto;padding-top:10px;display:flex;flex-direction:column;gap:4px;font-weight:600;font-size:14px;letter-spacing:.03em}
.astro-weg__m{display:none}
.astro-weg__go2 a{color:#806b3a;text-decoration:none;display:inline-block;padding:4px 0}
.astro-weg__go2 a:hover{color:#2c2420;text-decoration:underline}
.astro-weg:focus-visible,.astro-weg__go2 a:focus-visible,.astro-wege__also a:focus-visible{outline:3px solid #c5a55a;outline-offset:3px}
.astro-wege__also{margin:26px 0 0;display:flex;gap:10px 14px;flex-wrap:wrap;align-items:center;font-size:15px;color:#5a4a3a}
.astro-wege__also a{padding:9px 16px;border:1.5px solid #c5a55a;border-radius:24px;background:#fff;font-weight:500;color:#5a4a3a;text-decoration:none;min-height:44px;display:inline-flex;align-items:center}
.astro-wege__also a:hover{background:#f7f3ef}
@media (max-width:1100px){.astro-wege__grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:860px){
  .astro-wege{margin:0;padding:18px 14px 0;background:#f7f3ef;max-width:none}
  .astro-wege__lead{font-size:23px;margin-bottom:14px}
  .astro-wege__lead::after{margin-top:8px;width:36px}
  .astro-wege__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .astro-weg{padding:14px 14px 12px;min-height:0;box-shadow:0 2px 8px rgba(44,36,32,.09);gap:2px}
  .astro-weg svg{width:28px;height:28px;margin-bottom:4px}
  .astro-weg h3{font-size:17px}
  .astro-weg p{font-size:15px;line-height:1.35}
  .astro-weg__go{display:none}
  .astro-weg__d{display:none}
  .astro-weg__m{display:inline}
  .astro-weg__go2{font-size:14px;padding-top:6px;gap:2px;letter-spacing:0}
  .astro-wege__also{margin:0;padding:12px 0 16px;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;gap:8px}
  .astro-wege__also::-webkit-scrollbar{display:none}
  .astro-wege__also span{display:none}
  .astro-wege__also a{white-space:nowrap;font-size:15px}
}
</style>
