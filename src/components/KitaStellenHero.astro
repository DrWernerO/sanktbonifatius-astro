---
// Stellenbörse Hero — Kita-Stellen der Pfarrei Sankt Bonifatius Frankfurt
// CSS-Präfix: astro-stl-
const { count = 0 } = Astro.props;
---
<div class="astro-stl-root">
  <section class="astro-stl-hero">
    <div class="astro-stl-hero__in">
      <p class="astro-stl-hero__eyebrow">Kita-Stellen &middot; Pfarrei Sankt Bonifatius Frankfurt</p>
      <h1 class="astro-stl-hero__h1">Arbeiten, wo es z&auml;hlt.</h1>
      <p class="astro-stl-hero__lead">Wir suchen Menschen, die Kinder auf ihrem Weg begleiten m&ouml;chten. Keine Karriere wie jede andere.</p>
      {count > 0 && (
        <span class="astro-stl-hero__count">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
          Aktuell {count} offene {count === 1 ? 'Stelle' : 'Stellen'}
        </span>
      )}
    </div>
  </section>
</div>

<style is:global>
:root {
  --bf-bg: #f7f3ef;
  --bf-bg-alt: #ede4d5;
  --bf-ink: #1e1512;
  --bf-ink-60: #6b5c52;
  --bf-accent: #9a2d2d;
  --bf-gold: #b88a3a;
  --bf-border: #e0d8cf;
  --bf-radius: 14px;
}
.astro-stl-root {
  width: 100vw;
  position: relative;
  left: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
}
.astro-stl-hero {
  position: relative;
  display: flex;
  align-items: flex-end;
  min-height: 440px;
  background: linear-gradient(135deg, #3a1414 0%, #5a2424 35%, #7a3a20 65%, #9a6535 100%);
  overflow: hidden;
}
.astro-stl-hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 24% 16%, rgba(197,165,90,.32), transparent 60%);
}
.astro-stl-hero__in {
  position: relative;
  z-index: 1;
  max-width: 700px;
  width: 100%;
  margin: 0 auto;
  padding: 104px 24px 64px;
  text-align: center;
}
.astro-stl-hero__eyebrow {
  font-size: 12px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: #e8c87a;
  margin: 0 0 18px;
}
.astro-stl-hero__h1 {
  font-family: 'Playfair Display', Georgia, serif;
  font-weight: 700;
  font-size: clamp(36px, 5.5vw, 64px);
  line-height: 1.08;
  color: #fff;
  margin: 0 0 18px;
  text-shadow: 0 2px 14px rgba(0,0,0,.3);
}
.astro-stl-hero__lead {
  font-size: clamp(15px, 2vw, 18px);
  color: #ece0cc;
  line-height: 1.65;
  max-width: 480px;
  margin: 0 auto 28px;
}
.astro-stl-hero__count {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,.1);
  border: 1px solid rgba(232,200,122,.4);
  border-radius: 50px;
  padding: 8px 20px;
  font-size: 13px;
  color: #e8c87a;
  font-weight: 600;
  letter-spacing: .04em;
}

/* Shared section helper */
.astro-stl-sec { width: 100vw; position: relative; left: 50%; margin-left: -50vw; margin-right: -50vw; }
.astro-stl-eyebrow-sm { font-family: 'Futura LT W01 Book', Futura, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--bf-accent); margin: 0 0 10px; }
[id] { scroll-margin-top: 100px; }

@media (max-width: 600px) {
  .astro-stl-hero { min-height: 380px; }
  .astro-stl-hero__in { padding: 88px 20px 48px; }
}
</style>
