---
<div class="astro-apos-marquee" id="galerie">
  <button type="button" class="astro-apos-marquee__pause" aria-label="Bilderlauf pausieren" aria-pressed="false">
    <svg class="astro-apos-marquee__icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
    <svg class="astro-apos-marquee__icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><path d="M8 5v14l11-7z"></path></svg>
  </button>
  <div class="astro-apos-marquee-track">
    {images.map(src => <img src={src} alt="Leben in St. Aposteln" loading="lazy" />)}
    {images.map(src => <img src={src} alt="" loading="lazy" aria-hidden="true" />)}
  </div>
</div>

<style is:global>
.astro-apos-marquee {
  overflow: hidden;
  background: #1e1512;
  padding: 6px 0;
  width: 100vw;
  position: relative;
  left: 50%;
  margin-left: -50vw;
}
.astro-apos-marquee-track {
  display: flex;
  gap: 8px;
  width: max-content;
  animation: astroAposMarquee 70s linear infinite;
}
.astro-apos-marquee-track:hover, .astro-apos-marquee-track.is-paused { animation-play-state: paused; }
.astro-apos-marquee-track img {
  height: 240px;
  width: auto;
  object-fit: cover;
  border-radius: 4px;
  display: block;
  flex-shrink: 0;
}
@keyframes astroAposMarquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
@media (max-width: 600px) {
  .astro-apos-marquee-track img { height: 160px; }
}
@media (prefers-reduced-motion: reduce) {
  .astro-apos-marquee-track { animation: none; overflow-x: auto; }
}
.astro-apos-marquee__pause{position:absolute;top:8px;right:12px;z-index:5;width:30px;height:30px;border-radius:50%;border:1px solid rgba(255,255,255,.3);background:rgba(0,0,0,.35);color:#f0e8d8;display:flex;align-items:center;justify-content:center;cursor:pointer}
.astro-apos-marquee__pause:hover{background:rgba(0,0,0,.55)}
.astro-apos-marquee__pause:focus-visible{outline:2px solid var(--accent-gold-deco);outline-offset:2px}
</style>

<script>
  document.querySelectorAll('.astro-apos-marquee').forEach(function (wrap) {
    var btn = wrap.querySelector('.astro-apos-marquee__pause');
    var track = wrap.querySelector('.astro-apos-marquee-track');
    if (!btn || !track || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', function () {
      var paused = track.classList.toggle('is-paused');
      btn.setAttribute('aria-pressed', paused ? 'true' : 'false');
      btn.setAttribute('aria-label', paused ? 'Bilderlauf fortsetzen' : 'Bilderlauf pausieren');
      btn.querySelector('.astro-apos-marquee__icon-pause').hidden = paused;
      btn.querySelector('.astro-apos-marquee__icon-play').hidden = !paused;
    });
  });
</script>
