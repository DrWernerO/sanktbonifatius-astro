---
// Gemeinsames Formular „IHR St. Bonifatius" — wird auf /100-jahre/ (JubMitmachen.astro, aufklappbar)
// und auf /ihr-st-bonifatius/ (offen) eingesetzt. Sendet per FormData an die API-Route
// `/api/jubilaeum-erfahrung` (src/pages/api/jubilaeum-erfahrung.ts) — dieselbe Mail-Funktion
// (nodemailer/SMTP) wie Taufanmeldung und Kita-Bewerbung.
// 🔑 Feldnamen sind VERTRAG mit der API-Route: name, email, nachricht, foto, einverstaendnis,
// quelle (Herkunftsseite, nur für den Mailtext), webseite (Honeypot), astro_ts.
// Einwilligungstext (Werner, 09.11.2026): Website, Virtueller Kirchenführer UND Fernseher im Eingang der Kirche.
// Es darf nur ein Formular pro Seite stehen (feste IDs).
const { quelle = '/100-jahre/' } = Astro.props;
---
<form id="astro-jub-mit-form" class="astro-jub-mit__form" novalidate>
  <div class="astro-jub-mit__grid">
    <label class="astro-jub-mit__f">Ihr Name *<input type="text" name="name" autocomplete="name" required /></label>
    <label class="astro-jub-mit__f">Ihre E-Mail-Adresse *<input type="email" name="email" autocomplete="email" required /></label>
  </div>
  <label class="astro-jub-mit__f">Ihre Nachricht *
    <textarea name="nachricht" rows="6" maxlength="5000" required placeholder="Was verbinden Sie mit St. Bonifatius? Was haben Sie hier erlebt?"></textarea>
  </label>
  <label class="astro-jub-mit__f">Foto (optional)
    <input type="file" name="foto" accept="image/jpeg,image/png,image/webp" />
    <span class="astro-jub-mit__hint">Bitte nur Fotos, an denen Sie die Rechte haben und auf denen alle erkennbaren Personen einverstanden sind.</span>
  </label>
  <div class="astro-jub-mit__consent">
    <label><input type="checkbox" name="einverstaendnis" required /><span>Ich erlaube, meinen Namen, Text und gegebenenfalls mein Foto auf der Website der Pfarrei, im „Virtuellen Kirchenführer“ und im Jubiläumsjahr auf einem Fernseher im Eingang der Kirche zu zeigen. Mehr dazu in der <a href="/datenschutz/" target="_blank" rel="noopener">Datenschutzerklärung</a>. *</span></label>
  </div>
  <p class="astro-jub-mit__required">* Pflichtfeld</p>
  <button type="submit" class="astro-jub-mit__submit">Absenden</button>
  <div class="astro-jub-mit__msg" id="astro-jub-mit-msg" role="status" aria-live="polite" hidden></div>
  <!-- Anti-Spam wie Taufe/Kita: Honeypot unsichtbar, Server verwirft still -->
  <div class="astro-jub-mit__hp" aria-hidden="true">
    <label>Bitte dieses Feld leer lassen<input type="text" name="webseite" tabindex="-1" autocomplete="off" /></label>
  </div>
  <input type="hidden" name="astro_ts" id="astro-jub-mit-ts" value="" />
  <input type="hidden" name="quelle" value={quelle} />
</form>

<script is:inline>
(function () {
  var form = document.getElementById('astro-jub-mit-form');
  if (!form) return;
  var msg = document.getElementById('astro-jub-mit-msg');
  var btn = form.querySelector('.astro-jub-mit__submit');
  var MAX_MB = 4;
  var ts = document.getElementById('astro-jub-mit-ts');
  if (ts) ts.value = String(Date.now());

  function setMsg(ok, text) {
    msg.hidden = false;
    msg.className = 'astro-jub-mit__msg ' + (ok ? 'is-ok' : 'is-err');
    msg.textContent = (ok ? '✓ ' : '⚠ ') + text;
  }

  // Handyfotos sind oft 3–8 MB: vor dem Senden auf max. 2000 px / JPEG verkleinern (bleibt das
  // fehl, geht das Original raus, sofern es klein genug ist).
  function verkleinern(file) {
    return new Promise(function (resolve) {
      if (!file || !/^image\/(jpeg|png|webp)$/.test(file.type)) return resolve(file);
      var url = URL.createObjectURL(file);
      var img = new Image();
      img.onload = function () {
        var scale = Math.min(1, 2000 / Math.max(img.width, img.height));
        if (scale === 1 && file.size <= 1.5 * 1024 * 1024) { URL.revokeObjectURL(url); return resolve(file); }
        var c = document.createElement('canvas');
        c.width = Math.round(img.width * scale); c.height = Math.round(img.height * scale);
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        c.toBlob(function (blob) {
          URL.revokeObjectURL(url);
          if (!blob) return resolve(file);
          resolve(new File([blob], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' }));
        }, 'image/jpeg', 0.85);
      };
      img.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
      img.src = url;
    });
  }

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    if (!form.reportValidity()) return;
    btn.disabled = true; var alt = btn.textContent; btn.textContent = 'Wird gesendet…';
    try {
      var data = new FormData(form);
      var f = data.get('foto');
      if (f && f.size) {
        var klein = await verkleinern(f);
        if (klein.size > MAX_MB * 1024 * 1024) { setMsg(false, 'Das Foto ist größer als ' + MAX_MB + ' MB. Bitte ein kleineres wählen.'); return; }
        data.set('foto', klein, klein.name);
      } else { data.delete('foto'); }
      var res = await fetch('/api/jubilaeum-erfahrung', { method: 'POST', body: data }).then(function (r) { return r.json(); });
      if (res && res.success) { setMsg(true, typeof res.data === 'string' ? res.data : 'Vielen Dank! Ihr Beitrag ist angekommen.'); form.reset(); if (ts) ts.value = String(Date.now()); }
      else setMsg(false, (res && res.data) || 'Fehler beim Senden. Bitte versuchen Sie es erneut.');
    } catch (err) {
      setMsg(false, 'Verbindungsfehler. Bitte versuchen Sie es erneut oder schreiben Sie an w.otto@sanktbonifatius.de.');
    } finally { btn.disabled = false; btn.textContent = alt; }
  });
})();
</script>

<style is:global>
.astro-jub-mit__form{display:flex;flex-direction:column;gap:14px;margin-top:18px}
.astro-jub-mit__grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.astro-jub-mit__f{display:flex;flex-direction:column;gap:6px;font-size:15px;font-weight:600;color:#1e1512}
.astro-jub-mit__f input[type=text],.astro-jub-mit__f input[type=email],.astro-jub-mit__f textarea{font-family:inherit;font-size:16px;font-weight:400;color:#1e1512;padding:11px 12px;min-height:48px;border:1px solid #8a7a6c;border-radius:8px;background:#fff}
.astro-jub-mit__f input[type=file]{font-size:15px;font-weight:400}
.astro-jub-mit__f input:focus,.astro-jub-mit__f textarea:focus{outline:3px solid #9a2d2d;outline-offset:1px;border-color:#9a2d2d}
.astro-jub-mit__f textarea{resize:vertical}
.astro-jub-mit__hint{font-size:14px;font-weight:400;color:#5b4d44;line-height:1.5}
.astro-jub-mit__consent{background:#fff;border:1px solid #e0d8cf;border-radius:10px;padding:14px 16px}
.astro-jub-mit__consent label{display:flex;align-items:flex-start;gap:12px;font-size:15px;line-height:1.55;color:#1e1512}
.astro-jub-mit__consent input{margin-top:3px;width:22px;height:22px;flex:0 0 auto;accent-color:#9a2d2d}
.astro-jub-mit__consent a{color:#9a2d2d;font-weight:600}
.astro-jub-mit__required{font-size:14px;color:#5b4d44;margin:0}
.astro-jub-mit__submit{align-self:flex-start;display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:11px 28px;border-radius:50px;background:#9a2d2d;color:#fff;border:2px solid #9a2d2d;font-family:inherit;font-size:16px;font-weight:600;cursor:pointer}
.astro-jub-mit__submit:hover{box-shadow:0 10px 32px rgba(30,21,18,.1)}
.astro-jub-mit__submit:focus-visible{outline:3px solid #9a2d2d;outline-offset:3px}
.astro-jub-mit__submit:disabled{opacity:.65;cursor:default}
.astro-jub-mit__msg{padding:12px 14px;border-radius:8px;font-size:15px;line-height:1.5}
.astro-jub-mit__msg.is-ok{background:#e8f5e9;border:1px solid #a5d6a7;color:#1b5e20}
.astro-jub-mit__msg.is-err{background:#ffebee;border:1px solid #ef9a9a;color:#b71c1c}
.astro-jub-mit__hp{position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden}
@media(max-width:640px){.astro-jub-mit__grid{grid-template-columns:1fr}.astro-jub-mit__submit{align-self:stretch}}
</style>
