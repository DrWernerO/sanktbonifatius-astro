---
// Intro + Sprung-Navigation „Gruppen und Treffpunkte" (A9) — Präfix `astro-gtintro`.
// Text nach dem Heft „Gruppen und Treffpunkte 2026" der Pfarrei.
const jumpLinks = [
  { href: '#gottesdienst-glaube', label: 'Gottesdienst & Glaube' },
  { href: '#bonfamily', label: 'BonFamily' },
  { href: '#jugend', label: 'Jugend' },
  { href: '#kultur-begegnung', label: 'Kultur & Begegnung' },
  { href: '#engagiert-leben', label: 'Engagiert Leben' },
];
---
<section class="astro-gtintro">
  <div class="astro-gtintro__inner">
    <p class="astro-gtintro__txt">
      In der Pfarrei Sankt Bonifatius gibt es viele Gruppen und offene Treffpunkte f&uuml;r ganz
      unterschiedliche Interessen, Lebensphasen und Altersgruppen. Auf dieser Seite finden Sie eine
      &Uuml;bersicht &#8211; vielleicht ist ja genau das Angebot dabei, das zu Ihnen passt. Wir freuen
      uns auf alle, die neu dazukommen, einfach mal hereinschauen oder regelm&auml;&szlig;ig mitmachen
      m&ouml;chten.
    </p>
    <div class="astro-gtintro__wa">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
      <p>
        <strong>Ganz nah dran:</strong> Aktuelle Hinweise zu Terminen und &Auml;nderungen bei diesen
        Gruppen bekommen Sie auch direkt aufs Handy &#8211; &uuml;ber unseren
        <a href="/kontakt/whatsapp-kanal/">WhatsApp-Kanal</a>.
      </p>
    </div>
    <nav class="astro-gtintro__jump" aria-label="Sprung zu den Bereichen">
      {jumpLinks.map(j => <a href={j.href}>{j.label}</a>)}
    </nav>
  </div>
</section>

<style is:global>
.astro-gtintro{background:#f7f3ef;padding:48px 0 8px}
.astro-gtintro__inner{max-width:900px;margin:0 auto;padding:0 40px}
.astro-gtintro__txt{font-size:17px;line-height:1.75;color:#5a4a3a;margin:0 0 28px;text-align:center}
.astro-gtintro__wa{display:flex;align-items:flex-start;gap:14px;background:#fff;border:1px solid #e0d8cf;border-radius:14px;padding:20px 24px;margin:0 0 32px}
.astro-gtintro__wa svg{color:#128C7E;flex-shrink:0;margin-top:2px}
.astro-gtintro__wa p{margin:0;font-size:14.5px;line-height:1.6;color:#5a4a3a}
.astro-gtintro__wa a{color:#128C7E;text-decoration:underline}
.astro-gtintro__jump{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;padding-bottom:32px}
.astro-gtintro__jump a{font-size:13px;font-weight:600;color:#5a4a3a;text-decoration:none;background:#fff;border:1.5px solid var(--accent-gold-deco);border-radius:24px;padding:9px 18px;transition:all .2s}
.astro-gtintro__jump a:hover{background:#ede6dd;border-color:#a3813f;color:#2c2420}
@media(max-width:600px){.astro-gtintro__inner{padding:0 20px}}
</style>
