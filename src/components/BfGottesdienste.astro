---
// Gottesdienste-Section BonFamily — seit 2026-11-03 knappes Foto-Band statt drei Erklär-Kacheln
// (Wunsch Frank: Details stehen auf /bonfamily/familiengottesdienste/, hier nur Überblick + Verweis).
// Links 3 Fotos als ruhige Überblend-Galerie (Wechsel alle 6 s, bei „Bewegung reduzieren“ statisch;
// eine Collage war zu unruhig), rechts Überschrift,
// ein Satz ohne feste Zeitangabe, zwei Wegweiser-Zeilen (gleiche Formate wie KfgFormate)
// und ein deutlicher Button zur Unterseite. Präfix `astro-bfgd` (nicht `bf-gd-...`).
const formate = [
  {
    icon: `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>`,
    title: 'Kindergottesdienste',
    text: 'Mit Bilderbuch oder mit Farbe und Kleber – Kinder entdecken den Glauben auf ihre Weise.',
  },
  {
    icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
    title: 'Familiengottesdienste',
    text: 'Mitsingen, mitmachen, mitfeiern – für Groß und Klein in St. Bonifatius und St. Wendel.',
  },
];
const fotos = [
  { src: '/uploads/2026/11/bonfamily-gd-familie.webp', w: 1000, h: 666,
    alt: 'Kinder und Familien feiern gemeinsam Gottesdienst in St. Bonifatius' },
  { src: '/uploads/2026/11/bonfamily-gd-bilderbuch.webp', w: 666, h: 1000, pos: 'center 35%',
    alt: 'Bilderbuchgottesdienst: Kinder schauen gemeinsam in ein Bilderbuch' },
  { src: '/uploads/2026/11/bonfamily-gd-kreativ.webp', w: 1000, h: 666,
    alt: 'Kindergottesdienst: Kinder sitzen im Kreis und gestalten gemeinsam die Mitte' },
];
const href = '/bonfamily/familiengottesdienste/';
---
<section id="bonfamily-gottesdienste" class="astro-bfgd">
  <div class="astro-bfgd__inner">
    <div class="astro-bfgd__band">
      <div class="astro-bfgd__slides">
        {fotos.map((f, i) => (
          <img src={f.src} alt={f.alt} width={f.w} height={f.h}
               style={f.pos ? `object-position:${f.pos}` : undefined}
               class:list={['astro-bfgd__img', { 'is-active': i === 0 }]}
               loading="lazy" decoding="async" />
        ))}
        <div class="astro-bfgd__dots">
          {fotos.map((_, i) => (
            <button type="button" class:list={['astro-bfgd__dot', { 'is-active': i === 0 }]}
                    aria-label={`Foto ${i + 1} von ${fotos.length} zeigen`}
                    aria-current={i === 0 ? 'true' : undefined}></button>
          ))}
        </div>
      </div>
      <div class="astro-bfgd__text">
        <h2 class="astro-bfgd__title">Gottesdienste für Kinder und Familien</h2>
        <p class="astro-bfgd__sub">
          Kirche zum Mitmachen: Kinder feiern ihren eigenen Gottesdienst &ndash; und immer wieder
          kommen wir alle zusammen als gro&szlig;e Familie.
        </p>
        <ul class="astro-bfgd__list">
          {formate.map(f => (
            <li class="astro-bfgd__item">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                   aria-hidden="true" set:html={f.icon} />
              <span><strong>{f.title}</strong> {f.text}</span>
            </li>
          ))}
        </ul>
        <a href={href} class="astro-bfgd__btn">
          Zeiten, Orte und Formate ansehen
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
.astro-bfgd{width:100vw;position:relative;left:50%;margin-left:-50vw;margin-right:-50vw;background:#fff;padding:72px 0;scroll-margin-top:96px}
.astro-bfgd__inner{max-width:1120px;margin:0 auto;padding:0 40px}
.astro-bfgd__band{display:grid;grid-template-columns:1.1fr 1fr;border-radius:20px;overflow:hidden;background:#9a2d2d;box-shadow:0 8px 32px rgba(30,21,18,.14)}
.astro-bfgd__slides{position:relative;min-height:420px;background:#2c2420}
.astro-bfgd__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;opacity:0;transition:opacity 1.2s ease}
.astro-bfgd__img.is-active{opacity:1}
.astro-bfgd__dots{position:absolute;left:0;right:0;bottom:4px;display:flex;justify-content:center;z-index:1}
/* Tippfläche 44 × 44 px (Seiten-Checkliste), sichtbar bleibt nur der kleine Punkt (::before) */
.astro-bfgd__dot{width:44px;height:44px;padding:0;border:0;border-radius:50%;background:none;cursor:pointer;display:flex;align-items:center;justify-content:center}
.astro-bfgd__dot::before{content:'';width:11px;height:11px;box-sizing:border-box;border-radius:50%;border:2px solid #fff;background:rgba(255,255,255,.35);box-shadow:0 1px 4px rgba(0,0,0,.35);transition:background .3s,transform .3s}
.astro-bfgd__dot:hover::before{background:rgba(255,255,255,.7)}
.astro-bfgd__dot.is-active::before{background:#9a2d2d;transform:scale(1.15)}
.astro-bfgd__dot:focus-visible{outline:2px solid #fff;outline-offset:-8px}
@media(prefers-reduced-motion:reduce){.astro-bfgd__img,.astro-bfgd__dot::before{transition:none}}
.astro-bfgd__text{padding:48px 44px;display:flex;flex-direction:column;justify-content:center;color:#fff}
.astro-bfgd__title{font-family:'Playfair Display',Georgia,serif;font-size:clamp(26px,3vw,34px);font-weight:700;line-height:1.2;color:#fff;margin:0 0 14px}
.astro-bfgd__sub{font-size:16px;line-height:1.65;color:rgba(255,255,255,.85);margin:0 0 24px}
.astro-bfgd__list{list-style:none;padding:0;margin:0 0 32px;display:flex;flex-direction:column;gap:14px}
.astro-bfgd__item{display:flex;align-items:flex-start;gap:12px;font-size:15px;line-height:1.5;color:rgba(255,255,255,.85)}
.astro-bfgd__item svg{flex-shrink:0;margin-top:1px;color:#f3c98b}
.astro-bfgd__item strong{display:block;color:#fff;font-size:16px}
.astro-bfgd__btn{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:50px;background:#fff;color:#9a2d2d;font-size:14px;font-weight:700;text-decoration:none;transition:background .18s,color .18s}
.astro-bfgd__btn svg{transition:transform .15s}
.astro-bfgd__btn:hover{background:#f7f0e6}
.astro-bfgd__btn:hover svg{transform:translateX(4px)}
.astro-bfgd__btn:focus-visible{outline:3px solid #fff;outline-offset:3px}
@media(max-width:860px){
  .astro-bfgd__band{grid-template-columns:1fr}
  .astro-bfgd__slides{min-height:0;aspect-ratio:4/3}
  .astro-bfgd__text{padding:32px 28px}
}
@media(max-width:600px){
  .astro-bfgd{padding:52px 0}
  .astro-bfgd__inner{padding:0 20px}
  .astro-bfgd__btn{align-self:stretch;justify-content:center}
}
</style>

<script>
  // Überblend-Galerie: alle 6 s nächstes Foto, Punkte unten zeigen/wählen das aktive Foto.
  // Automatischer Wechsel ruht bei „Bewegung reduzieren“ und im Hintergrund-Tab.
  document.querySelectorAll<HTMLElement>('.astro-bfgd__slides').forEach(function (wrap) {
    var imgs = wrap.querySelectorAll('.astro-bfgd__img');
    var dots = wrap.querySelectorAll('.astro-bfgd__dot');
    if (imgs.length < 2 || wrap.dataset.bound) return;
    wrap.dataset.bound = '1';
    imgs.forEach(function (img) { img.removeAttribute('loading'); });
    var i = 0;
    var timer = 0;
    function show(n) {
      imgs[i].classList.remove('is-active');
      dots[i].classList.remove('is-active');
      dots[i].removeAttribute('aria-current');
      i = n;
      imgs[i].classList.add('is-active');
      dots[i].classList.add('is-active');
      dots[i].setAttribute('aria-current', 'true');
    }
    function start() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      clearInterval(timer);
      timer = window.setInterval(function () {
        if (!document.hidden) show((i + 1) % imgs.length);
      }, 6000);
    }
    dots.forEach(function (dot, n) {
      dot.addEventListener('click', function () { show(n); start(); });
    });
    start();
  });
</script>
