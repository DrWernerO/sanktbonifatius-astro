// Bildliste verdoppeln → nahtloser Loop (Animation läuft -50% der Gesamtbreite).
const loop = [...photos, ...photos];
// width/height (aus den echten Pixelmaßen) auf jedem <img>: der Track (width:max-content)
// und damit der -50%-Loop-Punkt der Animation dürfen sich nicht verschieben, während die
// 52 Bilder nacheinander laden -- sonst "rutscht" die halbe Reihe beim ersten Aufruf leer
// durch und wird erst nach Neuladen (Bilder dann aus dem Cache) sofort korrekt breit.
---
<div class="astro-marquee">
  <h2 class="astro-marquee__hl">Unser Leben als Pfarrei</h2>
  <button type="button" class="astro-marquee__pause" aria-label="Bilderlauf pausieren" aria-pressed="false">
    <svg class="astro-marquee__icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
    <svg class="astro-marquee__icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><path d="M8 5v14l11-7z"></path></svg>
  </button>
  <div class="astro-marquee__track">
    {loop.map((p, i) => (
      <img
        decoding="async"
        src={HOST + p.u}
        width={p.w}
        height="450"
        alt={i < photos.length ? p.a : ''}
        aria-hidden={i >= photos.length ? 'true' : undefined}
      />
    ))}
  </div>
</div>

<style is:global>
/* Auf Content-Breite begrenzt (kein Full-Bleed) → gleiche Breite wie die übrigen Sektionen,
   plus vertikaler Abstand zu Nachbarelementen. */
.astro-marquee{position:relative;overflow:hidden;background:#2c2420;padding:14px 0;width:calc(100% - 80px);max-width:1120px;margin:48px auto;border-radius:12px}
.astro-marquee__hl{text-align:center;color:var(--accent-gold-deco);font-size:.75rem;font-weight:400;letter-spacing:.15em;text-transform:uppercase;margin:0 0 8px;font-family:'Source Sans 3',sans-serif}
.astro-marquee__track{display:flex;gap:10px;width:max-content;animation:astro-marquee-scroll 150s linear infinite}
.astro-marquee__track:hover,.astro-marquee__track.is-paused{animation-play-state:paused}
.astro-marquee__track img{height:204px;width:auto;object-fit:cover;border-radius:4px;display:block;flex-shrink:0}
@keyframes astro-marquee-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media(max-width:600px){.astro-marquee{width:calc(100% - 40px);margin:32px auto}}
@media(prefers-reduced-motion:reduce){.astro-marquee__track{animation:none;overflow-x:auto}}
/* Manueller Pause-Knopf (WCAG 2.2.2) — Hover pausiert schon, aber Tastatur-/Touch-Nutzer:innen
   können nicht hovern, deshalb zusätzlich ein echter Button, unabhängig von prefers-reduced-motion. */
.astro-marquee__pause{position:absolute;top:8px;right:12px;z-index:5;width:30px;height:30px;border-radius:50%;border:1px solid rgba(255,255,255,.3);background:rgba(0,0,0,.35);color:#f0e8d8;display:flex;align-items:center;justify-content:center;cursor:pointer}
.astro-marquee__pause:hover{background:rgba(0,0,0,.55)}
.astro-marquee__pause:focus-visible{outline:2px solid var(--accent-gold-deco);outline-offset:2px}
</style>

<script>
  document.querySelectorAll('.astro-marquee').forEach(function (wrap) {
    var btn = wrap.querySelector('.astro-marquee__pause');
    var track = wrap.querySelector('.astro-marquee__track');
    if (!btn || !track || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', function () {
      var paused = track.classList.toggle('is-paused');
      btn.setAttribute('aria-pressed', paused ? 'true' : 'false');
      btn.setAttribute('aria-label', paused ? 'Bilderlauf fortsetzen' : 'Bilderlauf pausieren');
      btn.querySelector('.astro-marquee__icon-pause').hidden = paused;
      btn.querySelector('.astro-marquee__icon-play').hidden = !paused;
    });
  });
</script>
