<style is:global>
/* ANMELDUNG */
.astro-kwe-anmeld { background: var(--bf-bg); padding: 80px 24px; }
.astro-kwe-anmeld__in { max-width: 860px; margin: 0 auto; }
.astro-kwe-anmeld__head { text-align: center; margin-bottom: 44px; }
.astro-kwe-anmeld__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: var(--bf-ink); margin: 0; }
.astro-kwe-anmeld__steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; }
.astro-kwe-anmeld__step { display: flex; gap: 24px; position: relative; padding-bottom: 32px; }
.astro-kwe-anmeld__step:last-child { padding-bottom: 0; }
.astro-kwe-anmeld__step::before { content: ''; position: absolute; left: 21px; top: 48px; bottom: 0; width: 2px; background: var(--bf-border); }
.astro-kwe-anmeld__step:last-child::before { display: none; }
.astro-kwe-anmeld__num { width: 44px; height: 44px; border-radius: 50%; background: var(--bf-accent); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 17px; font-family: 'Playfair Display', Georgia, serif; flex-shrink: 0; }
.astro-kwe-anmeld__step-body h3 { font-family: 'Playfair Display', Georgia, serif; font-size: 18px; font-weight: 700; color: var(--bf-ink); margin: 8px 0 8px; }
.astro-kwe-anmeld__step-body p { font-size: 15px; color: var(--bf-ink-60); line-height: 1.7; margin: 0; }

/* DOKUMENTE */
.astro-kwe-docs { background: #fff; padding: 60px 24px; }
.astro-kwe-docs__in { max-width: 900px; margin: 0 auto; }
.astro-kwe-docs__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(22px, 2.5vw, 30px); font-weight: 700; color: var(--bf-ink); margin: 0 0 32px; }
.astro-kwe-docs__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
.astro-kwe-docs__card { display: flex; gap: 16px; align-items: flex-start; background: var(--bf-bg); border: 1px solid var(--bf-border); border-radius: var(--bf-radius); padding: 18px 20px; text-decoration: none; color: inherit; transition: border-color .2s, box-shadow .2s; }
