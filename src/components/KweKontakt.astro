.astro-kwe-faq__q { padding: 18px 24px; font-family: 'Playfair Display', Georgia, serif; font-size: 16px; font-weight: 700; color: var(--bf-ink); cursor: pointer; list-style: none; position: relative; padding-right: 48px; }
.astro-kwe-faq__q::-webkit-details-marker { display: none; }
.astro-kwe-faq__q::after { content: '+'; position: absolute; right: 20px; top: 50%; transform: translateY(-50%); font-size: 22px; font-weight: 400; color: var(--bf-accent); transition: transform .2s; }
