.astro-kwe-kontakt__addr-card p { font-size: 14.5px; color: var(--bf-ink-60); line-height: 1.7; margin: 0 0 8px; }
.astro-kwe-kontakt__addr-card p:last-child { margin-bottom: 0; }
.astro-kwe-kontakt__addr-card a { color: var(--bf-accent); text-decoration: none; }
.astro-kwe-kontakt__addr-card a:hover { text-decoration: underline; }
@media (max-width: 640px) { .astro-kwe-kontakt__addr-wrap { grid-template-columns: 1fr; gap: 20px; } }
</style>
