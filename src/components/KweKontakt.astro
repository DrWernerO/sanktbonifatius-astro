/* Adresse */
.astro-kwe-kontakt__addr-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
.astro-kwe-kontakt__addr-text p { font-size: 15px; color: var(--bf-ink-60); line-height: 1.7; margin: 0; }
