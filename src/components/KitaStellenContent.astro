---
// Stellenangebote + Warum-Grid + CTA — Kita-Stellenbörse
// CSS-Präfix: astro-stl-
---

<!-- STELLENANGEBOTE -->
<section class="astro-stl-stellen astro-stl-sec" id="astro-stl-stellen">
  <div class="astro-stl-stellen__in">
    <div class="astro-stl-stellen__head">
      <p class="astro-stl-eyebrow-sm">Offene Stellen</p>
      <h2 class="astro-stl-stellen__h2">Aktuelle Stellenangebote</h2>
      <p class="astro-stl-stellen__sub">Wir suchen engagierte P&auml;dagog:innen f&uuml;r unsere Kitas in Frankfurt-Sachsenhausen.</p>
    </div>
    <div class="astro-stl-stellen__list">
      <a class="astro-stl-card" href="/kitas/stellenboerse/fachkraft-st-bonifatius/">
        <div class="astro-stl-card__body">
          <p class="astro-stl-card__kita">Kita St. Bonifatius</p>
          <h3 class="astro-stl-card__title">P&auml;dagogische Fachkraft (w/m/d)</h3>
          <p class="astro-stl-card__type">Vollzeit &middot; Teilzeit &middot; Frankfurt am Main</p>
        </div>
        <span class="astro-stl-card__arrow" aria-hidden="true">&#8594;</span>
      </a>
      <a class="astro-stl-card" href="/kitas/stellenboerse/fachkraft-deutschorden/">
        <div class="astro-stl-card__body">
          <p class="astro-stl-card__kita">Kita Deutschorden</p>
          <h3 class="astro-stl-card__title">P&auml;dagogische Fachkraft (w/m/d)</h3>
          <p class="astro-stl-card__type">Vollzeit &middot; Teilzeit &middot; Frankfurt am Main</p>
        </div>
        <span class="astro-stl-card__arrow" aria-hidden="true">&#8594;</span>
      </a>
      <a class="astro-stl-card" href="/kitas/stellenboerse/leitung-deutschorden/">
        <div class="astro-stl-card__body">
          <p class="astro-stl-card__kita">Kita Deutschorden</p>
          <h3 class="astro-stl-card__title">Kita-Leitung (w/m/d)</h3>
          <p class="astro-stl-card__type">Vollzeit &middot; Teilzeit &middot; Frankfurt am Main</p>
        </div>
        <span class="astro-stl-card__arrow" aria-hidden="true">&#8594;</span>
      </a>
      <a class="astro-stl-card" href="/kitas/stellenboerse/fachkraft-herz-jesu/">
        <div class="astro-stl-card__body">
          <p class="astro-stl-card__kita">Kita Herz Jesu</p>
          <h3 class="astro-stl-card__title">P&auml;dagogische Fachkraft (w/m/d)</h3>
          <p class="astro-stl-card__type">Vollzeit &middot; Teilzeit &middot; Frankfurt am Main</p>
        </div>
        <span class="astro-stl-card__arrow" aria-hidden="true">&#8594;</span>
      </a>
    </div>
  </div>
</section>

<!-- WARUM BEI UNS -->
<section class="astro-stl-warum astro-stl-sec">
  <div class="astro-stl-warum__in">
    <div class="astro-stl-warum__head">
      <p class="astro-stl-eyebrow-sm">Das spricht f&uuml;r uns</p>
      <h2 class="astro-stl-warum__h2">Warum bei uns arbeiten?</h2>
      <p class="astro-stl-warum__sub">Als Teil der Pfarrei Sankt Bonifatius sind wir mehr als ein Arbeitgeber.</p>
    </div>
    <div class="astro-stl-warum__grid">
      <div class="astro-stl-warum__item">
        <h3 class="astro-stl-warum__item-h3">Christliche Werte</h3>
        <p>Unsere Arbeit basiert auf christlichen Werten als p&auml;dagogischem Fundament.</p>
      </div>
      <div class="astro-stl-warum__item">
        <h3 class="astro-stl-warum__item-h3">Moderne P&auml;dagogik</h3>
        <p>Spielerisches Lernen, kreative Aktivit&auml;ten und individuelle F&ouml;rderung.</p>
      </div>
      <div class="astro-stl-warum__item">
        <h3 class="astro-stl-warum__item-h3">Teamarbeit</h3>
        <p>Dynamische, multiprofessionelle Teams mit echter gegenseitiger Unterst&uuml;tzung.</p>
      </div>
      <div class="astro-stl-warum__item">
        <h3 class="astro-stl-warum__item-h3">Sicheres Umfeld</h3>
        <p>Liebevolle Einrichtungen, in denen Kinder und Mitarbeiter:innen sich wohlf&uuml;hlen.</p>
      </div>
      <div class="astro-stl-warum__item">
        <h3 class="astro-stl-warum__item-h3">Netzwerk</h3>
        <p>Teil von &uuml;ber 300 Kitas im Bistum Limburg mit vielen Vorteilen.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="astro-stl-cta astro-stl-sec">
  <div class="astro-stl-cta__in">
    <h2 class="astro-stl-cta__h2">Fragen zur Bewerbung?</h2>
    <p class="astro-stl-cta__p">Unsere Ansprechpartnerinnen helfen Ihnen gerne weiter.</p>
    <div class="astro-stl-cta__btns">
      <a href="mailto:s.roos-greulich@sanktbonifatius.de" class="astro-stl-cta__btn astro-stl-cta__btn--gold">
        Sandra Roos-Greulich &#8594;
      </a>
      <a href="mailto:j.douverne@sanktbonifatius.de" class="astro-stl-cta__btn astro-stl-cta__btn--outline">
        Jeannine Douverne &#8594;
      </a>
    </div>
  </div>
</section>

<style is:global>
/* STELLENANGEBOTE */
.astro-stl-stellen { background: #fff; padding: 80px 24px; }
.astro-stl-stellen__in { max-width: 1100px; margin: 0 auto; }
.astro-stl-stellen__head { margin-bottom: 36px; }
.astro-stl-stellen__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: var(--bf-ink); margin: 0 0 8px; }
.astro-stl-stellen__sub { font-size: 16px; color: var(--bf-ink-60); margin: 0; line-height: 1.6; }
.astro-stl-stellen__list { display: flex; flex-direction: column; gap: 10px; }
.astro-stl-card { display: flex; align-items: center; justify-content: space-between; background: var(--bf-bg); border: 1px solid var(--bf-border); border-radius: var(--bf-radius); padding: 22px 28px; text-decoration: none; color: inherit; transition: border-color .2s, box-shadow .2s; }
.astro-stl-card:hover { border-color: var(--bf-accent); box-shadow: 0 4px 20px rgba(154,45,45,.07); }
.astro-stl-card__kita { font-family: 'Futura LT W01 Book', Futura, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--bf-accent); margin: 0 0 5px; }
.astro-stl-card__title { font-family: 'Playfair Display', Georgia, serif; font-size: 18px; font-weight: 700; color: var(--bf-ink); margin: 0 0 5px; line-height: 1.25; }
.astro-stl-card__type { font-size: 13px; color: var(--bf-ink-60); margin: 0; }
.astro-stl-card__arrow { font-size: 20px; color: var(--bf-accent); flex-shrink: 0; margin-left: 16px; transition: transform .2s; }
.astro-stl-card:hover .astro-stl-card__arrow { transform: translateX(4px); }

/* WARUM */
.astro-stl-warum { background: var(--bf-bg); padding: 80px 24px; }
.astro-stl-warum__in { max-width: 1100px; margin: 0 auto; }
.astro-stl-warum__head { margin-bottom: 36px; }
.astro-stl-warum__h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 3vw, 36px); font-weight: 700; color: var(--bf-ink); margin: 0 0 8px; }
.astro-stl-warum__sub { font-size: 16px; color: var(--bf-ink-60); margin: 0; line-height: 1.6; }
.astro-stl-warum__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
.astro-stl-warum__item { background: #fff; border: 1px solid var(--bf-border); border-radius: var(--bf-radius); padding: 24px; }
.astro-stl-warum__item-h3 { font-family: 'Playfair Display', Georgia, serif; font-size: 16px; font-weight: 700; color: var(--bf-ink); margin: 0 0 8px; }
.astro-stl-warum__item p { font-size: 14px; color: var(--bf-ink-60); line-height: 1.65; margin: 0; }

/* CTA */
.astro-stl-cta { background: linear-gradient(135deg, #4a2e1a, #3a2315); padding: 80px 24px; text-align: center; }
.astro-stl-cta__in { max-width: 600px; margin: 0 auto; }
.astro-stl-cta__h2 { font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: clamp(26px, 4vw, 42px); color: #f0e8d8; margin: 0 0 14px; }
.astro-stl-cta__p { color: rgba(240,232,216,.72); font-size: 16px; margin: 0 0 32px; line-height: 1.65; }
.astro-stl-cta__btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
.astro-stl-cta__btn { display: inline-flex; align-items: center; gap: 6px; padding: 13px 28px; border-radius: 50px; font-size: 14px; font-weight: 700; text-decoration: none; transition: background .2s; }
.astro-stl-cta__btn--gold { background: var(--bf-gold); color: #1a120e; }
.astro-stl-cta__btn--gold:hover { background: var(--bf-accent); color: #fff; }
.astro-stl-cta__btn--outline { background: rgba(184,138,58,.15); border: 1px solid rgba(184,138,58,.4); color: var(--bf-gold); }
.astro-stl-cta__btn--outline:hover { background: rgba(184,138,58,.3); }

@media (max-width: 640px) {
  .astro-stl-card { flex-direction: column; align-items: flex-start; gap: 10px; }
  .astro-stl-card__arrow { display: none; }
}
</style>
