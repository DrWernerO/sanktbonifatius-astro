---
// Kleine Mitmach-Abteilung „IHR St. Bonifatius" (Werner, 03.10.2026) — sammelt Erfahrungen und
// Erinnerungen für die „virtuelle Pfarrkirche" (digitaler Rundweg). Eigene Klassen `astro-jub-mit`
// (Handbuch 3). Mail-Adresse: w.otto@ (Werner, 03.10.2026), Betreff vorbelegt — bei Bedarf in
// `mail` anpassen. Ein größerer Mitmach-Bereich ist ausdrücklich noch NICHT geplant.
const mail = 'w.otto@sanktbonifatius.de';
const betreff = 'IHR St. Bonifatius – meine Erfahrung mit der Pfarrkirche';
---
<section class="astro-jub-sec astro-jub-mit" id="mitmachen">
  <div class="astro-jub-wrap astro-jub-wrap--narrow">
    <div class="astro-jub-mit__box">
      <p class="astro-jub-mit__label">Mitmachen</p>
      <h2 class="astro-jub-mit__hl">IHR St. Bonifatius</h2>
      <p class="astro-jub-mit__q">Was bedeutet Ihnen die Pfarrkirche? Was haben Sie an diesem Ort erlebt?</p>
      <p class="astro-jub-mit__text">Schreiben Sie uns! Ihre Erfahrung möchten wir gerne einen Platz in der „virtuellen Pfarrkirche“ geben.</p>
      <a class="astro-jub-btn astro-jub-btn--primary" href={`mailto:${mail}?subject=${encodeURIComponent(betreff)}`}>Schreiben Sie uns</a>
    </div>
  </div>
</section>

<style is:global>
.astro-jub-mit{background:#fff;padding:12px 0 8px}
.astro-jub-mit__box{background:var(--bf-bg);border:1px solid var(--bf-border);border-left:5px solid var(--accent-gold-deco);border-radius:var(--bf-radius);padding:22px 26px}
.astro-jub-mit__label{font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--txt-gold-label);margin:0 0 2px}
.astro-jub-mit__hl{font-family:var(--jub-serif);font-size:clamp(21px,2.6vw,26px);font-weight:700;line-height:1.2;color:var(--bf-ink);margin:0 0 8px}
.astro-jub-mit__q{font-family:var(--jub-serif);font-size:18px;line-height:1.5;color:var(--bf-ink);margin:0 0 6px}
.astro-jub-mit__text{font-size:16px;line-height:1.6;color:var(--txt-muted-light);margin:0 0 14px}
@media(max-width:640px){.astro-jub-mit__box{padding:18px 18px}}
</style>
