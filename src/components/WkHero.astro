---
// Hero der versteckten Landingpage „Willkommen" (/willkommen/, Ziel des QR-Codes im Brief zum
// Willkommens-Flyer für Neuzugezogene). Eigene Klassen `astro-wkhero` (goldene Regel, Handbuch 3).
// Full-Bleed-Foto + Rot-Verlauf (Flyer-Rot = Haus-Bordeaux) nach Muster BfHero.astro.
// Die „Handschrift"-Zeile des Flyers wird mit Playfair Display kursiv umgesetzt — eine echte
// Handschrift-Schrift ist laut Design-System (Team-Handbuch 04, „Keine weiteren Schriften") nicht erlaubt.
// Seit 2026-10-01 Foto der Bonifatius-Weinprobe (Wunsch Werner; Original BoniWeinprobe-00364.jpg,
// auf 2400px verkleinert, ohne EXIF). Vorher Gemeinschaft.jpg — das steht jetzt in WkIntro.
const bg = '/uploads/2026/10/willkommen-hero-weinprobe.jpg';
---
<section class="astro-wkhero">
  <div class="astro-wkhero__bg" role="img"
       aria-label="Viele fröhliche Menschen winken bei der Weinprobe der Pfarrei Sankt Bonifatius in die Kamera, Konfetti fliegt"
       style={`background-image:url('${bg}')`}></div>
  <div class="astro-wkhero__overlay"></div>
  <div class="astro-wkhero__inner">
    <p class="astro-wkhero__script">Herzlich willkommen in Sankt Bonifatius</p>
    <h1 class="astro-wkhero__title">Schön, dass Sie da sind!</h1>
    <div class="astro-wkhero__btns">
      <a href="#angebote" class="astro-wkhero__btn astro-wkhero__btn--primary">Unsere Angebote</a>
      <a href="#rueckmeldung" class="astro-wkhero__btn astro-wkhero__btn--outline">Rückmeldung geben</a>
    </div>
  </div>
</section>

<style is:global>
.astro-wkhero{position:relative;width:100vw;left:50%;margin-left:-50vw;margin-right:-50vw;min-height:560px;display:flex;align-items:flex-end;overflow:hidden;padding-top:120px;box-sizing:border-box;background:#6e1e1e}
.astro-wkhero__bg{position:absolute;inset:0;background-size:cover;background-position:center 55%}
/* Transparenter seit 2026-10-01 (Wunsch Werner: mehr Gesichter sichtbar); Lesbarkeit der Schrift über text-shadow. */
.astro-wkhero__overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(122,28,28,.72) 0%,rgba(154,45,45,.32) 42%,rgba(154,45,45,0) 68%),linear-gradient(180deg,rgba(30,21,18,0) 55%,rgba(60,18,18,.4) 100%)}
.astro-wkhero__inner{position:relative;z-index:2;width:100%;max-width:1280px;margin:0 auto;padding:0 40px 64px;color:#fff}
.astro-wkhero__script{text-shadow:0 1px 10px rgba(40,10,10,.7);font-family:'Playfair Display',Georgia,serif;font-style:italic;font-weight:400;font-size:clamp(20px,2.6vw,30px);color:#f3e2b8;margin:0 0 10px;line-height:1.25}
.astro-wkhero__title{text-shadow:0 2px 18px rgba(40,10,10,.65);font-family:'Playfair Display',Georgia,serif;font-size:clamp(36px,5.4vw,68px);font-weight:700;color:#fff;margin:0 0 28px;line-height:1.08;max-width:720px}
.astro-wkhero__btns{display:flex;gap:12px;flex-wrap:wrap}
.astro-wkhero__btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 26px;border-radius:50px;font-size:15px;font-weight:600;text-decoration:none;transition:background .18s,color .18s,border-color .18s}
.astro-wkhero__btn--primary{background:#fff;color:#9a2d2d;border:2px solid #fff}
.astro-wkhero__btn--primary:hover{background:#f3e7d4;border-color:#f3e7d4;color:#7e2424}
.astro-wkhero__btn--outline{background:rgba(255,255,255,.12);color:#fff;border:2px solid rgba(255,255,255,.6)}
.astro-wkhero__btn--outline:hover{background:rgba(255,255,255,.22);border-color:#fff}
.astro-wkhero__btn:focus-visible{outline:3px solid #f3e2b8;outline-offset:3px}
@media(max-width:600px){
  .astro-wkhero{min-height:480px;padding-top:100px}
  .astro-wkhero__overlay{background:linear-gradient(180deg,rgba(122,28,28,0) 0%,rgba(122,28,28,.25) 35%,rgba(122,28,28,.55) 65%,rgba(110,26,26,.85) 100%)}
  .astro-wkhero__inner{padding:0 20px 40px}
  .astro-wkhero__btns{flex-direction:column}
}
</style>
