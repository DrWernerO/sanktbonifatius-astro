.astro-ki-intro__jobs { padding-top: 16px; border-top: 1px solid var(--bf-border); }
.astro-ki-intro__joblink { display: inline-block; margin-left: 4px; color: var(--bf-accent); font-weight: 700; text-decoration: none; white-space: nowrap; }
.astro-ki-intro__joblink:hover { text-decoration: underline; }
</style>
