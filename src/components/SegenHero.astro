---
// Hero der Seite „Begleitung auf dem Lebensweg" (früher „Segen und Sakramente") — WP-Seite 48265 (/segen-sakramente/, ersetzt WP-Block `ss-hero`).
// Eigene Klassen `astro-sshero` (goldene Regel, Handbuch Abschnitt 3 — niemals WP-Klassen `ss-…`).
// Full-Bleed-Bild + Verlauf-Overlay + Text. Bild lokal unter public/uploads/ (vom Dev-WP geladen,
// unabhängig vom Server, vgl. Handbuch 1b). Inhalte fest gepflegt (selten geändert).
---
<section class="astro-sshero">
  <img class="astro-sshero__bg"
       src="/uploads/kacheln/hero-lebensweg-1600.webp"
       srcset="/uploads/kacheln/hero-lebensweg-800.webp 800w, /uploads/kacheln/hero-lebensweg-1600.webp 1600w"
       sizes="100vw" width="1600" height="1067" fetchpriority="high" decoding="async"
       alt="Segnung eines Jugendlichen bei der Firmung in der Kirche St. Bonifatius in Frankfurt" />
  <div class="astro-sshero__overlay"></div>
  <div class="astro-sshero__inner">
    <h1 class="astro-sshero__title">Begleitung auf dem Lebensweg</h1>
    <p class="astro-sshero__sub">
      Segen und Sakramente in der Pfarrei Sankt Bonifatius in Frankfurt &#8212; wenn ein Kind kommt, zwei Menschen
      sich binden, ein Neuanfang n&ouml;tig ist oder ein Abschied bevorsteht.
    </p>
  </div>
</section>

<style is:global>
.astro-sshero{position:relative;width:100vw;left:50%;margin-left:-50vw;margin-right:-50vw;height:min(70vh,560px);display:flex;align-items:flex-end;overflow:hidden}
.astro-sshero__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;filter:brightness(1.2) saturate(1.05)}
.astro-sshero__overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(30,21,18,0) 0%,rgba(30,21,18,.12) 55%,rgba(30,21,18,.58) 100%)}
.astro-sshero__inner{text-shadow:0 1px 14px rgba(0,0,0,.45);position:relative;z-index:2;width:100%;max-width:1280px;margin:0 auto;padding:0 40px 56px;color:#f0e8d8}
.astro-sshero__title{font-family:'Playfair Display',Georgia,serif;font-size:clamp(36px,5vw,68px);color:#fff;margin:0 0 16px;line-height:1.08;font-weight:700}
.astro-sshero__sub{color:rgba(255,255,255,.9);font-size:clamp(16px,2vw,21px);margin:0;max-width:600px;line-height:1.5}
@media(max-width:600px){.astro-sshero{height:min(64vh,460px)}.astro-sshero__inner{padding:0 20px 40px}}
</style>
