---
// Terminübersicht (id="termine"). Eigene Klassen `astro-jub-ter` (Handbuch 3).
// Daten als Prop `termine` aus dem Seiten-Frontmatter. Je Eintrag:
//   von / bis (ISO 'YYYY-MM-DD'; bis optional), anzeige (Datums-Text), jahr, uhrzeit, titel, ort, text, href.
// Vergangene Termine (Ende < heute) werden grau dargestellt. Die Seite ist statisch gebaut —
// deshalb setzt ein kleines Client-Skript die Klasse beim Laden (Build-Zeitpunkt wäre veraltet);
// der Server-Render nutzt zusätzlich das Build-Datum als Startwert.
const { termine = [] } = Astro.props;
const heute = new Date().toISOString().slice(0, 10);
const sortiert = [...termine].sort((a, b) => a.von.localeCompare(b.von));
---
<section class="astro-jub-sec astro-jub-ter" id="termine">
  <div class="astro-jub-wrap astro-jub-wrap--narrow">
    <div class="astro-jub-head">
      <h2 class="astro-jub-hl">Termine im Überblick</h2>
      <p class="astro-jub-sub">Weitere Termine tragen wir hier laufend ein.</p>
    </div>
    <ul class="astro-jub-ter__list">
      {sortiert.map((t) => {
        const ende = t.bis ?? t.von;
        return (
          <li class={`astro-jub-ter__item${ende < heute ? ' is-past' : ''}`} data-ende={ende}>
            <div class="astro-jub-ter__date">
              <span class="astro-jub-ter__tag">{t.anzeige}</span>
              {t.jahr && <span class="astro-jub-ter__jahr">{t.jahr}</span>}
            </div>
            <div class="astro-jub-ter__body">
              <h3 class="astro-jub-ter__title">{t.href ? <a href={t.href}>{t.titel}</a> : t.titel}</h3>
              {(t.uhrzeit || t.ort) && <p class="astro-jub-ter__meta">{[t.uhrzeit, t.ort].filter(Boolean).join(' · ')}</p>}
              {t.text && <p class="astro-jub-ter__info">{t.text}</p>}
              {t.offen && <p class="astro-jub-ter__offen">{t.offen}</p>}
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script is:inline>
  (function () {
    var heute = new Date().toISOString().slice(0, 10);
    document.querySelectorAll('.astro-jub-ter__item').forEach(function (li) {
      li.classList.toggle('is-past', li.getAttribute('data-ende') < heute);
    });
  })();
</script>

<style is:global>
.astro-jub-ter{background:#fff}
.astro-jub-ter__list{list-style:none;margin:0;padding:0;border-top:1px solid var(--bf-border)}
.astro-jub-ter__item{display:grid;grid-template-columns:190px 1fr;gap:24px;padding:22px 0;border-bottom:1px solid var(--bf-border);align-items:baseline}
.astro-jub-ter__tag{display:block;font-family:var(--jub-serif);font-size:21px;font-weight:700;color:var(--bf-accent);line-height:1.2}
.astro-jub-ter__jahr{display:block;font-size:13px;color:var(--txt-muted-light);margin-top:2px}
.astro-jub-ter__title{font-family:var(--jub-serif);font-size:19px;font-weight:700;color:var(--bf-ink);margin:0 0 4px}
.astro-jub-ter__title a{color:inherit;text-decoration:underline;text-decoration-color:var(--accent-gold-deco);text-underline-offset:3px}
.astro-jub-ter__title a:hover{color:var(--bf-accent)}
.astro-jub-ter__title a:focus-visible{outline:3px solid var(--accent-gold-deco);outline-offset:3px;border-radius:4px}
.astro-jub-ter__meta{font-size:14.5px;font-weight:600;color:var(--txt-gold-label);margin:0 0 4px}
.astro-jub-ter__info,.astro-jub-ter__offen{font-size:15.5px;line-height:1.6;color:var(--txt-muted-light);margin:0}
.astro-jub-ter__offen{font-style:italic}
.astro-jub-ter__item.is-past{opacity:.6}
.astro-jub-ter__item.is-past .astro-jub-ter__tag{color:var(--txt-muted-light)}
.astro-jub-ter__item.is-past .astro-jub-ter__title::after{content:' (vorbei)';font-size:13px;font-weight:400;color:var(--txt-muted-light)}
@media(max-width:560px){.astro-jub-ter__item{grid-template-columns:1fr;gap:6px}}
</style>
