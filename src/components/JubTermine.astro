---
// Kompakte Terminübersicht in zwei Spalten (vor den FAQ). Eigene Klassen `astro-jub-ter` (Handbuch 3).
// Daten: automatisch aus den Programmsparten der Seite (Items mit `von`, ISO-Datum) — eine
// Datenquelle. Je Item genutzt: `kurz` (Datum-Anzeige), `ueb` (kurzer Titel, sonst `titel`), `zeit`,
// `von`/`bis` (Sortierung + „vorbei"). `offen` = Liste von Veranstaltungen ohne Termin (Fußzeile).
// `anker` (Sparten-ID, setzt die Seite automatisch) = Sprungziel; der Link springt zur Sparte und
// klappt deren Details auf. Vergangene Termine setzt ein kleines Client-Skript grau (Seite ist statisch gebaut).
const { termine = [], offen = [] } = Astro.props;
const sortiert = [...termine].sort((a, b) => a.von.localeCompare(b.von));
const heute = new Date().toISOString().slice(0, 10);
---
<section class="astro-jub-sec astro-jub-ter" id="termine">
  <div class="astro-jub-wrap">
    <div class="astro-jub-head">
      <h2 class="astro-jub-hl">Alle Termine auf einen Blick</h2>
    </div>
    <ol class="astro-jub-ter__list">
      {sortiert.map((t) => (
        <li class={`astro-jub-ter__item${(t.bis ?? t.von) < heute ? ' is-past' : ''}`} data-ende={t.bis ?? t.von}>
          <span class="astro-jub-ter__date">{t.kurz}</span>
          <span class="astro-jub-ter__what">{t.anker ? <a href={`#${t.anker}`}>{t.ueb ?? t.titel}</a> : (t.ueb ?? t.titel)}{t.zeit && <span class="astro-jub-ter__time"> · {t.zeit}</span>}</span>
        </li>
      ))}
    </ol>
    {offen.length > 0 && (
      <p class="astro-jub-ter__open"><strong>Termin folgt:</strong> {offen.join(' · ')}</p>
    )}
  </div>
</section>

<script is:inline>
  (function () {
    var heute = new Date().toISOString().slice(0, 10);
    document.querySelectorAll('.astro-jub-ter__item').forEach(function (li) {
      li.classList.toggle('is-past', li.getAttribute('data-ende') < heute);
    });
    // Klick auf einen Termin: Details der Zielsparte aufklappen, damit der Eintrag sichtbar ist
    document.querySelectorAll('.astro-jub-ter__what a').forEach(function (a) {
      a.addEventListener('click', function () {
        var card = document.getElementById(a.getAttribute('href').slice(1));
        var d = card && card.querySelector('details');
        if (d) d.open = true;
      });
    });
  })();
</script>

<style is:global>
.astro-jub-ter{background:var(--bf-bg)}
.astro-jub-ter__list{list-style:none;margin:0 auto;padding:0;max-width:960px;columns:2;column-gap:40px}
.astro-jub-ter__item{display:grid;grid-template-columns:128px 1fr;gap:12px;padding:9px 0;border-bottom:1px solid var(--bf-border);break-inside:avoid;align-items:baseline}
.astro-jub-ter__date{font-family:var(--jub-serif);font-size:16px;font-weight:700;color:var(--bf-accent);line-height:1.3}
.astro-jub-ter__what{font-size:16px;line-height:1.45;color:var(--bf-ink)}
.astro-jub-ter__what a{color:inherit;text-decoration:underline;text-decoration-color:var(--accent-gold-deco);text-underline-offset:3px}
.astro-jub-ter__what a:hover{color:var(--bf-accent)}
.astro-jub-ter__what a:focus-visible{outline:3px solid var(--bf-accent);outline-offset:3px;border-radius:4px}
.astro-jub-ter__time{color:var(--txt-muted-light);font-size:15px;white-space:nowrap}
.astro-jub-ter__open{max-width:960px;margin:16px auto 0;font-size:15.5px;line-height:1.6;color:var(--txt-muted-light)}
.astro-jub-ter__item.is-past{opacity:.6}
.astro-jub-ter__item.is-past .astro-jub-ter__date{color:var(--txt-muted-light)}
@media(max-width:820px){.astro-jub-ter__list{columns:1}}
@media(max-width:420px){.astro-jub-ter__item{grid-template-columns:1fr;gap:2px}}
</style>
